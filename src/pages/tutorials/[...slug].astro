---
// Redirect stub: tutorials moved to https://runtime.evox.group.
// Slugs are hardcoded (getStaticPaths runs in an isolated scope, so they
// must come from an import) because the content collection was removed.
import { tutorialSlugs } from "../../utils/movedSlugs";

export function getStaticPaths() {
  return tutorialSlugs.map((slug) => ({
    params: { slug },
  }));
}

return Astro.redirect(`https://runtime.evox.group/tutorials/${Astro.params.slug}`);
---
