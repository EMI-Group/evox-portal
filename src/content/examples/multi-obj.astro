<div id="rvea-plot" class="w-full h-full"></div>

<script src="https://cdn.plot.ly/plotly-3.3.0.min.js" charset="utf-8" is:inline></script>

<script>
  import { coordinate, splashed, layout } from "./rvea-data.js";
  import framesUrl from "./rvea-frames.json?url";

  const rvea_plot = document.getElementById("rvea-plot");
  if (rvea_plot) {
    const data = [coordinate, splashed];
    const initPlot = async () => {
      // @ts-ignore
      await Plotly.newPlot(rvea_plot, data, layout, { responsive: true });
      const values = await fetch(framesUrl).then((v) => v.json());
      // @ts-ignore
      values.forEach((it) => (it.data[0] = coordinate));
      // @ts-ignore
      Plotly.addFrames(rvea_plot, values);
      rvea_plot.setAttribute("data-ready", "true");
    };
    initPlot().catch(() => {});
  }
</script>
