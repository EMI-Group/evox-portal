---
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { type Locale, defaultLocale, loadTranslations, t } from "../../i18n/utils";

const locale: Locale = defaultLocale;
const tr = await loadTranslations(locale);
---

<Layout title={t(tr, "community.pageTitle")} locale={locale}>
  <div class="relative text-white py-20 md:py-28 overflow-hidden" style="background: rgb(22, 27, 48);">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at center, rgba(60, 70, 110, 0.4) 0%, transparent 60%);"></div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-4">{t(tr, "community.title")}</h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">{t(tr, "community.desc")}</p>
    </div>
  </div>
  <div class="bg-gray-50 min-h-screen py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <button type="button" data-qq-qr-open class="group block p-8 bg-white rounded-3xl border border-gray-100 hover:border-teal-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-left cursor-pointer">
          <div class="flex items-center gap-4 mb-5">
            <div class="p-3 bg-teal-100 rounded-xl text-teal-600 group-hover:bg-teal-600 group-hover:text-white transition-colors shadow-sm">
              <Icon name="simple-icons:tencentqq" class="h-6 w-6" />
            </div>
            <h2 class="text-2xl font-bold text-gray-900">EvoX <span class="text-teal-600 group-hover:text-teal-700 font-extrabold">{t(tr, "community.qq.title")}</span></h2>
          </div>
          <p class="text-gray-600 text-lg leading-relaxed">{t(tr, "community.qq.desc")}</p>
        </button>
        <a href="https://discord.com/invite/Vbtgcpy7G4" target="_blank" rel="noopener noreferrer" class="group block p-8 bg-white rounded-3xl border border-gray-100 hover:border-indigo-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="flex items-center gap-4 mb-5">
            <div class="p-3 bg-indigo-100 rounded-xl text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-colors shadow-sm">
              <Icon name="simple-icons:discord" class="h-6 w-6" />
            </div>
            <h2 class="text-2xl font-bold text-gray-900">EvoX <span class="text-indigo-600 group-hover:text-indigo-700 font-extrabold">{t(tr, "community.discord.title")}</span></h2>
          </div>
          <p class="text-gray-600 text-lg leading-relaxed">{t(tr, "community.discord.desc")}</p>
        </a>
      </div>
    </div>
  </div>
  <div id="qq-qr-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-label={t(tr, "community.qq.title")}>
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" data-qq-qr-close></div>
    <div class="relative bg-white rounded-3xl p-6 md:p-8 shadow-2xl max-w-sm w-full text-center">
      <button type="button" data-qq-qr-close aria-label={t(tr, "community.qq.close")} class="absolute top-3 right-3 p-2 text-gray-400 hover:text-gray-700 transition-colors cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
      <img src="/images/qq-group-qr.png" alt={t(tr, "community.qq.title")} width="610" height="610" class="w-full h-auto rounded-xl" loading="lazy" />
      <p class="mt-4 text-lg font-bold text-gray-900">QQ: 297969717</p>
      <p class="mt-1 text-gray-600">{t(tr, "community.qq.scan")}</p>
    </div>
  </div>
  <script>
    const qqQrModal = document.getElementById("qq-qr-modal");
    const closeQqQrModal = () => {
      qqQrModal?.classList.add("hidden");
      qqQrModal?.classList.remove("flex");
    };
    document.querySelectorAll("[data-qq-qr-open]").forEach((btn) => {
      btn.addEventListener("click", () => {
        qqQrModal?.classList.remove("hidden");
        qqQrModal?.classList.add("flex");
      });
    });
    qqQrModal?.querySelectorAll("[data-qq-qr-close]").forEach((el) => {
      el.addEventListener("click", closeQqQrModal);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeQqQrModal();
    });
  </script>
</Layout>
