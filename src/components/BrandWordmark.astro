      <path d="M35457.69 0.85l-5624.74 0c-29.83,0 -56.28,6.1 -77.72,17.2 -21.88,12.19 -41.69,30.48 -57.91,54.54 -16.87,24.16 -26.45,49.42 -28.96,73.59 -2.61,25.04 1.63,52.36 12.74,80.01l10643.05 26342.91c12.85,31.9 33.64,57.59 59.43,74.89 25.04,16.87 56.93,26.34 92.42,26.34l7391.24 0c35.59,0 67.38,-9.47 92.42,-26.34 25.8,-17.31 46.59,-43 59.43,-74.89l10552.81 -26119.32c41.91,-103.74 30.59,-212.16 -32,-304.9 -62.59,-92.85 -158.82,-144.02 -270.72,-144.02l-5383.52 0c-35.49,0 -67.38,9.47 -92.42,26.34 -25.8,17.31 -46.7,43.11 -59.43,74.89l-7906.55 19569.51c-54.75,136.07 -145.43,246.78 -259.29,323.52 -114.3,77.07 -250.69,119.96 -396.34,119.96 -145.76,0 -282.04,-42.89 -396.34,-119.96 -113.86,-76.74 -204.54,-187.45 -259.29,-323.52l-7906.45 -19569.51c-12.74,-31.79 -33.64,-57.58 -59.43,-74.89 -25.04,-16.87 -56.82,-26.34 -92.42,-26.34z" />
      <path d="M87541.84 0.85l-16295.44 0c-1875.13,0 -3580.12,767.43 -4816.28,2003.47 -1236.15,1236.27 -2003.47,2941.15 -2003.47,4816.29l0 13029.94c0,1875.14 767.43,3580.13 2003.47,4816.29 1236.16,1236.05 2941.15,2003.47 4816.28,2003.47l16295.44 0c1875.13,0 3580.23,-767.43 4816.28,-2003.58 1236.15,-1236.05 2003.58,-2941.04 2003.58,-4816.18l0 -13029.94c0,-1875.14 -767.43,-3580.13 -2003.58,-4816.18 -1236.05,-1236.16 -2941.15,-2003.58 -4816.28,-2003.58zm-15199.06 5442.75l14102.78 0c680.45,0 1299.07,278.23 1747.12,726.28 448.04,448.05 726.28,1066.67 726.28,1747.12l0 10837.06c0,680.45 -278.23,1299.08 -726.28,1747.12 -448.05,448.05 -1066.67,726.28 -1747.12,726.28l-14102.78 0c-680.45,0 -1299.07,-278.23 -1747.12,-726.28 -448.05,-448.05 -726.28,-1066.67 -726.28,-1747.12l0 -10837.06c0,-680.45 278.23,-1299.08 726.28,-1747.12 448.05,-448.05 1066.67,-726.28 1747.12,-726.28z" />
    </g>
  </svg>
  <span class="wordmark-x"><BrandMark /></span>
</span>

<style>
  .brand-wordmark { display: block; position: relative; width: 100%; aspect-ratio: 134531.44 / 28473.72; }
  .brand-lettering { display: block; width: 100%; height: auto; }
  .wordmark-x { display: block; position: absolute; top: 0; right: 0; width: 26.1023877166%; }
  .wordmark-x :global(.brand-logo) { width: 100%; }
  .brand-stop { transition: stop-color 150ms cubic-bezier(0.16, 1, 0.3, 1); }
  .brand-stop-0 { stop-color: #373435; }
  .brand-stop-1 { stop-color: #373535; }
  .brand-stop-2 { stop-color: #373636; }
  .brand-stop-3 { stop-color: #302f30; }
  .brand-stop-4 { stop-color: #282829; }
  :global([data-theme="dark"]) .brand-stop { stop-color: #fefefe; }
  @media (prefers-reduced-motion: reduce) {
    .brand-stop { transition: none; }
  }
</style>
