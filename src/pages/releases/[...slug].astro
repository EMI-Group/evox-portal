---
import { getCollection } from "astro:content";
import BlogArticle from "../../components/pages/BlogArticle.astro";
import { type Locale, defaultLocale, loadTranslations, t, getLocalizedUrl, getDateLocale, getLocalizedArticles } from "../../i18n/utils";

export async function getStaticPaths() {
  const allArticles = await getCollection("releases");
  const articles = getLocalizedArticles(allArticles, defaultLocale);
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const locale: Locale = defaultLocale;

const { article } = Astro.props;

---

<BlogArticle locale={locale} slug={article.slug} kind="releases" />
