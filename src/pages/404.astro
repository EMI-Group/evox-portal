---
import NotFoundContent from "../components/pages/NotFoundContent.astro";
---
<NotFoundContent />
<script>
  import { getLocaleFromUrl, defaultLocale, getLocalizedUrl } from "../i18n/utils";
  const locale = getLocaleFromUrl(window.location.pathname);
  if (locale !== defaultLocale) window.location.replace(getLocalizedUrl("/404", locale));
</script>
