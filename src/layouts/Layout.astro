---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { type Locale, defaultLocale, locales, loadTranslations, t, getLocalizedUrl } from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  fullBleed?: boolean;
  locale?: Locale;
  noSEO?: boolean;
  localePath?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleImage?: string;
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title,
  description,
  hideHeader = false,
  hideFooter = false,
  fullBleed = false,
  locale = defaultLocale,
  noSEO = false,
  localePath,
  articlePublishedTime,
  articleModifiedTime,
  articleImage,
  breadcrumbs,
} = Astro.props;

const htmlLang =
  locale === "es-419" ? "es-419"
  : locale === "pt-br" ? "pt-BR"
  : locale === "zh-cn" ? "zh-CN"
  : locale === "zh-tw" ? "zh-TW"
  : locale;

const tr = await loadTranslations(locale);
// Default title follows the page locale, not always English
const pageTitle = title ?? t(tr, "site.title");
// Pages can pass their own description (e.g. an article summary); the
// site-wide tagline is the fallback.
const metaDescription = description ?? t(tr, "meta.description");

// BCP-47 codes for hreflang attributes
const hreflangCodes: Record<Locale, string> = {
  "en": "en",
  "zh-cn": "zh-CN",
  "zh-tw": "zh-TW",
  "ja": "ja",
  "ko": "ko",
  "fr": "fr",
  "de": "de",
  "it": "it",
  "es": "es-ES",
  // Google does not support the UN M49 region 419 in hreflang.
  // Use the Latin American edition as the general Spanish fallback.
  "es-419": "es",
  "ru": "ru",
  "pt": "pt",
  "pt-br": "pt-BR",
};

// Open Graph locale codes (language_TERRITORY)
const ogLocale: Record<Locale, string> = {
  "en": "en_US",
  "zh-cn": "zh_CN",
  "zh-tw": "zh_TW",
  "ja": "ja_JP",
  "ko": "ko_KR",
  "fr": "fr_FR",
  "de": "de_DE",
  "it": "it_IT",
  "es": "es_ES",
  "es-419": "es_LA",
  "ru": "ru_RU",
  "pt": "pt_PT",
  "pt-br": "pt_BR",
};

const site = Astro.site ?? new URL("https://www.evox.group");
// Internal links site-wide use no trailing slash; normalize the build-time
// pathname (which always ends with "/") so canonical/hreflang/og:url agree.
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalUrl = new URL(pathname, site);
const socialImage = new URL(articleImage ?? "/images/og-image.png", site).href;
const localizedUrls = locales.map((loc) => ({
  locale: loc,
  url: new URL(getLocalizedUrl(pathname, loc), site),
}));
const organizationId = new URL("/#organization", site).href;
const isHome = pathname === getLocalizedUrl("/", locale);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization", "@id": organizationId,
      name: "EvoX Team", url: site.href,
      logo: new URL("/favicon.png", site).href,
      sameAs: ["https://github.com/EMI-Group"],
    },
    ...(isHome ? [{
      "@type": "WebSite", "@id": `${canonicalUrl.href}#website`,
      name: "EvoX", url: canonicalUrl.href, description: metaDescription,
      inLanguage: htmlLang, publisher: { "@id": organizationId },
    }] : []),
    ...(articlePublishedTime ? [{
      "@type": "BlogPosting", "@id": `${canonicalUrl.href}#article`,
      headline: pageTitle, description: metaDescription,
      datePublished: articlePublishedTime, inLanguage: htmlLang,
      ...(articleModifiedTime ? { dateModified: articleModifiedTime } : {}),
      ...(articleImage ? { image: [socialImage] } : {}),
      url: canonicalUrl.href,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl.href },
      publisher: { "@id": organizationId },
    }] : []),
    ...(breadcrumbs ? [{
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl.href}#breadcrumbs`,
      itemListElement: breadcrumbs.map((item, index) => ({
        "@type": "ListItem", position: index + 1,
        name: item.name, item: new URL(item.url, site).href,
      })),
    }] : []),
  ],
};
// Escaping angle brackets prevents content from terminating the script element.
const structuredJson = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={htmlLang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem("evox-theme") === "dark" ? "dark" : "light";
      } catch {
        document.documentElement.dataset.theme = "light";
      }
    </script>
    <link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDescription} />
    {noSEO && <meta name="robots" content="noindex" />}
    {!noSEO && <link rel="canonical" href={canonicalUrl} />}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {!noSEO && <script type="application/ld+json" is:inline set:html={structuredJson} />}
    {!noSEO && localizedUrls.map(({ locale: loc, url }) => (
      <link rel="alternate" hreflang={hreflangCodes[loc]} href={url} />
    ))}
    {!noSEO && <link rel="alternate" hreflang="x-default" href={localizedUrls[0].url} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    {!noSEO && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:type" content={articlePublishedTime && !noSEO ? "article" : "website"} />
    <meta property="og:site_name" content="EvoX" />
    {!noSEO && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {!noSEO && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={articleImage ? pageTitle : "EvoX"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={articleImage ? pageTitle : "EvoX"} />
    <title>{pageTitle}</title>
  </head>

  <body class="antialiased min-h-screen flex flex-col">
    {!hideHeader && <Header locale={locale} localePath={localePath} />}

    <main class:list={["site-main flex-grow w-full", { "site-main-padded": !hideHeader && !fullBleed }]}>
      <slot />
    </main>

    {!hideFooter && <Footer locale={locale} />}
  </body>
</html>
