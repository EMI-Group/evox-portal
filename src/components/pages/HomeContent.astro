---
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import { getCollection } from "astro:content";
import { Code } from "astro:components";
import { Icon } from "astro-icon/components";
import {
  type Locale,
  defaultLocale,
  loadTranslations,
  t,
  getLocalizedUrl,
  getDateLocale,
  getLocalizedArticles,
} from "../../i18n/utils";

import codeSingleObj from "../../content/examples/single-obj.py?raw";
import codeMultiObj from "../../content/examples/multi-obj.py?raw";
import codeNeuro from "../../content/examples/neuroevolution.py?raw";

import SingleObj from "../../content/examples/single-obj.astro";
import MultiObj from "../../content/examples/multi-obj.astro";
import Neuroevolution from "../../content/examples/neuroevolution.astro";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const tr = await loadTranslations(locale);
const dateLocale = getDateLocale(locale);

const allNews = await getCollection("news");
const allReleases = await getCollection("releases");
const localizedNews = getLocalizedArticles(allNews, locale);
const localizedReleases = getLocalizedArticles(allReleases, locale);
const latestRelease = localizedReleases.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)[0];
const latestNews = localizedNews
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const latestArticles = [latestRelease, ...latestNews];

const allLibs = await getCollection("libs");
const ecosystem = allLibs.slice(0, 3);
---

<Layout title={t(tr, "site.title")} hideHeader hideFooter locale={locale}>
  <!-- ========== Navbar (starts at bottom, flies to top) ========== -->
  <div
    id="navbar"
    class="fixed left-0 right-0 top-0 transition-transform duration-700 ease-out"
    style="z-index: 50; transform: translateY(100vh);"
  >
    <Header animated locale={locale} />
  </div>

  <!-- ========== Scroll Indicator ========== -->
  <div
    id="scroll-indicator"
    class="fixed bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center text-gray-500 scroll-bounce cursor-pointer transition-opacity duration-300"
    style="z-index: 35;"
  >
    <span class="text-sm mb-2">{t(tr, "hero.scroll")}</span>
    <svg
      class="w-4 h-4"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
      ></path>
    </svg>
  </div>

  <!-- ========== Hero Section ========== -->
  <section
    id="hero-section"
    class="relative flex flex-col items-center justify-center text-center px-4 py-16"
    style="min-height: 100vh; background: rgb(22, 27, 48); z-index: 10;"
  >
    <div
      class="absolute inset-0 transition-opacity duration-700"
      id="hero-gradient"
      style="background: radial-gradient(ellipse at center, rgba(60, 70, 110, 0.5) 0%, transparent 60%);"
    >
    </div>

    <div class="relative z-10">
      <!-- Hero Logo (visible by default) -->
      <img
        id="hero-logo"
        src="/logo.png"
        alt="EvoX Logo"
        class="h-28 md:h-36 mb-10 mx-auto"
      />

      <h1
        id="hero-title"
        class="text-4xl md:text-6xl font-bold text-white mb-5 transition-opacity duration-700"
      >
        {t(tr, "hero.title")}
      </h1>
      <p
        id="hero-subtitle"
        class="text-lg md:text-xl text-gray-400 mb-8 transition-opacity duration-700"
      >
        {t(tr, "hero.subtitle")}
      </p>

      <!-- CTA Content (appears when expanded) -->
      <div
        id="cta-content"
        class="mt-8 transition-opacity duration-700"
        style="opacity: 0;"
      >
        <p class="text-lg text-blue-400 mb-10">
          {t(tr, "hero.cta.tagline")}
        </p>
        <a
          href={getLocalizedUrl("/tutorials", locale)}
          class="inline-block border-2 border-blue-500 text-white font-medium px-14 py-3 rounded-lg hover:bg-blue-500 transition-colors duration-200"
        >
          {t(tr, "hero.cta.button")}
        </a>
      </div>
    </div>
  </section>

  <!-- ========== Page Content ========== -->
  <div id="page-content" class="relative" style="background: rgb(22, 27, 48);">
    <div id="content-body" style="background: rgb(22, 27, 48);">
      <!-- Latest News -->
      <section class="bg-white py-16">
        <div class="max-w-[1280px] mx-auto px-4">
          <div
            class="flex justify-between items-end border-b border-gray-200 pb-4 mb-8"
          >
            <h2 class="text-2xl font-bold text-gray-900 relative pb-4 -mb-4">
              {t(tr, "news.title")}
              <span class="absolute bottom-0 left-0 w-16 h-0.5 bg-blue-500"
              ></span>
            </h2>
            <a
              href={getLocalizedUrl("/news", locale)}
              class="text-blue-500 hover:text-blue-700 flex items-center gap-1 text-sm font-medium"
            >
              {t(tr, "news.viewAll")}
              <span>&rarr;</span>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {
              latestArticles.map((post) => {
                const section = localizedNews.some((n) => n.slug === post.slug)
                  ? "news"
                  : "releases";
                return (
                  <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
                    <p class="text-sm text-gray-400 mb-2">
                      {post.data.pubDate.toLocaleDateString(dateLocale, {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </p>
                    <h3 class="text-lg font-bold text-gray-900 mb-3">
                      {post.data.title}
                    </h3>
                    <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                      {post.data.summary || t(tr, "news.defaultSummary")}
                    </p>
                    <a
                      href={getLocalizedUrl(`/${section}/${post.slug}`, locale)}
                      class="text-blue-500 hover:text-blue-700 text-sm flex items-center gap-1"
                    >
                      {t(tr, "news.readMore")} <span>&rarr;</span>
                    </a>
                  </div>
                );
              })
            }
          </div>
        </div>
      </section>

      <!-- Key Features -->
      <div class="bg-gray-50 py-16">
        <div class="max-w-[1280px] mx-auto px-4 text-center">
          <h2 class="text-3xl font-bold text-teal-700 mb-12">
            {t(tr, "features.title")}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left">
            <div
              class="bg-white p-6 rounded-lg shadow-sm border-t-4 border-teal-500"
            >
              <h3 class="text-lg font-bold mb-3">
                {t(tr, "features.perf.title")}
              </h3>
              <ul class="text-sm text-gray-600 space-y-2">
                <li set:html={t(tr, "features.perf.item1")} />
                <li>{t(tr, "features.perf.item2")}</li>
              </ul>
            </div>
            <div
              class="bg-white p-6 rounded-lg shadow-sm border-t-4 border-teal-500"
            >
              <h3 class="text-lg font-bold mb-3">
                {t(tr, "features.allinone.title")}
              </h3>
              <ul class="text-sm text-gray-600 space-y-2">
                <li set:html={t(tr, "features.allinone.item1")} />
                <li>{t(tr, "features.allinone.item2")}</li>
              </ul>
            </div>
            <div
              class="bg-white p-6 rounded-lg shadow-sm border-t-4 border-teal-500"
            >
              <h3 class="text-lg font-bold mb-3">
                {t(tr, "features.easy.title")}
              </h3>
              <ul class="text-sm text-gray-600 space-y-2">
                <li>{t(tr, "features.easy.item1")}</li>
                <li>{t(tr, "features.easy.item2")}</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Community -->
      <div class="bg-gray-100 py-16">
        <div class="max-w-[1280px] mx-auto px-4">
          <div class="text-center mb-10">
            <h2 class="text-3xl font-bold text-gray-900 mb-2">{t(tr, "community.title")}</h2>
            <p class="text-xl text-gray-600">{t(tr, "community.desc")}</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
            <a href="http://qm.qq.com/cgi-bin/qm/qr?_wv=1027&k=_9aIGJT9OSyG6Zxi_8owHw5-Kpih8--g&authKey=0J4q%2FdbCjeH3p12Y9qlIavA8vdK3g5FIPJ%2BwpO9M3UkNnEwZCSuw9WiRMO4zNe7d&noverify=0&group_code=297969717" target="_blank" rel="noopener noreferrer" class="group block p-8 bg-white rounded-3xl border border-gray-100 hover:border-teal-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
              <div class="flex items-center gap-4 mb-5">
                <div class="p-3 bg-teal-100 rounded-xl text-teal-600 group-hover:bg-teal-600 group-hover:text-white transition-colors shadow-sm">
                  <Icon name="simple-icons:tencentqq" class="h-6 w-6" />
                </div>
                <h4 class="text-2xl font-bold text-gray-900">EvoX <span class="text-teal-600 group-hover:text-teal-700 font-extrabold">{t(tr, "community.qq.title")}</span></h4>
              </div>
              <p class="text-gray-600 text-lg leading-relaxed">{t(tr, "community.qq.desc")}</p>
            </a>
            <a href="https://discord.com/invite/Vbtgcpy7G4" target="_blank" rel="noopener noreferrer" class="group block p-8 bg-white rounded-3xl border border-gray-100 hover:border-indigo-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
              <div class="flex items-center gap-4 mb-5">
                <div class="p-3 bg-indigo-100 rounded-xl text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-colors shadow-sm">
                  <Icon name="simple-icons:discord" class="h-6 w-6" />
                </div>
                <h4 class="text-2xl font-bold text-gray-900">EvoX <span class="text-indigo-600 group-hover:text-indigo-700 font-extrabold">{t(tr, "community.discord.title")}</span></h4>
              </div>
              <p class="text-gray-600 text-lg leading-relaxed">{t(tr, "community.discord.desc")}</p>
            </a>
          </div>
        </div>
      </div>

      <!-- Code Examples (Tabbed) -->
      <div class="bg-white py-16">
        <div class="max-w-[1280px] mx-auto px-4">
          <!-- Tab Bar -->
          <div class="flex justify-between mb-8 pt-4 items-end min-h-[5rem]">
            <button
              class="example-tab active flex flex-col items-center gap-2 px-6 cursor-pointer"
              data-tab="0"
            >
              <img src="/arrow_1.png" alt="" class="h-6 tab-icon" />
              {t(tr, "examples.singleObj")}
            </button>
            <button
              class="example-tab flex flex-col items-center gap-2 px-6 cursor-pointer"
              data-tab="1"
            >
              <img src="/arrow_2.png" alt="" class="h-6 tab-icon" />
              {t(tr, "examples.multiObj")}
            </button>
            <button
              class="example-tab flex flex-col items-center gap-2 px-6 cursor-pointer"
              data-tab="2"
            >
              <img src="/arrow_3.png" alt="" class="h-6 tab-icon" />
              {t(tr, "examples.neuro")}
            </button>
          </div>

          <!-- Tab Panels -->
          <div class="example-panel" data-panel="0">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
              <div
                class="rounded-lg overflow-auto shadow-lg border border-gray-200 h-[28rem] bg-[#0d1117]"
              >
                <Code
                  code={codeSingleObj}
                  lang="python"
                  theme="github-dark"
                  class="p-4 md:p-6 min-h-full"
                />
              </div>
              <div
                class="h-[28rem] bg-white rounded-lg border border-gray-200 overflow-hidden relative"
              >
                <SingleObj />
              </div>
            </div>
          </div>
          <div class="example-panel hidden" data-panel="1">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
              <div
                class="rounded-lg overflow-auto shadow-lg border border-gray-200 h-[28rem] bg-[#0d1117]"
              >
                <Code
                  code={codeMultiObj}
                  lang="python"
                  theme="github-dark"
                  class="p-4 md:p-6 min-h-full"
                />
              </div>
              <div
                class="h-[28rem] bg-white rounded-lg border border-gray-200 overflow-hidden relative"
              >
                <MultiObj />
              </div>
            </div>
          </div>
          <div class="example-panel hidden" data-panel="2">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
              <div
                class="rounded-lg overflow-auto shadow-lg border border-gray-200 h-[28rem] bg-[#0d1117]"
              >
                <Code
                  code={codeNeuro}
                  lang="python"
                  theme="github-dark"
                  class="p-4 md:p-6 min-h-full"
                />
              </div>
              <div
                class="h-[28rem] bg-white rounded-lg border border-gray-200 overflow-hidden relative"
              >
                <Neuroevolution />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Ecosystem -->
      <div class="bg-gray-50 py-16 border-t border-gray-200">
        <div class="max-w-[1280px] mx-auto px-4">
          <div class="mb-10">
            <h2 class="text-3xl font-bold text-gray-900 mb-2">
              {t(tr, "ecosystem.title")}
            </h2>
            <h5 class="text-teal-600 font-medium mb-4">
              {t(tr, "ecosystem.subtitle")}
            </h5>
            <p class="text-xl text-gray-600">{t(tr, "ecosystem.desc")}</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
              ecosystem.map((item) => (
                <a href={item.data.url} target="_blank" rel="noopener noreferrer" class="block group">
                  <div class="bg-white p-6 rounded-lg shadow-sm group-hover:shadow-md transition-shadow border border-gray-100 h-full">
                    <h4 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-teal-600 transition-colors">
                      {item.data.title}
                    </h4>
                    <p class="text-gray-600 text-sm leading-relaxed">
                      {item.data.description}
                    </p>
                  </div>
                </a>
              ))
            }
          </div>
          <div class="mt-8 text-center md:text-left">
            <a
              href={getLocalizedUrl("/libs", locale)}
              class="text-teal-700 font-semibold hover:text-teal-900 inline-flex items-center gap-1"
            >
              {t(tr, "ecosystem.seeAll")}
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <Footer locale={locale} />
    </div>
  </div>
</Layout>

<style>
  .scroll-bounce {
    animation: float 2s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  /* Example tabs */
  .example-tab {
    color: #9ca3af;
    font-size: 1.25rem;
    font-weight: 700;
    transition:
      color 0.3s ease,
      font-size 0.3s ease;
  }
  .example-tab .tab-icon {
    opacity: 0.25;
    filter: grayscale(100%);
    transition:
      opacity 0.3s ease,
      filter 0.3s ease,
      transform 0.3s ease;
  }
  .example-tab:hover {
    color: #374151;
  }
  .example-tab:hover .tab-icon {
    opacity: 0.6;
    filter: grayscale(50%);
  }
  .example-tab.active {
    color: #0f172a;
    font-size: 1.5rem;
  }
  .example-tab.active .tab-icon {
    opacity: 1;
    filter: grayscale(0%);
  }
</style>

<script>
  // Disable browser scroll restoration so page always starts at top
  if ("scrollRestoration" in history) {
    history.scrollRestoration = "manual";
  }

  function init() {
    const navbar = document.getElementById("navbar");
    const heroSection = document.getElementById("hero-section");
    const heroLogo = document.getElementById("hero-logo") as HTMLImageElement;
    const heroGradient = document.getElementById("hero-gradient");
    const scrollIndicator = document.getElementById("scroll-indicator");
    const ctaContent = document.getElementById("cta-content");

    if (!navbar || !heroSection || !heroLogo) return;

    const navbarLogoImg = navbar.querySelector(
      "img[alt='X']",
    ) as HTMLImageElement;
    if (!navbarLogoImg) return;

    navbarLogoImg.style.opacity = "0";

    let isExpanded = false;
    let isAnimating = false;
    const scrollThreshold = 5;
    const DURATION = 1200;

    function preventScroll(e: Event) {
      e.preventDefault();
    }
    function lockScroll() {
      document.body.style.overflow = "hidden";
      window.addEventListener("wheel", preventScroll, { passive: false });
      window.addEventListener("touchmove", preventScroll, { passive: false });
    }
    function unlockScroll() {
      document.body.style.overflow = "";
      window.removeEventListener("wheel", preventScroll);
      window.removeEventListener("touchmove", preventScroll);
    }

    function easeOut(t: number) {
      return 1 - (1 - t) * (1 - t);
    }

    let expandCallback: (() => void) | null = null;

    function expand(onDone?: () => void) {
      if (isExpanded || isAnimating) {
        if (isExpanded && !isAnimating && onDone) onDone();
        return;
      }
      isExpanded = true;
      isAnimating = true;
      lockScroll();
      if (onDone) expandCallback = onDone;

      // Measure hero logo position
      const logoRect = heroLogo.getBoundingClientRect();
      const logoStartX = logoRect.left;
      const logoStartY = logoRect.top;
      const logoW = logoRect.width;
      const logoH = logoRect.height;

      // Measure navbar height and logo end position
      navbar.style.transition = "none";
      navbar.style.transform = "translateY(0)";
      navbar.offsetHeight;
      const navbarH = navbar.offsetHeight;
      const navLogoRect = navbarLogoImg.getBoundingClientRect();
      const logoEndX = navLogoRect.left;
      const logoEndY = navLogoRect.top;
      const logoEndW = navLogoRect.width;
      const logoEndH = navLogoRect.height;
      navbar.style.transform = `translateY(${window.innerHeight}px)`;
      navbar.offsetHeight;
      navbar.style.transition = "";

      // Clone logo for flying
      const flyLogo = heroLogo.cloneNode(true) as HTMLImageElement;
      flyLogo.id = "";
      flyLogo.className = "";
      flyLogo.style.cssText = `position:fixed;left:${logoStartX}px;top:${logoStartY}px;width:${logoW}px;height:${logoH}px;z-index:60;pointer-events:none;margin:0;padding:0;`;
      document.body.appendChild(flyLogo);
      heroLogo.style.visibility = "hidden";

      const startTime = performance.now();

      function animate(now: number) {
        const elapsed = now - startTime;
        const rawT = Math.min(elapsed / DURATION, 1);
        const t = easeOut(rawT);

        // Navbar flies from bottom to top
        const navbarY = window.innerHeight * (1 - t);
        navbar.style.transform = `translateY(${navbarY}px)`;

        // Use calculated position directly
        const navTopY = navbarY;
        const logoBottomIfStill = logoStartY + logoH;
        const contacted = navTopY < logoBottomIfStill;

        if (!contacted) {
          flyLogo.style.left = `${logoStartX}px`;
          flyLogo.style.top = `${logoStartY}px`;
          flyLogo.style.width = `${logoW}px`;
          flyLogo.style.height = `${logoH}px`;

          heroSection.style.minHeight = "100vh";
          if (heroGradient) heroGradient.style.opacity = "1";
          if (ctaContent) ctaContent.style.opacity = "0";
          if (scrollIndicator) scrollIndicator.style.opacity = "1";
        } else {
          // Progress since contact: 0 at contact, 1 when logo reaches its final position
          const contactY = logoBottomIfStill;
          const doneY = logoEndY + logoEndH;
          const totalTravel = contactY - doneY;
          const progressAfterContact = Math.min(
            (contactY - navTopY) / totalTravel,
            1,
          );

          const p = Math.min(progressAfterContact, 1);
          const curW = logoW + (logoEndW - logoW) * p;
          const curH = logoH + (logoEndH - logoH) * p;
          const curX = logoStartX + (logoEndX - logoStartX) * p;
          // Logo bottom sticks to navbar top early on,
          // but transitions to final Y (inside navbar) as p approaches 1
          const ridingTop = navTopY - curH;
          const logoTop = ridingTop + (logoEndY - ridingTop) * p * p;

          flyLogo.style.left = `${curX}px`;
          flyLogo.style.top = `${logoTop}px`;
          flyLogo.style.width = `${curW}px`;
          flyLogo.style.height = `${curH}px`;

          // Other elements animate only after contact
          const heroMinH = 100 - 40 * progressAfterContact;
          heroSection.style.minHeight = `${heroMinH}vh`;
          if (heroGradient)
            heroGradient.style.opacity = `${1 - 0.7 * progressAfterContact}`;
          if (ctaContent) ctaContent.style.opacity = `${progressAfterContact}`;
          if (scrollIndicator)
            scrollIndicator.style.opacity = `${1 - progressAfterContact}`;
        }

        if (rawT < 1) {
          requestAnimationFrame(animate);
        } else {
          // Ensure navbar is at final position
          navbar.style.transform = "translateY(0)";
          // Place flyLogo exactly at navbarLogo position
          flyLogo.style.left = `${logoEndX}px`;
          flyLogo.style.top = `${logoEndY}px`;
          flyLogo.style.width = `${logoEndW}px`;
          flyLogo.style.height = `${logoEndH}px`;
          // Wait one frame so the browser renders everything in place,
          // THEN swap flyLogo → navbarLogo after a short delay
          requestAnimationFrame(() => {
            setTimeout(() => {
              navbarLogoImg.style.opacity = "1";
              flyLogo.remove();
              isAnimating = false;
              unlockScroll();
              removeFirstScrollListeners();
              if (expandCallback) {
                expandCallback();
                expandCallback = null;
              }
            }, 1500);
          });
        }
      }

      requestAnimationFrame(animate);
    }

    function collapse() {
      if (!isExpanded || isAnimating) return;
      isExpanded = false;
      isAnimating = true;
      lockScroll();

      // Measure current navbar logo position
      const navLogoRect = navbarLogoImg.getBoundingClientRect();
      const logoStartX = navLogoRect.left;
      const logoStartY = navLogoRect.top;
      const logoStartW = navLogoRect.width;
      const logoStartH = navLogoRect.height;

      const heroEndW = heroLogo.offsetWidth || 144;
      const heroEndH = heroLogo.offsetHeight || 144;

      const flyLogo = heroLogo.cloneNode(true) as HTMLImageElement;
      flyLogo.id = "";
      flyLogo.className = "";
      flyLogo.style.cssText = `position:fixed;left:${logoStartX}px;top:${logoStartY}px;width:${logoStartW}px;height:${logoStartH}px;z-index:60;pointer-events:none;margin:0;padding:0;`;
      document.body.appendChild(flyLogo);
      navbarLogoImg.style.opacity = "0";

      const startTime = performance.now();

      function animate(now: number) {
        const elapsed = now - startTime;
        const rawT = Math.min(elapsed / DURATION, 1);
        const t = easeOut(rawT);

        // Navbar flies back down
        const navbarY = window.innerHeight * t;
        navbar.style.transform = `translateY(${navbarY}px)`;

        const navRect = navbar.getBoundingClientRect();
        const navTopY = navRect.top;

        // Hero expands
        const heroMinH = 60 + 40 * t;
        heroSection.style.minHeight = `${heroMinH}vh`;

        // Logo grows + moves right + rides on navbar
        const heroRect = heroLogo.getBoundingClientRect();
        const heroLogoX = heroRect.left;
        const heroLogoY = heroRect.top;

        const curW = logoStartW + (heroEndW - logoStartW) * t;
        const curH = logoStartH + (heroEndH - logoStartH) * t;
        const curX = logoStartX + (heroLogoX - logoStartX) * t;
        // Logo bottom sticks to navbar top, but don't go below hero logo position
        const ridingTop = navTopY - curH;
        const curY = Math.min(ridingTop, heroLogoY);

        flyLogo.style.left = `${curX}px`;
        flyLogo.style.top = `${curY}px`;
        flyLogo.style.width = `${curW}px`;
        flyLogo.style.height = `${curH}px`;

        if (heroGradient) heroGradient.style.opacity = `${0.3 + 0.7 * t}`;
        if (ctaContent) ctaContent.style.opacity = `${1 - t}`;
        if (scrollIndicator) scrollIndicator.style.opacity = `${t}`;

        if (rawT < 1) {
          requestAnimationFrame(animate);
        } else {
          heroLogo.style.visibility = "visible";
          flyLogo.remove();
          isAnimating = false;
          unlockScroll();
          window.scrollTo(0, 0);
        }
      }

      requestAnimationFrame(animate);
    }

    // Intercept first wheel/touch to trigger animation directly
    function onFirstScroll(e: Event) {
      e.preventDefault();
      if (!isExpanded && !isAnimating) {
        expand();
      }
    }
    window.addEventListener("wheel", onFirstScroll, { passive: false });
    window.addEventListener("touchmove", onFirstScroll, { passive: false });

    function removeFirstScrollListeners() {
      window.removeEventListener("wheel", onFirstScroll);
      window.removeEventListener("touchmove", onFirstScroll);
    }

    heroSection.addEventListener("click", () => {
      if (!isExpanded && !isAnimating) {
        expand();
      }
    });

    if (scrollIndicator) {
      scrollIndicator.addEventListener("click", (e) => {
        e.stopPropagation();
        if (!isExpanded && !isAnimating) {
          expand();
        }
      });
    }

    // Intercept anchor links: if animation hasn't played, play it first then scroll
    document.addEventListener("click", (e) => {
      const anchor = (e.target as HTMLElement).closest(
        "a[href^='#']",
      ) as HTMLAnchorElement | null;
      if (!anchor) return;
      const targetId = anchor.getAttribute("href")?.slice(1);
      if (!targetId) return;
      const targetEl = document.getElementById(targetId);
      if (!targetEl) return;

      e.preventDefault();
      if (!isExpanded) {
        expand(() => {
          targetEl.scrollIntoView({ behavior: "smooth" });
        });
      } else if (!isAnimating) {
        targetEl.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  document.addEventListener("DOMContentLoaded", init);

  // --- Tab carousel + animation control for code examples ---
  document.addEventListener("DOMContentLoaded", () => {
    const tabs = document.querySelectorAll(".example-tab");
    const panels = document.querySelectorAll(".example-panel");
    const totalTabs = 3;
    let currentTab = 0;
    let carouselTimer: ReturnType<typeof setTimeout> | null = null;
    let animationActive = false;
    const BRAX_DURATION = 16000;

    function activateTab(tabIndex: number) {
      stopAnimation();

      tabs.forEach((t) => t.classList.remove("active"));
      tabs[tabIndex]?.classList.add("active");

      panels.forEach((p) => {
        if ((p as HTMLElement).dataset.panel === tabIndex + "") {
          p.classList.remove("hidden");
        } else {
          p.classList.add("hidden");
        }
      });

      currentTab = tabIndex;

      requestAnimationFrame(() => {
        const plotId =
          tabIndex === 0 ? "cso-plot" : tabIndex === 1 ? "rvea-plot" : null;
        if (plotId) {
          const plot = document.getElementById(plotId);
          // @ts-ignore
          if (plot) Plotly.Plots.resize(plot);
        }
        startAnimation(tabIndex);
      });
    }

    function startAnimation(tabIndex: number) {
      animationActive = true;

      if (tabIndex === 2) {
        carouselTimer = setTimeout(() => {
          if (currentTab === 2) activateTab(0);
        }, BRAX_DURATION);
        return;
      }

      const plotId = tabIndex === 0 ? "cso-plot" : "rvea-plot";
      const plot = document.getElementById(plotId);
      // @ts-ignore
      if (!plot || !plot.data) return;

      // @ts-ignore
      Plotly.animate(plot, ["0"], {
        frame: { duration: 0, redraw: true },
        transition: { duration: 0 },
        mode: "immediate",
      })
        .then(() => {
          // @ts-ignore
          return Plotly.animate(plot, null, {
            frame: { duration: 200, redraw: false },
            transition: { duration: 200 },
          });
        })
        .then(() => {
          if (currentTab === tabIndex && animationActive) {
            const nextTab = (tabIndex + 1) % totalTabs;
            activateTab(nextTab);
          }
        })
        .catch(() => {});
    }

    function stopAnimation() {
      animationActive = false;
      if (carouselTimer) {
        clearTimeout(carouselTimer);
        carouselTimer = null;
      }
      [0, 1].forEach((idx) => {
        const plotId = idx === 0 ? "cso-plot" : "rvea-plot";
        const plot = document.getElementById(plotId);
        if (plot) {
          // @ts-ignore
          Plotly.animate(plot, [null], {
            frame: { duration: 0, redraw: false },
            mode: "immediate",
          }).catch(() => {});
        }
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = parseInt((tab as HTMLElement).dataset.tab || "0", 10);
        if (target !== currentTab) {
          activateTab(target);
        }
      });
    });

    // Wait for first plot to be ready, then start carousel
    function waitAndStart() {
      const plot = document.getElementById("cso-plot");
      if (plot?.getAttribute("data-ready") === "true") {
        startAnimation(0);
      } else {
        setTimeout(waitAndStart, 300);
      }
    }
    waitAndStart();
  });
</script>
