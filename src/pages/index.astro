---
import ScrollLayout from "../layouts/ScrollLayout.astro";
import ExampleCarousel from "../components/ExampleCarousel.astro";
import FeatureSections from "../components/FeatureSections.astro";
import EcosystemSection from "../components/EcosystemSection.astro";
import "../styles/scroll-animations.css";

// Import logo assets
import logo from "../assets/logo.png";
import logoText from "../assets/logo_text.png";
import tagDown from "../assets/tag_down.png";

// Import raw Python code files
import codeSingleObj from "../content/examples/single-obj.py?raw";
import codeMultiObj from "../content/examples/multi-obj.py?raw";
import codeNeuro from "../content/examples/neuroevolution.py?raw";

// Import visualization components
import SingleObj from "../content/examples/single-obj.astro";
import MultiObj from "../content/examples/multi-obj.astro";
import Neuroevolution from "../content/examples/neuroevolution.astro";
---

<ScrollLayout title="EvoX - Evolutionary Computation for Everyone">
  <!-- Scrollable container: total height 300vh -->
  <div class="scroll-container">
    <!-- Background layer: for background color transition -->
    <div class="background-layer" id="bg-layer"></div>

    <!-- Hero Section: Logo and brand name - fixed in viewport -->
    <section class="hero-section">
      <div class="logo-wrapper" id="logo-wrapper">
        <img src={logo.src} alt="EvoX Logo" class="logo-large" id="logo-img" />
        <img src={logoText.src} alt="evox" class="brand-name-img" id="brand-name" />
        <div class="tagline" id="tagline">
          <p>Evolutionary Computation for Everyone</p>
          <p>EvoX is All You Need</p>
        </div>
      </div>
    </section>

    <!-- Explore Section: "Explore evox" - fixed in viewport -->
    <section class="explore-section" id="explore-section">
      <h2>Explore</h2>
      <img src={logoText.src} alt="evox" class="explore-logo" />
    </section>

    <!-- Scroll down hint arrow -->
    <div class="scroll-hint" id="scroll-hint">
      <img src={tagDown.src} alt="Scroll down" class="scroll-arrow" />
    </div>

    <!-- Content Section: Carousel - in document flow -->
    <section class="content-section" id="content-section">
      <div class="content-grid">
        <ExampleCarousel codeSingleObj={codeSingleObj} codeMultiObj={codeMultiObj} codeNeuro={codeNeuro}>
          <SingleObj slot="visual-single" />
          <MultiObj slot="visual-multi" />
          <Neuroevolution slot="visual-neuro" />
        </ExampleCarousel>
      </div>
    </section>

    <!-- Feature Sections -->
    <section class="features-section">
      <FeatureSections />
    </section>

    <!-- Ecosystem Section -->
    <section class="features-section">
      <EcosystemSection />
    </section>
  </div>
</ScrollLayout>

<script>
  // Get elements
  const header = document.getElementById('main-header');
  const logoWrapper = document.getElementById('logo-wrapper');
  const logoImg = document.getElementById('logo-img');
  const brandName = document.getElementById('brand-name');
  const tagline = document.getElementById('tagline');
  const exploreSection = document.getElementById('explore-section');
  const contentSection = document.getElementById('content-section');
  const bgLayer = document.getElementById('bg-layer');
  const scrollHint = document.getElementById('scroll-hint');

  // Stage state
  let currentStage = 1; // 1 or 2
  let isTransitioning = false;

  // Scroll accumulator
  let scrollAccumulator = 0;
  const STAGE_1_TO_2_THRESHOLD = 50; // Stage 1 → Stage 2: very low, light scroll

  // Viewport height
  let vh = window.innerHeight;

  window.addEventListener('resize', () => {
    vh = window.innerHeight;
  });

  // Helper functions
  function clamp(value: number, min: number, max: number): number {
    return Math.min(Math.max(value, min), max);
  }

  function lerp(start: number, end: number, progress: number): number {
    return start + (end - start) * progress;
  }

  // Stage 1 initial state
  function setStage1() {
    if (logoWrapper) {
      logoWrapper.style.transform = 'translate(0, 0) scale(1)';
      logoWrapper.style.opacity = '1';
    }
    if (tagline) tagline.style.opacity = '1';
    if (header) {
      header.style.opacity = '0';
      header.style.transform = 'translateY(-100%)';
    }
    if (exploreSection) exploreSection.style.opacity = '0';
    if (bgLayer) bgLayer.style.opacity = '0';
    if (scrollHint) scrollHint.style.opacity = '0';
  }

  // Transition to Stage 2 (triggered by click or light scroll)
  function transitionToStage2() {
    if (currentStage !== 1 || isTransitioning) return;

    isTransitioning = true;
    currentStage = 2;
    scrollAccumulator = 0;

    const duration = 800;

    // Logo moves to top-left and fades out
    if (logoWrapper) {
      logoWrapper.style.transition = `all ${duration}ms cubic-bezier(0.4, 0, 0.2, 1)`;
      logoWrapper.style.transform = 'translate(-40vw, -42vh) scale(0.4)';
      logoWrapper.style.opacity = '0';
    }

    // Tagline fades out
    if (tagline) {
      tagline.style.transition = `opacity ${duration}ms ease`;
      tagline.style.opacity = '0';
    }

    // Header shows
    if (header) {
      header.style.transition = `all ${duration}ms ease`;
      header.style.opacity = '1';
      header.style.transform = 'translateY(0)';
    }

    // "Explore" fades in
    setTimeout(() => {
      if (exploreSection) {
        exploreSection.style.transition = `all ${duration * 0.6}ms ease`;
        exploreSection.style.opacity = '1';
        exploreSection.style.transform = 'translate(-50%, -50%)';
      }
      // Scroll hint arrow fades in
      if (scrollHint) {
        scrollHint.style.opacity = '1';
      }
    }, duration * 0.3);

    setTimeout(() => {
      isTransitioning = false;
      // Clear transitions
      if (logoWrapper) logoWrapper.style.transition = 'none';
      if (tagline) tagline.style.transition = 'none';
      if (header) header.style.transition = 'none';
      if (exploreSection) exploreSection.style.transition = 'none';

      // Unlock scrolling, enter Stage 2 scroll animation
      document.body.style.overflow = 'auto';
    }, duration);
  }

  // Stage 2 scroll-driven animation
  function handleStage2Scroll() {
    if (currentStage !== 2 || isTransitioning) return;

    const scrollY = window.scrollY;
    // Scroll progress: 0 to 1 (based on 100vh scroll distance)
    const progress = clamp(scrollY / vh, 0, 1);

    // "Explore" text moves up with the page and gradually fades out
    if (exploreSection) {
      // Move up from center (-50%) of screen
      const translateY = lerp(-50, -100, progress);
      exploreSection.style.transform = `translate(-50%, ${translateY}%)`;
      // Fade out with scroll (complete at 0-60% progress)
      const opacity = 1 - clamp(progress / 0.6, 0, 1);
      exploreSection.style.opacity = opacity.toString();
    }

    // Scroll hint arrow fades out (disappears faster)
    if (scrollHint) {
      const arrowOpacity = 1 - clamp(progress / 0.3, 0, 1);
      scrollHint.style.opacity = arrowOpacity.toString();
    }

    // Background gradually turns gray
    if (bgLayer) {
      bgLayer.style.opacity = progress.toString();
    }
  }

  // Stage 1 interaction handling
  function handleStage1Interaction(deltaY: number) {
    if (currentStage !== 1 || isTransitioning) return;

    if (deltaY > 0) {
      scrollAccumulator += Math.abs(deltaY);

      if (scrollAccumulator > STAGE_1_TO_2_THRESHOLD) {
        transitionToStage2();
      }
    }
  }

  // Wheel event
  function handleWheel(e: WheelEvent) {
    if (currentStage === 1) {
      e.preventDefault();
      handleStage1Interaction(e.deltaY);
    } else if (currentStage === 2) {
      // Stage 2: normal scroll, update animation simultaneously
      handleStage2Scroll();
    }
  }

  // Scroll event (for continuous animation in Stage 2)
  function handleScroll() {
    if (currentStage === 2) {
      handleStage2Scroll();
    }
  }

  // Click event (quick trigger for first stage transition)
  function handleClick(e: MouseEvent) {
    if (currentStage === 1 && !isTransitioning) {
      transitionToStage2();
    }
  }

  // Touch event support
  let touchStartY = 0;

  function handleTouchStart(e: TouchEvent) {
    touchStartY = e.touches[0].clientY;
  }

  function handleTouchMove(e: TouchEvent) {
    if (currentStage === 1) {
      e.preventDefault();
      const touchEndY = e.touches[0].clientY;
      const deltaY = touchStartY - touchEndY;

      if (deltaY > 10) {
        handleStage1Interaction(deltaY);
      }
      touchStartY = touchEndY;
    }
  }

  // Add event listeners
  window.addEventListener('wheel', handleWheel, { passive: false });
  window.addEventListener('scroll', handleScroll, { passive: true });
  window.addEventListener('click', handleClick);
  window.addEventListener('touchstart', handleTouchStart, { passive: true });
  window.addEventListener('touchmove', handleTouchMove, { passive: false });

  // Initialize
  setStage1();
  // Stage 1 locks scrolling
  document.body.style.overflow = 'hidden';

  // Cleanup
  window.addEventListener('beforeunload', () => {
    window.removeEventListener('wheel', handleWheel);
    window.removeEventListener('scroll', handleScroll);
    window.removeEventListener('click', handleClick);
    window.removeEventListener('touchstart', handleTouchStart);
    window.removeEventListener('touchmove', handleTouchMove);
  });
</script>
