---
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import { getCollection } from "astro:content";
import { Code } from "astro:components";
import { Icon } from "astro-icon/components";
import {
  type Locale,
  defaultLocale,
  loadTranslations,
  t,
  getLocalizedUrl,
  getDateLocale,
  getLocalizedArticles,
  getLocalizedNews,
} from "../../i18n/utils";

import codeSingleObj from "../../content/examples/single-obj.py?raw";
import codeMultiObj from "../../content/examples/multi-obj.py?raw";
import codeNeuro from "../../content/examples/neuroevolution.py?raw";

import SingleObj from "../../content/examples/single-obj.astro";
import MultiObj from "../../content/examples/multi-obj.astro";
import Neuroevolution from "../../content/examples/neuroevolution.astro";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const tr = await loadTranslations(locale);
const dateLocale = getDateLocale(locale);

const allNews = await getCollection("news");
const allReleases = await getCollection("releases");
const localizedNews = getLocalizedNews(allNews, locale);
const localizedReleases = getLocalizedArticles(allReleases, locale);
const latestRelease = localizedReleases.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)[0];
const latestNews = localizedNews
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const latestArticles = [latestRelease, ...latestNews];

const allLibs = await getCollection("libs");
const ecosystem = allLibs.slice(0, 3);
---

<Layout title={t(tr, "site.title")} hideHeader hideFooter locale={locale}>
  <!-- ========== Navbar (starts at bottom, flies to top) ========== -->
  <div
    id="navbar"
    class="fixed left-0 right-0 top-0"
    style="z-index: 50; transform: translateY(100vh);"
  >
    <Header animated locale={locale} />
  </div>

  <!-- ========== Scroll Indicator ========== -->
  <div
    id="scroll-indicator"
    class="fixed bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center text-gray-500 scroll-bounce cursor-pointer"
    style="z-index: 35;"
  >
    <span class="text-sm mb-2">{t(tr, "hero.scroll")}</span>
    <svg
      class="w-4 h-4"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
      ></path>
    </svg>
  </div>

  <!-- ========== Hero Section ========== -->
  <section
    id="hero-section"
    class="relative flex flex-col items-center justify-center text-center px-4 py-16"
    style="min-height: 100vh; background: rgb(22, 27, 48); z-index: 10;"
  >
    <div
      class="absolute inset-0"
      id="hero-gradient"
      style="background: radial-gradient(ellipse at center, rgba(60, 70, 110, 0.5) 0%, transparent 60%);"
    >
    </div>

    <div class="relative z-10 w-full max-w-[1280px]">
      <!-- Hero Logo (visible by default) -->
      <img
        id="hero-logo"
        src="/logo.svg"
        alt="EvoX Logo"
        class="h-28 md:h-36 mb-10 mx-auto"
      />

      <h1
        id="hero-title"
        class="text-4xl md:text-6xl font-bold text-white mb-5 transition-opacity duration-700 mx-auto max-w-full"
      >
        <span class="block">{t(tr, "hero.title.line1")}</span>
        <span class="block">{t(tr, "hero.title.line2")}</span>
      </h1>
      <p
        id="hero-subtitle"
        class="text-lg md:text-xl text-gray-400 mb-8 transition-opacity duration-700 break-words"
      >
        {t(tr, "hero.subtitle")}
      </p>

      <!-- CTA Content (appears when expanded) -->
      <div
        id="cta-content"
        class="mt-8"
        style="opacity: 0; pointer-events: none;"
        inert
      >
        <p class="text-lg text-blue-400 mb-10">
          {t(tr, "hero.cta.tagline")}
        </p>
        <a
          href={getLocalizedUrl("/tutorials", locale)}
          class="inline-block border-2 border-blue-500 text-white font-medium px-14 py-3 rounded-lg hover:bg-blue-500 transition-colors duration-200"
        >
          {t(tr, "hero.cta.button")}
        </a>
      </div>
    </div>
  </section>

  <!-- ========== Page Content ========== -->
  <div id="page-content" class="relative" style="background: rgb(22, 27, 48);">
    <div id="content-body" style="background: rgb(22, 27, 48);">
      <!-- Latest News -->
      <section class="bg-white py-16">
        <div class="max-w-[1280px] mx-auto px-4">
          <div
            class="flex flex-col sm:flex-row sm:justify-between items-start sm:items-end gap-3 border-b border-gray-200 pb-4 mb-8"
          >
            <h2 class="text-2xl font-bold text-gray-900 relative pb-4 -mb-4">
              {t(tr, "news.title")}
              <span class="absolute bottom-0 left-0 w-16 h-0.5 bg-blue-500"
              ></span>
            </h2>
            <a
              href={getLocalizedUrl("/news", locale)}
              class="text-blue-500 hover:text-blue-700 flex items-center gap-1 text-sm font-medium max-w-full break-words"
            >
              {t(tr, "news.viewAll")}
              <span>&rarr;</span>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {
              latestArticles.map((post) => {
                const section = localizedNews.some((n) => n.slug === post.slug)
                  ? "news"
                  : "releases";
                return (
                  <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
                    <p class="text-sm text-gray-400 mb-2">
                      {post.data.pubDate.toLocaleDateString(dateLocale, {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                        timeZone: "UTC",
                      })}
                    </p>
                    <h3 class="text-lg font-bold text-gray-900 mb-3">
                      {post.data.title}
                    </h3>
                    <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                      {post.data.summary ||
                        (section === "releases"
                          ? t(tr, "releases.defaultSummary")
                          : t(tr, "news.defaultSummary"))}
                    </p>
                    <a
                      href={getLocalizedUrl(`/${section}/${post.slug}`, locale)}
                      class="text-blue-500 hover:text-blue-700 text-sm flex items-center gap-1"
                    >
                      {t(tr, "news.readMore")} <span>&rarr;</span>
                    </a>
                  </div>
                );
              })
            }
          </div>
        </div>
      </section>

      <!-- Community -->
      <div class="bg-gray-100 py-16">
        <div class="max-w-[1280px] mx-auto px-4">
          <div class="text-center mb-10">
            <h2 class="text-3xl font-bold text-gray-900 mb-2">{t(tr, "community.title")}</h2>
            <p class="text-xl text-gray-600">{t(tr, "community.desc")}</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
            <button type="button" data-qq-qr-open class="group block p-8 bg-white rounded-3xl border border-gray-100 hover:border-teal-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-left cursor-pointer">
              <div class="flex items-center gap-4 mb-5">
                <div class="p-3 bg-teal-100 rounded-xl text-teal-600 group-hover:bg-teal-600 group-hover:text-white transition-colors shadow-sm">
                  <Icon name="simple-icons:tencentqq" class="h-6 w-6" />
                </div>
                <h3 class="text-2xl font-bold text-gray-900">EvoX <span class="text-teal-600 group-hover:text-teal-700 font-extrabold">{t(tr, "community.qq.title")}</span></h3>
              </div>
              <p class="text-gray-600 text-lg leading-relaxed">{t(tr, "community.qq.desc")}</p>
            </button>
            <a href="https://discord.com/invite/Vbtgcpy7G4" target="_blank" rel="noopener noreferrer" class="group block p-8 bg-white rounded-3xl border border-gray-100 hover:border-indigo-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
              <div class="flex items-center gap-4 mb-5">
                <div class="p-3 bg-indigo-100 rounded-xl text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-colors shadow-sm">
                  <Icon name="simple-icons:discord" class="h-6 w-6" />
                </div>
                <h3 class="text-2xl font-bold text-gray-900">EvoX <span class="text-indigo-600 group-hover:text-indigo-700 font-extrabold">{t(tr, "community.discord.title")}</span></h3>
              </div>
              <p class="text-gray-600 text-lg leading-relaxed">{t(tr, "community.discord.desc")}</p>
            </a>
          </div>
        </div>
      </div>

      <!-- Code Examples (Tabbed) -->
      <div class="bg-white py-16">
        <div class="max-w-[1280px] mx-auto px-4">
          <!-- Tab Bar -->
          <div class="flex flex-col sm:flex-row sm:justify-between gap-3 mb-8 pt-4 sm:items-end sm:min-h-[5rem]" role="tablist" aria-label={t(tr, "examples.title")}>
            <button
              class="example-tab active flex flex-col items-center gap-2 px-4 sm:px-6 py-2 sm:py-0 cursor-pointer w-full sm:w-auto max-w-full"
              data-tab="0"
              role="tab"
              id="example-tab-0"
              aria-controls="example-panel-0"
              aria-selected="true"
            >
              <img src="/arrow_1.png" alt="" class="h-5 sm:h-6 tab-icon" />
              {t(tr, "examples.singleObj")}
            </button>
            <button
              class="example-tab flex flex-col items-center gap-2 px-4 sm:px-6 py-2 sm:py-0 cursor-pointer w-full sm:w-auto max-w-full"
              data-tab="1"
              role="tab"
              id="example-tab-1"
              aria-controls="example-panel-1"
              aria-selected="false"
            >
              <img src="/arrow_2.png" alt="" class="h-5 sm:h-6 tab-icon" />
              {t(tr, "examples.multiObj")}
            </button>
            <button
              class="example-tab flex flex-col items-center gap-2 px-4 sm:px-6 py-2 sm:py-0 cursor-pointer w-full sm:w-auto max-w-full"
              data-tab="2"
              role="tab"
              id="example-tab-2"
              aria-controls="example-panel-2"
              aria-selected="false"
            >
              <img src="/arrow_3.png" alt="" class="h-5 sm:h-6 tab-icon" />
              {t(tr, "examples.neuro")}
            </button>
          </div>

          <!-- Tab Panels -->
          <div class="example-panel" data-panel="0" role="tabpanel" id="example-panel-0" aria-labelledby="example-tab-0">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
              <div
                class="rounded-lg overflow-auto shadow-lg border border-gray-200 h-[28rem] bg-[#0d1117] min-w-0"
              >
                <Code
                  code={codeSingleObj}
                  lang="python"
                  theme="github-dark"
                  class="p-4 md:p-6 min-h-full"
                />
              </div>
              <div
                class="h-[28rem] bg-white rounded-lg border border-gray-200 overflow-hidden relative"
              >
                <SingleObj />
              </div>
            </div>
          </div>
          <div class="example-panel hidden" data-panel="1" role="tabpanel" id="example-panel-1" aria-labelledby="example-tab-1">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
              <div
                class="rounded-lg overflow-auto shadow-lg border border-gray-200 h-[28rem] bg-[#0d1117] min-w-0"
              >
                <Code
                  code={codeMultiObj}
                  lang="python"
                  theme="github-dark"
                  class="p-4 md:p-6 min-h-full"
                />
              </div>
              <div
                class="h-[28rem] bg-white rounded-lg border border-gray-200 overflow-hidden relative"
              >
                <MultiObj />
              </div>
            </div>
          </div>
          <div class="example-panel hidden" data-panel="2" role="tabpanel" id="example-panel-2" aria-labelledby="example-tab-2">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
              <div
                class="rounded-lg overflow-auto shadow-lg border border-gray-200 h-[28rem] bg-[#0d1117] min-w-0"
              >
                <Code
                  code={codeNeuro}
                  lang="python"
                  theme="github-dark"
                  class="p-4 md:p-6 min-h-full"
                />
              </div>
              <div
                class="h-[28rem] bg-white rounded-lg border border-gray-200 overflow-hidden relative"
              >
                <Neuroevolution locale={locale} />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Ecosystem -->
      <div class="bg-gray-50 py-16 border-t border-gray-200">
        <div class="max-w-[1280px] mx-auto px-4">
          <div class="mb-10">
            <h2 class="text-3xl font-bold text-gray-900 mb-2">
              {t(tr, "ecosystem.title")}
            </h2>
            <h3 class="text-teal-600 font-medium mb-4">
              {t(tr, "ecosystem.subtitle")}
            </h3>
            <p class="text-xl text-gray-600">{t(tr, "ecosystem.desc")}</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
              ecosystem.map((item) => (
                <a href={item.data.url} target="_blank" rel="noopener noreferrer" class="block group">
                  <div class="bg-white p-6 rounded-lg shadow-sm group-hover:shadow-md transition-shadow border border-gray-100 h-full">
                    <h4 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-teal-600 transition-colors">
                      {item.data.title}
                    </h4>
                    <p class="text-gray-600 text-sm leading-relaxed">
                      {t(tr, `libs.desc.${item.data.id}`)}
                    </p>
                  </div>
                </a>
              ))
            }
          </div>
          <div class="mt-8 text-center md:text-left">
            <a
              href={getLocalizedUrl("/libs", locale)}
              class="text-teal-700 font-semibold hover:text-teal-900 inline-flex items-center gap-1"
            >
              {t(tr, "ecosystem.seeAll")}
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <Footer locale={locale} />
    </div>
  </div>
</Layout>

<style>
  .scroll-bounce {
    animation: float 2s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-bounce {
      animation: none;
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  /* Example tabs */
  .example-tab {
    color: #9ca3af;
    font-size: 1.25rem;
    font-weight: 700;
    text-align: center;
    line-height: 1.25;
    white-space: normal;
    overflow-wrap: anywhere;
    transition:
      color 0.3s ease,
      font-size 0.3s ease;
  }
  .example-tab .tab-icon {
    opacity: 0.25;
    filter: grayscale(100%);
    transition:
      opacity 0.3s ease,
      filter 0.3s ease,
      transform 0.3s ease;
  }
  .example-tab:hover {
    color: #374151;
  }
  .example-tab:hover .tab-icon {
    opacity: 0.6;
    filter: grayscale(50%);
  }
  .example-tab.active {
    color: #0f172a;
    font-size: 1.5rem;
  }
  .example-tab.active .tab-icon {
    opacity: 1;
    filter: grayscale(0%);
  }

  @media (max-width: 280px) {
    #hero-section {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    #hero-logo {
      height: 4.5rem;
      margin-bottom: 1.25rem;
    }

    #hero-title {
      font-size: 1.5rem;
      line-height: 1.15;
      margin-bottom: 0.75rem;
    }

    #hero-subtitle {
      font-size: 1rem;
      line-height: 1.35;
      margin-bottom: 1rem;
    }
  }

  @media (max-width: 640px) {
    .example-tab {
      font-size: 1rem;
    }

    .example-tab.active {
      font-size: 1.125rem;
    }
  }

  @media (max-height: 640px) {
    #scroll-indicator {
      display: none;
    }

    #hero-section {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    #hero-logo {
      margin-bottom: 1.5rem;
      height: 5rem;
    }

    #hero-title {
      font-size: 2.25rem;
      line-height: 1.1;
      margin-bottom: 0.75rem;
    }

    #hero-subtitle {
      margin-bottom: 1rem;
    }
  }
</style>

<script>
  // Disable browser scroll restoration so page always starts at top
  if ("scrollRestoration" in history) {
    history.scrollRestoration = "manual";
  }

  function init() {
    const navbar = document.getElementById("navbar");
    const heroSection = document.getElementById("hero-section");
    const heroLogo = document.getElementById("hero-logo");
    const heroGradient = document.getElementById("hero-gradient");
    const scrollIndicator = document.getElementById("scroll-indicator");
    const ctaContent = document.getElementById("cta-content");

    if (!(navbar instanceof HTMLElement) ||
      !(heroSection instanceof HTMLElement) ||
      !(heroLogo instanceof HTMLImageElement)) {
      return;
    }

    const navbarLogoImg = navbar.querySelector("img[data-logo-mark]");
    if (!(navbarLogoImg instanceof HTMLImageElement)) return;

    const navbarEl = navbar;
    const heroSectionEl = heroSection;
    const heroLogoImg = heroLogo;
    const navbarLogoEl = navbarLogoImg;

    navbarLogoEl.style.opacity = "0";

    let isExpanded = false;
    let isAnimating = false;
    // Users who prefer reduced motion get the expanded state instantly,
    // without the flight animation or the scroll lock.
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    function preventScroll(e: Event) {
      e.preventDefault();
    }
    function lockScroll() {
      document.body.style.overflow = "hidden";
      window.addEventListener("wheel", preventScroll, { passive: false });
      window.addEventListener("touchmove", preventScroll, { passive: false });
    }
    function unlockScroll() {
      document.body.style.overflow = "";
      window.removeEventListener("wheel", preventScroll);
      window.removeEventListener("touchmove", preventScroll);
    }

    function easeInCubic(t: number) {
      return t * t * t;
    }

    let expandCallback: (() => void) | null = null;
    let pendingAnchor: HTMLElement | null = null;

    // Auto flight: a click or a downward wheel/touch gesture triggers the
    // flight once (expand() sets targetP = 1); a rAF loop eases shownP
    // toward it, rendering via applyProgress(). Gestures never scrub the
    // progress — they only start the animation, which then runs to the end.
    let targetP = 0;
    let shownP = 0;
    let rafId: number | null = null;
    let flyLogo: HTMLImageElement | null = null;
    let logoStartX = 0;
    let logoStartY = 0;
    let logoW = 0;
    let logoH = 0;
    let logoEndX = 0;
    let logoEndY = 0;
    let logoEndW = 0;
    let logoEndH = 0;
    const vh = window.innerHeight;

    // On trigger: measure both ends of the flight and clone the hero logo
    // into a fixed-position flying copy
    function beginFlight() {
      if (isAnimating || isExpanded) return;
      isAnimating = true;
      lockScroll();

      // Measure hero logo position
      const logoRect = heroLogoImg.getBoundingClientRect();
      logoStartX = logoRect.left;
      logoStartY = logoRect.top;
      logoW = logoRect.width;
      logoH = logoRect.height;

      // Measure the navbar logo's docked position. The navbar is moved by
      // applyProgress() every frame, so it must have no CSS transform
      // transition — otherwise the rendered position would lag behind.
      navbarEl.style.transform = "translateY(0)";
      navbarEl.offsetHeight;
      const navLogoRect = navbarLogoEl.getBoundingClientRect();
      logoEndX = navLogoRect.left;
      logoEndY = navLogoRect.top;
      logoEndW = navLogoRect.width;
      logoEndH = navLogoRect.height;
      navbarEl.style.transform = `translateY(${vh}px)`;
      navbarEl.offsetHeight;

      // Clone logo for flying. Position/size are animated via transform
      // (translate + scale from a 0,0 origin) instead of left/top/width/
      // height: transforms are composited with sub-pixel precision, so the
      // logo doesn't re-rasterize and jitter on fractional values as it
      // slows into the dock.
      flyLogo = heroLogoImg.cloneNode(true) as HTMLImageElement;
      flyLogo.id = "";
      flyLogo.className = "";
      flyLogo.style.cssText = `position:fixed;left:0;top:0;width:${logoW}px;height:${logoH}px;z-index:60;pointer-events:none;margin:0;padding:0;transform-origin:0 0;will-change:transform;`;
      document.body.appendChild(flyLogo);
      heroLogoImg.style.visibility = "hidden";
    }

    // Render the flight at progress p ∈ [0,1]:
    // - the logo flies in a straight diagonal line to its navbar docking
    //   point on a cubic ease-in (accelerating), shrinking on the same eased
    //   progress;
    // - the navbar rises from the bottom on the identical eased progress, so
    //   both dock at the same instant;
    // - the hero collapse follows the same eased progress, so the hero's
    //   bottom edge never outruns the navbar's top edge (no white gap flashes
    //   between them) and the hero content rises in sync with the logo's
    //   flight (the title cannot catch up and overlap the logo);
    // - CTA fade-in, gradient and scroll indicator follow linear progress.
    function applyProgress(p: number) {
      const e = easeInCubic(p);
      navbarEl.style.transform = `translateY(${vh * (1 - e)}px)`;

      heroSectionEl.style.minHeight = `${100 - 40 * e}vh`;
      if (heroGradient) heroGradient.style.opacity = `${1 - 0.7 * p}`;
      if (ctaContent) ctaContent.style.opacity = `${p}`;
      if (scrollIndicator) {
        scrollIndicator.style.opacity = `${1 - p}`;
        scrollIndicator.style.pointerEvents = p > 0 ? "none" : "";
      }

      if (flyLogo) {
        const x = logoStartX + (logoEndX - logoStartX) * e;
        const y = logoStartY + (logoEndY - logoStartY) * e;
        const sx = (logoW + (logoEndW - logoW) * e) / logoW;
        const sy = (logoH + (logoEndH - logoH) * e) / logoH;
        flyLogo.style.transform = `translate(${x}px, ${y}px) scale(${sx}, ${sy})`;
      }
    }

    function tick() {
      rafId = null;
      shownP += (targetP - shownP) * 0.06;
      // Snap only when the remaining eased distance is sub-pixel — the logo
      // position uses shownP³, so snapping on raw shownP would jump the last
      // few pixels at once and read as a docking stutter
      if (Math.abs(targetP ** 3 - shownP ** 3) < 0.001) shownP = targetP;
      applyProgress(shownP);
      if (shownP >= 1) {
        finalize();
        return;
      }
      rafId = requestAnimationFrame(tick);
    }
    function ensureTicking() {
      if (rafId === null) rafId = requestAnimationFrame(tick);
    }

    // The flight is done: dock the logo, hand off to the real navbar logo
    // and release the page
    function finalize() {
      if (isExpanded) return;
      isExpanded = true;
      isAnimating = false;
      applyProgress(1);
      navbarEl.style.transform = "translateY(0)";
      if (ctaContent) {
        ctaContent.style.pointerEvents = "";
        ctaContent.removeAttribute("inert");
      }
      unlockScroll();
      removeFirstScrollListeners();
      requestAnimationFrame(() => {
        // Park flyLogo on a freshly measured dock rect before the handoff —
        // the beginFlight measurements may be stale by the time the flight
        // ends, and even a pixel of drift reads as a docking stutter
        if (flyLogo) {
          const dock = navbarLogoEl.getBoundingClientRect();
          const sx = dock.width / logoW;
          const sy = dock.height / logoH;
          flyLogo.style.transform = `translate(${dock.left}px, ${dock.top}px) scale(${sx}, ${sy})`;
        }
        setTimeout(() => {
          navbarLogoEl.style.opacity = "1";
          if (flyLogo) {
            flyLogo.remove();
            flyLogo = null;
          }
          if (expandCallback) {
            expandCallback();
            expandCallback = null;
          }
          if (pendingAnchor) {
            pendingAnchor.scrollIntoView({ behavior: "smooth" });
            pendingAnchor = null;
          }
        }, 50);
      });
    }

    // Trigger the flight: a click or a downward wheel/touch gesture starts
    // it; the animation then runs to the end on its own
    function expand(onDone?: () => void) {
      if (reduceMotion) {
        // Skip the flight animation and the scroll lock entirely
        completeExpand();
        if (onDone) onDone();
        return;
      }
      if (isExpanded) {
        if (onDone) onDone();
        return;
      }
      if (onDone) expandCallback = onDone;
      beginFlight();
      targetP = 1;
      ensureTicking();
    }

    // Skip the flight animation and jump straight to the expanded final state
    function completeExpand() {
      if (isExpanded) return;
      isExpanded = true;
      isAnimating = false;
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
      if (flyLogo) {
        flyLogo.remove();
        flyLogo = null;
      }
      navbarEl.style.transform = "translateY(0)";
      navbarLogoEl.style.opacity = "1";
      heroLogoImg.style.visibility = "hidden";
      heroSectionEl.style.minHeight = "60vh";
      if (heroGradient) heroGradient.style.opacity = "0.3";
      if (ctaContent) {
        ctaContent.style.opacity = "1";
        ctaContent.style.pointerEvents = "";
        ctaContent.removeAttribute("inert");
      }
      if (scrollIndicator) {
        scrollIndicator.style.opacity = "0";
        scrollIndicator.style.pointerEvents = "none";
      }
      unlockScroll();
      removeFirstScrollListeners();
      if (expandCallback) {
        expandCallback();
        expandCallback = null;
      }
    }

    // A downward wheel gesture triggers the flight (the wheel no longer
    // scrubs the progress — the animation always runs on its own)
    function onWheel(e: WheelEvent) {
      if (isExpanded) return;
      e.preventDefault();
      if (reduceMotion) {
        if (e.deltaY > 0) completeExpand();
        return;
      }
      if (e.deltaY > 0) expand();
    }

    // Same for touch: a downward drag triggers the flight
    let lastTouchY: number | null = null;
    function onTouchStart(e: TouchEvent) {
      lastTouchY = e.touches[0].clientY;
    }
    function onTouchMove(e: TouchEvent) {
      if (isExpanded) return;
      e.preventDefault();
      const y = e.touches[0].clientY;
      const delta = lastTouchY === null ? 0 : lastTouchY - y;
      lastTouchY = y;
      if (reduceMotion) {
        if (delta > 0) completeExpand();
        return;
      }
      if (delta > 0) expand();
    }

    // Fallback: keyboard/scrollbar scrolling bypasses wheel/touchmove,
    // so finish the expand immediately once the page actually scrolls
    function onScrollFallback() {
      if (!isExpanded && window.scrollY > 0) {
        completeExpand();
      }
    }
    window.addEventListener("wheel", onWheel, { passive: false });
    window.addEventListener("touchstart", onTouchStart, { passive: true });
    window.addEventListener("touchmove", onTouchMove, { passive: false });
    window.addEventListener("scroll", onScrollFallback, { passive: true });

    function removeFirstScrollListeners() {
      window.removeEventListener("wheel", onWheel);
      window.removeEventListener("touchstart", onTouchStart);
      window.removeEventListener("touchmove", onTouchMove);
      window.removeEventListener("scroll", onScrollFallback);
    }

    heroSection.addEventListener("click", () => {
      if (!isExpanded) {
        expand();
      }
    });

    if (scrollIndicator) {
      scrollIndicator.addEventListener("click", (e) => {
        e.stopPropagation();
        if (!isExpanded) {
          expand();
        }
      });
    }

    // Intercept anchor links: play the flight first, then scroll
    document.addEventListener("click", (e) => {
      const anchor = (e.target as HTMLElement).closest(
        "a[href^='#']",
      ) as HTMLAnchorElement | null;
      if (!anchor) return;
      const targetId = anchor.getAttribute("href")?.slice(1);
      if (!targetId) return;
      const targetEl = document.getElementById(targetId);
      if (!targetEl) return;

      e.preventDefault();
      if (!isExpanded) {
        expand(() => {
          targetEl.scrollIntoView({ behavior: "smooth" });
        });
      } else if (!isAnimating) {
        targetEl.scrollIntoView({ behavior: "smooth" });
      } else {
        pendingAnchor = targetEl;
      }
    });
  }

  document.addEventListener("DOMContentLoaded", init);
</script>

<div id="qq-qr-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-label={t(tr, "community.qq.title")}>
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" data-qq-qr-close></div>
  <div class="relative bg-white rounded-3xl p-6 md:p-8 shadow-2xl max-w-sm w-full text-center">
    <button type="button" data-qq-qr-close aria-label={t(tr, "community.qq.close")} class="absolute top-3 right-3 p-2 text-gray-400 hover:text-gray-700 transition-colors cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </button>
    <img src="/images/qq-group-qr.png" alt={t(tr, "community.qq.title")} width="610" height="610" class="w-full h-auto rounded-xl" loading="lazy" />
    <p class="mt-4 text-lg font-bold text-gray-900">QQ: 297969717</p>
    <p class="mt-1 text-gray-600">{t(tr, "community.qq.scan")}</p>
  </div>
</div>
<script>
  const qqQrModal = document.getElementById("qq-qr-modal");
  const closeQqQrModal = () => {
    qqQrModal?.classList.add("hidden");
    qqQrModal?.classList.remove("flex");
  };
  document.querySelectorAll("[data-qq-qr-open]").forEach((btn) => {
    btn.addEventListener("click", () => {
      qqQrModal?.classList.remove("hidden");
      qqQrModal?.classList.add("flex");
    });
  });
  qqQrModal?.querySelectorAll("[data-qq-qr-close]").forEach((el) => {
    el.addEventListener("click", closeQqQrModal);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeQqQrModal();
  });
</script>
