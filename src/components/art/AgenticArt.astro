---
import { createGenesisTree } from "./genesisTree.ts";
import { getAgenticFinalFrame } from "./agenticLifecycle.ts";

// Reuse the submitted Genesis cover geometry; lifecycle states come from the
// authored message sequence, independently of the seeded generator's statuses.
const { nodes, edges, transform } = createGenesisTree("evox");
const final = getAgenticFinalFrame();
const nodeStates = new Map(final.nodes.map(node => [node.id, node]));
const edgeStates = new Map(final.edges.map(edge => [edge.id, edge]));
---

<agentic-tree class="agentic-lifecycle" data-mode="static" data-phase="static">
  <svg class="agentic-art evo-graph-root" viewBox="0 0 480 280" fill="none" aria-hidden="true" focusable="false">
    <g class="tree-viewport" transform={transform}>
      <g class="evo-edges">
        {edges.map(edge => {
          const state = edgeStates.get(edge.id)!;
          return <path class:list={["edge", `st-${state.state}`, { parked: state.parked }]}
            d={edge.d} data-edge-id={edge.id} data-parent-id={state.parentId} data-state={state.state} />;
        })}
      </g>
      <g class="evo-signals" />
      <g class="evo-nodes">
        {nodes.map(node => {
          const state = nodeStates.get(node.id)!;
          return (
            <g class:list={["node", state.state, { root: node.depth === 0, parked: state.parked }]}
              transform={`translate(${node.tx} ${node.ty})`} data-node-id={node.id} data-depth={node.depth}
              data-state={state.state} data-parked={String(state.parked)}>
              <g class="node-enter">
                <circle class="halo" r={node.r + 5} />
                <circle class="pulse" r={node.r} />
                <g class="ring-reveal">
                  <circle class="ring" r={node.r} pathLength="100" />
                </g>
                <circle class="dot" r={Number((node.r * .3).toFixed(1))} />
              </g>
            </g>
          );
        })}
      </g>
    </g>
  </svg>
</agentic-tree>

<script>
  import "./agenticPlayer.ts";
</script>

<style is:global>
  /* Namespace all rules so incrementally created SVG nodes share SSR styling. */
  .agentic-lifecycle { display: block; width: 100%; }
  .agentic-lifecycle .agentic-art { display: block; width: 100%; height: auto; }
  .agentic-lifecycle .edge {
    fill: none; stroke: var(--art-line); stroke-width: 1.2;
    transition: stroke .8s, opacity .8s;
  }
  .agentic-lifecycle .edge.st-waiting { stroke: var(--art-accent); opacity: .6; }
  .agentic-lifecycle .edge.st-running {
    stroke: var(--art-ink); stroke-dasharray: 7 9; opacity: .8;
    animation: agentic-native-flow .9s linear infinite;
  }
  .agentic-lifecycle .edge.st-pending { stroke-dasharray: 3 6; opacity: .6; }
  .agentic-lifecycle .edge.st-dispatching { stroke: var(--art-accent); opacity: .55; }
  .agentic-lifecycle .edge.st-ready,
  .agentic-lifecycle .edge.st-processing { stroke: var(--art-accent); opacity: .9; }
  .agentic-lifecycle .edge.converge {
    stroke: var(--art-accent); stroke-dasharray: 7 9; opacity: .95;
    animation: agentic-native-flow-reverse .7s linear infinite;
  }
  .agentic-lifecycle .edge.growing {
    animation: agentic-edge-grow var(--growth-duration, .9s) linear var(--growth-age, 0ms) both;
  }
  .agentic-lifecycle .edge.parked { opacity: .3; }
  .agentic-lifecycle .node { opacity: 1; transition: opacity .3s ease-out; }
  .agentic-lifecycle .node.parked { opacity: .46; }
  .agentic-lifecycle .node-enter {
    animation: agentic-node-enter .6s ease-out var(--node-age, 0ms) both;
  }
  .agentic-lifecycle .ring {
    fill: var(--art-surface); stroke: var(--art-line); stroke-width: 1.5;
    transition: fill .3s ease-out, stroke .3s ease-out, stroke-width .3s ease-out;
  }
  .agentic-lifecycle .ring-reveal .ring {
    animation: agentic-ring-reveal .8s ease-out calc(.15s + var(--node-age, 0ms)) backwards;
  }
  .agentic-lifecycle .node.waiting .ring { stroke: var(--art-accent); stroke-width: 2.6; }
  .agentic-lifecycle .node.root .ring { stroke: var(--art-accent); stroke-width: 2.2; }
  .agentic-lifecycle .node.running .ring { fill: var(--art-ink); stroke: var(--art-ink); }
  .agentic-lifecycle .node.ready .ring { fill: var(--art-ink); stroke: var(--art-ink); stroke-width: 2.2; }
  .agentic-lifecycle .node.ready .ring-reveal { animation: agentic-native-ready .7s ease-in-out 2; }
  .agentic-lifecycle .node.processing .ring { fill: var(--art-accent-soft); stroke: var(--art-accent); stroke-width: 2.6; }
  .agentic-lifecycle .dot {
    fill: var(--art-accent); opacity: 0; transform: scale(0);
    transform-box: fill-box; transform-origin: center;
    transition: opacity .3s ease-out, transform .3s ease-out;
  }
  .agentic-lifecycle .node.pending .dot {
    opacity: 1; transform: scale(1);
    animation: agentic-native-dot 2.4s ease-in-out infinite;
  }
  .agentic-lifecycle .halo {
    opacity: 0; stroke: none; transform-box: fill-box; transform-origin: center;
  }
  .agentic-lifecycle .pulse {
    fill: none; stroke: var(--art-ink); stroke-width: .8; opacity: 0;
    transform-box: fill-box; transform-origin: center;
  }
  .agentic-lifecycle .node.running .halo {
    fill: var(--art-ink); animation: agentic-native-halo 2.6s ease-in-out infinite;
  }
  .agentic-lifecycle .node.running .pulse { animation: agentic-native-ripple 2.2s ease-out infinite; }
  .agentic-lifecycle .node.waiting .halo,
  .agentic-lifecycle .node.processing .halo {
    fill: var(--art-accent); animation: agentic-native-waiting 3.4s ease-in-out infinite;
  }
  .agentic-lifecycle .node.ready .pulse { animation: agentic-native-ripple .8s ease-out 2; }
  .agentic-lifecycle .node.processing .pulse {
    stroke: var(--art-accent); animation: agentic-native-ripple 2.2s ease-out infinite;
  }
  .agentic-lifecycle .evo-signals { pointer-events: none; }
  .agentic-lifecycle .message-signal { fill: var(--art-accent); }
  .agentic-lifecycle .signal-tail { fill: none; stroke: var(--art-accent); stroke-width: 1.4; stroke-linecap: round; }
  .agentic-lifecycle .signal-body {
    animation: agentic-signal-fade var(--signal-duration, .9s) linear var(--signal-age, 0ms) both;
  }
  .agentic-lifecycle .tree-viewport.cycle-enter {
    animation: agentic-cycle-enter .24s ease-out var(--cycle-age, 0ms) both;
  }
  .agentic-lifecycle .tree-viewport.cycle-exit {
    animation: agentic-cycle-exit .8s ease-in-out var(--exit-age, 0ms) both;
  }

  @keyframes agentic-native-dot {
    0%, 100% { transform: scale(.72); opacity: .5; }
    50% { transform: scale(1.18); opacity: 1; }
  }
  @keyframes agentic-native-halo {
    0%, 100% { opacity: .16; }
    50% { opacity: .48; }
  }
  @keyframes agentic-native-waiting {
    0%, 100% { opacity: .10; }
    50% { opacity: .38; }
  }
  @keyframes agentic-native-ripple {
    from { transform: scale(1); opacity: .5; }
    to { transform: scale(2.4); opacity: 0; }
  }
  @keyframes agentic-native-ready {
    0%, 100% { opacity: 1; }
    50% { opacity: .4; }
  }
  @keyframes agentic-native-flow { from { stroke-dashoffset: 0; } to { stroke-dashoffset: -16; } }
  @keyframes agentic-native-flow-reverse { from { stroke-dashoffset: 0; } to { stroke-dashoffset: 16; } }
  @keyframes agentic-node-enter { from { opacity: 0; } to { opacity: 1; } }
  @keyframes agentic-ring-reveal {
    from { stroke-dasharray: 100; stroke-dashoffset: 100; }
    to { stroke-dasharray: 100; stroke-dashoffset: 0; }
  }
  @keyframes agentic-edge-grow {
    from { stroke-dasharray: var(--edge-length); stroke-dashoffset: var(--edge-length); }
    to { stroke-dasharray: var(--edge-length); stroke-dashoffset: 0; }
  }
  @keyframes agentic-signal-fade {
    0%, 100% { opacity: 0; }
    8%, 92% { opacity: 1; }
  }
  @keyframes agentic-cycle-enter { from { opacity: 0; } to { opacity: 1; } }
  @keyframes agentic-cycle-exit { from { opacity: 1; } to { opacity: 0; } }

  .agentic-lifecycle[data-playback="paused"] * { animation-play-state: paused !important; }
  .agentic-lifecycle[data-mode="static"] * { animation: none !important; transition: none !important; }
  .agentic-lifecycle[data-mode="static"] .pulse,
  .agentic-lifecycle[data-mode="static"] .halo,
  .agentic-lifecycle[data-mode="static"] .evo-signals { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .agentic-lifecycle * { animation: none !important; transition: none !important; }
    .agentic-lifecycle .pulse, .agentic-lifecycle .halo, .agentic-lifecycle .evo-signals { display: none; }
  }
</style>
