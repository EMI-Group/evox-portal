---
import { type Locale } from "../i18n/utils";
import GenerativeArt from "./art/GenerativeArt.astro";
import AgenticArt from "./art/AgenticArt.astro";
import PhysicalArt from "./art/PhysicalArt.astro";
import ScienceArt from "./art/ScienceArt.astro";

interface Props {
  locale?: Locale;
  kind: "generative" | "agentic" | "physical" | "science";
}

const { kind, locale } = Astro.props;
// Share surface and palette while keeping each domain-specific animation distinct.
const illustrations = {
  generative: GenerativeArt,
  agentic: AgenticArt,
  physical: PhysicalArt,
  science: ScienceArt,
};
const Illustration = illustrations[kind];
---

<div class={`application-art application-art--${kind}`}>
  <div class="art-content"><Illustration locale={locale} /></div>
</div>

<style>
  .application-art {
    --art-ink: var(--diagram-ink);
    --art-line: var(--diagram-muted);
    --art-guide: var(--diagram-guide);
    --art-fill: var(--diagram-fill);
    --art-surface: var(--diagram-bg);
    --art-accent: var(--diagram-red);
    --art-bright: var(--diagram-bright);
    --art-accent-soft: var(--diagram-soft);
    --art-glow: drop-shadow(0 0 3px color-mix(in srgb, var(--diagram-red) 25%, transparent));
    position: relative;
    width: 100%;
    border: 1px solid var(--diagram-border);
    border-radius: 18px;
    background: var(--diagram-bg);
    overflow: hidden;
    isolation: isolate;
  }
  .art-content { position: relative; z-index: 1; width: 100%; }
  .art-content :global(svg) { display: block; width: 100%; height: auto; overflow: visible; transform: scale(.93); transform-origin: center; }
  .art-content :global(svg :is(path, rect, circle, ellipse, line, polyline)) { vector-effect: non-scaling-stroke; }
  .application-art[data-paused] .art-content :global(*) { animation-play-state: paused !important; }
  @media (prefers-reduced-motion: reduce) {
    .art-content :global(*) { animation: none !important; transition: none !important; }
  }
</style>
