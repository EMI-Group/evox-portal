---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LanguagePreference from "../components/LanguagePreference.astro";
import { type Locale, defaultLocale, locales, loadTranslations, t, getLocalizedUrl } from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  fullBleed?: boolean;
  locale?: Locale;
  noSEO?: boolean;
  localePath?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleImage?: string;
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title,
  description,
  hideHeader = false,
  hideFooter = false,
  fullBleed = false,
  locale = defaultLocale,
  noSEO = false,
  localePath,
  articlePublishedTime,
  articleModifiedTime,
  articleImage,
  breadcrumbs,
} = Astro.props;

const htmlLang =
  locale === "es-419" ? "es-419"
  : locale === "pt-br" ? "pt-BR"
  : locale === "zh-cn" ? "zh-CN"
  : locale === "zh-tw" ? "zh-TW"
  : locale;

const tr = await loadTranslations(locale);
// Default title follows the page locale, not always English
const pageTitle = title ?? t(tr, "site.title");
// Pages can pass their own description (e.g. an article summary); the
// site-wide tagline is the fallback.
const metaDescription = description ?? t(tr, "meta.description");

// BCP-47 codes for hreflang attributes
const hreflangCodes: Record<Locale, string> = {
  "en": "en",
  "zh-cn": "zh-CN",
  "zh-tw": "zh-TW",
  "ja": "ja",
  "ko": "ko",
  "fr": "fr",
  "de": "de",
  "it": "it",
  "es": "es-ES",
  // Google does not support the UN M49 region 419 in hreflang.
  // Use the Latin American edition as the general Spanish fallback.
  "es-419": "es",
  "ru": "ru",
  "pt": "pt",
  "pt-br": "pt-BR",
};

// Open Graph locale codes (language_TERRITORY)
const ogLocale: Record<Locale, string> = {
  "en": "en_US",
  "zh-cn": "zh_CN",
  "zh-tw": "zh_TW",
  "ja": "ja_JP",
  "ko": "ko_KR",
  "fr": "fr_FR",
  "de": "de_DE",
  "it": "it_IT",
  "es": "es_ES",
  "es-419": "es_LA",
  "ru": "ru_RU",
  "pt": "pt_PT",
  "pt-br": "pt_BR",
};

const site = Astro.site ?? new URL("https://www.evox.group");
// Internal links site-wide use no trailing slash; normalize the build-time
// pathname (which always ends with "/") so canonical/hreflang/og:url agree.
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalUrl = new URL(pathname, site);
const socialImage = new URL(articleImage ?? "/images/og-image.png", site).href;
const localizedUrls = locales.map((loc) => ({
  locale: loc,
  url: new URL(getLocalizedUrl(pathname, loc), site),
}));
const organizationId = new URL("/#organization", site).href;
const isHome = pathname === getLocalizedUrl("/", locale);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization", "@id": organizationId,
      name: "EvoX Team", url: site.href,
      logo: new URL("/favicon.png", site).href,
      sameAs: ["https://github.com/EMI-Group"],
    },
    ...(isHome ? [{
      "@type": "WebSite", "@id": `${canonicalUrl.href}#website`,
      name: "EvoX", url: canonicalUrl.href, description: metaDescription,
      inLanguage: htmlLang, publisher: { "@id": organizationId },
    }] : []),
    ...(articlePublishedTime ? [{
      "@type": "BlogPosting", "@id": `${canonicalUrl.href}#article`,
      headline: pageTitle, description: metaDescription,
      datePublished: articlePublishedTime, inLanguage: htmlLang,
      ...(articleModifiedTime ? { dateModified: articleModifiedTime } : {}),
      ...(articleImage ? { image: [socialImage] } : {}),
      url: canonicalUrl.href,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl.href },
      publisher: { "@id": organizationId },
    }] : []),
    ...(breadcrumbs ? [{
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl.href}#breadcrumbs`,
      itemListElement: breadcrumbs.map((item, index) => ({
        "@type": "ListItem", position: index + 1,
        name: item.name, item: new URL(item.url, site).href,
      })),
    }] : []),
  ],
};
// Escaping angle brackets prevents content from terminating the script element.
const structuredJson = JSON.stringify(structuredData).replace(/</g, "\\u003c");---

<!doctype html>
<html lang={htmlLang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <LanguagePreference autoDetect={!noSEO} />
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem("evox-theme") === "dark" ? "dark" : "light";
      } catch {
        document.documentElement.dataset.theme = "light";
      }
      // Only Chromium renders SVG filters inside backdrop-filter; elsewhere the lens is skipped.
      if (navigator.userAgentData?.brands?.some((entry) => entry.brand === "Chromium")) document.documentElement.dataset.lens = "";
    </script>
    <link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDescription} />
    {noSEO && <meta name="robots" content="noindex" />}
    {!noSEO && <link rel="canonical" href={canonicalUrl} />}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {!noSEO && <script type="application/ld+json" is:inline set:html={structuredJson} />}
    {!noSEO && localizedUrls.map(({ locale: loc, url }) => (
      <link rel="alternate" hreflang={hreflangCodes[loc]} href={url} />
    ))}
    {!noSEO && <link rel="alternate" hreflang="x-default" href={localizedUrls[0].url} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    {!noSEO && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:type" content={articlePublishedTime && !noSEO ? "article" : "website"} />
    <meta property="og:site_name" content="EvoX" />
    {!noSEO && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {!noSEO && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={articleImage ? pageTitle : "EvoX"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={articleImage ? pageTitle : "EvoX"} />
    <title>{pageTitle}</title>
  </head>

  <body class="antialiased min-h-screen flex flex-col">
    <svg class="lens-defs" width="0" height="0" aria-hidden="true" focusable="false"></svg>
    {!hideHeader && <Header locale={locale} localePath={localePath} />}

    <main class:list={["site-main flex-grow w-full", { "site-main-padded": !hideHeader && !fullBleed }]}>
      <slot />
    </main>

    {!hideFooter && <Footer locale={locale} />}
    <script>
      import { mountContourBackdrops } from "../components/art/contour-backdrop";
      mountContourBackdrops();

      // Glass glare and surface rim light follow the pointer.
      document.addEventListener("pointermove", (event) => {
        if (event.pointerType !== "mouse" || !(event.target instanceof Element)) return;
        const host = event.target.closest<HTMLElement>(".liquid-glass, .surface-card, .surface-button, .site-header");
        const glass = host?.classList.contains("site-header") ? host.querySelector<HTMLElement>(":scope > .liquid-glass") : host;
        if (!glass) return;
        const rect = glass.getBoundingClientRect();
        glass.style.setProperty("--lg-x", `${event.clientX - rect.left}px`);
        glass.style.setProperty("--lg-y", `${event.clientY - rect.top}px`);
      }, { passive: true });

      // Chromium only: each glass surface gets a pixel-exact lens filter. The
      // centre is frosted; a thin rim shows the backdrop displaced and almost
      // sharp, so content bends at the edges like light through thick glass.
      const lensDefs = document.querySelector(".lens-defs");
      if (lensDefs && "lens" in document.documentElement.dataset) {
        const SVG_NS = "http://www.w3.org/2000/svg";
        let count = 0;
        const svgUrl = (w: number, h: number, body: string) =>
          `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="${SVG_NS}" width="${w}" height="${h}">${body}</svg>`)}`;
        const core = (w: number, h: number, inset: number, radius: number, fill: string) =>
          `<filter id="b" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="${inset / 3}"/></filter><rect x="${inset}" y="${inset}" width="${w - inset * 2}" height="${h - inset * 2}" rx="${Math.max(0, radius - inset)}" fill="${fill}" filter="url(#b)"/>`;
        // Red ramps act only in the left/right bands and green only in the top/bottom
        // bands (128 is neutral), so every rim sample is pulled straight inward.
        const ramp = (id: string, channel: (v: number) => string, band: number, vertical: boolean) =>
          `<linearGradient id="${id}"${vertical ? ' x2="0" y2="1"' : ""}><stop offset="0" stop-color="${channel(255)}"/><stop offset="${band}" stop-color="${channel(128)}"/><stop offset="${1 - band}" stop-color="${channel(128)}"/><stop offset="1" stop-color="${channel(0)}"/></linearGradient>`;
        const displacementMap = (w: number, h: number, inset: number) => svgUrl(w, h,
          `${ramp("r", (v) => `rgb(${v},0,0)`, Math.min(.45, inset * 1.4 / w), false)}${ramp("g", (v) => `rgb(0,${v},0)`, Math.min(.45, inset * 1.4 / h), true)}<rect width="${w}" height="${h}" fill="url(#r)"/><rect width="${w}" height="${h}" fill="url(#g)" style="mix-blend-mode:screen"/>`);
        const rimMask = (w: number, h: number, inset: number, radius: number) => svgUrl(w, h,
          `<rect width="${w}" height="${h}" fill="#fff"/>${core(w, h, inset, radius, "#000")}`);
        const set = (el: Element, attrs: Record<string, string | number>) => { for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v)); return el; };
        const primitive = (name: string, attrs: Record<string, string | number>) => set(document.createElementNS(SVG_NS, name), attrs);
        const update = (glass: HTMLElement) => {
          const { width, height } = glass.getBoundingClientRect();
          const filter = document.getElementById(glass.dataset.lensId ?? "");
          if (!filter || width < 8 || height < 8) return;
          const w = Math.round(width), h = Math.round(height);
          const radius = parseFloat(getComputedStyle(glass).borderTopLeftRadius) || 0;
          const size = `${w}x${h}x${radius}`;
          if (glass.dataset.lensSize === size) return;
          glass.dataset.lensSize = size;
          const inset = Math.min(14, w / 5, h / 4.5);
          set(filter, { width: w, height: h });
          const [map, mask] = filter.querySelectorAll("feImage");
          set(map, { width: w, height: h, href: displacementMap(w, h, inset) });
          set(mask, { width: w, height: h, href: rimMask(w, h, inset, radius) });
        };
        const pending = new Set<HTMLElement>();
        let frame = 0;
        const resizeObserver = new ResizeObserver((entries) => {
          entries.forEach((entry) => pending.add(entry.target as HTMLElement));
          frame ||= requestAnimationFrame(() => { frame = 0; pending.forEach(update); pending.clear(); });
        });
        document.querySelectorAll<HTMLElement>(".liquid-glass").forEach((glass) => {
          const id = `liquid-lens-${count++}`;
          const filter = primitive("filter", { id, filterUnits: "userSpaceOnUse", primitiveUnits: "userSpaceOnUse", x: 0, y: 0, "color-interpolation-filters": "sRGB" });
          filter.append(
            primitive("feImage", { x: 0, y: 0, preserveAspectRatio: "none", result: "map" }),
            primitive("feImage", { x: 0, y: 0, preserveAspectRatio: "none", result: "ring" }),
            primitive("feColorMatrix", { in: "ring", type: "luminanceToAlpha", result: "rim" }),
            primitive("feGaussianBlur", { in: "SourceGraphic", stdDeviation: glass.dataset.frost ?? 9, edgeMode: "duplicate", result: "frost" }),
            primitive("feDisplacementMap", { in: "SourceGraphic", in2: "map", scale: 30, xChannelSelector: "R", yChannelSelector: "G", result: "bent" }),
            primitive("feGaussianBlur", { in: "bent", stdDeviation: 2.2, result: "lens" }),
            primitive("feComposite", { in: "lens", in2: "rim", operator: "in", result: "edge" }),
            primitive("feMerge", {}),
          );
          filter.lastElementChild!.append(primitive("feMergeNode", { in: "frost" }), primitive("feMergeNode", { in: "edge" }));
          lensDefs.append(filter);
          glass.dataset.lensId = id;
          glass.style.setProperty("--lg-lens-url", `url(#${id})`);
          update(glass);
          resizeObserver.observe(glass);
        });
      }
    </script>
  </body>
</html>
