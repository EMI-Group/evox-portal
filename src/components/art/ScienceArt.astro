---
import { scienceAirfoil } from "./science-airfoil-data";

// P-51D Mustang root section, with an offline incompressible potential-flow field.
// Geometry, calculation method, source URLs, and limits are documented in the data module.
const flowMotion = [
  { index: 2, duration: 9.4, delay: -2.1 },
  { index: 5, duration: 8.6, delay: -6.2 },
  { index: 8, duration: 7.2, delay: -3.9 },
  { index: 10, duration: 7.8, delay: -0.8 },
  { index: 11, duration: 8.2, delay: -5.7 },
  { index: 13, duration: 8.9, delay: -4.8 },
  { index: 15, duration: 9.8, delay: -7.5 },
];
// The lower streamline at index 7 comes within 0.537 units of the section.
// Omit it rather than altering the calculated geometry; remaining clearance is >= 7.994.
const visibleStreamlines = scienceAirfoil.streamlines.filter((_, index) => index !== 7);
---

<svg class="science-art" viewBox="0 0 480 280" fill="none" aria-hidden="true" focusable="false">
  <g class="flow-field">
    {visibleStreamlines.map((line) => (
      <path
        d={line.path}
        class:list={{ "selected-flow": line.accent }}
        opacity={line.accent ? 0.93 : line.opacity}
      />
    ))}
  </g>

  <g class="flow-motion" aria-hidden="true">
    {flowMotion.map(({ index, duration, delay }) => (
      <g
        class:list={["flow-traveler", { "flow-traveler-accent": scienceAirfoil.streamlines[index].accent }]}
        style={`--flow-path: path('${scienceAirfoil.streamlines[index].path}'); --flow-duration: ${duration}s; --flow-delay: ${delay}s;`}
      >
        <path class="flow-arrow" d="M-4.5 -2 L0 0 L-4.5 2" />
      </g>
    ))}
  </g>

  <path class="airfoil-section" d={scienceAirfoil.outline} />
  <g class="section-stations">
    {scienceAirfoil.stations.map((path) => <path d={path} />)}
  </g>
  <path class="section-camber" d={scienceAirfoil.camber} />
</svg>

<style>
  .science-art { display: block; width: 100%; height: auto; }
  .science-art path { stroke-linecap: round; stroke-linejoin: round; }
  .flow-field { stroke: var(--art-line, #777780); stroke-width: 0.8; }
  .flow-field .selected-flow { stroke: var(--art-accent, #c8383c); stroke-width: 1.3; }
  .flow-motion { pointer-events: none; }
  .flow-traveler {
    offset-path: var(--flow-path) view-box;
    offset-distance: 0%;
    offset-rotate: auto;
    offset-anchor: 100% 50%;
    offset-position: 0 0;
    transform-box: fill-box;
    transform-origin: 100% 50%;
    opacity: 0;
    animation: science-arrow-travel var(--flow-duration) linear var(--flow-delay) infinite;
  }
  .flow-arrow {
    stroke: var(--art-ink, #dedee2);
    stroke-width: 0.8;
  }
  .flow-traveler-accent .flow-arrow { stroke: var(--art-accent, #c8383c); stroke-width: 0.85; }
  .airfoil-section { fill: var(--art-fill, #29292e); stroke: var(--art-ink, #dedee2); stroke-width: 1.15; }
  .section-stations { stroke: var(--art-line, #777780); stroke-width: 0.55; opacity: 0.28; }
  .section-camber { stroke: var(--art-line, #777780); stroke-width: 0.6; stroke-dasharray: 3 5; opacity: 0.48; }
  /* Path coordinates share the SVG viewBox. Fade only at the two field edges
     so resetting the arrow to the inlet is never visible. */
  @keyframes science-arrow-travel {
    0% { offset-distance: 0%; opacity: 0; }
    4% { opacity: 0.8; }
    96% { opacity: 0.8; }
    100% { offset-distance: 100%; opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-motion { display: none; }
    .flow-traveler { animation: none; }
  }
</style>
