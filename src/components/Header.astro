---
import { Icon } from "astro-icon/components";
import logo from "../assets/logo.png";
import logoText from "../assets/logo_text.png";

// Get current language - priority from cookie, otherwise default to English
const langCookie = Astro.cookies.get("evox-lang");
const currentLang = langCookie?.value || "en";

// Chinese navigation configuration
const navLinksZh = [
  {
    label: "生态系统",
    dropdown: [
      {
        label: "项目",
        desc: "了解 EvoX 生态系统中的项目和框架",
        href: "/libs",
      },
      {
        label: "社区",
        desc: "加入 EvoX 开发者社区",
        href: "/#community-section",
      },
    ],
  },
  {
    label: "教程",
    dropdown: [
      {
        label: "English Tutorials",
        desc: "Follow the tutorial and run your first EvoX task instantly",
        href: "https://evox.readthedocs.io/en/latest/tutorial/index.html",
      },
      {
        label: "中文教程",
        desc: "跟随教程，立即运行你的第一个 EvoX 任务",
        href: "https://evox.readthedocs.io/zh-cn/latest/tutorial/index.html",
      },
    ],
  },
  {
    label: "文档",
    dropdown: [
      {
        label: "English Documentation",
        desc: "Explore the documentation",
        href: "https://evox.readthedocs.io/en/latest/",
      },
      {
        label: "中文文档",
        desc: "阅读文档以全面了解如何使用EvoX",
        href: "https://evox.readthedocs.io/zh-cn/latest/",
      },
    ],
  },
  {
    label: "博客与新闻",
    href: "/blogs",
  },
];

// English navigation configuration
const navLinksEn = [
  {
    label: "Ecosystem",
    dropdown: [
      {
        label: "Projects",
        desc: "Learn about the projects and frameworks in the EvoX Ecosystem",
        href: "/libs",
      },
      {
        label: "Community",
        desc: "Join the EvoX developer community",
        href: "/#community-section",
      },
    ],
  },
  {
    label: "Tutorials",
    dropdown: [
      {
        label: "English Tutorials",
        desc: "Follow the tutorial and run your first EvoX task instantly",
        href: "https://evox.readthedocs.io/en/latest/tutorial/index.html",
      },
      {
        label: "中文教程",
        desc: "跟随教程，立即运行你的第一个 EvoX 任务",
        href: "https://evox.readthedocs.io/zh-cn/latest/tutorial/index.html",
      },
    ],
  },
  {
    label: "Docs",
    dropdown: [
      {
        label: "English Documentation",
        desc: "Explore the documentation",
        href: "https://evox.readthedocs.io/en/latest/",
      },
      {
        label: "中文文档",
        desc: "阅读文档以全面了解如何使用EvoX",
        href: "https://evox.readthedocs.io/zh-cn/latest/",
      },
    ],
  },
  {
    label: "Blogs & News",
    href: "/blogs",
  },
];

const navLinks = currentLang === "en" ? navLinksEn : navLinksZh;
---

<header
  id="main-header"
  class="fixed top-0 w-full z-50 bg-white backdrop-blur-md border-b border-gray-200 text-gray-900 header-hidden"
>
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center gap-2" aria-label="EvoX">
          <img src={logo.src} alt="EvoX Logo" class="h-10 w-10" />
          <img src={logoText.src} alt="evox" class="h-6" />
        </a>
      </div>

      <nav class="hidden md:flex space-x-6 items-center">
        {
          navLinks.map((link) => (
            <div class="relative group">
              {link.dropdown ? (
                // Dropdown Trigger
                <button class="flex items-center gap-1 py-2 text-sm font-medium text-gray-900 hover:text-teal-600 transition-colors focus:outline-none cursor-pointer">
                  {link.label}
                  <Icon
                    name="heroicons:chevron-down-20-solid"
                    class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180"
                  />
                </button>
              ) : (
                // Direct Link
                <a
                  href={link.href}
                  class="text-sm font-medium text-gray-900 hover:text-teal-600 transition-colors"
                >
                  {link.label}
                </a>
              )}

              {/* Dropdown Menu (Tailwind Group Hover Implementation) */}
              {link.dropdown && (
                <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top">
                  <div class="bg-white rounded-lg shadow-xl overflow-hidden ring-1 ring-black ring-opacity-5">
                    <div class="py-2">
                      {link.dropdown.map((item) => (
                        <a
                          href={item.href}
                          target={
                            item.href.startsWith("http") ? "_blank" : undefined
                          }
                          rel={
                            item.href.startsWith("http")
                              ? "noopener noreferrer"
                              : undefined
                          }
                          class="block px-4 py-3 hover:bg-gray-50 transition-colors group/item"
                        >
                          <p class="text-sm font-bold text-gray-900 group-hover/item:text-teal-600">
                            {item.label}
                          </p>
                          <p class="mt-1 text-xs text-gray-500 line-clamp-2">
                            {item.desc}
                          </p>
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              )}
            </div>
          ))
        }

        <!-- Language Switcher -->
        <div class="relative group ml-4">
          <button
            class="flex items-center gap-1.5 py-2 px-3 text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors focus:outline-none cursor-pointer border border-gray-200 rounded-lg hover:border-gray-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path
                d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
              ></path>
            </svg>
            <span id="current-lang-label"
              >{currentLang === "zh" ? "中文" : "EN"}</span
            >
            <Icon
              name="heroicons:chevron-down-20-solid"
              class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180"
            />
          </button>
          <div
            class="absolute right-0 top-full pt-2 w-32 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top"
          >
            <div
              class="bg-white rounded-lg shadow-xl overflow-hidden ring-1 ring-black ring-opacity-5"
            >
              <div class="py-1">
                <button
                  data-lang="zh"
                  class="lang-switch-btn w-full text-left px-4 py-2 text-sm hover:bg-gray-50 transition-colors flex items-center gap-2"
                >
                  <span
                    class={currentLang === "zh"
                      ? "text-teal-600 font-semibold"
                      : "text-gray-700"}>中文</span
                  >
                  {currentLang === "zh" && <span class="text-teal-600">✓</span>}
                </button>
                <button
                  data-lang="en"
                  class="lang-switch-btn w-full text-left px-4 py-2 text-sm hover:bg-gray-50 transition-colors flex items-center gap-2"
                >
                  <span
                    class={currentLang === "en"
                      ? "text-teal-600 font-semibold"
                      : "text-gray-700"}>English</span
                  >
                  {currentLang === "en" && <span class="text-teal-600">✓</span>}
                </button>
              </div>
            </div>
          </div>
        </div>
      </nav>

      <div class="md:hidden flex items-center gap-2">
        <!-- Mobile Language Switcher -->
        <button
          id="mobile-lang-btn"
          class="text-gray-600 hover:text-gray-900 p-2 border border-gray-200 rounded-lg text-xs font-medium"
        >
          {currentLang === "zh" ? "中/EN" : "EN/中"}
        </button>
        <button class="text-gray-700 hover:text-gray-900 p-2">
          <Icon name="heroicons:ellipsis-horizontal-20-solid" class="h-6 w-6" />
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  // Language switching logic - using cookies so server can read
  function switchLanguage(lang: string) {
    // Store language preference in cookie (1 year expiration)
    document.cookie = `evox-lang=${lang};path=/;max-age=31536000`;

    // Trigger custom event to notify page of language switch
    window.dispatchEvent(new CustomEvent("langChange", { detail: { lang } }));

    // Refresh page to apply new language
    location.reload();
  }

  // Get current language
  function getCurrentLang(): string {
    const match = document.cookie.match(/evox-lang=(\w+)/);
    return match ? match[1] : "en";
  }

  // Bind language switch buttons
  document.querySelectorAll(".lang-switch-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const lang = btn.getAttribute("data-lang");
      if (lang) switchLanguage(lang);
    });
  });

  // Mobile language switch
  const mobileLangBtn = document.getElementById("mobile-lang-btn");
  if (mobileLangBtn) {
    mobileLangBtn.addEventListener("click", () => {
      const currentLang = getCurrentLang();
      switchLanguage(currentLang === "zh" ? "en" : "zh");
    });
  }
</script>
