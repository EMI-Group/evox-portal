---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import { getLocalizedUrl, getDateLocale, loadTranslations, t, type Locale } from "../i18n/utils";

interface Props {
  article: CollectionEntry<"news"> & { slug: string };
  locale: Locale;
  eager?: boolean;
}

const { article, locale, eager = false } = Astro.props;
const tr = await loadTranslations(locale);
const images = import.meta.glob<ImageMetadata>("../content/news/**/*.{png,jpg,jpeg,webp}", { eager: true, import: "default" });
const firstImage = article.body?.match(/!\[([^\]]*)\]\(\.\/([^\s)]+)/);
// Content IDs are normalized to lowercase, while some source directories are not.
const imageKey = `../content/news/${article.id.replace(/\/[^/]+$/, "")}/${firstImage?.[2]}`.toLowerCase();
const cover = Object.entries(images).find(([path]) => path.toLowerCase() === imageKey)?.[1];
---

<a
  href={getLocalizedUrl(`/news/${article.slug}`, locale)}
  class="news-card group flex flex-col overflow-hidden bg-white rounded-3xl border border-gray-100 shadow-sm hover:shadow-2xl hover:border-teal-100 transition-all duration-300 transform hover:-translate-y-2"
>
  {cover && <Image
    src={cover}
    alt={firstImage?.[1] || article.data.title}
    width={1088}
    widths={[480, 768, 1088]}
    sizes="(min-width: 1280px) 384px, (min-width: 1024px) calc((100vw - 96px) / 2), (min-width: 768px) calc((100vw - 80px) / 2), calc(100vw - 48px)"
    format="webp"
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    class="block w-full aspect-video object-cover"
  />}
  <div class="flex flex-col flex-grow min-w-0 p-6">
    <div class="mb-5">
      <time datetime={article.data.pubDate.toISOString()} class="inline-block px-3 py-1 rounded-full bg-teal-50 text-teal-700 text-xs font-bold uppercase tracking-wider">
        {article.data.pubDate.toLocaleDateString(getDateLocale(locale), {
          year: "numeric", month: "long", day: "numeric", timeZone: "UTC",
        })}
      </time>
    </div>
    <h2 class="text-xl font-bold text-gray-900 mb-4 group-hover:text-teal-600 transition-colors leading-snug break-words">{article.data.title}</h2>
    <p class="text-gray-600 text-base leading-relaxed line-clamp-3 mb-6">{article.data.summary || t(tr, "news.defaultSummary")}</p>
    <div class="mt-auto flex items-center text-teal-600 font-bold group-hover:gap-2 transition-all">
      {t(tr, "news.readMore")}
      <span class="ml-2 transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
    </div>
  </div>
</a>
