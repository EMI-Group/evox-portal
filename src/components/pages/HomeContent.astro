---
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import genesisResultImage from "../../content/news/evox-genesis/evox-genesis-1.png";
import {
  type Locale,
  defaultLocale,
  loadTranslations,
  t,
  getLocalizedUrl,
  getDateLocale,
  getLocalizedArticles,
  getLocalizedNews,
} from "../../i18n/utils";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const tr = await loadTranslations(locale);
const dateLocale = getDateLocale(locale);

const allNews = await getCollection("news");
const allReleases = await getCollection("releases");
const localizedNews = getLocalizedNews(allNews, locale);
const localizedReleases = getLocalizedArticles(allReleases, locale);
const latestRelease = localizedReleases.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)[0];
const latestNews = localizedNews
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const latestArticles = [latestRelease, ...latestNews];

const GENESIS_URL = "https://genesis.evox.group/";
const GITHUB_URL = "https://github.com/EMI-Group";

// 02 · The Power of Evolution — the loop shown under the intro copy.
const evolutionSteps = [
  "evolution.step.generate",
  "evolution.step.execute",
  "evolution.step.evaluate",
  "evolution.step.select",
  "evolution.step.improve",
];

// 03 · Evolution Across AI Paradigms — compact 2 × 2 cards, each backed by a
// real EvoX project. The card artwork is chosen by `key` in the markup.
const paradigms: {
  key: "generative" | "agentic" | "physical" | "science";
  href: string;
  featured?: boolean;
}[] = [
  { key: "generative", href: getLocalizedUrl("/news/evogm", locale) },
  { key: "agentic", href: GENESIS_URL, featured: true },
  { key: "physical", href: getLocalizedUrl("/news/evorl", locale) },
  { key: "science", href: getLocalizedUrl("/news/evogo", locale) },
];

// 04 · Computing Without Boundaries — status labels reflect the validated
// scope only: Ascend is project-level validation, not full-framework support;
// Vulkan is validated through the EvoX Compiler (evoxc → IREE Vulkan-SPIRV).
const platforms: { key: string; icon: string; status: string; tone: "ok" | "partial" }[] = [
  { key: "nvidia", icon: "simple-icons:nvidia", status: "computing.status.supported", tone: "ok" },
  { key: "amd", icon: "simple-icons:amd", status: "computing.status.rocm", tone: "ok" },
  { key: "vulkan", icon: "simple-icons:vulkan", status: "computing.status.compiler", tone: "ok" },
  { key: "apple", icon: "simple-icons:apple", status: "computing.status.mps", tone: "ok" },
  { key: "ascend", icon: "simple-icons:huawei", status: "computing.status.project", tone: "partial" },
  { key: "cpu", icon: "heroicons:cpu-chip", status: "computing.status.supported", tone: "ok" },
  { key: "distributed", icon: "heroicons:server-stack", status: "computing.status.experimental", tone: "partial" },
];

// Real, published measurements (see the linked articles for methodology).
const stats = [
  { value: "computing.stat1.value", label: "computing.stat1.label", href: getLocalizedUrl("/news/evococo", locale) },
  { value: "computing.stat2.value", label: "computing.stat2.label", href: getLocalizedUrl("/news/gpu-accelerated-emo", locale) },
];

// 05 · Explore EvoX — simple resource cards.
const exploreCards: {
  title: string;
  desc: string;
  href: string;
  icon: string;
  badge?: string;
}[] = [
  {
    title: t(tr, "explore.genesis.title"),
    desc: t(tr, "explore.genesis.desc"),
    href: GENESIS_URL,
    icon: "heroicons:sparkles",
    badge: t(tr, "explore.genesis.badge"),
  },
  {
    title: t(tr, "explore.ecosystem.title"),
    desc: t(tr, "explore.ecosystem.desc"),
    href: getLocalizedUrl("/libs", locale),
    icon: "heroicons:squares-2x2",
  },
  {
    title: t(tr, "explore.docs.title"),
    desc: t(tr, "explore.docs.desc"),
    href: getLocalizedUrl("/docs", locale),
    icon: "heroicons:book-open",
  },
  {
    title: t(tr, "explore.github.title"),
    desc: t(tr, "explore.github.desc"),
    href: GITHUB_URL,
    icon: "simple-icons:github",
  },
];

const isExternal = (href: string) => href.startsWith("http");
---

<Layout title={t(tr, "site.title")} hideHeader hideFooter locale={locale}>
  <!-- Flag JS before content paints so .reveal elements start hidden only when JS can reveal them -->
  <script is:inline>document.documentElement.classList.add("js-reveal");</script>
  <!-- ========== Navbar (starts above the viewport, flies down into place) ========== -->
  <div
    id="navbar"
    class="fixed left-0 right-0 top-0"
    style="z-index: 50; transform: translateY(-100%);"
  >
    <Header animated locale={locale} />
  </div>

  <!-- ========== Scroll Indicator ========== -->
  <div
    id="scroll-indicator"
    class="fixed bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center text-gray-500 scroll-bounce cursor-pointer"
    style="z-index: 35;"
  >
    <span class="text-sm mb-2">{t(tr, "hero.scroll")}</span>
    <svg
      class="w-4 h-4"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
      ></path>
    </svg>
  </div>

  <!-- ========== Hero Section ========== -->
  <section
    id="hero-section"
    class="relative flex flex-col items-center justify-center text-center px-4 py-16 overflow-hidden"
    style="min-height: 100vh; background: rgb(22, 27, 48); z-index: 10;"
  >
    <div
      class="absolute inset-0"
      id="hero-gradient"
      style="background: radial-gradient(ellipse at center, rgba(60, 70, 110, 0.5) 0%, transparent 60%);"
    >
    </div>
    <!-- Decorative layers: faint grid, drifting glow orbs, evolving particle field -->
    <div class="hero-grid absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-a" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-b" aria-hidden="true"></div>
    <canvas id="hero-canvas" class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true"></canvas>

    <div class="relative z-10 w-full max-w-[1280px]">
      <!-- Hero Logo (visible by default) -->
      <img
        id="hero-logo"
        src="/logo.svg"
        alt="EvoX Logo"
        class="h-28 md:h-36 mb-10 mx-auto"
      />

      <h1
        id="hero-title"
        class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-6 transition-opacity duration-700 mx-auto max-w-full leading-[1.08] tracking-tight"
      >
        <span class="hero-rise block" style="--d: 0.1s">{t(tr, "hero.title.line1")}</span>
        <span class="hero-rise block hero-gradient-text" style="--d: 0.25s">{t(tr, "hero.title.line2")}</span>
      </h1>
      <p
        id="hero-subtitle"
        class="hero-rise text-lg md:text-xl text-slate-300/80 mb-8 transition-opacity duration-700 break-words max-w-2xl mx-auto"
        style="--d: 0.4s"
      >
        {t(tr, "hero.subtitle")}
      </p>

      <!-- CTA Content (appears when expanded) -->
      <div
        id="cta-content"
        class="mt-8"
        style="opacity: 0; pointer-events: none;"
        inert
      >
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a href={getLocalizedUrl("/docs", locale)} class="hero-btn hero-btn-primary group">
            {t(tr, "hero.cta.button")}
            <Icon name="heroicons:arrow-right-20-solid" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5" aria-hidden="true" />
          </a>
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="hero-btn hero-btn-ghost">
            <Icon name="simple-icons:github" class="w-4 h-4" aria-hidden="true" />
            {t(tr, "nav.github")}
          </a>
        </div>
        <p class="mt-6 text-sm font-medium tracking-wide text-sky-300/80">
          {t(tr, "hero.cta.tagline")}
        </p>
      </div>
    </div>
  </section>

  <!-- ========== Page Content ========== -->
  <div id="page-content" class="relative" style="background: rgb(22, 27, 48);">
    <div id="content-body" style="background: rgb(22, 27, 48);">

      <!-- ===== 02 · The Power of Evolution ===== -->
      <section class="relative bg-white py-20 md:py-28 overflow-hidden">
        <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div>
            <p class="reveal section-kicker" style="--d: 0s">{t(tr, "evolution.kicker")}</p>
            <h2 class="reveal section-title" style="--d: 0.08s">{t(tr, "evolution.title")}</h2>
            <p class="reveal mt-6 text-lg text-gray-600 leading-relaxed max-w-xl" style="--d: 0.16s">
              {t(tr, "evolution.desc")}
            </p>
            <ol class="reveal loop-track mt-10" style="--d: 0.24s">
              {evolutionSteps.map((key, i) => (
                <li class="loop-step" style={`--i: ${i}`}>
                  <span class="loop-dot">{String(i + 1).padStart(2, "0")}</span>
                  <span class="loop-label">{t(tr, key)}</span>
                </li>
              ))}
              <li class="loop-repeat" aria-hidden="true">
                <Icon name="heroicons:arrow-path-20-solid" class="w-4 h-4" />
              </li>
            </ol>
          </div>

          <!-- Lightweight mechanism figure: branch → filter → converge → extend -->
          <div class="reveal" style="--d: 0.2s">
            <div class="evo-panel relative rounded-3xl overflow-hidden p-4 md:p-6 shadow-2xl shadow-indigo-950/20 ring-1 ring-white/10">
              <svg
                id="evo-figure"
                class="evo-figure w-full h-auto"
                viewBox="0 0 480 320"
                role="img"
                aria-label={t(tr, "evolution.figure")}
              >
                <defs>
                  <linearGradient id="evo-stroke" x1="0" x2="1" y1="0" y2="0">
                    <stop offset="0%" stop-color="#60a5fa" />
                    <stop offset="100%" stop-color="#2dd4bf" />
                  </linearGradient>
                  <filter id="evo-glow" x="-50%" y="-50%" width="200%" height="200%">
                    <feGaussianBlur stdDeviation="3" result="b" />
                    <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
                  </filter>
                </defs>

                <!-- Generation guides -->
                <g class="evo-guides" stroke="rgba(255,255,255,0.06)" stroke-width="1">
                  <line x1="130" y1="24" x2="130" y2="296" />
                  <line x1="230" y1="24" x2="230" y2="296" />
                  <line x1="330" y1="24" x2="330" y2="296" />
                  <line x1="430" y1="24" x2="430" y2="296" />
                </g>

                <g fill="none" stroke-width="2.25" stroke-linecap="round">
                  <!-- Stage 1: branch out -->
                  <path class="evo-path s1" pathLength="1" stroke="url(#evo-stroke)" d="M40 160 C85 160, 85 90, 130 90" />
                  <path class="evo-path s1" pathLength="1" stroke="url(#evo-stroke)" d="M40 160 C85 160, 85 160, 130 160" />
                  <path class="evo-path s1" pathLength="1" stroke="url(#evo-stroke)" d="M40 160 C85 160, 85 230, 130 230" />
                  <!-- Stage 2: branch again; some candidates are filtered out -->
                  <path class="evo-path s2 pruned" pathLength="1" d="M130 90 C180 90, 180 52, 230 52" />
                  <path class="evo-path s2" pathLength="1" stroke="url(#evo-stroke)" d="M130 90 C180 90, 180 118, 230 118" />
                  <path class="evo-path s2" pathLength="1" stroke="url(#evo-stroke)" d="M130 160 C180 160, 180 150, 230 150" />
                  <path class="evo-path s2 pruned" pathLength="1" d="M130 160 C180 160, 180 192, 230 192" />
                  <path class="evo-path s2" pathLength="1" stroke="url(#evo-stroke)" d="M130 230 C180 230, 180 222, 230 222" />
                  <path class="evo-path s2 pruned" pathLength="1" d="M130 230 C180 230, 180 272, 230 272" />
                  <!-- Stage 3: survivors converge -->
                  <path class="evo-path s3" pathLength="1" stroke="url(#evo-stroke)" d="M230 118 C280 118, 280 160, 330 160" />
                  <path class="evo-path s3" pathLength="1" stroke="url(#evo-stroke)" d="M230 150 C280 150, 280 160, 330 160" />
                  <path class="evo-path s3" pathLength="1" stroke="url(#evo-stroke)" d="M230 222 C280 222, 280 160, 330 160" />
                  <!-- Stage 4: keep extending -->
                  <path class="evo-path s4" pathLength="1" stroke="url(#evo-stroke)" d="M330 160 C380 160, 380 104, 430 104" />
                  <path class="evo-path s4" pathLength="1" stroke="url(#evo-stroke)" d="M330 160 C380 160, 380 160, 430 160" />
                  <path class="evo-path s4" pathLength="1" stroke="url(#evo-stroke)" d="M330 160 C380 160, 380 216, 430 216" />
                  <path class="evo-path s4 tail" pathLength="1" stroke="url(#evo-stroke)" d="M430 104 L470 92" />
                  <path class="evo-path s4 tail" pathLength="1" stroke="url(#evo-stroke)" d="M430 160 L470 160" />
                  <path class="evo-path s4 tail" pathLength="1" stroke="url(#evo-stroke)" d="M430 216 L470 228" />
                </g>

                <!-- Nodes -->
                <g>
                  <circle class="evo-node n0" cx="40" cy="160" r="7" fill="#60a5fa" filter="url(#evo-glow)" />
                  <circle class="evo-node n1" cx="130" cy="90" r="5" fill="#7dd3fc" />
                  <circle class="evo-node n1" cx="130" cy="160" r="5" fill="#7dd3fc" />
                  <circle class="evo-node n1" cx="130" cy="230" r="5" fill="#7dd3fc" />
                  <circle class="evo-node n2 pruned-node" cx="230" cy="52" r="4.5" />
                  <circle class="evo-node n2" cx="230" cy="118" r="5" fill="#5eead4" />
                  <circle class="evo-node n2" cx="230" cy="150" r="5" fill="#5eead4" />
                  <circle class="evo-node n2 pruned-node" cx="230" cy="192" r="4.5" />
                  <circle class="evo-node n2" cx="230" cy="222" r="5" fill="#5eead4" />
                  <circle class="evo-node n2 pruned-node" cx="230" cy="272" r="4.5" />
                  <circle class="evo-node n3" cx="330" cy="160" r="8" fill="#2dd4bf" filter="url(#evo-glow)" />
                  <circle class="evo-node n4" cx="430" cy="104" r="5" fill="#99f6e4" />
                  <circle class="evo-node n4" cx="430" cy="160" r="5" fill="#99f6e4" />
                  <circle class="evo-node n4" cx="430" cy="216" r="5" fill="#99f6e4" />
                </g>
              </svg>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== 03 · Evolution Across AI Paradigms ===== -->
      <section class="relative bg-slate-50 py-20 md:py-28 border-t border-gray-100 overflow-hidden">
        <div class="paradigm-bg absolute inset-0 pointer-events-none" aria-hidden="true"></div>
        <div class="relative max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-2xl mb-12">
            <p class="reveal section-kicker" style="--d: 0s">{t(tr, "paradigms.kicker")}</p>
            <h2 class="reveal section-title" style="--d: 0.08s">{t(tr, "paradigms.title")}</h2>
            <p class="reveal mt-5 text-lg text-gray-600" style="--d: 0.16s">{t(tr, "paradigms.desc")}</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
            {paradigms.map((p, i) => (
              <a
                href={p.href}
                target={isExternal(p.href) ? "_blank" : undefined}
                rel={isExternal(p.href) ? "noopener noreferrer" : undefined}
                class:list={[
                  "reveal paradigm-card group relative flex flex-col bg-white rounded-3xl overflow-hidden ring-1 transition-all duration-500",
                  p.featured ? "ring-teal-300/70 shadow-lg shadow-teal-900/5" : "ring-gray-200/80",
                ]}
                style={`--d: ${0.08 * i}s`}
              >
                <div class="paradigm-visual relative aspect-[16/9] overflow-hidden">
                  {p.key === "generative" && (
                    <svg class="w-full h-full" viewBox="0 0 400 225" aria-hidden="true">
                      <rect width="400" height="225" fill="url(#gen-bg)" />
                      <defs>
                        <linearGradient id="gen-bg" x1="0" y1="0" x2="1" y2="1">
                          <stop offset="0%" stop-color="#eef2ff" /><stop offset="100%" stop-color="#ecfeff" />
                        </linearGradient>
                      </defs>
                      <!-- Three expert models (weight grids) merge into one evolved model -->
                      {[
                        { x: 40, y: 22, c: ["#a5b4fc", "#818cf8", "#c7d2fe"] },
                        { x: 40, y: 88, c: ["#5eead4", "#99f6e4", "#2dd4bf"] },
                        { x: 40, y: 154, c: ["#fda4af", "#fecdd3", "#fb7185"] },
                      ].map((m, mi) => (
                        <g class="gen-expert" style={`--i: ${mi}`}>
                          {[0, 1, 2].map((r) => [0, 1, 2, 3].map((c) => (
                            <rect x={m.x + c * 14} y={m.y + r * 16} width="11" height="13" rx="2" fill={m.c[(r + c) % 3]} />
                          )))}
                        </g>
                      ))}
                      <g fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="4 5" class="gen-flow">
                        <path d="M105 46 C170 46, 190 112, 250 112" />
                        <path d="M105 112 L250 112" />
                        <path d="M105 178 C170 178, 190 112, 250 112" />
                      </g>
                      <g class="gen-merged">
                        {[0, 1, 2, 3].map((r) => [0, 1, 2, 3, 4].map((c) => (
                          <rect x={262 + c * 19} y={70 + r * 21} width="15" height="17" rx="3"
                            fill={["#818cf8", "#2dd4bf", "#fb7185", "#38bdf8"][(r * 2 + c) % 4]} opacity={0.55 + ((r + c) % 3) * 0.15} />
                        )))}
                      </g>
                    </svg>
                  )}
                  {p.key === "agentic" && (
                    <div class="w-full h-full bg-[#f7f7f6] flex items-center justify-center">
                      <Image
                        src={genesisResultImage}
                        alt=""
                        widths={[480, 900]}
                        sizes="(min-width: 768px) 600px, 100vw"
                        class="w-full h-full object-contain px-4 transition-transform duration-700 group-hover:scale-[1.04]"
                        loading="lazy"
                      />
                    </div>
                  )}
                  {p.key === "physical" && (
                    <svg class="w-full h-full" viewBox="0 0 400 225" aria-hidden="true">
                      <defs>
                        <linearGradient id="phy-bg" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0%" stop-color="#f0f9ff" /><stop offset="100%" stop-color="#f8fafc" />
                        </linearGradient>
                      </defs>
                      <rect width="400" height="225" fill="url(#phy-bg)" />
                      <line x1="0" y1="186" x2="400" y2="186" stroke="#cbd5e1" stroke-width="2" />
                      <g class="phy-ground" stroke="#e2e8f0" stroke-width="2">
                        {Array.from({ length: 22 }, (_, k) => (
                          <line x1={k * 20} y1="194" x2={k * 20 - 8} y2="202" />
                        ))}
                      </g>
                      <!-- Earlier generations of the gait, fading in, then the current walker -->
                      {[0, 1, 2, 3].map((g) => (
                        <g transform={`translate(${60 + g * 82} 0)`} opacity={0.18 + g * 0.27}>
                        <g class="phy-walker" style={`--i: ${g}`}>
                          <g stroke={g === 3 ? "#0ea5e9" : "#94a3b8"} stroke-width={g === 3 ? 5 : 4} stroke-linecap="round" fill="none">
                            <line x1="0" y1="112" x2="44" y2="104" />
                            <path d={`M6 112 L${-6 + g * 3} 150 L${4 - g * 2} 186`} />
                            <path d={`M38 106 L${52 - g * 3} 146 L${44 + g * 3} 186`} />
                            <line x1="44" y1="104" x2="58" y2="86" />
                          </g>
                          <circle cx="60" cy="82" r={g === 3 ? 7 : 6} fill={g === 3 ? "#0ea5e9" : "#94a3b8"} />
                        </g>
                        </g>
                      ))}
                      <path class="phy-trail" d="M40 70 C140 40, 240 40, 350 62" fill="none" stroke="#38bdf8" stroke-width="2" stroke-dasharray="3 7" stroke-linecap="round" />
                    </svg>
                  )}
                  {p.key === "science" && (
                    <svg class="w-full h-full" viewBox="0 0 400 225" aria-hidden="true">
                      <defs>
                        <linearGradient id="sci-bg" x1="0" y1="0" x2="1" y2="1">
                          <stop offset="0%" stop-color="#f5f3ff" /><stop offset="100%" stop-color="#eff6ff" />
                        </linearGradient>
                        <linearGradient id="sci-foil" x1="0" y1="0" x2="1" y2="0">
                          <stop offset="0%" stop-color="#6366f1" /><stop offset="100%" stop-color="#0ea5e9" />
                        </linearGradient>
                      </defs>
                      <rect width="400" height="225" fill="url(#sci-bg)" />
                      <!-- Streamlines flowing around a supercritical airfoil -->
                      <g fill="none" stroke="#a5b4fc" stroke-width="1.4" class="sci-flow">
                        {[-66, -44, -24, 26, 46, 68].map((dy) => (
                          <path d={`M-20 ${112 + dy} C90 ${112 + dy}, 140 ${112 + dy * (dy < 0 ? 1.35 : 0.8)}, 220 ${112 + dy * (dy < 0 ? 1.3 : 0.85)} S340 ${112 + dy}, 420 ${112 + dy}`} />
                        ))}
                      </g>
                      <!-- Baseline airfoil (ghost) and the optimized one -->
                      <path d="M78 116 C110 86, 210 84, 300 104 C318 108, 330 114, 336 120 C300 120, 200 132, 120 130 C96 129, 82 124, 78 116 Z" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="4 4" />
                      <path class="sci-foil" d="M74 114 C104 80, 214 80, 302 100 C322 105, 336 114, 342 124 C306 118, 210 128, 122 128 C94 128, 78 122, 74 114 Z" fill="url(#sci-foil)" opacity="0.92" />
                      <g font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11" fill="#475569">
                        <text x="270" y="190">L/D 47.3 → 56.4</text>
                      </g>
                    </svg>
                  )}
                  {p.featured && (
                    <span class="absolute top-4 left-4 inline-flex items-center gap-1 rounded-full bg-teal-600 px-3 py-1 text-xs font-semibold text-white shadow-md">
                      <Icon name="heroicons:sparkles" class="w-3.5 h-3.5" aria-hidden="true" />
                      {t(tr, "paradigms.featured")}
                    </span>
                  )}
                </div>
                <div class="flex flex-col flex-grow p-6 md:p-7">
                  <h3 class="text-xl md:text-2xl font-bold text-gray-900">{t(tr, `paradigms.${p.key}.title`)}</h3>
                  <p class="mt-2 flex-grow text-gray-600 leading-relaxed">{t(tr, `paradigms.${p.key}.desc`)}</p>
                  <span class="mt-5 pt-4 border-t border-gray-100 block text-sm font-semibold text-teal-700">
                    {t(tr, `paradigms.${p.key}.project`)}
                    <Icon
                      name={isExternal(p.href) ? "heroicons:arrow-up-right-20-solid" : "heroicons:arrow-right-20-solid"}
                      class="inline-block align-[-0.2em] ml-1 w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
                      aria-hidden="true"
                    />
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- ===== 04 · Computing Without Boundaries ===== -->
      <section class="relative py-20 md:py-28 overflow-hidden text-white" style="background: rgb(22, 27, 48);">
        <div class="computing-glow absolute inset-0 pointer-events-none" aria-hidden="true"></div>
        <div class="hero-grid absolute inset-0 pointer-events-none opacity-60" aria-hidden="true"></div>
        <div class="relative max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center max-w-3xl mx-auto mb-12">
            <p class="reveal section-kicker !text-teal-400" style="--d: 0s">{t(tr, "computing.kicker")}</p>
            <h2 class="reveal section-title !text-white" style="--d: 0.08s">{t(tr, "computing.title")}</h2>
            <p class="reveal mt-5 text-lg text-slate-300" style="--d: 0.16s">{t(tr, "computing.subtitle")}</p>
          </div>

          <ul class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3 md:gap-4">
            {platforms.map((pl, i) => (
              <li class="reveal platform-tile spotlight" style={`--d: ${0.06 * i}s`}>
                <Icon name={pl.icon} class="w-8 h-8 text-slate-200 platform-icon" aria-hidden="true" />
                <span class="mt-3 text-sm font-semibold text-white text-center">{t(tr, `computing.platform.${pl.key}`)}</span>
                <span
                  class:list={[
                    "mt-2 inline-flex items-center gap-1.5 rounded-xl px-2.5 py-1 text-[11px] leading-tight font-medium text-center text-balance",
                    pl.tone === "ok" ? "bg-teal-400/10 text-teal-300 ring-1 ring-teal-400/30" : "bg-amber-400/10 text-amber-300 ring-1 ring-amber-400/30",
                  ]}
                >
                  <span class:list={["w-1.5 h-1.5 rounded-full shrink-0", pl.tone === "ok" ? "bg-teal-300" : "bg-amber-300"]}></span>
                  {t(tr, pl.status)}
                </span>
              </li>
            ))}
          </ul>

          <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
            {stats.map((s, i) => (
              <a
                href={s.href}
                class="reveal stat-card spotlight group block rounded-3xl p-7 md:p-8 ring-1 ring-white/10 bg-white/[0.04] hover:bg-white/[0.07] transition-colors"
                style={`--d: ${0.1 + 0.1 * i}s`}
              >
                <p class="stat-value text-5xl md:text-6xl font-extrabold tracking-tight">{t(tr, s.value)}</p>
                <div class="stat-bar mt-5 h-1.5 rounded-full bg-white/10 overflow-hidden">
                  <span class="block h-full rounded-full" style="--w: 100%"></span>
                </div>
                <p class="mt-5 text-slate-300 leading-relaxed">{t(tr, s.label)}</p>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-teal-300">
                  {t(tr, "computing.source")}
                  <Icon name="heroicons:arrow-right-20-solid" class="w-4 h-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
                </span>
              </a>
            ))}
          </div>
          <p class="reveal mt-6 text-xs text-slate-500 text-center max-w-3xl mx-auto" style="--d: 0.2s">{t(tr, "computing.note")}</p>
        </div>
      </section>

      <!-- ===== 05 · Explore EvoX + Latest News ===== -->
      <section class="bg-white py-20 md:py-28">
        <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="reveal section-title mb-10" style="--d: 0s">{t(tr, "explore.title")}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {exploreCards.map((card, i) => (
              <a
                href={card.href}
                target={isExternal(card.href) ? "_blank" : undefined}
                rel={isExternal(card.href) ? "noopener noreferrer" : undefined}
                class:list={[
                  "reveal explore-card group relative flex items-start gap-5 rounded-2xl p-6 md:p-7 ring-1 transition-all duration-300",
                  card.badge ? "ring-teal-200 bg-gradient-to-br from-teal-50/80 to-white" : "ring-gray-200 bg-white",
                ]}
                style={`--d: ${0.07 * i}s`}
              >
                <span
                  class:list={[
                    "shrink-0 grid place-items-center w-12 h-12 rounded-xl transition-colors duration-300",
                    card.badge ? "bg-teal-600 text-white" : "bg-slate-100 text-slate-700 group-hover:bg-slate-900 group-hover:text-white",
                  ]}
                >
                  <Icon name={card.icon} class="w-6 h-6" aria-hidden="true" />
                </span>
                <span class="flex-grow min-w-0">
                  <span class="flex flex-wrap items-center gap-2">
                    <span class="text-lg font-bold text-gray-900">{card.title}</span>
                    {card.badge && (
                      <span class="rounded-full bg-teal-100 px-2 py-0.5 text-[11px] font-semibold text-teal-700">{card.badge}</span>
                    )}
                  </span>
                  <span class="mt-1 block text-gray-600">{card.desc}</span>
                </span>
                <Icon
                  name={isExternal(card.href) ? "heroicons:arrow-up-right-20-solid" : "heroicons:arrow-right-20-solid"}
                  class="shrink-0 w-5 h-5 text-gray-300 transition-all duration-300 group-hover:text-teal-600 group-hover:translate-x-1"
                  aria-hidden="true"
                />
              </a>
            ))}
          </div>

          <!-- Compact Latest News -->
          <div class="mt-20">
            <div class="reveal flex flex-col sm:flex-row sm:justify-between items-start sm:items-end gap-3 border-b border-gray-200 pb-4 mb-6" style="--d: 0s">
              <h3 class="text-xl font-bold text-gray-900">{t(tr, "news.title")}</h3>
              <a
                href={getLocalizedUrl("/news", locale)}
                class="text-teal-700 hover:text-teal-900 inline-flex items-center gap-1 text-sm font-semibold"
              >
                {t(tr, "news.viewAll")}
                <Icon name="heroicons:arrow-right-20-solid" class="w-4 h-4" aria-hidden="true" />
              </a>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
              {
                latestArticles.map((post, i) => {
                  const section = localizedNews.some((n) => n.slug === post.slug)
                    ? "news"
                    : "releases";
                  return (
                    <a
                      href={getLocalizedUrl(`/${section}/${post.slug}`, locale)}
                      class="reveal news-card group block rounded-2xl p-5 ring-1 ring-gray-200 hover:ring-gray-300 transition-all duration-300"
                      style={`--d: ${0.07 * i}s`}
                    >
                      <p class="flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-gray-400 mb-2">
                        <span
                          class:list={[
                            "rounded-full px-2 py-0.5 text-[10px] font-semibold tracking-wide normal-case",
                            section === "releases" ? "bg-sky-50 text-sky-700 ring-1 ring-sky-200" : "bg-teal-50 text-teal-700 ring-1 ring-teal-200",
                          ]}
                        >
                          {section === "releases" ? t(tr, "nav.blog.releases") : t(tr, "nav.blog.news")}
                        </span>
                        {post.data.pubDate.toLocaleDateString(dateLocale, {
                          year: "numeric",
                          month: "long",
                          day: "numeric",
                          timeZone: "UTC",
                        })}
                      </p>
                      <h4 class="font-bold text-gray-900 leading-snug line-clamp-2 group-hover:text-teal-700 transition-colors">
                        {post.data.title}
                      </h4>
                      <p class="mt-2 text-gray-600 text-sm line-clamp-2">
                        {post.data.summary ||
                          (section === "releases"
                            ? t(tr, "releases.defaultSummary")
                            : t(tr, "news.defaultSummary"))}
                      </p>
                    </a>
                  );
                })
              }
            </div>
          </div>
        </div>
      </section>

      <Footer locale={locale} />
    </div>
  </div>
</Layout>

<style>
