---
import Layout from "../../layouts/Layout.astro";
import EvolutionDiagram from "../EvolutionDiagram.astro";
import ParadigmArt from "../ParadigmArt.astro";
import ParallelDiagram from "../ParallelDiagram.astro";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import {
  type Locale,
  defaultLocale,
  loadTranslations,
  t,
  getLocalizedUrl,
  getDateLocale,
  getLocalizedArticles,
  getLocalizedNews,
} from "../../i18n/utils";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const tr = await loadTranslations(locale);
const dateLocale = getDateLocale(locale);

const allNews = await getCollection("news");
const allReleases = await getCollection("releases");
const localizedNews = getLocalizedNews(allNews, locale);
const localizedReleases = getLocalizedArticles(allReleases, locale);
const latestRelease = localizedReleases.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)[0];
const latestNews = localizedNews
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const latestArticles = [
  ...(latestRelease ? [{ post: latestRelease, section: "releases" }] : []),
  ...latestNews.map((post) => ({ post, section: "news" })),
].sort((a, b) => b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf());

const GENESIS_URL = "https://genesis.evox.group/";
const GITHUB_URL = "https://github.com/EMI-Group";

// 02 · The Power of Evolution — interactive loop beside the intro copy.
const evolutionSteps = [
  "evolution.step.generate",
  "evolution.step.evaluate",
  "evolution.step.select",
  "evolution.step.mutate",
];

// 03 · Evolution Across AI Paradigms — compact 2 × 2 cards, each backed by a
// real EvoX project. The card artwork is chosen by `key` in the markup.
const paradigms: {
  key: "generative" | "agentic" | "physical" | "science";
  href: string;
  featured?: boolean;
}[] = [
  { key: "generative", href: getLocalizedUrl("/news/evogm", locale) },
  { key: "agentic", href: GENESIS_URL, featured: true },
  { key: "physical", href: getLocalizedUrl("/news/evorl", locale) },
  { key: "science", href: getLocalizedUrl("/news/evogo", locale) },
];

// 04 · Computing Without Boundaries — status labels reflect the validated
// scope only: Ascend is project-level validation, not full-framework support;
// Vulkan is validated through the EvoX Compiler (evoxc → IREE Vulkan-SPIRV).
const platforms: { key: string; icon: string; status: string; tone: "ok" | "partial" }[] = [
  { key: "nvidia", icon: "simple-icons:nvidia", status: "computing.status.supported", tone: "ok" },
  { key: "amd", icon: "simple-icons:amd", status: "computing.status.rocm", tone: "ok" },
  { key: "vulkan", icon: "simple-icons:vulkan", status: "computing.status.compiler", tone: "ok" },
  { key: "apple", icon: "simple-icons:apple", status: "computing.status.mps", tone: "ok" },
  { key: "ascend", icon: "simple-icons:huawei", status: "computing.status.project", tone: "partial" },
  { key: "cpu", icon: "heroicons:cpu-chip", status: "computing.status.supported", tone: "ok" },
  { key: "distributed", icon: "heroicons:server-stack", status: "computing.status.experimental", tone: "partial" },
];

// 05 · Explore EvoX — a featured destination and three supporting resources.
const featuredResource = {
  title: t(tr, "explore.genesis.title"),
  desc: t(tr, "explore.genesis.desc"),
  href: GENESIS_URL,
  badge: t(tr, "explore.genesis.badge"),
};
const exploreCards = [
  {
    title: t(tr, "explore.ecosystem.title"),
    desc: t(tr, "explore.ecosystem.desc"),
    href: getLocalizedUrl("/libs", locale),
  },
  {
    title: t(tr, "explore.docs.title"),
    desc: t(tr, "explore.docs.desc"),
    href: getLocalizedUrl("/docs", locale),
  },
  {
    title: t(tr, "explore.github.title"),
    desc: t(tr, "explore.github.desc"),
    href: GITHUB_URL,
  },
];

const isExternal = (href: string) => href.startsWith("http");

const chapters = [
  { id: "top", label: "EvoX" },
  { id: "news", label: t(tr, "news.title") },
  { id: "evolution", label: t(tr, "evolution.kicker") },
  { id: "applications", label: t(tr, "paradigms.kicker") },
  { id: "computing", label: t(tr, "computing.kicker") },
  { id: "explore", label: t(tr, "explore.title") },
];
---

<Layout title={t(tr, "site.title")} fullBleed locale={locale}>
  <div class="evox-home" id="top">
    <section class="hero chapter" id="home" data-chapter-id="top" aria-labelledby="hero-title">
      <div class="container hero-content">
        <div class="hero-heading">
          <h1 id="hero-title" class="hero-statement">
            {locale.startsWith("zh") ? (
              <><span class="hero-phrase">{t(tr, "hero.title.line1")}</span><span class="hero-phrase">{t(tr, "hero.title.line2")}</span></>
            ) : (
              <>{t(tr, "hero.title.line1")}{locale === "ja" ? "" : " "}{t(tr, "hero.title.line2")}</>
            )}
          </h1>
        </div>
        <div class="hero-support">
          <p class="hero-description">{t(tr, "hero.subtitle")}</p>
          <div class="hero-actions">
            <a href={getLocalizedUrl("/docs", locale)} class="button button-primary">
              {t(tr, "hero.cta.button")}
              <Icon name="heroicons:arrow-right-20-solid" aria-hidden="true" />
            </a>
            <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="text-link">
              <Icon name="simple-icons:github" aria-hidden="true" />
              {t(tr, "nav.github")}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="news-section chapter" id="news" aria-labelledby="news-title">
      <div class="container">
        <div class="news-heading reveal">
          <h2 id="news-title"><i aria-hidden="true"></i>{t(tr, "news.title")}</h2>
          <a class="text-link" href={getLocalizedUrl("/news", locale)}>{t(tr, "news.viewAll")}<span aria-hidden="true">→</span></a>
        </div>
        <div class="news-grid">
          {latestArticles.map(({ post, section }) => (
            <a href={getLocalizedUrl(`/${section}/${post.slug}`, locale)} class="news-card reveal">
              <div class="news-meta">
                <span>{t(tr, `nav.blog.${section}`)}</span>
                <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString(dateLocale, { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })}</time>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.summary || t(tr, `${section}.defaultSummary`)}</p>
              <Icon name="heroicons:arrow-up-right-20-solid" class="news-arrow" aria-hidden="true" />
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-alt chapter" id="evolution" aria-labelledby="evolution-title">
      <div class="container evolution-layout">
        <div class="section-heading evolution-copy reveal">
          <p class="eyebrow"><span>01</span>{t(tr, "evolution.kicker")}</p>
          <h2 id="evolution-title">{t(tr, "evolution.title")}</h2>
          <p class="section-description">{t(tr, "evolution.desc")}</p>
        </div>
        <div class="evolution-panel reveal">
          <EvolutionDiagram
            steps={evolutionSteps.map((key) => t(tr, key))}
            captions={evolutionSteps.map((key) => t(tr, key.replace(".step.", ".caption.")))}
            description={t(tr, "evolution.figure")}
            pauseLabel={t(tr, "evolution.pause")}
            playLabel={t(tr, "evolution.play")}
            restartLabel={t(tr, "evolution.restart")}
          />
        </div>
      </div>
    </section>

    <section class="section chapter" id="applications" aria-labelledby="applications-title">
      <div class="container">
        <div class="section-heading reveal">
          <p class="eyebrow"><span>02</span>{t(tr, "paradigms.kicker")}</p>
          <h2 id="applications-title">{t(tr, "paradigms.title")}</h2>
          <p class="section-description">{t(tr, "paradigms.desc")}</p>
        </div>
        <div class="paradigm-grid">
          {paradigms.map((item, index) => (
            <article class:list={["paradigm-card reveal", { featured: item.featured }]}>
              <a class="card-destination" href={item.href} target={isExternal(item.href) ? "_blank" : undefined} rel={isExternal(item.href) ? "noopener noreferrer" : undefined} aria-label={t(tr, `paradigms.${item.key}.project`)}></a>
              <div class="card-topline">
                <span class="card-index">{String(index + 1).padStart(2, "0")}</span>
                {item.featured && <span class="featured-label"><i></i>{t(tr, "paradigms.featured")}</span>}
                <Icon name="heroicons:arrow-up-right-20-solid" class="card-arrow" aria-hidden="true" />
              </div>
              <div class="paradigm-art"><ParadigmArt kind={item.key} locale={locale} /></div>
              <div class="card-copy">
                <h3>{t(tr, `paradigms.${item.key}.title`)}</h3>
                <p>{t(tr, `paradigms.${item.key}.desc`)}</p>
                <span class="project-link">{t(tr, `paradigms.${item.key}.project`)}<span aria-hidden="true">→</span></span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-alt chapter" id="computing" aria-labelledby="computing-title">
      <div class="container">
        <div class="section-heading reveal">
          <p class="eyebrow"><span>03</span>{t(tr, "computing.kicker")}</p>
          <h2 id="computing-title">{t(tr, "computing.title")}</h2>
          <p class="section-description">{t(tr, "computing.subtitle")}</p>
        </div>
        <ParallelDiagram locale={locale} />
        <ul class="platforms reveal">
          {platforms.map((platform) => (
            <li data-platform={platform.key}>
              <span class="platform-mark" aria-hidden="true">
                <Icon name={platform.icon} class="platform-icon" />
              </span>
              <span class="platform-name">{t(tr, `computing.platform.${platform.key}`)}</span>
              <span class="sr-only">{t(tr, platform.status)}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section chapter" id="explore" aria-labelledby="explore-title">
      <div class="container explore-layout">
        <div class="explore-feature reveal">
          <div class="section-heading">
            <p class="eyebrow"><span>04</span>{t(tr, "explore.kicker")}</p>
            <h2 id="explore-title">{t(tr, "explore.title")}</h2>
          </div>
          <a class="genesis-resource" href={featuredResource.href} target="_blank" rel="noopener noreferrer">
            <span class="resource-badge"><i aria-hidden="true"></i>{featuredResource.badge}</span>
            <div class="genesis-body">
              <div class="genesis-copy"><h3>{featuredResource.title}</h3><p>{featuredResource.desc}</p></div>
              <svg class="genesis-art" viewBox="0 0 128 88" fill="none" aria-hidden="true">
                <path class="branch" d="M12 44C36 44 32 18 54 18H73C92 18 93 44 116 44M12 44C36 44 32 70 54 70H73C92 70 93 44 116 44" />
                <path class="lineage" d="M12 44H116" />
                <circle class="branch-node" cx="54" cy="18" r="3"/><circle class="branch-node" cx="73" cy="70" r="3"/>
                <circle class="lineage-node" cx="12" cy="44" r="3"/><circle class="lineage-node" cx="54" cy="44" r="3"/>
                <circle class="lineage-halo" cx="116" cy="44" r="10"/><circle class="lineage-tip" cx="116" cy="44" r="4"/>
              </svg>
            </div>
            <Icon name="heroicons:arrow-up-right-20-solid" class="genesis-arrow" aria-hidden="true" />
          </a>
        </div>
        <div class="resource-list">
          {exploreCards.map((card, index) => (
            <a href={card.href} target={isExternal(card.href) ? "_blank" : undefined}
              rel={isExternal(card.href) ? "noopener noreferrer" : undefined} class="resource-row reveal">
              <span class="resource-number">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{card.title}</h3>
                <p>{card.desc}</p>
              </div>
              <Icon name="heroicons:arrow-up-right-20-solid" aria-hidden="true" />
            </a>
          ))}
        </div>
      </div>
    </section>



    <nav class="chapter-map" aria-label={t(tr, "nav.primary")}>
      <a href="#top" class="map-root" aria-label="EvoX"><span></span></a>
      <div class="map-branches">
        {chapters.slice(1).map((chapter) => (
          <a href={`#${chapter.id}`} data-chapter={chapter.id} aria-label={chapter.label}>
            <i aria-hidden="true"></i><span>{chapter.label}</span>
          </a>
        ))}
      </div>
    </nav>
  </div>
</Layout>

<style>
  .evox-home { background: var(--site-bg); color: var(--site-ink); font-family: var(--site-font); }
  .container { width: calc(100% - 64px); max-width: 1040px; margin-inline: auto; }
  .section { padding: clamp(88px, 10vw, 144px) 0; scroll-margin-top: 0; }
  .section-alt { background: var(--site-alt); }
  .hero { padding: 128px 0 48px; text-align: center; }
  .hero-content { display: flex; flex-direction: column; align-items: center; gap: 28px; }
  .hero-heading, .hero-support { width: 100%; min-width: 0; }
  .hero-statement { max-width: 23ch; margin: 0 auto; font-size: clamp(40px, 4.7vw, 64px); font-weight: 500; line-height: 1.2; letter-spacing: -.035em; text-wrap: balance; }
  .hero-statement:lang(zh), .hero-statement:lang(ja) { max-width: 9em; letter-spacing: -.02em; line-height: 1.3; }
  .hero-statement:lang(zh) { max-width: 12em; }
  .hero-phrase { display: block; white-space: nowrap; }
  .hero-description { max-width: 620px; margin: 0 auto; font-size: 19px; line-height: 1.8; color: var(--site-muted); text-wrap: balance; }
  .hero-actions { display: flex; justify-content: center; align-items: center; gap: 28px; flex-wrap: wrap; margin-top: 28px; }
  .hero-actions .button { min-height: 50px; padding: 13px 27px; font-size: 16px; }
  .hero-actions .text-link { font-size: 16px; }
  .button { display: inline-flex; gap: 10px; justify-content: center; align-items: center; min-height: 48px; padding: 12px 25px; border-radius: 999px; font-weight: 500; font-size: 15px; transition: background .2s, transform .2s; }
  .button svg, .text-link svg { width: 17px; height: 17px; }
  .button-primary { color: #fff; background: var(--site-accent); }
  .button-primary:hover { background: #ae2e32; transform: translateY(-2px); }
  .text-link { display: inline-flex; gap: 10px; align-items: center; font-size: 14px; font-weight: 500; }
  .text-link:hover { text-decoration: underline; text-underline-offset: 5px; }
  .text-link > span { color: var(--site-muted); }
  .eyebrow { display: flex; gap: 14px; align-items: center; font-size: 13px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--site-muted); margin: 0 0 23px;  line-height: 1.5; }
  .eyebrow > span { color: var(--site-accent); font-family: ui-monospace, monospace; font-size: 12px; }
  h2 { font-size: clamp(32px, 4.4vw, 52px); font-weight: 500; line-height: 1.2; letter-spacing: -.025em; text-wrap: balance; margin: 0; max-width: 840px; }
  .section-description { font-size: 18px; line-height: 1.7; color: var(--site-muted); max-width: 720px; margin: 26px 0 0; text-wrap: pretty; }
  h2:lang(zh), h3:lang(zh) { letter-spacing: -.015em; }
  .evolution-layout { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); align-items: center; gap: clamp(32px, 5vw, 72px); }
  .evolution-copy { min-width: 0; }
  .evolution-copy h2 { font-size: clamp(32px, 4.4vw, 52px); line-height: 1.2; }
  .evolution-copy .section-description { max-width: 410px; }
  .evolution-panel { min-width: 0; margin: 0; }
  .paradigm-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 56px; }
  .card-destination { position:absolute; inset:0; border-radius:inherit; z-index:2; }
  .card-destination:focus-visible { outline:2px solid var(--site-accent); outline-offset:4px; }
  .paradigm-art { position:relative; z-index:3; pointer-events:auto; }
  .paradigm-art :global(button) { pointer-events:auto; }
  .paradigm-card { position:relative; min-width: 0; display: flex; flex-direction: column; padding: 27px 32px 30px; border: 1px solid transparent; border-radius: 24px; background: var(--site-alt); transition: border-color .25s, transform .25s; }
  .paradigm-card:hover { border-color: var(--site-line); }
  .paradigm-card.featured { border-color: color-mix(in srgb, var(--site-accent) 48%, transparent); }
  .card-topline { display: flex; align-items: center; gap: 14px; color: var(--site-muted); min-height: 20px; }
  .card-index { font-family: ui-monospace, monospace; font-size: 12px; }
  .card-arrow { margin-left: auto; width: 18px; height: 18px; }
  .featured-label { display: flex; gap: 6px; align-items: center; font-size: 12px; }
  .featured-label i { width: 5px; height: 5px; background: var(--site-accent); border-radius: 50%; }
  .paradigm-art { margin: 20px -12px 24px; }
  .card-copy { display: flex; flex-direction: column; flex: 1; }
  h3 { font-size: 26px; line-height: 1.3; letter-spacing: -.015em; font-weight: 500; margin: 0; }
  .card-copy > p { color: var(--site-muted); font-size: 16px; line-height: 1.7; margin: 15px 0 26px; flex: 1; }
  .project-link { font-size: 14px; border-top: 1px solid var(--site-line); padding-top: 21px; display: flex; justify-content: space-between; gap: 12px;  line-height: 1.6; }
  .project-link > span { color: var(--site-accent); }
  .platforms { list-style: none; padding: 0; margin: 36px 0 0; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 12px; }
  .platforms li { min-width: 0; padding: 24px 4px; display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; }
  .platform-mark { height: 64px; width: 100%; display: flex; align-items: center; justify-content: center; }
  .platform-icon { width: 48px; height: 48px; flex-shrink: 0; color: var(--site-ink); }
  .platforms [data-platform="amd"] .platform-icon,
  .platforms [data-platform="vulkan"] .platform-icon { width: 88px; height: 88px; }
  .platform-name { color: var(--site-muted); font-size: 14px; font-weight: 500; line-height: 1.5; letter-spacing: .015em; text-wrap: balance; overflow-wrap: anywhere; }
  .explore-layout { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 80px; align-items: stretch; }
  .explore-feature { display: flex; flex-direction: column; gap: 52px; min-width: 0; }
  .resource-list { min-width: 0; }
  .explore-layout h2 { max-width: none; }
  .genesis-resource { display: block; position: relative; padding: 24px 0 28px; border-block: 1px solid var(--site-line); transition: border-color .2s; }
  .genesis-resource::before { content: ""; position: absolute; top: -1px; left: 0; height: 1px; width: 42px; background: var(--site-accent); transition: width .25s; }
  .genesis-resource:hover::before { width: 84px; }
  .genesis-resource:focus-visible { outline: 2px solid var(--site-accent); outline-offset: 8px; }
  .genesis-body { display: grid; grid-template-columns: minmax(0, 1fr) 112px; align-items: center; gap: 20px; margin-top: 22px; }
  .genesis-copy { min-width: 0; }
  .genesis-resource h3 { margin: 0; font-size: 30px; line-height: 1.2; font-weight: 500; letter-spacing: -.035em; }
  .genesis-resource p { margin: 10px 0 0; font-size: 14px; line-height: 1.75; color: var(--site-muted); }
  .genesis-art { width: 100%; height: auto; }
  .genesis-art .branch { stroke: var(--site-muted); opacity: .4; stroke-width: 1; }
  .genesis-art .lineage { stroke: var(--site-accent); stroke-width: 1.2; }
  .genesis-art .branch-node { stroke: var(--site-muted); fill: var(--site-bg); opacity: .7; }
  .genesis-art .lineage-node { stroke: var(--site-accent); fill: var(--site-bg); }
  .genesis-art .lineage-halo { stroke: var(--site-accent); opacity: .25; }
  .genesis-art .lineage-tip { fill: var(--site-accent); }
  .genesis-resource > .genesis-arrow { position: absolute; top: 24px; right: 0; width: 18px; height: 18px; color: var(--site-muted); transition: transform .2s, color .2s; }
  .genesis-resource:hover > .genesis-arrow { color: var(--site-accent); transform: translate(2px, -2px); }
  .resource-row { display: grid; grid-template-columns: 20px 1fr 18px; gap: 18px; padding: 28px 0; border-top: 1px solid var(--site-line); }
  .resource-row:last-child { border-bottom: 1px solid var(--site-line); }
  .resource-number { color: var(--site-muted); font-size: 12px; font-family: ui-monospace, monospace; margin-top: 5px; }
  .resource-row h3 { font-size: 22px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .resource-badge { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; line-height: 1.5; letter-spacing: .025em; color: var(--site-muted); }
  .resource-badge i { width: 5px; height: 5px; background: var(--site-accent); border-radius: 50%; }
  .resource-row p { font-size: 16px; line-height: 1.7; margin: 10px 0 0; color: var(--site-muted); }
  .resource-row > svg { width: 18px; height: 18px; margin-top: 5px; color: var(--site-muted); transition: transform .2s, color .2s; }
  .resource-row:hover > svg { color: var(--site-accent); transform: translate(2px, -2px); }
  .news-section { padding: 32px 0 64px; scroll-margin-top: 84px; }
  .news-heading { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin-bottom: 24px; }
  .news-heading h2 { display: flex; align-items: center; gap: 12px; font-size: 24px; line-height: 1.3; letter-spacing: -.025em; }
  .news-heading h2 i { width: 6px; height: 6px; border-radius: 50%; background: var(--site-accent); flex-shrink: 0; }
  .news-heading .text-link { flex-shrink: 0; font-size: 14px; }
  .news-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .news-card { display: flex; flex-direction: column; min-width: 0; padding: 24px; border: 1px solid var(--site-line); border-radius: 16px; background: var(--site-alt); transition: border-color .2s; }
  .news-card:hover { border-color: var(--site-muted); }
  .news-meta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 12px; font-size: 12px; line-height: 1.6; color: var(--site-muted); margin-bottom: 18px; }
  .news-meta > span { color: var(--site-link); }
  .news-meta time { font-variant-numeric: tabular-nums; }
