  .evo-figure.is-playing .s2.pruned { animation: draw-pruned 9s ease-in-out infinite; }
  .evo-figure.is-playing .s3 { animation: draw-s3 9s ease-in-out infinite; }
  .evo-figure.is-playing .s4 { animation: draw-s4 9s ease-in-out infinite; }
  .evo-figure.is-playing .s4.tail { animation: draw-tail 9s ease-in-out infinite; }
  .evo-figure.is-playing .n0 { animation: node-n0 9s ease-in-out infinite; }
  .evo-figure.is-playing .n1 { animation: node-n1 9s ease-in-out infinite; }
  .evo-figure.is-playing .n2 { animation: node-n2 9s ease-in-out infinite; }
  .evo-figure.is-playing .n2.pruned-node { animation: node-pruned 9s ease-in-out infinite; }
  .evo-figure.is-playing .n3 { animation: node-n3 9s ease-in-out infinite; }
  .evo-figure.is-playing .n4 { animation: node-n4 9s ease-in-out infinite; }

  @keyframes draw-s1 { 0% { stroke-dashoffset: 1; opacity: 1; } 12% { stroke-dashoffset: 0; } 88% { stroke-dashoffset: 0; opacity: 1; } 96%, 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes draw-s2 { 0%, 12% { stroke-dashoffset: 1; opacity: 1; } 26% { stroke-dashoffset: 0; } 88% { stroke-dashoffset: 0; opacity: 1; } 96%, 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes draw-pruned { 0%, 12% { stroke-dashoffset: 1; opacity: 0.9; } 26% { stroke-dashoffset: 0; opacity: 0.9; } 34% { opacity: 0.9; } 42%, 88% { stroke-dashoffset: 0; opacity: 0.15; } 96%, 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes draw-s3 { 0%, 40% { stroke-dashoffset: 1; opacity: 1; } 54% { stroke-dashoffset: 0; } 88% { stroke-dashoffset: 0; opacity: 1; } 96%, 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes draw-s4 { 0%, 56% { stroke-dashoffset: 1; opacity: 1; } 70% { stroke-dashoffset: 0; } 88% { stroke-dashoffset: 0; opacity: 1; } 96%, 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes draw-tail { 0%, 70% { stroke-dashoffset: 1; opacity: 0.6; } 80% { stroke-dashoffset: 0; opacity: 0.6; } 88% { opacity: 0.3; } 96%, 100% { stroke-dashoffset: 0; opacity: 0; } }
