---
interface Props {
  steps: string[];
  captions: string[];
  description: string;
  pauseLabel: string;
  playLabel: string;
  restartLabel: string;
}
const { steps, captions, description, pauseLabel, playLabel, restartLabel } = Astro.props;
---

<section class="evox-evolution" id="evox-evolution" aria-label={description} data-pause-label={pauseLabel} data-play-label={playLabel}>
  <div class="evx-visual">
    <canvas class="evx-canvas" role="img" aria-label={description}></canvas>
    <div class="evx-controls" role="group" aria-label={description}>
      <button class="evx-control" data-action="play" type="button" aria-label={pauseLabel} title={pauseLabel}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3v14H7zM14 5h3v14h-3z"/></svg>
      </button>
      <button class="evx-control" data-action="reset" type="button" aria-label={restartLabel} title={restartLabel}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1.8 7.3M4 4v6h6"/></svg>
      </button>
    </div>
  </div>
  <div class="evx-steps" role="group" aria-label={description}>
    {steps.map((step, i) => (
      <button class:list={['evx-step', { 'is-active': i === 0 }]} data-stage={i} data-caption={captions[i]} aria-pressed={i === 0 ? 'true' : 'false'} type="button">
        <span class="evx-number">{String(i + 1).padStart(2, '0')}</span><span class="evx-name">{step}</span>
      </button>
    ))}
  </div>
  <p class="evx-caption" data-status aria-live="off">{captions[0]}</p>
</section>

<style>

  /* The component is independent of the surrounding page. */
  .evox-evolution {--evx-red:var(--diagram-red);--evx-bright:var(--diagram-bright);--evx-text:var(--diagram-ink);--evx-muted:var(--diagram-muted);width:100%;max-width:940px;color:var(--site-ink)}
  .evx-visual {position:relative;background:var(--diagram-bg);border:1px solid var(--diagram-border);border-radius:22px;overflow:hidden;isolation:isolate}
  .evx-canvas {width:100%;height:auto;aspect-ratio:1;display:block}
  .evx-controls {position:absolute;right:20px;top:19px;display:flex;gap:8px;z-index:2}
  .evx-control {display:grid;place-items:center;width:32px;height:32px;padding:0;border:1px solid var(--diagram-border);border-radius:50%;background:var(--diagram-fill);color:var(--diagram-muted);cursor:pointer;transition:color .15s,border-color .15s,background .15s}
  .evx-control:hover {color:var(--diagram-ink);border-color:var(--diagram-bright);background:var(--diagram-soft)}
  .evx-control:focus-visible,.evx-step:focus-visible {outline:2px solid var(--diagram-bright);outline-offset:5px}
  .evx-control svg {width:14px;height:14px;display:block}
  .evx-steps {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:22px}
  .evx-step {appearance:none;position:relative;border:0;background:transparent;color:var(--site-muted);text-align:left;padding:19px 0 2px;cursor:pointer;font:inherit;min-width:0}
  .evx-step::before,.evx-step::after {content:"";height:1px;position:absolute;left:0;right:0;top:0;background:var(--diagram-guide)}
  .evx-step::after {height:2px;right:auto;width:100%;transform:scaleX(var(--progress,0));transform-origin:left;background:var(--evx-red)}
  .evx-step.is-active::after {box-shadow:0 0 11px #e6536144}
  .evx-step.is-complete::after {background:var(--diagram-soft)}
  .evx-number {display:block;font-size:13px;line-height:1;letter-spacing:.06em;color:var(--diagram-muted);font-variant-numeric:tabular-nums;margin-bottom:14px}
  .evx-name {display:block;font-size:15px;line-height:1.25;font-weight:450;letter-spacing:-.025em;overflow-wrap:anywhere}
  .evx-step.is-active .evx-number {color:var(--evx-bright)}
  .evx-step.is-active .evx-name {color:var(--site-ink)}
  .evx-step:hover .evx-name {color:var(--site-ink)}
  .evx-caption {margin:18px 0 0;min-height:3em;font-size:14px;line-height:1.6;color:var(--site-muted);text-wrap:pretty}
  @media (max-width:640px) {
    .evx-visual {border-radius:19px}
    .evx-canvas {height:auto;aspect-ratio:1}
    .evx-controls {top:13px;right:13px;gap:7px}
    .evx-control {width:29px;height:29px}
    .evx-control svg {width:13px;height:13px}
    .evx-steps {gap:10px;margin-top:21px}
    .evx-step {padding-top:16px}
    .evx-number {font-size:12px;margin-bottom:12px}
    .evx-name {font-size:clamp(12px,3.4vw,15px);letter-spacing:-.035em}
  }
  @media (prefers-reduced-motion:reduce) {.evx-control {transition:none}}
</style>

<script is:inline>

/* EvoX evolution loop. Plain Canvas 2D + JavaScript; no network or library dependency.
   This is an illustrative, deterministic toy evolutionary algorithm, not EvoX benchmark data.
   Generate (inherit and vary) -> evaluate a synthetic objective -> retain 3 elites.
   The same selected individuals persist across generations. The ring itself does not rotate. */
(() => {
  'use strict';
  const TAU = Math.PI*2;
  const COUNT = 12, KEEP = 3, FAMILY = COUNT / KEEP;
  const DURATIONS = [5000,3400,3000];
  const STARTS = [0];
  DURATIONS.forEach(v=>STARTS.push(STARTS[STARTS.length-1]+v));
  const CYCLE = STARTS[DURATIONS.length];
  const NAMES = ['Generate','Evaluate','Select'];

  const clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));
  const mix=(a,b,t)=>a+(b-a)*t;
  const smooth=t=>{t=clamp(t);return t*t*(3-2*t)};
  const ease=t=>1-Math.pow(1-clamp(t),3);
  const color=(rgb,a=1)=>`rgba(${rgb.map(v=>Math.round(v)).join(',')},${clamp(a)})`;
  const blend=(a,b,t)=>a.map((v,i)=>mix(v,b[i],t));
  const polar=(r,a)=>({x:r*Math.cos(a),y:r*Math.sin(a)});
    function rng(seed) {let a=seed>>>0;return ()=>{a|=0;a=(a+0x6D2B79F5)|0;let t=Math.imul(a^(a>>>15),1|a);t=(t+Math.imul(t^(t>>>7),61|t))^t;return ((t^(t>>>14))>>>0)/4294967296}}
  function shortAngle(a,b) {let d=(b-a+Math.PI)%TAU;if(d<0)d+=TAU;return d-Math.PI}
  function score(x,y) {return 1/(1+2*(.55*x*x+1.1*y*y+.07*(Math.sin(x*4)**2+Math.sin(y*4)**2)))}
  function target(slot) {return {a:-Math.PI/2+slot*TAU/COUNT,r:147+5*Math.sin(slot*2.39996323)}}
  function budPose(item) {const source=target(item.parent*FAMILY),rank=item.slot%FAMILY;return {a:source.a+(rank-2)*.20,r:source.r-32}}
  function moving(a,b,t,curve=0) {return {a:a.a+shortAngle(a.a,b.a)*t,r:mix(a.r,b.r,t)+Math.sin(Math.PI*t)*curve}}
  class EvolutionDiagram {
    constructor(root) {
      if(!root) throw new Error('An EvoX component root is required.');
      this.updatePalette();
      this.root=root;this.canvas=root.querySelector('canvas');
      this.ctx=this.canvas.getContext('2d',{alpha:false});
      if(!this.ctx) throw new Error('Canvas 2D is not supported in this browser.');
      this.steps=[...root.querySelectorAll('[data-stage]')];
      this.playButton=root.querySelector('[data-action="play"]');
      this.resetButton=root.querySelector('[data-action="reset"]');
      this.status=root.querySelector('[data-status]');
      this.generations=[];this.time=0;this.playing=false;this.visible=true;this.destroyed=false;
      this.frameId=null;this.lastTime=null;this.lastStage=-1;this.lastGen=-1;
      this.abort=new AbortController();const signal=this.abort.signal;
      this.media=matchMedia('(prefers-reduced-motion: reduce)');
      this.motion=this.media.matches;
      this.loop=this.loop.bind(this);this.resize=this.resize.bind(this);
      this.playButton.addEventListener('click',()=>this.playing?this.pause():this.play(),{signal});
      this.resetButton.addEventListener('click',()=>{const play=this.playing;this.seek(0);if(play)this.play()},{signal});
      this.steps.forEach((b,i)=>b.addEventListener('click',()=>{
        const playing=this.playing;
        this.seek(Math.floor(this.time/CYCLE)*CYCLE+STARTS[i]+DURATIONS[i]*.52);
        if(playing)this.play();
      },{signal}));
      document.addEventListener('visibilitychange',()=>this.schedule(),{signal});
      this.media.addEventListener('change',e=>{this.motion=e.matches;if(e.matches)this.pause()},{signal});
      this.resizeObserver=new ResizeObserver(this.resize);this.resizeObserver.observe(this.canvas);
      this.intersectionObserver=new IntersectionObserver(entries=>{this.visible=entries[0].isIntersecting;this.schedule()},{threshold:0});
      this.intersectionObserver.observe(this.root);
      this.themeObserver=new MutationObserver(()=>{this.updatePalette();this.render()});
      this.themeObserver.observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});
      this.generation(0);this.resize();
      if(this.motion)this.seek(STARTS[2]+DURATIONS[2]*.75);else this.play();
    }
    updatePalette() {
      const style=getComputedStyle(document.documentElement);
      const hex=name=>style.getPropertyValue('--diagram-'+name).trim();
      const rgb=name=>{
        const raw=hex(name).slice(1);
        const value=raw.length===3?[...raw].map(v=>v+v).join(''):raw;
        return value.match(/.{2}/g).map(v=>parseInt(v,16));
      };
      this.fill=rgb('fill');this.red=rgb('red');this.bright=rgb('bright');this.grey=rgb('muted');this.ink=rgb('ink');this.background=hex('bg');
    }
    generation(g) {
      if(this.generations[g])return this.generations[g];
      for(let k=this.generations.length;k<=g;k++) {
        const random=rng(24771+k*7013),items=[];
        if(k===0) {
          for(let i=0;i<COUNT;i++) {
            const x=random()*2-1,y=random()*2-1;
            items.push({id:`0:${i}`,slot:i,x,y,fitness:score(x,y),trait:random()*TAU,seed:random(),parent:-1,retained:false});
          }
        } else {
          const prev=this.generations[k-1],parents=prev.winners.map(i=>prev.items[i]);
          for(let i=0;i<COUNT;i++) {
            const pi=Math.floor(i/FAMILY),parent=parents[pi];
            if(i%FAMILY===0)items.push({...parent,slot:i,parent:pi,retained:true});
            else {
              const sigma=.31*Math.pow(.91,Math.min(k,8))+.055;
              const normal=()=>Math.sqrt(-2*Math.log(Math.max(random(),.00001)))*Math.cos(TAU*random());
              const x=clamp(parent.x+normal()*sigma,-1.2,1.2),y=clamp(parent.y+normal()*sigma,-1.2,1.2);
              items.push({id:`${k}:${i}`,slot:i,x,y,fitness:score(x,y),trait:parent.trait+(random()-.5)*.7,seed:random(),parent:pi,retained:false});
            }
          }
        }
        const winners=items.map((_,i)=>i).sort((a,b)=>items[b].fitness-items[a].fitness).slice(0,KEEP);
        this.generations.push({items,winners,best:items[winners[0]].fitness});
      }
      return this.generations[g];
    }
    resize() {
      if(this.destroyed)return;
      const r=this.canvas.getBoundingClientRect();this.w=r.width;this.h=r.height;
      if(!this.w||!this.h)return;
      this.dpr=Math.min(devicePixelRatio||1,2);
      this.canvas.width=Math.round(this.w*this.dpr);this.canvas.height=Math.round(this.h*this.dpr);
      this.scale=Math.min((this.w-32)/470,(this.h-38)/470);
      this.render();
    }
    readTime() {
      const gen=Math.floor(this.time/CYCLE),inCycle=this.time-gen*CYCLE;
      let stage=DURATIONS.length-1;for(let i=0;i<DURATIONS.length;i++)if(inCycle<STARTS[i+1]){stage=i;break}
      return {gen,stage,p:clamp((inCycle-STARTS[stage])/DURATIONS[stage]),inCycle};
    }
    ring(r,a,b,stroke,width=1,alpha=1) {
      if(alpha<=0||b-a<.0001)return;
      const c=this.ctx;c.beginPath();c.arc(0,0,r,a,b);c.strokeStyle=typeof stroke==='string'?stroke:color(stroke,alpha);c.lineWidth=width;c.lineCap='round';c.stroke();
    }
    dot(x,y,r,fill,alpha=1) {
      if(r<=0||alpha<=0)return;
      const c=this.ctx;c.beginPath();c.arc(x,y,r,0,TAU);c.fillStyle=typeof fill==='string'?fill:color(fill,alpha);c.fill();
    }
    halo(x,y,r,rgb,alpha) {
      if(alpha<=.001)return;
      const c=this.ctx,g=c.createRadialGradient(x,y,0,x,y,r);
      g.addColorStop(0,color(rgb,alpha));g.addColorStop(.25,color(rgb,alpha*.5));g.addColorStop(1,color(rgb,0));
      c.fillStyle=g;c.fillRect(x-r,y-r,r*2,r*2);
    }
    updateUi(state) {
      const {gen,stage,p}=state;
      if(stage!==this.lastStage||gen!==this.lastGen) {
        this.steps.forEach((b,i)=>{b.classList.toggle('is-active',i===stage);b.classList.toggle('is-complete',i<stage);b.setAttribute('aria-pressed',String(i===stage))});
        this.status.textContent=this.steps[stage].dataset.caption;
        this.lastStage=stage;this.lastGen=gen;
      }
      this.steps.forEach((b,i)=>b.style.setProperty('--progress',i<stage?'1':i===stage?String(p):'0'));
    }
    drawFramework(state) {
      const {stage,p}=state,c=this.ctx;
      // Three fixed waypoints; each arc covers one phase of the loop.
      this.ring(198,0,TAU,this.grey,.7,.14);
      this.ring(112,0,TAU,this.grey,.7,.12);
      const span=TAU/DURATIONS.length;
      for(let i=0;i<DURATIONS.length;i++) {
        const a=-Math.PI/2+i*span,gap=.056;
        this.ring(207,a+gap,a+span-gap,this.grey,1,.49);
        if(i<stage)this.ring(207,a+gap,a+span-gap,this.red,1.35,.53);
        if(i===stage) {
          const end=a+gap+(span-gap*2)*smooth(p);
          this.ring(207,a+gap,end,this.red,2,.94);
          const tip=polar(207,end);this.halo(tip.x,tip.y,14,this.red,.28);this.dot(tip.x,tip.y,1.7,this.bright,.98);
          const sweepStart=Math.max(a+gap,end-.2);
          this.ring(207,sweepStart,end,this.bright,1.5,.8);
        }
        // Tiny directional chevrons, independent of node animation.
        const arrow=polar(207,a+span*.5),direction=a+span*.5+Math.PI/2;
        c.save();c.translate(arrow.x,arrow.y);c.rotate(direction);
        c.beginPath();c.moveTo(-2.5,-2.8);c.lineTo(.5,0);c.lineTo(-2.5,2.8);
        c.strokeStyle=color(i<=stage?this.red:this.grey,i===stage?.8:.28);c.lineWidth=1;c.stroke();c.restore();
        const at=polar(207,a),active=i===stage;
        if(active)this.halo(at.x,at.y,24,this.red,.28+.06*Math.sin(p*Math.PI));
        this.dot(at.x,at.y,11.5,this.fill);
        c.beginPath();c.arc(at.x,at.y,active?11:10,0,TAU);c.lineWidth=active?1.5:1;
        c.strokeStyle=color(active?this.bright:i<stage?this.red:this.grey,active?1:i<stage?.6:.46);c.stroke();
        c.save();c.textAlign='center';c.textBaseline='middle';c.font='500 9px system-ui, sans-serif';
        c.fillStyle=color(active?this.bright:this.grey,1);c.fillText(String(i+1).padStart(2,'0'),at.x,at.y);c.restore();
      }
      // The localized phase title gives the abstract population a readable anchor.
      c.save();c.textAlign='center';c.fillStyle=color(this.ink,.88);
      c.font='500 20px system-ui, sans-serif';
      c.fillText(this.steps[stage].querySelector('.evx-name').textContent,0,-43,174);
      c.restore();
    }
    pose(item,state,pop) {
      const {gen,stage,p}=state,t=target(item.slot),winner=pop.winners.indexOf(item.slot);
      let pos=t,alpha=1,scale=1,red=0,scan=0,fitness=0;
      if(stage===0) {
        if(item.retained) {
          const settle=smooth((p-.45)/.45);
          red=mix(1,0,settle);scale=mix(1.12,1,settle);
        } else {
          const group=gen===0?Math.floor(item.slot/FAMILY):item.parent;
          const source=gen===0?{...target(group*FAMILY),r:target(group*FAMILY).r-5}:budPose(item);
          const rank=item.slot%FAMILY;
          const progress=gen===0?ease((p-.045-rank*.047)/.59):ease((p-.48-rank*.025)/.40);
          pos=moving(source,t,progress,-14);
          alpha=gen===0?smooth((p-.045-rank*.047)/.13):smooth((p-.05-rank*.025)/.18);
          scale=mix(gen===0?.32:.48,1,progress);
        }
      } else if(stage===1) {
        const reveal=smooth((p-item.slot*.026)/.5);
        scan=Math.sin(Math.PI*reveal)*.65;
        fitness=reveal;
        alpha=mix(1,.4+.6*item.fitness,reveal);
        scale=mix(1,.8+.35*item.fitness,reveal);
      } else if(stage===2) {
        const select=smooth((p-.06)/.63);
        fitness=1-select;
        const evaluatedAlpha=.4+.6*item.fitness,evaluatedScale=.8+.35*item.fitness;
        if(winner>=0){
          red=select;alpha=mix(evaluatedAlpha,1,select);scale=mix(evaluatedScale,1.12,select);scan=.24*Math.sin(Math.PI*select);
          // Prepare the selected parents at their family positions for the next Generate.
          pos=moving(t,target(winner*FAMILY),smooth((p-.65)/.35),-12);
        }
        else {alpha=mix(evaluatedAlpha,0,smooth((p-.06-item.slot*.009)/.70));pos={a:t.a,r:t.r+12*select};scale=evaluatedScale*(1-.3*select)}
      }
      return {...pos,alpha,scale,red,scan,fitness,winner};
    }
    drawCandidate(item,pose,state,alphaOverride=null) {
      const c=this.ctx,{p,stage}=state;
      const {a,r,scale,red,scan,fitness}=pose;
      const alpha=alphaOverride===null?pose.alpha:alphaOverride;
      if(alpha<.002)return;
      const q=polar(r,a),rgb=blend(this.grey,this.red,red),core=blend(this.ink,this.bright,red);
      if(red>.02)this.halo(q.x,q.y,20,this.red,alpha*red*.40);
      if(scan>.01)this.halo(q.x,q.y,17,this.ink,alpha*scan*.45);
      c.save();c.translate(q.x,q.y);c.scale(scale,scale);
      // A candidate is a small parameter signature, independent of any application.
      c.beginPath();c.roundRect(-13,-15,26,30,5);
      c.fillStyle=color(this.fill,alpha);c.fill();
      c.strokeStyle=color(rgb,alpha*(.55+.35*red));c.lineWidth=red>.7?1.4:.85;c.stroke();
      const signature=v=>[clamp((v.x+1.2)/2.4),clamp((v.y+1.2)/2.4),.5+.35*Math.sin(v.trait)];
      const genes=signature(item);
      let inherited=null,change=1;
      if(stage===0&&state.gen>0&&!item.retained) {
        const previous=this.generation(state.gen-1);
        inherited=signature(previous.items[previous.winners[item.parent]]);
        change=smooth((p-.20)/.28);
      }
      genes.forEach((value,j)=>{
        if(inherited)value=mix(inherited[j],value,change);
        const y=-8+j*8;
        c.beginPath();c.moveTo(-8,y);c.lineTo(8,y);
        c.strokeStyle=color(this.grey,alpha*.16);c.lineWidth=2.5;c.stroke();
        c.beginPath();c.moveTo(-8,y);c.lineTo(-8+4+12*value,y);
        c.strokeStyle=color(core,alpha*.85);c.stroke();
        if(inherited&&change>0) {
          c.beginPath();c.moveTo(-4+12*inherited[j],y);c.lineTo(-4+12*value,y);
          c.strokeStyle=color(this.bright,alpha*(1-smooth((p-.65)/.3)));c.stroke();
        }
      });
      if(stage===1) {
        const y=-12+24*((p*1.5+item.seed)%1);
        c.beginPath();c.moveTo(-10,y);c.lineTo(10,y);
        c.strokeStyle=color(this.bright,alpha*scan*.7);c.lineWidth=1;c.stroke();
      }
      if(fitness>.001) {
        c.beginPath();c.moveTo(-12,21);c.lineTo(12,21);
        c.strokeStyle=color(this.grey,alpha*fitness*.18);c.lineWidth=2;c.stroke();
        c.beginPath();c.moveTo(-12,21);c.lineTo(-12+24*item.fitness,21);
        c.strokeStyle=color(this.ink,alpha*fitness*.85);c.stroke();
      }
      c.restore();
    }
    drawTests(state) {
      const {stage,p}=state,c=this.ctx,pop=this.generation(state.gen);
      const tile=(item,x,y,alpha=1,red=0,scale=1)=>this.drawCandidate(item,{a:Math.atan2(y,x),r:Math.hypot(x,y),scale,red,scan:0,fitness:0,alpha},state);
      c.save();c.scale(1.12,1.12);c.lineCap='round';
      if(stage===0&&state.gen===0) {
        // Distinct signatures appear one by one, without implying quality yet.
        [0,4,8].forEach((slot,i)=>{
          const enter=smooth((p-i*.14)/.35);
          tile(pop.items[slot],(i-1)*44,12+12*(1-enter),.15+.85*enter,0,.8+.2*enter);
        });
      } else if(stage===1) {
        // Each bar is tied to the same candidate as its population-ring counterpart.
        pop.items.forEach((item,i)=>{
          const reveal=smooth((p-i*.026)/.5),x=-66+i*12;
          c.beginPath();c.moveTo(x,40);c.lineTo(x,40-(8+48*item.fitness)*reveal);
          c.strokeStyle=color(this.ink,.3+.5*reveal);c.lineWidth=5;c.stroke();
          if(reveal>0&&reveal<1)this.dot(x,40-(8+48*item.fitness)*reveal,2,this.bright,.9);
        });
        c.beginPath();c.moveTo(-72,46);c.lineTo(72,46);c.strokeStyle=color(this.grey,.25);c.lineWidth=.7;c.stroke();
      } else if(stage===2) {
        pop.winners.forEach((slot,i)=>{
          const reveal=smooth((p-.08-i*.1)/.45),x=(i-1)*46;
          tile(pop.items[slot],x,9,.2+.8*reveal,reveal,1.05);
          c.beginPath();c.moveTo(x-4,36);c.lineTo(x-1,39);c.lineTo(x+5,32);
          c.strokeStyle=color(this.red,reveal);c.lineWidth=1.6;c.stroke();
        });
      } else {
        // Retained parent and two actual descendants: unchanged features stay neutral.
        const parent=pop.items[0],next=pop;
        const copy=smooth(p/.20);
        tile(parent,-43,14,1,1,1.1);
        [{x:38,y:-7},{x:38,y:39}].forEach(({x,y},i)=>{
          c.beginPath();c.moveTo(-26,14);c.bezierCurveTo(0,14,0,y,20,y);
          c.strokeStyle=color(this.grey,.5*copy);c.lineWidth=1;c.stroke();
          c.beginPath();c.moveTo(16,y-3);c.lineTo(20,y);c.lineTo(16,y+3);c.stroke();
          const child=next.items[i+1];
          tile(child,x,y,copy,0,1);
        });
      }
      c.restore();
    }
    drawInheritance(state,pop) {
      const {stage,p}=state;
      if(stage!==0||state.gen===0)return;
      for(let j=0;j<KEEP;j++) {
        const t=target(j*FAMILY),q=polar(t.r,t.a);
        const strength=1-smooth(p/.45);
        if(strength>.001) {
          const ripple=clamp(p/.45);
          const c=this.ctx;c.beginPath();c.arc(q.x,q.y,12+16*ripple,0,TAU);c.lineWidth=.8;
          c.strokeStyle=color(this.red,strength*(1-ripple)*.32);c.stroke();
        }
      }
      // New candidates branch from retained parents before expanding into the population.
      const strength=smooth(p/.18)*(1-smooth((p-.50)/.25));
      if(strength>.001) {
        pop.items.filter(v=>!v.retained).forEach(item=>{
          const pose=this.pose(item,state,pop);
          const source=target(item.parent*FAMILY),from=polar(source.r,source.a),to=polar(pose.r,pose.a);
          const c=this.ctx;c.beginPath();c.moveTo(from.x,from.y);c.lineTo(to.x,to.y);
          c.strokeStyle=color(this.red,strength*.28);c.lineWidth=.7;c.stroke();
        });
      }
    }
    render() {
      if(this.destroyed||!this.w||!this.h)return;
      const c=this.ctx,s=this.readTime(),pop=this.generation(s.gen);this.updateUi(s);
      c.setTransform(this.dpr,0,0,this.dpr,0,0);c.fillStyle=this.background;c.fillRect(0,0,this.w,this.h);
      c.save();c.translate(this.w/2,this.h/2+4);c.scale(this.scale,this.scale);
      // A neutral stage keeps the red emphasis on active nodes.
      this.drawFramework(s);
      // Briefly blend the center scenes while the new phase title stays readable.
      // Keep direct stage selection and reduced-motion views immediate.
      const enter=this.motion||!this.playing?1:smooth(s.p*DURATIONS[s.stage]/260);
      if(enter<1&&(s.gen>0||s.stage>0)) {
        const previousStage=(s.stage+DURATIONS.length-1)%DURATIONS.length;
        c.save();c.globalAlpha=1-enter;
        this.drawTests({...s,gen:s.gen-(s.stage===0?1:0),stage:previousStage,p:1});
        c.restore();
      }
      c.save();c.globalAlpha=enter;this.drawTests(s);c.restore();
      this.drawInheritance(s,pop);
      for(const item of pop.items)this.drawCandidate(item,this.pose(item,s,pop),s);
      c.restore();
    }
    schedule() {
      if(this.frameId!==null){cancelAnimationFrame(this.frameId);this.frameId=null}
      this.lastTime=null;
      if(!this.destroyed&&this.playing&&this.visible&&!document.hidden)this.frameId=requestAnimationFrame(this.loop);
    }
    loop(now) {
      this.frameId=null;
      if(this.destroyed||!this.playing||!this.visible||document.hidden)return;
      if(this.lastTime!==null)this.time+=Math.min(now-this.lastTime,120);
      this.lastTime=now;this.render();this.frameId=requestAnimationFrame(this.loop);
    }
    updateButton() {
      const label=this.playing?this.root.dataset.pauseLabel:this.root.dataset.playLabel;this.playButton.setAttribute('aria-label',label);this.playButton.title=label;
      this.playButton.querySelector('svg').innerHTML=this.playing?'<path d="M7 5h3v14H7zM14 5h3v14h-3z"/>':'<path d="M8 4.7L19 12 8 19.3z"/>';
    }
    play() {if(this.destroyed)return;this.playing=true;this.updateButton();this.schedule()}
    pause() {this.playing=false;this.updateButton();this.schedule()}
    seek(milliseconds) {
      if(!Number.isFinite(milliseconds)||milliseconds<0)throw new RangeError('seek() requires non-negative milliseconds.');
      this.pause();this.time=milliseconds;this.render();return this.getState();
    }
    getState() {
      const state=this.readTime(),pop=this.generation(state.gen);
      return {milliseconds:this.time,generation:state.gen+1,stage:NAMES[state.stage],stageIndex:state.stage,progress:state.p,playing:this.playing,
        population:pop.items.map(p=>({id:p.id,slot:p.slot,fitness:p.fitness,retained:p.retained})),
        selected:pop.winners.map(i=>pop.items[i].id),best:pop.best,cycleMilliseconds:CYCLE};
    }
    destroy() {this.pause();this.destroyed=true;this.abort.abort();this.themeObserver.disconnect();this.resizeObserver.disconnect();this.intersectionObserver.disconnect()}
  }
  window.EvolutionDiagram=EvolutionDiagram;
  window.evolutionDiagram=new EvolutionDiagram(document.getElementById('evox-evolution'));
})();

</script>
