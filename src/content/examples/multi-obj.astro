---
import { type Locale, defaultLocale, loadTranslations, t } from "../../i18n/utils";
interface Props { locale?: Locale }
const { locale = defaultLocale } = Astro.props;
const tr = await loadTranslations(locale);
---

<div id="rvea-plot" data-generation={t(tr, "examples.plot.generation")}  data-min={t(tr, "examples.plot.min")}  data-max={t(tr, "examples.plot.max")}  data-median={t(tr, "examples.plot.median")}  data-front={t(tr, "examples.plot.front")}  data-population={t(tr, "examples.plot.population")}  class="w-full h-full"></div>

<script is:inline>
  // Load Plotly only once: multiple components on the same page share this
  // promise, so the CDN script is injected a single time and everyone awaits it.
  window.__plotlyLoad =
    window.__plotlyLoad ||
    new Promise((resolve, reject) => {
      if (window.Plotly) {
        resolve(window.Plotly);
        return;
      }
      const s = document.createElement("script");
      s.src = "https://cdn.plot.ly/plotly-3.3.0.min.js";
      s.charset = "utf-8";
      s.onload = () => resolve(window.Plotly);
      s.onerror = () => reject(new Error("Failed to load Plotly"));
      document.head.appendChild(s);
    });
</script>

<script>
  import { syncPlotTheme } from "./plot-theme";
  import { coordinate, splashed, layout } from "./rvea-data.js";
  import framesUrl from "./rvea-frames.json?url";

  const rvea_plot = document.getElementById("rvea-plot");
  if (rvea_plot) {
    const localizedLayout = structuredClone(layout);
    localizedLayout.sliders.forEach(slider => {
      slider.currentvalue.prefix = `${rvea_plot.dataset.generation}: `;
    });
    const data = [{ ...coordinate, name: rvea_plot.dataset.front }, { ...splashed, name: rvea_plot.dataset.population }];
    const initPlot = async () => {
      // @ts-ignore
      await (window.__plotlyLoad || Promise.reject(new Error("Plotly loader not initialized")));
      // @ts-ignore
      if (typeof Plotly === "undefined") {
        throw new Error("Plotly is not defined");
      }
      // @ts-ignore
      await Plotly.newPlot(rvea_plot, data, localizedLayout, { responsive: true });
      const values = await fetch(framesUrl).then((v) => v.json());
      // @ts-ignore
      values.forEach((it) => {
        it.data[0] = data[0];
        if (it.data[1]) it.data[1].name = rvea_plot.dataset.population;
      });
      // @ts-ignore
      await Plotly.addFrames(rvea_plot, values);
      syncPlotTheme(rvea_plot);
        rvea_plot.setAttribute("data-ready", "true");
      // If the panel became visible while frames were loading, the initial
      // newPlot measured a hidden container and got the default size —
      // resize now that the plot can actually be measured.
      if (rvea_plot.offsetParent !== null) {
        // @ts-ignore
        Plotly.Plots.resize(rvea_plot).catch(() => {});
      }
    };
    initPlot().catch((err) => {
      console.warn("Failed to render rvea plot:", err);
      rvea_plot.style.display = "none";
    });
  }
</script>
