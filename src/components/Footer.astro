---
import { Icon } from "astro-icon/components";
import { type Locale, defaultLocale, loadTranslations, t, getLocalizedUrl } from "../i18n/utils";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const tr = await loadTranslations(locale);
const year = new Date().getFullYear();

const footerLinks: { label: string; href: string }[] = [
  { label: t(tr, "nav.ecosystem"), href: getLocalizedUrl("/libs", locale) },
  { label: t(tr, "nav.blog.news"), href: getLocalizedUrl("/news", locale) },
  { label: t(tr, "nav.blog.releases"), href: getLocalizedUrl("/releases", locale) },
  { label: t(tr, "nav.docs"), href: getLocalizedUrl("/docs", locale) },
  { label: t(tr, "nav.community"), href: getLocalizedUrl("/libs", locale) + "#community" },
  { label: t(tr, "nav.github"), href: "https://github.com/EMI-Group" },
  { label: t(tr, "nav.contact"), href: "https://chengran.tech/" },
];
---

<footer class="pt-16 pb-8 border-t border-gray-800" style="background: rgb(22, 27, 48);">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-8">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4 sm:gap-6">
        <a
          href={getLocalizedUrl("/", locale)}
          class="opacity-80 hover:opacity-100 transition-opacity flex-shrink-0 flex items-center"
        >
          <img
            src="/logo_text.png"
            alt="EVO"
            class="h-8"
            style="filter: brightness(0) invert(1);"
          />
          <img
            src="/logo.svg"
            alt="EvoX mark"
            class="h-10"
            style="filter: brightness(0) invert(1);"
          />
        </a>

        <ul class="flex flex-wrap justify-center sm:justify-end gap-4 sm:gap-6 md:gap-10">
          <li>
            <a
              href="https://www.facebook.com/share/1Bspargk4W"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-500 hover:text-[#1877F2] transition-colors"
              aria-label="Facebook"
            >
              <Icon name="simple-icons:facebook" class="w-10 h-10" />
            </a>
          </li>
          <li>
            <a
              href="https://x.com/EvoX__Group"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-500 hover:text-white transition-colors"
              aria-label="X"
            >
              <Icon name="simple-icons:x" class="w-10 h-10" />
            </a>
          </li>
          <li>
            <a
              href="https://www.zhihu.com/people/liang-zhen-yu-13-4"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-500 hover:text-[#0084FF] transition-colors"
              aria-label="Zhihu"
            >
              <Icon name="simple-icons:zhihu" class="w-10 h-10" />
            </a>
          </li>
          <li>
            <a
              href="https://www.producthunt.com/@evox__group"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-500 hover:text-[#DA552F] transition-colors"
              aria-label="Product Hunt"
            >
              <Icon name="simple-icons:producthunt" class="w-10 h-10" />
            </a>
          </li>
          <li>
            <a
              href="https://www.reddit.com/user/EvoX_Group/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-500 hover:text-[#FF4500] transition-colors"
              aria-label="Reddit"
            >
              <Icon name="simple-icons:reddit" class="w-10 h-10" />
            </a>
          </li>
        </ul>
      </div>

      {/* Secondary links; Contact Us lives here instead of the primary nav. */}
      <nav>
        <ul class="flex flex-wrap justify-center sm:justify-start gap-x-6 gap-y-2 text-sm">
          {footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                class="text-gray-400 hover:text-teal-400 transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="text-center border-t border-gray-800 pt-6">
        <p class="text-sm text-gray-500" data-copyright-year={year}>
          {t(tr, "footer.copyright", { year: String(year) })}
        </p>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    var currentYear = String(new Date().getFullYear());
    document.querySelectorAll("[data-copyright-year]").forEach(function (el) {
      var buildYear = el.getAttribute("data-copyright-year");
      if (buildYear && buildYear !== currentYear && el.textContent) {
        // Replace every occurrence: in a year equal to the start year the
        // build year appears twice ("© 2022-2022"), and a first-match
        // replace would corrupt the range.
        el.textContent = el.textContent.replaceAll(buildYear, currentYear);
      }
    });
  })();
</script>
