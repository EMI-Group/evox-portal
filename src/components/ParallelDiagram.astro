---
import { type Locale, defaultLocale, loadTranslations, t } from "../i18n/utils";
interface Props { locale?: Locale; }
const { locale = defaultLocale } = Astro.props;
const tr = await loadTranslations(locale);
// Abstract code fragments: indentation and unequal line lengths, without language syntax.
const codeLines = [
  { x: 16, y: 40, widths: [16, 30, 9, 19] },
  { x: 26, y: 52, widths: [12, 7, 25, 8, 16] },
  { x: 36, y: 64, widths: [9, 15, 6, 18, 7, 12] },
  { x: 26, y: 76, widths: [12, 6, 22, 8, 10, 7] },
  { x: 16, y: 91, widths: [23, 9, 18, 28] },
];
const codeFragments = (depth: number) => codeLines.flatMap((line, row) => line.widths.map((width, column) => ({
  x: line.x + line.widths.slice(0, column).reduce((sum, value) => sum + value + 4, 0),
  y: line.y, width, accent: row > 0 && column === (row + depth) % line.widths.length,
})));
const devices = ["CPU", "GPU", t(tr, "computing.diagram.accelerator")];
---
<figure class="parallel-figure" aria-label={t(tr, "computing.diagram.title")}>
  <div class="network-stage">
    <canvas class="motion-canvas" aria-hidden="true"></canvas>
    <div class="motion-controls">
    <button class="motion-toggle" type="button" aria-label={t(tr, "evolution.pause")} data-pause={t(tr, "evolution.pause")} data-play={t(tr, "evolution.play")} aria-pressed="false">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path class="pause-icon" d="M5 4v8M11 4v8"/><path class="play-icon" d="m5 3 7 5-7 5Z"/></svg>
    </button>
    <button class="motion-restart" type="button" aria-label={t(tr, "evolution.restart")}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6a5.3 5.3 0 1 1 .8 5M3 2v4h4"/></svg>
    </button>
    </div>
    <ol class="pipeline">
      <li class="pipeline-step tasks-step">
        <h3><span>01</span>{t(tr, "computing.diagram.tasks")}</h3>
        <div class="step-art">
          <svg class="task-stack" viewBox="0 0 230 220" fill="none" aria-hidden="true">
            {[2, 1, 0].map(depth => <g class="task-layer" data-layer={depth} transform={`translate(${22 + depth * 17} ${24 + depth * 28})`}>
              <rect class="task-sheet" width="145" height="112" rx="8"/>
              <path class="task-rule" d="M14 18h36M14 24h20M111 18h19"/>
              <g class="task-code">
                {codeFragments(depth).map(fragment => <rect class:list={["task-fragment", {accent: fragment.accent}]} x={fragment.x} y={fragment.y} width={fragment.width} height="3.4" rx="1.7" />)}
              </g>
            </g>)}
          </svg>
        </div>
        <span class="transfer" aria-hidden="true"></span>
      </li>
      <li class="pipeline-step tensor-step">
        <h3><span>02</span>{t(tr, "computing.diagram.workflow")}</h3>
        <div class="step-art">
          <svg class="tensor-stack" viewBox="0 0 230 220" fill="none" aria-hidden="true">
            {[2, 1, 0].map(depth => <g class="tensor-layer" data-layer={depth} transform={`matrix(1.15 .55 -1.15 .55 115 ${42 + depth * 30})`}>
              <rect class="tensor-plane" x="-4" y="-4" width="78" height="78" rx="3" />
              {Array.from({length: 25}, (_, index) => <rect class:list={["tensor-cell", {accent: codeFragments(depth)[index].accent}]} x={(index % 5) * 14} y={Math.floor(index / 5) * 14} width="11" height="11" rx="1" style={`--strength: ${.3 + ((index * 3 + depth) % 6) / 10}; --delay: ${depth * -.8}s`} />)}
            </g>)}
          </svg>
        </div>
        <span class="transfer" aria-hidden="true"></span>
      </li>
      <li class="pipeline-step hardware-step">
        <h3><span>03</span>{t(tr, "computing.diagram.hardware")}</h3>
        <div class="step-art device-art">
          <svg class="device-bus" viewBox="0 0 230 220" preserveAspectRatio="none" fill="none" aria-hidden="true">
            {[43,110,177].map((y,i) => <g style={`--delay:${i * -.8}s`}><path class="bus-wire" d={`M0 110H10Q19 110 19 ${y < 110 ? 101 : y > 110 ? 119 : 110}V${y}H34`}/></g>)}
          </svg>
          {devices.map((label, i) => <div class="compute-node">
            <span class="node-name">{label}</span>
            <div class="tensor-operation" aria-hidden="true">
              <div class="matrix">{Array.from({length: 9}, (_, j) => <i class:list={{bright: j % 3 === i}}></i>)}</div>
              <span class="operator">×</span>
              <div class="matrix">{Array.from({length: 9}, (_, j) => <i class:list={{bright: Math.floor(j / 3) === i}}></i>)}</div>
              <span class="operator">→</span>
              <div class="matrix result">{Array.from({length: 9}, (_, j) => <i style={`--cell:${j}`}></i>)}</div>
            </div>
          </div>)}
        </div>
      </li>
    </ol>
    <div class="sequence-track" aria-hidden="true"><i></i><i></i><i></i></div>
  </div>
</figure>
<style>
  .parallel-figure { margin: 42px 0 0; }
  .network-stage { position: relative; border: 1px solid var(--diagram-border); border-radius: 18px; background: var(--diagram-bg); overflow: hidden; isolation: isolate; padding: 54px 40px 34px; }
  .network-stage::before { content: ""; position: absolute; inset: 24px; background-image: radial-gradient(#70677832 .7px, transparent .7px); background-size: 22px 22px; mask-image: radial-gradient(ellipse, #000, transparent 75%); z-index: -1; }
  .pipeline { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 54px; list-style: none; padding: 0; margin: 0; }
  .pipeline-step { position: relative; min-width: 0; }
  h3 { display: flex; align-items: baseline; justify-content: center; gap: 10px; color: var(--diagram-ink); font-size: 15px; font-weight: 500; line-height: 1.5; margin: 0; min-height: 45px; text-align: center; text-wrap: balance; }
  h3 span { color: var(--diagram-red); font-size: 10px; font-weight: 400; font-variant-numeric: tabular-nums; }
  .step-art { position: relative; height: 220px; display: flex; align-items: center; justify-content: center; }
  .task-stack, .tensor-stack { width: 100%; max-width: 230px; height: 220px; overflow: visible; }
  .task-sheet { fill: var(--diagram-fill); stroke: var(--diagram-line); stroke-width: .9; }
  .task-rule { stroke: var(--diagram-line); stroke-width: 2; stroke-linecap: round; }
  .task-fragment { fill: var(--diagram-muted); fill-opacity: .65; }.task-fragment.accent { fill: var(--diagram-red); fill-opacity: .85; }
  .tensor-stack { filter: drop-shadow(0 7px 10px rgb(0 0 0 / .04)); }
  .tensor-plane { fill: var(--diagram-fill); stroke: var(--diagram-line); stroke-width: .8; }
  .tensor-cell { fill: var(--diagram-ink); fill-opacity: var(--strength); }
  .tensor-cell.accent { fill: var(--diagram-red); fill-opacity: .85; }
  .transfer { position: absolute; left: calc(100% + 4px); top: 155px; width: 46px; height: 1px; background: var(--diagram-line); }
  .transfer::after { content: ""; position: absolute; right: 0; top: -3px; width: 7px; height: 7px; border-top: 1px solid var(--diagram-bright); border-right: 1px solid var(--diagram-bright); transform: rotate(45deg); }
  .device-art { flex-direction: column; gap: 13px; padding-left: 28px; }
  .device-bus { position: absolute; inset: 0; width: 100%; height: 100%; }
  .bus-wire { stroke: var(--diagram-line); stroke-width: 1; }
  .compute-node { position: relative; width: 100%; height: 54px; display: flex; align-items: center; justify-content: space-between; gap: 8px; border: 1px solid var(--diagram-line); border-radius: 7px; background: var(--diagram-fill); padding: 10px 12px; }
  .node-name { font-size: 11px; color: var(--diagram-ink); line-height: 1.3; overflow-wrap: anywhere; }
  .tensor-operation { display: flex; align-items: center; gap: 5px; flex: none; }
  .matrix { display: grid; grid-template-columns: repeat(3,1fr); width: 20px; height: 20px; gap: 2px; }.matrix i { background: var(--diagram-line); border-radius: .5px; }.matrix .bright { background: var(--diagram-red); }.matrix.result i { background: var(--diagram-red); }
  .operator { color: var(--diagram-muted); font-size: 11px; }
  .motion-controls { position: absolute; right: 12px; top: 10px; z-index: 3; display: flex; gap: 6px; }
  .motion-controls button { width: 32px; height: 32px; display: grid; place-items: center; color: var(--diagram-muted); border: 1px solid var(--diagram-border); border-radius: 50%; background: var(--diagram-fill); cursor: pointer; }
  .motion-controls svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.2; }.motion-controls button:hover { color: var(--diagram-ink); border-color: var(--diagram-bright); }.motion-controls button:focus-visible { outline: 2px solid var(--diagram-bright); outline-offset: 3px; }
  .play-icon, [data-user-paused] .pause-icon { display: none; }[data-user-paused] .play-icon { display: block; }[data-paused] * { animation-play-state: paused !important; }
  @media (min-width: 761px) and (max-width: 1000px) { .network-stage { padding-inline: 24px; }.pipeline { gap: 30px; }.transfer { width: 22px; }.compute-node { padding-inline: 8px; }.tensor-operation { gap: 3px; }.matrix { width: 16px; height: 16px; } }
  @media (max-width: 760px) {
    .network-stage { padding: 46px 24px 26px; }.pipeline { grid-template-columns: minmax(0,1fr); gap: 42px; max-width: 280px; margin-inline: auto; }
    h3 { min-height: 26px; font-size: 14px; }.step-art { height: 170px; }.task-stack, .tensor-stack { width: 190px; height: 170px; }
    .transfer { left: 50%; top: calc(100% + 6px); width: 1px; height: 26px; }.transfer::after { top: auto; bottom: 0; right: -3px; transform: rotate(135deg); }
    .device-art { height: 200px; padding-left: 28px; gap: 7px; }.compute-node { height: 54px; }.device-bus { top: 0; height: 200px; }
  }
  @media (prefers-reduced-motion: reduce) { * { animation: none !important; }.motion-controls { display: none; } }
  .motion-canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2; opacity: 0; }
  [data-motion-ready] .motion-canvas { opacity: 1; }
  [data-motion-ready] .task-layer { opacity: var(--task-opacity, 1); }
  [data-motion-ready] .task-code { visibility: hidden; }
  [data-motion-ready] .tensor-layer { visibility: hidden; }
  [data-motion-ready] .matrix i { opacity: .18; }
  [data-motion-ready] .matrix.result i { opacity: 0; }
  [data-motion-ready] .compute-node { border-color: color-mix(in srgb, var(--diagram-red) calc(var(--device-active, 0) * 30%), var(--diagram-line)); box-shadow: 0 0 22px color-mix(in srgb, var(--diagram-red) calc(var(--device-active, 0) * 8%), transparent); }
  [data-motion-ready] .pipeline-step h3 { opacity: var(--heading-opacity, 1); }
  .compute-node::before { content: ""; position: absolute; left: -4px; top: calc(50% - 3px); width: 6px; height: 6px; border: 1px solid var(--diagram-line); border-radius: 50%; background: var(--diagram-fill); }
  .sequence-track { display: flex; gap: 5px; width: 96px; margin: 15px auto 0; }
  .sequence-track i { height: 2px; flex: 1; background: var(--diagram-guide); border-radius: 2px; overflow: hidden; }
  .sequence-track i::after { content: ""; display: block; height: 100%; width: 100%; background: var(--diagram-red); transform-origin: left; transform: scaleX(var(--progress, 0)); }
  @media (prefers-reduced-motion: reduce) {
    .motion-canvas, .sequence-track { display: none; }
    .parallel-figure .task-code, .parallel-figure .tensor-layer { visibility: visible; }
    .parallel-figure .task-layer { opacity: 1; }
  }
</style>

<script>
  import { readDiagramPalette } from "./art/diagram-theme";
  type Point = { x: number; y: number };
  document.querySelectorAll<HTMLElement>(".parallel-figure").forEach(figure => {
    const stage = figure.querySelector<HTMLElement>(".network-stage")!;
    const canvas = figure.querySelector<HTMLCanvasElement>("canvas")!;
    const ctx = canvas.getContext("2d")!;
    const button = figure.querySelector<HTMLButtonElement>(".motion-toggle")!;
    const steps = [...figure.querySelectorAll<HTMLElement>(".pipeline-step")];
    const restart = figure.querySelector<HTMLButtonElement>(".motion-restart")!;
    const tracks = [...figure.querySelectorAll<HTMLElement>(".sequence-track i")];
    const devices = [...figure.querySelectorAll<HTMLElement>(".compute-node")];
    const taskFragments = [0, 1, 2].map(layer => [...figure.querySelectorAll<SVGRectElement>(`.task-layer[data-layer="${layer}"] .task-fragment`)].map(fragment => ({
      x: Number(fragment.getAttribute("x")), y: Number(fragment.getAttribute("y")),
      width: Number(fragment.getAttribute("width")), accent: fragment.classList.contains("accent"),
    })));
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    const duration = 12000;
    let palette = readDiagramPalette();
    let visible = false, userPaused = false, frame = 0, previous = 0, elapsed = 0;
    let width = 0, height = 0, vertical = false;
    let taskMap: (x: number, y: number) => Point;
    let tensorMap: (x: number, y: number) => Point;
    let matrixTargets: Point[][][] = [];
    let matrixSizes: number[] = [];
    let devicePorts: Point[] = [];
    let dispatchGutter = 0;
    let tensorLift = 0, tensorSpread = 30;
    const clamp = (n: number) => Math.max(0, Math.min(1, n));
    const ease = (n: number) => { const t = clamp(n); return t * t * (3 - 2 * t); };
    const mix = (a: number, b: number, t: number) => a + (b - a) * t;
    const lerp = (a: Point, b: Point, t: number): Point => ({ x: mix(a.x, b.x, t), y: mix(a.y, b.y, t) });
    const curve = (a: Point, b: Point, t: number, bend: number): Point => {
      const p = lerp(a, b, t);
      const distance = Math.hypot(b.x - a.x, b.y - a.y) || 1;
      return { x: p.x - (b.y - a.y) / distance * Math.sin(t * Math.PI) * bend, y: p.y + (b.x - a.x) / distance * Math.sin(t * Math.PI) * bend };
    };
    const gutterCurve = (start: Point, end: Point, progress: number, gutter: number): Point => {
      const inverse = 1 - progress;
      return {
        x: inverse ** 3 * start.x + 3 * inverse * progress * gutter + progress ** 3 * end.x,
        y: (inverse ** 3 + 3 * inverse ** 2 * progress) * start.y + (3 * inverse * progress ** 2 + progress ** 3) * end.y,
      };
    };
    const svgMap = (selector: string) => {
      const box = figure.querySelector(selector)!.getBoundingClientRect();
      const origin = stage.getBoundingClientRect();
      const scale = Math.min(box.width / 230, box.height / 220);
      return (x: number, y: number): Point => ({ x: box.left - origin.left + (box.width - 230 * scale) / 2 + x * scale, y: box.top - origin.top + (box.height - 220 * scale) / 2 + y * scale });
    };
    const tensorCell = (layer: number, cell: number) => {
      const x = cell % 5 * 14 + 5.5, y = Math.floor(cell / 5) * 14 + 5.5;
      return tensorMap(115 + 1.15 * (x - y), 42 + tensorLift + layer * tensorSpread + .55 * (x + y));
    };
    const tile = (p: Point, size: number, tilt: number, alpha: number, accent: boolean, glow = false, aspect = 1) => {
      if (alpha <= .001) return;
      ctx.save(); ctx.translate(p.x, p.y); ctx.globalAlpha = alpha;
      ctx.fillStyle = accent ? palette.red : palette.muted;
      if (glow) { ctx.shadowColor = palette.red; ctx.shadowBlur = accent ? 8 : 3; }
      ctx.transform(1, tilt * .48, -tilt, 1 - tilt * .52, 0, 0);
      ctx.beginPath(); ctx.roundRect(-size * aspect / 2, -size / 2, size * aspect, size, .8); ctx.fill();
      ctx.restore();
    };
    new MutationObserver(() => { palette = readDiagramPalette(); draw(); }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    const draw = () => {
      if (!width || !taskMap) return;
      const t = (elapsed % duration) / duration;
      const fade = 1 - ease((t - .94) / .06);
      ctx.clearRect(0, 0, width, height);
      const phase = t < .2 ? 0 : t < .55 ? 1 : 2;
      figure.dataset.phase = String(phase);
      const moving = ease((t - .18) / .27);
      stage.style.setProperty("--task-opacity", String(1 - .4 * moving * fade));
      steps.forEach((step, i) => step.style.setProperty("--heading-opacity", String(i === phase ? 1 : .8)));
      [clamp(t / .2), clamp((t - .2) / .35), clamp((t - .55) / .39)].forEach((p, i) => tracks[i].style.setProperty("--progress", String(p * fade)));
      const scale = Math.min(1, (tensorMap(230, 0).x - tensorMap(0, 0).x) / 230);
      tensorLift = -5 * Math.sin(Math.PI * t) * fade;
      tensorSpread = 30 + 5 * Math.sin(Math.PI * moving) * fade;
      // Indented code fragments leave their task cards and gather into tensor cells.
      // Draw each slice from back to front, preserving a light layered surface.
      for (const layer of [2, 1, 0]) {
        const assembled = ease((t - .29 - (2 - layer) * .045) / .12) * fade;
        const corners = [[-4,-4],[74,-4],[74,74],[-4,74]].map(([x,y]) => tensorMap(115 + 1.15 * (x - y), 42 + tensorLift + layer * tensorSpread + .55 * (x + y)));
        ctx.save();ctx.globalAlpha = .3 + .56 * assembled;ctx.fillStyle = palette.fill;ctx.strokeStyle = palette.line;ctx.lineWidth = .8;
        ctx.beginPath();corners.forEach((p,i) => i ? ctx.lineTo(p.x,p.y) : ctx.moveTo(p.x,p.y));ctx.closePath();ctx.fill();ctx.stroke();ctx.restore();
        for (let cell = 0; cell < 25; cell++) {
          const row = Math.floor(cell / 5), col = cell % 5;
          const departure = .18 + (2 - layer) * .045 + col * .006 + row * .004;
          const travel = ease((t - departure) / .19);
          const fragment = taskFragments[layer][cell];
          const start = taskMap(22 + layer * 17 + fragment.x + fragment.width / 2, 24 + layer * 28 + fragment.y + 1.7);
          const destination = tensorCell(layer, cell);
          const position = vertical ? gutterCurve(start, destination, travel, width - 18) : curve(start, destination, travel, (layer - 1) * 18 + (row - 2) * 3);
          // Fragments on rear cards stay hidden behind the cards in front until departure.
          if (travel < .015 && layer > 0) {
            const occluded = Array.from({length:layer},(_,front) => {
              const a = taskMap(22 + front * 17,24 + front * 28),b = taskMap(167 + front * 17,136 + front * 28);
              return position.x > a.x && position.x < b.x && position.y > a.y && position.y < b.y;
            }).some(Boolean);
            if (occluded) continue;
          }
          const size = mix(3.4, 12.65, travel) * scale;
          const aspect = mix(fragment.width / 3.4, 1, ease(travel / .38));
          tile(position, size, travel, (fragment.accent ? .95 : .6) * fade, fragment.accent, travel > .03 && travel < .97, aspect);
        }
      }
      // Small staggered streams carry each slice to a device input.
      // Results still wait for arrival and computation; the flow avoids device labels.
      devices.forEach((device, deviceIndex) => {
        const departure = .52 + deviceIndex * .025;
        const arrival = departure + .17;
        const computing = clamp((t - arrival - .02) / .13);
        const active = ease((t - arrival) / .035) * fade;
        device.style.setProperty("--device-active", String(active));
        for (let cell = 0; cell < 9; cell++) {
          const progress = ease((t - departure - cell * .004) / .135);
          if (progress > 0 && progress < 1) {
            const start = tensorCell(deviceIndex, Math.floor(cell / 3) * 5 + cell % 3 + 6);
            const end = devicePorts[deviceIndex];
            const path = (p: number) => vertical ? gutterCurve(start,end,p,dispatchGutter) : curve(start,end,p,(deviceIndex-1)*20+(cell%3-1)*5);
            const alpha = ease(progress / .1) * (1 - ease((progress - .9) / .1));
            for (const trail of [.05,.025]) {
              if(progress>trail)tile(path(progress-trail),3*scale,1-progress,alpha*.12,true);
            }
            tile(path(progress),mix(7*scale,3.5,progress),1-progress,alpha,true,true);
          }
          matrixTargets[deviceIndex].forEach((matrix, matrixIndex) => {
            const output = matrixIndex === 2;
            const filled = output ? ease((computing - cell / 14) * 5) * fade : active;
            const sweep = !output && computing > 0 && computing < 1 && Math.floor(computing * 3) === Math.floor(cell / 3);
            tile(matrix[cell], matrixSizes[deviceIndex], 0, filled * (output ? 1 : .8), output || sweep, sweep);
          });
        }
      });
    };
    const measure = () => {
      const rect = stage.getBoundingClientRect(); width = rect.width; height = rect.height;
      vertical = steps[1].getBoundingClientRect().top > steps[0].getBoundingClientRect().bottom;
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * ratio); canvas.height = Math.round(height * ratio);
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      taskMap = svgMap(".task-stack"); tensorMap = svgMap(".tensor-stack");
      dispatchGutter = Math.max(12, steps[2].getBoundingClientRect().left - rect.left - 18);
      devicePorts = devices.map(device => {const r=device.getBoundingClientRect();return {x:r.left-rect.left-9,y:r.top-rect.top+r.height/2};});
      matrixSizes = devices.map(device => device.querySelector(".matrix i")!.getBoundingClientRect().width);
      matrixTargets = devices.map(device => [...device.querySelectorAll(".matrix")].map(matrix => [...matrix.children].map(cell => { const r = cell.getBoundingClientRect(); return { x: r.left - rect.left + r.width / 2, y: r.top - rect.top + r.height / 2 }; })));
      draw();
    };
    const tick = (now: number) => {
      if (previous) elapsed += Math.min(now - previous, 80);
      previous = now; draw(); frame = requestAnimationFrame(tick);
    };
    const sync = () => {
      cancelAnimationFrame(frame); previous = 0;
      const paused = userPaused || !visible || document.hidden || reduced.matches;
      figure.toggleAttribute("data-paused", paused);
      figure.toggleAttribute("data-motion-ready", !reduced.matches);
      if (!paused) frame = requestAnimationFrame(tick);
    };
    button.addEventListener("click", () => {
      userPaused = !userPaused;
      figure.toggleAttribute("data-user-paused", userPaused);
      button.setAttribute("aria-pressed", String(userPaused));
      button.setAttribute("aria-label", (userPaused ? button.dataset.play : button.dataset.pause)!);
      sync();
    });
    restart.addEventListener("click", () => { elapsed = 0; draw(); sync(); });
    new ResizeObserver(measure).observe(stage);
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); }).observe(figure);
    document.addEventListener("visibilitychange", sync);
    reduced.addEventListener("change", sync);
    measure(); sync();
  });
</script>
