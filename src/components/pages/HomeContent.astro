---
import Layout from "../../layouts/Layout.astro";
import BrandMark from "../BrandMark.astro";
import BrandWordmark from "../BrandWordmark.astro";
import HomeIntro from "../HomeIntro.astro";
import EvolutionDiagram from "../EvolutionDiagram.astro";
import ParadigmArt from "../ParadigmArt.astro";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import {
  type Locale,
  defaultLocale,
  loadTranslations,
  t,
  getLocalizedUrl,
  getDateLocale,
  getLocalizedArticles,
  getLocalizedNews,
} from "../../i18n/utils";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const tr = await loadTranslations(locale);
const dateLocale = getDateLocale(locale);

const allNews = await getCollection("news");
const allReleases = await getCollection("releases");
const localizedNews = getLocalizedNews(allNews, locale);
const localizedReleases = getLocalizedArticles(allReleases, locale);
const latestRelease = localizedReleases.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)[0];
const latestNews = localizedNews
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const latestArticles = [
  ...(latestRelease ? [{ post: latestRelease, section: "releases" }] : []),
  ...latestNews.map((post) => ({ post, section: "news" })),
];

const GENESIS_URL = "https://genesis.evox.group/";
const GITHUB_URL = "https://github.com/EMI-Group";

// 02 · The Power of Evolution — the loop shown under the intro copy.
const evolutionSteps = [
  "evolution.step.generate",
  "evolution.step.execute",
  "evolution.step.evaluate",
  "evolution.step.select",
  "evolution.step.improve",
];

// 03 · Evolution Across AI Paradigms — compact 2 × 2 cards, each backed by a
// real EvoX project. The card artwork is chosen by `key` in the markup.
const paradigms: {
  key: "generative" | "agentic" | "physical" | "science";
  href: string;
  featured?: boolean;
}[] = [
  { key: "generative", href: getLocalizedUrl("/news/evogm", locale) },
  { key: "agentic", href: GENESIS_URL, featured: true },
  { key: "physical", href: getLocalizedUrl("/news/evorl", locale) },
  { key: "science", href: getLocalizedUrl("/news/evogo", locale) },
];

// 04 · Computing Without Boundaries — status labels reflect the validated
// scope only: Ascend is project-level validation, not full-framework support;
// Vulkan is validated through the EvoX Compiler (evoxc → IREE Vulkan-SPIRV).
const platforms: { key: string; icon: string; status: string; tone: "ok" | "partial" }[] = [
  { key: "nvidia", icon: "simple-icons:nvidia", status: "computing.status.supported", tone: "ok" },
  { key: "amd", icon: "simple-icons:amd", status: "computing.status.rocm", tone: "ok" },
  { key: "vulkan", icon: "simple-icons:vulkan", status: "computing.status.compiler", tone: "ok" },
  { key: "apple", icon: "simple-icons:apple", status: "computing.status.mps", tone: "ok" },
  { key: "ascend", icon: "simple-icons:huawei", status: "computing.status.project", tone: "partial" },
  { key: "cpu", icon: "heroicons:cpu-chip", status: "computing.status.supported", tone: "ok" },
  { key: "distributed", icon: "heroicons:server-stack", status: "computing.status.experimental", tone: "partial" },
];

// Real, published measurements (see the linked articles for methodology).
const stats = [
  { value: "computing.stat1.value", label: "computing.stat1.label", href: getLocalizedUrl("/news/evococo", locale) },
  { value: "computing.stat2.value", label: "computing.stat2.label", href: getLocalizedUrl("/news/gpu-accelerated-emo", locale) },
];

// 05 · Explore EvoX — simple resource cards.
const exploreCards: {
  title: string;
  desc: string;
  href: string;
  icon: string;
  badge?: string;
}[] = [
  {
    title: t(tr, "explore.genesis.title"),
    desc: t(tr, "explore.genesis.desc"),
    href: GENESIS_URL,
    icon: "heroicons:sparkles",
    badge: t(tr, "explore.genesis.badge"),
  },
  {
    title: t(tr, "explore.ecosystem.title"),
    desc: t(tr, "explore.ecosystem.desc"),
    href: getLocalizedUrl("/libs", locale),
    icon: "heroicons:squares-2x2",
  },
  {
    title: t(tr, "explore.docs.title"),
    desc: t(tr, "explore.docs.desc"),
    href: getLocalizedUrl("/docs", locale),
    icon: "heroicons:book-open",
  },
  {
    title: t(tr, "explore.github.title"),
    desc: t(tr, "explore.github.desc"),
    href: GITHUB_URL,
    icon: "simple-icons:github",
  },
];

const isExternal = (href: string) => href.startsWith("http");

const chapters = [
  { id: "top", label: "EvoX" },
  { id: "evolution", label: t(tr, "evolution.kicker") },
  { id: "applications", label: t(tr, "paradigms.kicker") },
  { id: "computing", label: t(tr, "computing.kicker") },
  { id: "explore", label: t(tr, "explore.title") },
  { id: "news", label: t(tr, "nav.blog.news") },
];
---

<Layout title={t(tr, "site.title")} fullBleed homeIntro locale={locale}>
  <div class="evox-home" id="top">
    <HomeIntro scrollLabel={t(tr, "hero.scroll")} />
    <section class="hero chapter" id="home" data-chapter-id="top" aria-labelledby="hero-title">
      <div class="hero-content">
        <h1 id="hero-title" class="hero-wordmark" aria-label="EvoX"><BrandWordmark /></h1>
        <p class="hero-statement">
          <span>{t(tr, "hero.title.line1")}</span>
          <strong>{t(tr, "hero.title.line2")}</strong>
        </p>
        <p class="hero-description">{t(tr, "hero.subtitle")}</p>
        <div class="hero-actions">
          <a href={getLocalizedUrl("/docs", locale)} class="button button-primary">
            {t(tr, "hero.cta.button")}
            <Icon name="heroicons:arrow-right-20-solid" aria-hidden="true" />
          </a>
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="text-link">
            <Icon name="simple-icons:github" aria-hidden="true" />
            {t(tr, "nav.github")}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="hero-signature">{t(tr, "hero.cta.tagline")}</p>
      </div>
      <a class="scroll-cue" href="#evolution" aria-label={t(tr, "hero.scroll")}>
        <span></span><Icon name="heroicons:chevron-down-20-solid" aria-hidden="true" />
      </a>
      <div class="hero-rule" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
    </section>

    <section class="section section-alt chapter" id="evolution" aria-labelledby="evolution-title">
      <div class="container">
        <div class="section-heading reveal">
          <p class="eyebrow"><span>01</span>{t(tr, "evolution.kicker")}</p>
          <h2 id="evolution-title">{t(tr, "evolution.title")}</h2>
          <p class="section-description">{t(tr, "evolution.desc")}</p>
        </div>
        <figure class="evolution-panel reveal" aria-label={t(tr, "evolution.figure")}>
          <EvolutionDiagram />
        </figure>
        <ol class="evolution-loop reveal">
          {evolutionSteps.map((key, i) => (
            <li>
              <span class="step-index">{String(i + 1).padStart(2, "0")}</span>
              <span>{t(tr, key)}</span>
              {i < 4 && <span class="step-arrow" aria-hidden="true">→</span>}
              {i === 4 && <Icon name="heroicons:arrow-path-20-solid" class="step-arrow" aria-hidden="true" />}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section chapter" id="applications" aria-labelledby="applications-title">
      <div class="container">
        <div class="section-heading reveal">
          <p class="eyebrow"><span>02</span>{t(tr, "paradigms.kicker")}</p>
          <h2 id="applications-title">{t(tr, "paradigms.title")}</h2>
          <p class="section-description">{t(tr, "paradigms.desc")}</p>
        </div>
        <div class="paradigm-grid">
          {paradigms.map((item, index) => (
            <a href={item.href} target={isExternal(item.href) ? "_blank" : undefined}
              rel={isExternal(item.href) ? "noopener noreferrer" : undefined}
              class:list={["paradigm-card reveal", { featured: item.featured }]}>
              <div class="card-topline">
                <span class="card-index">{String(index + 1).padStart(2, "0")}</span>
                {item.featured && <span class="featured-label"><i></i>{t(tr, "paradigms.featured")}</span>}
                <Icon name="heroicons:arrow-up-right-20-solid" class="card-arrow" aria-hidden="true" />
              </div>
              <div class="paradigm-art"><ParadigmArt kind={item.key} /></div>
              <div class="card-copy">
                <h3>{t(tr, `paradigms.${item.key}.title`)}</h3>
                <p>{t(tr, `paradigms.${item.key}.desc`)}</p>
                <span class="project-link">{t(tr, `paradigms.${item.key}.project`)}<span aria-hidden="true">→</span></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-alt chapter" id="computing" aria-labelledby="computing-title">
      <div class="container">
        <div class="section-heading reveal">
          <p class="eyebrow"><span>03</span>{t(tr, "computing.kicker")}</p>
          <h2 id="computing-title">{t(tr, "computing.title")}</h2>
          <p class="section-description">{t(tr, "computing.subtitle")}</p>
        </div>
        <ul class="platforms reveal">
          {platforms.map((platform) => (
            <li>
              <Icon name={platform.icon} class="platform-icon" aria-hidden="true" />
              <h3>{t(tr, `computing.platform.${platform.key}`)}</h3>
              <p class:list={["platform-status", { partial: platform.tone === "partial" }]}>
                <i aria-hidden="true"></i>{t(tr, platform.status)}
              </p>
            </li>
          ))}
        </ul>
        <div class="stats-grid">
          {stats.map((stat) => (
            <a href={stat.href} class="stat reveal">
              <p class="stat-value">{t(tr, stat.value)}</p>
              <p class="stat-description">{t(tr, stat.label)}</p>
              <span class="text-link">{t(tr, "computing.source")}<span aria-hidden="true">↗</span></span>
            </a>
          ))}
        </div>
        <p class="hardware-note">{t(tr, "computing.note")}</p>
      </div>
    </section>

    <section class="section chapter" id="explore" aria-labelledby="explore-title">
      <div class="container explore-layout">
        <div class="section-heading reveal">
          <p class="eyebrow"><span>04</span>EvoX</p>
          <h2 id="explore-title">{t(tr, "explore.title")}</h2>
          <div class="explore-mark" aria-hidden="true"><BrandMark size={94} /></div>
        </div>
        <div class="resource-list">
          {exploreCards.map((card, index) => (
            <a href={card.href} target={isExternal(card.href) ? "_blank" : undefined}
              rel={isExternal(card.href) ? "noopener noreferrer" : undefined} class="resource-row reveal">
              <span class="resource-number">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{card.title}{card.badge && <span class="resource-badge">{card.badge}</span>}</h3>
                <p>{card.desc}</p>
              </div>
              <Icon name="heroicons:arrow-up-right-20-solid" aria-hidden="true" />
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-alt chapter news-section" id="news" aria-labelledby="news-title">
      <div class="container">
        <div class="news-heading reveal">
          <div><p class="eyebrow"><span>05</span>{t(tr, "nav.blog")}</p><h2 id="news-title">{t(tr, "news.title")}</h2></div>
          <a class="text-link" href={getLocalizedUrl("/news", locale)}>{t(tr, "news.viewAll")}<span aria-hidden="true">→</span></a>
        </div>
        <div class="news-list">
          {latestArticles.map(({ post, section }) => (
            <a href={getLocalizedUrl(`/${section}/${post.slug}`, locale)} class="news-row reveal">
              <div class="news-meta">
                <span>{t(tr, `nav.blog.${section}`)}</span>
                <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString(dateLocale, { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })}</time>
              </div>
              <div class="news-copy"><h3>{post.data.title}</h3><p>{post.data.summary || t(tr, `${section}.defaultSummary`)}</p></div>
              <Icon name="heroicons:arrow-up-right-20-solid" aria-hidden="true" />
            </a>
          ))}
        </div>
      </div>
    </section>

    <nav class="chapter-map" aria-label={t(tr, "nav.primary")}>
      <a href="#top" class="map-root" aria-label="EvoX"><span></span></a>
      <div class="map-branches">
        {chapters.slice(1).map((chapter) => (
          <a href={`#${chapter.id}`} data-chapter={chapter.id} aria-label={chapter.label}>
            <i aria-hidden="true"></i><span>{chapter.label}</span>
          </a>
        ))}
      </div>
    </nav>
  </div>
</Layout>

<style>
  .evox-home { background: var(--site-bg); color: var(--site-ink); font-family: var(--site-font); }
  .container { width: calc(100% - 64px); max-width: 1040px; margin-inline: auto; }
  .section { padding: clamp(88px, 10vw, 144px) 0; scroll-margin-top: 0; }
  .section-alt { background: var(--site-alt); }
  .hero { min-height: max(740px, 100svh); padding: 140px 24px 108px; display: grid; place-items: center; text-align: center; position: relative; }
  .hero-content { max-width: 1000px; position: relative; z-index: 1; }
  .hero-wordmark { width: min(68vw, 520px); margin: 0 auto 34px; }
  .hero-statement { margin: 0; font-size: clamp(27px, 3.5vw, 44px); line-height: 1.12; letter-spacing: -.035em; font-weight: 500; text-wrap: balance; }
  .hero-statement span, .hero-statement strong { display: block; font-weight: inherit; }
  .hero-statement span { color: var(--site-muted); }
  .hero-description { max-width: 580px; margin: 28px auto 0; font-size: 18px; line-height: 1.65; color: var(--site-muted); text-wrap: pretty; }
  .hero-actions { display: flex; gap: 30px; justify-content: center; align-items: center; flex-wrap: wrap; margin-top: 32px; }
  .button { display: inline-flex; gap: 10px; justify-content: center; align-items: center; min-height: 48px; padding: 12px 25px; border-radius: 999px; font-weight: 500; font-size: 15px; transition: background .2s, transform .2s; }
  .button svg, .text-link svg { width: 17px; height: 17px; }
  .button-primary { color: #fff; background: var(--site-accent); }
  .button-primary:hover { background: #ae2e32; transform: translateY(-2px); }
  .text-link { display: inline-flex; gap: 10px; align-items: center; font-size: 14px; font-weight: 500; }
  .text-link:hover { text-decoration: underline; text-underline-offset: 5px; }
  .text-link > span { color: var(--site-muted); }
  .hero-signature { margin-top: 22px; font-size: 11px; letter-spacing: .13em; color: var(--site-muted); text-transform: uppercase; }
  .scroll-cue { position: absolute; bottom: 30px; left: calc(50% - 20px); width: 40px; height: 40px; color: var(--site-muted); display: grid; place-items: center; z-index: 1; }
  .scroll-cue svg { width: 19px; height: 19px; }
  .hero-rule { position: absolute; inset-inline: 0; bottom: 80px; display: flex; justify-content: space-evenly; border-top: 1px solid var(--site-line); opacity: .55; }
  .hero-rule i { width: 5px; height: 5px; border-radius: 50%; background: var(--site-muted); transform: translateY(-3px); }
  .hero-rule i:nth-child(3) { background: var(--site-accent); box-shadow: 0 0 0 5px color-mix(in srgb, var(--site-accent) 14%, transparent); }
  .eyebrow { display: flex; gap: 14px; align-items: center; font-size: 11px; font-weight: 500; letter-spacing: .13em; text-transform: uppercase; color: var(--site-muted); margin: 0 0 23px; }
  .eyebrow > span { color: var(--site-accent); font-family: ui-monospace, monospace; font-size: 10px; }
  h2 { font-size: clamp(37px, 5.5vw, 64px); font-weight: 500; line-height: 1.07; letter-spacing: -.045em; text-wrap: balance; margin: 0; max-width: 840px; }
  .section-description { font-size: 18px; line-height: 1.7; color: var(--site-muted); max-width: 720px; margin: 26px 0 0; text-wrap: pretty; }
  .evolution-panel { margin: 55px 0 0; padding: 30px 28px; border-radius: 24px; background: var(--site-bg); }
  .evolution-loop { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); list-style: none; padding: 0; margin: 30px 0 0; }
  .evolution-loop li { display: flex; gap: 12px; align-items: baseline; position: relative; padding: 16px 20px 16px 0; border-top: 1px solid var(--site-line); font-size: 14px; font-weight: 500; }
  .step-index { font-family: ui-monospace, monospace; color: var(--site-muted); font-size: 10px; }
  .step-arrow { position: absolute; right: 14px; top: 18px; font-size: 11px; color: var(--site-muted); width: 13px; height: 13px; }
  .paradigm-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 56px; }
  .paradigm-card { min-width: 0; display: flex; flex-direction: column; padding: 27px 32px 30px; border: 1px solid transparent; border-radius: 24px; background: var(--site-alt); transition: border-color .25s, transform .25s; }
  .paradigm-card:hover { border-color: var(--site-line); transform: translateY(-4px); }
  .paradigm-card.featured { border-color: color-mix(in srgb, var(--site-accent) 48%, transparent); }
  .card-topline { display: flex; align-items: center; gap: 14px; color: var(--site-muted); min-height: 20px; }
  .card-index { font-family: ui-monospace, monospace; font-size: 10px; }
  .card-arrow { margin-left: auto; width: 18px; height: 18px; }
  .featured-label { display: flex; gap: 6px; align-items: center; font-size: 10px; }
  .featured-label i { width: 5px; height: 5px; background: var(--site-accent); border-radius: 50%; }
  .paradigm-art { margin: 20px -12px 24px; }
  .card-copy { display: flex; flex-direction: column; flex: 1; }
  h3 { font-size: 27px; line-height: 1.15; letter-spacing: -.025em; font-weight: 500; margin: 0; }
  .card-copy > p { color: var(--site-muted); font-size: 16px; line-height: 1.7; margin: 15px 0 26px; flex: 1; }
  .project-link { font-size: 12px; border-top: 1px solid var(--site-line); padding-top: 21px; display: flex; justify-content: space-between; gap: 12px; }
  .project-link > span { color: var(--site-accent); }
  .platforms { list-style: none; padding: 0; margin: 58px 0 0; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); border-block: 1px solid var(--site-line); }
  .platforms li { padding: 32px 8px; text-align: center; }
  .platform-icon { width: 29px; height: 29px; margin: 0 auto 23px; color: var(--site-ink); }
  .platforms h3 { font-size: 12px; letter-spacing: -.02em; line-height: 1.4; }
  .platform-status { font-size: 10px; line-height: 1.6; color: var(--site-muted); margin-top: 9px; padding-inline: 2px; }
  .platform-status i { display: inline-block; width: 4px; height: 4px; border-radius: 50%; background: var(--site-muted); margin: 0 5px 2px 0; }
  .platform-status.partial i { background: transparent; border: 1px solid var(--site-muted); width: 5px; height: 5px; }
  .stats-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 52px 0 0; gap: 60px; }
  .stat-value { font-size: clamp(38px, 4.4vw, 62px); line-height: 1.1; letter-spacing: -.055em; font-weight: 500; margin: 0; }
  .stat-description { font-size: 15px; color: var(--site-muted); line-height: 1.65; margin: 22px 0 18px; max-width: 390px; }
  .stat .text-link { color: var(--site-ink); font-size: 12px; }
  .stat:hover .text-link { text-decoration: underline; text-underline-offset: 4px; }
  .hardware-note { font-size: 11px; line-height: 1.65; color: var(--site-muted); max-width: 760px; margin: 46px 0 0; }
  .explore-layout { display: grid; grid-template-columns: .8fr 1.2fr; gap: 80px; }
  .explore-layout h2 { max-width: 300px; }
  .explore-mark { width: 94px; margin: 65px 0 0; opacity: .8; }
  .resource-row { display: grid; grid-template-columns: 20px 1fr 18px; gap: 18px; padding: 28px 0; border-top: 1px solid var(--site-line); }
  .resource-row:last-child { border-bottom: 1px solid var(--site-line); }
  .resource-number { color: var(--site-muted); font-size: 10px; font-family: ui-monospace, monospace; margin-top: 5px; }
  .resource-row h3 { font-size: 22px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .resource-badge { font-size: 9px; letter-spacing: 0; font-weight: 400; border: 1px solid var(--site-line); padding: 4px 7px; border-radius: 999px; color: var(--site-muted); }
  .resource-row p { font-size: 14px; line-height: 1.6; margin: 10px 0 0; color: var(--site-muted); }
  .resource-row > svg { width: 18px; height: 18px; margin-top: 5px; color: var(--site-muted); transition: transform .2s, color .2s; }
  .resource-row:hover > svg, .news-row:hover > svg { color: var(--site-accent); transform: translate(2px, -2px); }
  .news-heading { display: flex; justify-content: space-between; gap: 24px; align-items: end; margin-bottom: 44px; }
  .news-heading h2 { font-size: clamp(34px, 4.5vw, 48px); }
  .news-heading .text-link { flex-shrink: 0; margin-bottom: 4px; font-size: 12px; }
  .news-row { display: grid; grid-template-columns: 145px minmax(0, 1fr) 20px; gap: 32px; padding: 32px 0; border-top: 1px solid var(--site-line); }
  .news-row:last-child { border-bottom: 1px solid var(--site-line); }
  .news-meta { display: flex; flex-direction: column; align-items: start; gap: 11px; font-size: 10px; color: var(--site-muted); }
  .news-meta > span { border: 1px solid var(--site-line); border-radius: 999px; padding: 3px 8px; color: var(--site-ink); }
  .news-copy h3 { font-size: 22px; line-height: 1.3; }
  .news-copy p { margin: 12px 0 0; color: var(--site-muted); font-size: 13px; line-height: 1.6; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  .news-row > svg { width: 19px; height: 19px; color: var(--site-muted); transition: transform .2s, color .2s; }
  .chapter-map { position: fixed; bottom: 28px; left: 22px; width: 158px; display: flex; align-items: center; z-index: 30; pointer-events: none; opacity: .6; transition: opacity .25s; }
  .chapter-map:hover, .chapter-map:focus-within { opacity: 1; }
  .map-root { width: 24px; height: 28px; display: grid; place-items: center; pointer-events: auto; }
  .map-root span { width: 10px; height: 10px; border: 1px solid var(--site-muted); border-radius: 50%; }
  .map-branches { position: relative; flex: 1; padding-left: 22px; }
  .map-branches::before { content: ""; position: absolute; left: 0; top: 13px; bottom: 13px; border-left: 1px solid var(--site-line); border-radius: 12px 0 0 12px; }
  .map-branches a { position: relative; display: flex; gap: 8px; align-items: center; min-height: 28px; pointer-events: auto; }
  .map-branches a::before { content: ""; position: absolute; width: 22px; left: -22px; border-top: 1px solid var(--site-line); }
  .map-branches i { flex: 0 0 auto; width: 6px; height: 6px; border-radius: 50%; border: 1px solid var(--site-muted); background: var(--site-bg); }
  .map-branches span { font-size: 9px; line-height: 1.2; max-width: 100px; color: var(--site-muted); opacity: 0; transition: opacity .2s; background: color-mix(in srgb, var(--site-bg) 85%, transparent); border-radius: 3px; padding: 2px 4px; }
  .map-branches a[aria-current] i { background: var(--site-accent); border-color: var(--site-accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--site-accent) 14%, transparent); }
  .map-branches a[aria-current] span, .chapter-map:hover span, .chapter-map:focus-within span { opacity: 1; }
  .evox-home a:focus-visible { outline: 2px solid var(--site-accent); outline-offset: 5px; border-radius: 4px; }
  .reveal.is-ready { opacity: 0; transform: translateY(22px); transition: opacity .75s ease, transform .75s cubic-bezier(.22, 1, .36, 1); }
  .reveal.is-visible { opacity: 1; transform: none; }
  @media (max-width: 1279px) { .chapter-map { display: none; } }
  @media (max-width: 850px) {
    .platforms { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .platforms li { padding: 26px 8px; }
