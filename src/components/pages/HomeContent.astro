  .map-branches i { flex: 0 0 auto; width: 6px; height: 6px; border-radius: 50%; border: 1px solid var(--site-muted); background: var(--site-bg); }
  .map-branches span { font-size: 12px; line-height: 1.4; max-width: 130px; color: var(--site-muted); opacity: 0; transition: opacity .2s; background: color-mix(in srgb, var(--site-bg) 85%, transparent); border-radius: 3px; padding: 2px 4px; }
  .map-branches a[aria-current] i { background: var(--site-accent); border-color: var(--site-accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--site-accent) 14%, transparent); }
