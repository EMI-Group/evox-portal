---
const year = new Date().getFullYear();
---

<footer class="bg-white border-t border-gray-200 pt-16 pb-8">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center mb-16">
      <div class="flex flex-col items-center">
        <h2 class="text-2xl font-bold text-gray-900 mb-2">Docs</h2>
        <p class="text-gray-600 mb-4 text-sm">Access comprehensive developer documentation for EvoX</p>
        <a href="https://evox.readthedocs.io/en/latest/" class="text-teal-700 font-semibold hover:text-teal-900 flex items-center gap-1 transition-colors">
          View Docs <span>&rarr;</span>
        </a>
      </div>

      <div class="flex flex-col items-center">
        <h2 class="text-2xl font-bold text-gray-900 mb-2">Tutorials</h2>
        <p class="text-gray-600 mb-4 text-sm">Get in-depth tutorials for beginners and advanced developers</p>
        <a href="https://evox.readthedocs.io/en/latest/example/index.html" class="text-teal-700 font-semibold hover:text-teal-900 flex items-center gap-1 transition-colors">
          View Tutorials <span>&rarr;</span>
        </a>
      </div>

      <div class="flex flex-col items-center">
        <h2 class="text-2xl font-bold text-gray-900 mb-2">Resources</h2>
        <p class="text-gray-600 mb-4 text-sm">Find development resources and get your questions answered</p>
        <a href="https://github.com/EMI-Group" class="text-teal-700 font-semibold hover:text-teal-900 flex items-center gap-1 transition-colors">
          View Resources <span>&rarr;</span>
        </a>
      </div>
    </div>

    <hr class="border-gray-200 my-8" />

    <div class="flex flex-col items-center gap-6">
      
