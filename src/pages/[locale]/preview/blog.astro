---
import BlogSample from "../../../components/pages/BlogSample.astro";
import { locales, defaultLocale, type Locale } from "../../../i18n/utils";
export function getStaticPaths() {
  return locales.filter(locale => locale !== defaultLocale).map(locale => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
---
<BlogSample locale={locale} />
