---
import { Icon } from "astro-icon/components";
import BrandWordmark from "./BrandWordmark.astro";
import { type Locale, defaultLocale, locales, localeNames, loadTranslations, t, getLocalizedUrl } from "../i18n/utils";

interface Props {
  sticky?: boolean;
  animated?: boolean;
  locale?: Locale;
  localePath?: string;
}

const { locale = defaultLocale, localePath } = Astro.props;
const tr = await loadTranslations(locale);
const currentPath = (localePath ?? Astro.url.pathname).replace(/\/$/, "") || "/";
const navLinks: { label: string; href?: string; dropdown?: { label: string; desc: string; href: string }[] }[] = [
  { label: t(tr, "nav.home"), href: getLocalizedUrl("/", locale) },
  { label: t(tr, "nav.ecosystem"), href: getLocalizedUrl("/libs", locale) },
  {
    label: t(tr, "nav.blog"),
    dropdown: [
      { label: t(tr, "nav.blog.news"), desc: t(tr, "nav.blog.news.desc"), href: getLocalizedUrl("/news", locale) },
      { label: t(tr, "nav.blog.releases"), desc: t(tr, "nav.blog.releases.desc"), href: getLocalizedUrl("/releases", locale) },
    ],
  },
  {
    label: t(tr, "nav.docs"),
    dropdown: [
      { label: t(tr, "nav.docs.guide"), desc: t(tr, "nav.docs.guide.desc"), href: getLocalizedUrl("/docs", locale) },
      { label: t(tr, "nav.tutorials"), desc: t(tr, "footer.tutorials.desc"), href: getLocalizedUrl("/tutorials", locale) },
      { label: t(tr, "nav.docs.api"), desc: t(tr, "nav.docs.api.desc"), href: "https://evox.readthedocs.io/en/latest/apidocs/index.html" },
      { label: t(tr, "nav.docs.runtime"), desc: t(tr, "nav.runtime.overview.desc"), href: getLocalizedUrl("/runtime", locale) },
    ],
  },
];
---

<header class="site-header">
  <div class="header-glass liquid-glass" aria-hidden="true"></div>
  <div class="header-inner">
    <a href={getLocalizedUrl("/", locale)} class="site-brand" aria-label="EvoX">
      <span class="header-mark"><BrandWordmark /></span>
    </a>

    <nav class="desktop-nav" aria-label={t(tr, "nav.primary")}>
      {navLinks.map((link) => link.dropdown ? (
        <details class="nav-dropdown" data-desktop-dropdown>
          <summary class="nav-link" aria-expanded="false">
            {link.label}<Icon name="heroicons:chevron-down-20-solid" class="nav-chevron" />
          </summary>
          <div class="dropdown-panel liquid-glass">
            {link.dropdown.map((item) => (
              <a href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}>
                <span class="dropdown-label">{item.label}</span>
                <span class="dropdown-description">{item.desc}</span>
              </a>
            ))}
          </div>
        </details>
      ) : <a href={link.href} class="nav-link">{link.label}</a>)}
      <a href="https://github.com/EMI-Group" target="_blank" rel="noopener noreferrer" class="nav-link github-link">
        <Icon name="simple-icons:github" class="nav-icon" />{t(tr, "nav.github")}
      </a>
      <a href="https://chengran.tech/" target="_blank" rel="noopener noreferrer" class="contact-button">
        {t(tr, "nav.contact")}
      </a>
      <details class="nav-dropdown language-dropdown" data-desktop-dropdown>
        <summary class="nav-link" aria-expanded="false">
          <Icon name="heroicons:language-20-solid" class="nav-icon" />
          <span>{localeNames[locale]}</span><Icon name="heroicons:chevron-down-20-solid" class="nav-chevron" />
        </summary>
        <div class="dropdown-panel language-panel liquid-glass">
          {locales.map((loc) => (
            <a href={getLocalizedUrl(currentPath, loc)} data-locale-link lang={loc} aria-current={loc === locale ? "true" : undefined}>{localeNames[loc]}</a>
          ))}
        </div>
      </details>
    </nav>

    <div class="header-actions">
      <button class="theme-toggle" type="button" aria-label={t(tr, "theme.toggle")} title={t(tr, "theme.toggle")} data-theme-toggle aria-pressed="false">
        <Icon name="heroicons:sun-20-solid" class="theme-sun" />
        <Icon name="heroicons:moon-20-solid" class="theme-moon" />
      </button>
      <details class="mobile-menu" data-mobile-menu>
        <summary class="mobile-toggle" aria-label={t(tr, "nav.openMenu")} aria-expanded="false">
          <Icon name="heroicons:bars-3-20-solid" class="mobile-open-icon" />
          <Icon name="heroicons:x-mark-20-solid" class="mobile-close-icon" />
        </summary>
        <div class="mobile-panel liquid-glass">
          <nav aria-label={t(tr, "nav.primary")}>
            {navLinks.map((link) => link.dropdown ? (
              <details class="mobile-section">
                <summary>{link.label}<Icon name="heroicons:chevron-down-20-solid" class="nav-chevron" /></summary>
                <div class="mobile-submenu">
                  {link.dropdown.map((item) => (
                    <a href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}>{item.label}</a>
                  ))}
                </div>
              </details>
            ) : <a href={link.href} class="mobile-link">{link.label}</a>)}
            <a href="https://github.com/EMI-Group" target="_blank" rel="noopener noreferrer" class="mobile-link">{t(tr, "nav.github")}</a>
            <details class="mobile-section">
              <summary>{localeNames[locale]}<Icon name="heroicons:chevron-down-20-solid" class="nav-chevron" /></summary>
              <div class="mobile-submenu mobile-languages">
                {locales.map((loc) => (
                  <a href={getLocalizedUrl(currentPath, loc)} data-locale-link lang={loc} aria-current={loc === locale ? "true" : undefined}>{localeNames[loc]}</a>
                ))}
              </div>
            </details>
            <a href="https://chengran.tech/" target="_blank" rel="noopener noreferrer" class="contact-button mobile-contact">
              {t(tr, "nav.contact")}
            </a>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 100; height: 64px; }
  /* The glass is a sibling layer, so the header is not a backdrop root and its menus can blur the page. */
  .header-glass { position: absolute; inset: 0; z-index: -1; border-radius: 0; background: var(--glass-strong); transition: inset .55s cubic-bezier(.2, .9, .25, 1), border-radius .55s cubic-bezier(.2, .9, .25, 1), opacity .35s; }
  .site-header[data-at-top] .header-glass { opacity: 0; }
  .site-header[data-floating] .header-glass { inset: 8px max(12px, calc(50% - 632px)); border-radius: 24px; background: linear-gradient(color-mix(in srgb, var(--site-bg) 30%, transparent), color-mix(in srgb, var(--site-bg) 30%, transparent)), var(--lg-tint); }
  .header-inner { width: min(100% - 64px, 1216px); height: 100%; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 28px; }
  .site-brand { display: inline-flex; align-items: center; gap: 3px; flex-shrink: 0; }
  .header-mark { display: flex; flex-shrink: 0; width: 120px; }
  .desktop-nav { display: flex; align-items: center; justify-content: flex-end; gap: 26px; margin-left: auto; }
  .nav-link { display: flex; align-items: center; gap: 6px; padding: 20px 0; font-size: 14px; font-weight: 500; color: var(--site-muted); white-space: nowrap; transition: color .2s; cursor: pointer;  line-height: 24px; }
  .nav-link:hover, details[open] > .nav-link { color: var(--site-ink); }
  .contact-button { display: inline-flex; align-items: center; justify-content: center; min-height: 38px; padding: 6px 16px; border: 1px solid var(--site-line); border-radius: 999px; color: var(--site-ink); font-size: 14px; font-weight: 500; line-height: 24px; white-space: nowrap; transition: color .2s, border-color .2s, background .2s; }
  .contact-button:hover { color: var(--site-accent); border-color: var(--site-accent); background: var(--site-alt); }
  .contact-button:focus-visible { outline: 2px solid var(--site-accent); outline-offset: 4px; }
  .mobile-contact { display: flex; width: 100%; min-height: 44px; margin-top: 20px; }
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .nav-icon { width: 15px; height: 15px; }
  .nav-chevron { width: 13px; height: 13px; transition: transform .2s; }
  details[open] > summary .nav-chevron { transform: rotate(180deg); }
  .nav-dropdown { position: relative; }
  .dropdown-panel { position: absolute; top: calc(100% - 1px); left: -24px; width: 286px; padding: 8px; border-radius: 20px; background: var(--glass-strong); }
  .dropdown-panel a { display: block; padding: 12px 14px; border-radius: 9px; transition: background .2s; }
  .dropdown-panel a:hover, .dropdown-panel a:focus-visible { background: color-mix(in srgb, var(--site-ink) 6%, transparent); }
  .dropdown-label { display: block; color: var(--site-ink); font-size: 15px; font-weight: 600;  line-height: 1.5; }
  .dropdown-description { display: block; color: var(--site-muted); font-size: 13px; line-height: 1.6; margin-top: 4px; }
  .language-panel { right: -10px; left: auto; width: 190px; max-height: min(80vh, 560px); overflow-y: auto; }
  .language-panel a { font-size: 14px; color: var(--site-muted); padding-block: 9px; }
  a[aria-current="true"] { color: var(--site-accent); font-weight: 600; }
  .header-actions { display: flex; align-items: center; gap: 14px; }
  .theme-toggle, .mobile-toggle { width: 40px; height: 40px; border: 1px solid var(--site-line); border-radius: 50%; display: grid; place-items: center; color: var(--site-muted); cursor: pointer; background: transparent; transition: color .2s, background .2s; }
  .theme-toggle:hover, .mobile-toggle:hover { background: var(--site-alt); color: var(--site-ink); }
  .theme-toggle svg { width: 18px; height: 18px; }
  .theme-moon { display: none; }
  :global([data-theme="light"]) .theme-sun { display: none; }
  :global([data-theme="light"]) .theme-moon { display: block; }
  .mobile-menu { display: none; }
  .mobile-toggle svg { width: 18px; height: 18px; }
  .mobile-close-icon, .mobile-menu[open] .mobile-open-icon { display: none; }
  .mobile-menu[open] .mobile-close-icon { display: block; }
  .mobile-panel { position: absolute; inset: 62px 12px auto; padding: 12px 20px 20px; border-radius: 24px; max-height: calc(100dvh - 76px); overflow-y: auto; background: var(--glass-strong); }
  .mobile-link, .mobile-section > summary { display: flex; align-items: center; justify-content: space-between; padding: 15px 0; font-size: 16px; color: var(--site-ink); border-bottom: 1px solid var(--site-line); cursor: pointer; }
  .mobile-submenu { display: grid; gap: 0; padding: 6px 0 12px; }
  .mobile-submenu a { padding: 10px 16px; font-size: 15px; color: var(--site-muted);  line-height: 1.5; }
  .mobile-submenu a:hover { color: var(--site-ink); }
  .mobile-languages { grid-template-columns: 1fr 1fr; }
  .mobile-languages a[aria-current="true"] { color: var(--site-accent); }
  @media (min-width: 1024px) and (max-width: 1199px) {
    .desktop-nav { gap: 20px; }
  }
  @media (max-width: 1023px) {
    .header-inner { width: calc(100% - 40px); gap: 28px; }
    .desktop-nav { display: none;  gap: 26px; }
    .mobile-menu { display: block; }
  }
</style>

<script>
  const siteHeader = document.querySelector<HTMLElement>(".site-header");
  const syncHeaderState = () => {
    const atTop = window.scrollY < 8;
    siteHeader?.toggleAttribute("data-at-top", atTop);
    siteHeader?.toggleAttribute("data-floating", !atTop);
  };
  syncHeaderState();
  window.addEventListener("scroll", syncHeaderState, { passive: true });

  const desktopMenus = document.querySelectorAll<HTMLDetailsElement>("[data-desktop-dropdown]");
  const mobileMenu = document.querySelector<HTMLDetailsElement>("[data-mobile-menu]");
  const closeDesktopMenus = (except?: HTMLDetailsElement) => {
    desktopMenus.forEach((menu) => { if (menu !== except) menu.open = false; });
  };

  desktopMenus.forEach((menu) => {
    const trigger = menu.querySelector("summary");
    let pinned = false;
    trigger?.addEventListener("click", (event) => {
      event.preventDefault();
      closeDesktopMenus(menu);
      pinned = !pinned;
      menu.open = pinned;
    });
    trigger?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") {
        event.preventDefault();
        closeDesktopMenus(menu);
        menu.open = true;
        pinned = true;
        menu.querySelector("a")?.focus();
      }
    });
    menu.addEventListener("toggle", () => {
      trigger?.setAttribute("aria-expanded", String(menu.open));
      if (!menu.open) pinned = false;
      if (menu.open) closeDesktopMenus(menu);
    });
    menu.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse") { closeDesktopMenus(menu); menu.open = true; }
    });
    menu.addEventListener("pointerleave", () => {
      if (!menu.contains(document.activeElement)) menu.open = false;
    });
    menu.addEventListener("focusout", (event) => {
      if (!(event.relatedTarget instanceof Node) || !menu.contains(event.relatedTarget)) menu.open = false;
    });
  });

  mobileMenu?.addEventListener("toggle", () => {
    mobileMenu.querySelector("summary")?.setAttribute("aria-expanded", String(mobileMenu.open));
  });
  mobileMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { mobileMenu.open = false; }));

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    desktopMenus.forEach((menu) => { if (!menu.contains(event.target as Node)) menu.open = false; });
    if (mobileMenu && !mobileMenu.contains(event.target)) mobileMenu.open = false;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const activeDesktopMenu = [...desktopMenus].find((menu) => menu.open);
    if (activeDesktopMenu) {
      activeDesktopMenu.open = false;
      activeDesktopMenu.querySelector("summary")?.focus();
      event.preventDefault();
    }
    if (mobileMenu?.open) {
      mobileMenu.open = false;
      mobileMenu.querySelector("summary")?.focus();
      event.preventDefault();
    }
  });
  window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
    if (event.matches && mobileMenu) mobileMenu.open = false;
    if (!event.matches) closeDesktopMenus();
  });

  document.querySelectorAll<HTMLAnchorElement>("[data-locale-link]").forEach((link) => {
    const destination = new URL(link.href);
    destination.search = window.location.search;
    if (window.location.hash) destination.hash = window.location.hash;
    link.href = destination.href;
  });

  const themeButtons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
  const syncThemeButtons = () => themeButtons.forEach((button) => {
    button.setAttribute("aria-pressed", String(document.documentElement.dataset.theme === "dark"));
  });
  syncThemeButtons();
  themeButtons.forEach((button) => button.addEventListener("click", () => {
    const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem("evox-theme", theme); } catch { /* Theme switching still works when storage is unavailable. */ }
    syncThemeButtons();
  }));
  window.addEventListener("storage", (event) => {
    if (event.key === "evox-theme" || event.key === null) {
      document.documentElement.dataset.theme = event.newValue === "dark" ? "dark" : "light";
      syncThemeButtons();
    }
  });
</script>
