---
import "../styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const {
  title = "EvoX - GPU-accelerated Evolutionary Computation",
  hideHeader = false,
  hideFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>

  <body class="bg-white text-gray-900 antialiased min-h-screen flex flex-col">
    {!hideHeader && <Header />}

    <main class:list={["flex-grow w-full", { "pt-20": !hideHeader }]}>
      <slot />
    </main>

    {!hideFooter && <Footer />}
  </body>
</html>

<style is:global>
  /* Smooth Scrolling */
  html {
    scroll-behavior: smooth;
  }
</style>
