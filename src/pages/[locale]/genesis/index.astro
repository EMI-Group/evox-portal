---
import GenesisContent from "../../../components/pages/GenesisContent.astro";
import { locales, defaultLocale, type Locale } from "../../../i18n/utils";

export function getStaticPaths() {
  return locales
    .filter((l) => l !== defaultLocale)
    .map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<GenesisContent locale={locale as Locale} />
