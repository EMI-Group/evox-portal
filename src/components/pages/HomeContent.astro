  @keyframes node-n2 { 0%, 24% { opacity: 0; transform: scale(0.4); } 28% { opacity: 1; transform: scale(1); } 88% { opacity: 1; } 96%, 100% { opacity: 0; } }
  @keyframes node-pruned { 0%, 24% { opacity: 0; transform: scale(0.4); } 28%, 34% { opacity: 1; transform: scale(1); } 42%, 88% { opacity: 0.2; transform: scale(0.7); } 96%, 100% { opacity: 0; } }
  @keyframes node-n3 { 0%, 52% { opacity: 0; transform: scale(0.3); } 56% { opacity: 1; transform: scale(1.35); } 60% { transform: scale(1); } 88% { opacity: 1; } 96%, 100% { opacity: 0; } }
  @keyframes node-n4 { 0%, 68% { opacity: 0; transform: scale(0.4); } 72% { opacity: 1; transform: scale(1); } 88% { opacity: 1; } 96%, 100% { opacity: 0; } }

  /* ---------- 03 · Paradigm cards ---------- */
  .paradigm-bg {
    background:
      radial-gradient(40rem 20rem at 0% 0%, rgba(99, 102, 241, 0.07), transparent 70%),
      radial-gradient(40rem 20rem at 100% 100%, rgba(20, 184, 166, 0.08), transparent 70%);
