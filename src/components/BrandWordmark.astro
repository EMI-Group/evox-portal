---
import { randomUUID } from "node:crypto";
import BrandMark from "./BrandMark.astro";

// Source: ../assets/brand/evox-wordmark-source.svg, preserved as supplied.
// Preserve its EVO paths, gradient and overall layout.
// The existing X component retains its original per-segment theme animation.
const gradientId = `evox-lettering-${randomUUID()}`;
---

