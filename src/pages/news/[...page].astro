---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import NewsCard from "../../components/NewsCard.astro";
import { type Locale, defaultLocale, loadTranslations, t, getLocalizedNews } from "../../i18n/utils";
import type { PaginateFunction, PaginatedPage } from "../../types/pagination";

type NewsArticle = CollectionEntry<"news"> & { slug: string };

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction<NewsArticle> }) {
  const allArticles = await getCollection("news");
  const articles = getLocalizedNews(allArticles, defaultLocale);
  const sorted = articles.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return paginate(sorted, { pageSize: 12 });
}

const locale: Locale = defaultLocale;
const tr = await loadTranslations(locale);

const { page } = Astro.props as { page: PaginatedPage<NewsArticle> };
const title = t(tr, "news.pageTitle", { page: page.currentPage > 1 ? t(tr, "news.pageTitlePage", { page: String(page.currentPage) }) : "" });
---

<Layout title={title} description={t(tr, "news.heroDesc")} locale={locale}>
  <div
    class="relative text-white py-20 md:py-28 overflow-hidden"
    style="background: rgb(22, 27, 48);"
  >
    <div
      class="absolute inset-0 page-hero-backdrop"
      style="background: radial-gradient(ellipse at center, rgba(60, 70, 110, 0.4) 0%, transparent 60%);"
    ></div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-4">
        {t(tr, "news.heroTitle")}
      </h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">
        {t(tr, "news.heroDesc")}
      </p>
    </div>
  </div>

  <div class="bg-gray-50 min-h-screen py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
        {page.data.map((article, index) => (
          <NewsCard article={article} locale={locale} eager={index < 3} />
        ))}
      </div>

      {
        page.lastPage > 1 && (
          <nav aria-label={t(tr, "nav.pagination")} class="mt-20 flex flex-col sm:flex-row items-center justify-between border-t border-gray-200 pt-10 gap-8">
            <div class="flex items-center gap-2">
              {page.url.prev ? (
                <a href={page.url.prev} class="flex items-center px-6 py-3 surface-button text-gray-700 font-semibold">
                  &larr; <span class="ml-2">{t(tr, "news.prev")}</span>
                </a>
              ) : (
                <span class="flex items-center px-6 py-3 bg-gray-50 border border-gray-100 rounded-2xl text-gray-300 font-semibold cursor-not-allowed">
                  &larr; <span class="ml-2">{t(tr, "news.prev")}</span>
                </span>
              )}
            </div>
            <div class="flex items-center gap-3">
              <span class="text-gray-500 font-medium mr-2">
                {t(tr, "news.pageInfo", { current: String(page.currentPage), total: String(page.lastPage) })}
              </span>
            </div>
            <div class="flex items-center gap-2">
              {page.url.next ? (
                <a href={page.url.next} class="flex items-center px-6 py-3 surface-button text-gray-700 font-semibold">
                  <span class="mr-2">{t(tr, "news.next")}</span> &rarr;
                </a>
              ) : (
                <span class="flex items-center px-6 py-3 bg-gray-50 border border-gray-100 rounded-2xl text-gray-300 font-semibold cursor-not-allowed">
                  <span class="mr-2">{t(tr, "news.next")}</span> &rarr;
                </span>
              )}
            </div>
          </nav>
        )
      }
    </div>
  </div>
</Layout>
