---
import { getCollection } from "astro:content";
import BlogArticle from "../../../components/pages/BlogArticle.astro";
import { locales, defaultLocale, type Locale, loadTranslations, t, getLocalizedUrl, getDateLocale, getLocalizedArticles } from "../../../i18n/utils";

export async function getStaticPaths() {
  const allArticles = await getCollection("releases");
  const nonDefaultLocales = locales.filter((l) => l !== defaultLocale);
  return nonDefaultLocales.flatMap((locale) => {
    const articles = getLocalizedArticles(allArticles, locale);
    return articles.map((article) => ({
      params: { locale, slug: article.slug },
      props: { article },
    }));
  });
}

const locale = Astro.params.locale as Locale;

const { article } = Astro.props;

---

<BlogArticle locale={locale} slug={article.slug} kind="releases" />
