  <svg class="brand-lettering" xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 134531.44 28473.72" width="134531.44" height="28473.72"
    fill-rule="evenodd" clip-rule="evenodd" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={gradientId} gradientUnits="userSpaceOnUse" x1="0" y1="26942.46" x2="0" y2="-271.29">
        <stop class="brand-stop brand-stop-0" offset="0" stop-opacity="0.917647" />
        <stop class="brand-stop brand-stop-1" offset="0.309804" stop-opacity="0.835294" />
        <stop class="brand-stop brand-stop-2" offset="0.560784" stop-opacity="0.74902" />
        <stop class="brand-stop brand-stop-3" offset="0.788235" stop-opacity="0.87451" />
        <stop class="brand-stop brand-stop-4" offset="1" stop-opacity="1" />
      </linearGradient>
    </defs>
    <g fill={`url(#${gradientId})`}>
