---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import bannerImage from "../assets/evox_banner.jpg";

const allLibs = await getCollection("libs");

// SEO
const title = "EvoX Ecosystem - Libraries and Tools";
const description =
  "Explore the rich ecosystem of libraries, tools, and projects within the EvoX evolutionary computation framework.";
---

<Layout title={title}>
  <!-- Hero Banner Portion -->
  <div
    class="relative bg-gray-900 text-white py-24 md:py-32 overflow-hidden bg-cover bg-center xl:bg-[length:100%_100%]"
    style={`background-image: url(${bannerImage.src});`}
  >
    <div class="absolute inset-0 bg-black/60 z-0"></div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-6 md:px-8">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6">
          EvoX Ecosystem
        </h1>
        <p class="text-xl md:text-2xl font-light text-gray-200 leading-relaxed">
          A collection of libraries, tools, and projects designed to accelerate
          computation and optimization research.
        </p>
      </div>
    </div>
  </div>

  <div class="bg-gray-50 min-h-screen py-16 md:py-24">
    <div class="max-w-[1280px] mx-auto px-6 md:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-12 w-full">
        {
          allLibs.map((item) => (
            <a
              href={item.data.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group block h-full"
            >
              <div class="bg-white p-10 rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl hover:border-teal-100 transition-all duration-300 h-full flex flex-col">
                <div class="flex items-start justify-between mb-6">
                  <h2 class="text-2xl font-bold text-gray-900 group-hover:text-teal-600 transition-colors">
                    {item.data.title}
                  </h2>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6 text-gray-400 group-hover:text-teal-500 transition-colors transform group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    />
                  </svg>
                </div>
                <p class="text-gray-600 text-lg leading-relaxed mb-8 flex-grow">
                  {item.data.description}
                </p>
                <div class="mt-auto pt-4 border-t border-gray-50">
                  <span class="inline-flex items-center text-teal-600 font-semibold group-hover:underline text-lg">
                    Learn more <span class="ml-2">→</span>
                  </span>
                </div>
              </div>
            </a>
          ))
        }
      </div>

      {
        allLibs.length === 0 && (
          <div class="text-center py-24 bg-white rounded-xl border border-dashed border-gray-300">
            <p class="text-gray-500 text-lg">
              No libraries found in the collection.
            </p>
          </div>
        )
      }
    </div>
  </div>
</Layout>
