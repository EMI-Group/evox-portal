---
import { Icon } from "astro-icon/components";
import BrandWordmark from "./BrandWordmark.astro";
import { type Locale, defaultLocale, loadTranslations, t, getLocalizedUrl } from "../i18n/utils";

interface Props { locale?: Locale; }
const { locale = defaultLocale } = Astro.props;
const tr = await loadTranslations(locale);
const year = new Date().getFullYear();
const footerLinks = [
  { label: t(tr, "nav.ecosystem"), href: getLocalizedUrl("/libs", locale) },
  { label: t(tr, "nav.blog.news"), href: getLocalizedUrl("/news", locale) },
  { label: t(tr, "nav.blog.releases"), href: getLocalizedUrl("/releases", locale) },
  { label: t(tr, "nav.docs"), href: getLocalizedUrl("/docs", locale) },
  { label: t(tr, "nav.community"), href: getLocalizedUrl("/libs", locale) + "#community" },
  { label: t(tr, "nav.github"), href: "https://github.com/EMI-Group" },
];
const socials = [
  { label: "Facebook", icon: "simple-icons:facebook", href: "https://www.facebook.com/share/1Bspargk4W" },
  { label: "X", icon: "simple-icons:x", href: "https://x.com/EvoX__Group" },
  { label: "Zhihu", icon: "simple-icons:zhihu", href: "https://www.zhihu.com/people/liang-zhen-yu-13-4" },
  { label: "Product Hunt", icon: "simple-icons:producthunt", href: "https://www.producthunt.com/@evox__group" },
  { label: "Reddit", icon: "simple-icons:reddit", href: "https://www.reddit.com/user/EvoX_Group/" },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <a href={getLocalizedUrl("/", locale)} class="footer-brand" aria-label="EvoX">
        <BrandWordmark />
      </a>
      <nav>
        <ul class="footer-links">
          {footerLinks.map((link) => (
            <li><a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="footer-bottom">
      <p data-copyright-year={year}>{t(tr, "footer.copyright", { year: String(year) })}</p>
      <ul class="social-links">
        {socials.map((social) => (
          <li><a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label}><Icon name={social.icon} /></a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--site-bg); color: var(--site-muted); border-top: 1px solid var(--site-line); padding: 54px 0 28px; }
  .footer-inner { width: min(100% - 64px, 1216px); margin: auto; }
  .footer-top { display: flex; align-items: center; justify-content: space-between; gap: 40px; padding-bottom: 38px; }
  .footer-brand { display: block; width: 100px; flex-shrink: 0; }
  .footer-links, .social-links { display: flex; align-items: center; flex-wrap: wrap; gap: 16px 27px; list-style: none; padding: 0; margin: 0; }
  .footer-links { font-size: 14px; justify-content: flex-end;  line-height: 1.6; }
  .footer-links a, .social-links a { transition: color .2s; }
  .footer-links a:hover, .social-links a:hover { color: var(--site-ink); }
  .footer-bottom { padding-top: 24px; border-top: 1px solid var(--site-line); display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .footer-bottom p { margin: 0; font-size: 12px; line-height: 1.7; }
  .social-links { gap: 20px; }
  .social-links a { display: flex; padding: 4px; }
  .social-links svg { width: 18px; height: 18px; }
  @media (max-width: 760px) {
    .site-footer { padding-top: 30px; }
    .footer-inner { width: calc(100% - 40px); }
    .footer-top { align-items: flex-start; flex-direction: column; gap: 18px; padding-bottom: 18px; }
    .footer-top nav { width: 100%; }
    .footer-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: stretch; gap: 0 12px; font-size: 14px; line-height: 1.6; }
    .footer-links a { display: flex; align-items: center; min-height: 44px; height: 100%; padding-block: 8px; overflow-wrap: anywhere; hyphens: auto; }
    .footer-bottom { align-items: flex-start; flex-direction: column-reverse; gap: 14px; padding-top: 14px; }
    .social-links { gap: 4px; margin-left: -13px; }
    .social-links a { width: 44px; height: 44px; align-items: center; justify-content: center; }
  }
</style>

<script is:inline>
  (function () {
    var currentYear = String(new Date().getFullYear());
    document.querySelectorAll("[data-copyright-year]").forEach(function (el) {
      var buildYear = el.getAttribute("data-copyright-year");
      if (buildYear && buildYear !== currentYear && el.textContent) {
        el.textContent = el.textContent.replaceAll(buildYear, currentYear);
      }
    });
  })();
</script>
