---
import { locales, defaultLocale } from "../../../i18n/utils";
import { docSlugs } from "../../../utils/movedSlugs";

// Redirect stub: docs moved to https://runtime.evox.group.
// Slugs are hardcoded (getStaticPaths runs in an isolated scope, so they
// must come from an import) because the content collection was removed.

export function getStaticPaths() {
  const nonDefaultLocales = locales.filter((l) => l !== defaultLocale);
  return nonDefaultLocales.flatMap((locale) =>
    docSlugs.map((slug) => ({
      params: { locale, slug },
    })),
  );
}

const { locale, slug } = Astro.params;
return Astro.redirect(`https://runtime.evox.group/${locale}/docs/${slug}`);
---
