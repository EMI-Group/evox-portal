---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { type Locale, defaultLocale, loadTranslations, t, getLocalizedUrl, getLocalizedArticles } from "../../i18n/utils";

const locale: Locale = defaultLocale;
const tr = await loadTranslations(locale);

const allTutorials = await getCollection("tutorials");
const tutorials = getLocalizedArticles(allTutorials, locale);
const sorted = tutorials.sort((a, b) => a.data.order - b.data.order);
---

<Layout title={t(tr, "tutorials.pageTitle")} locale={locale}>
  <div class="relative text-white py-20 md:py-28 overflow-hidden" style="background: rgb(22, 27, 48);">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at center, rgba(60, 70, 110, 0.4) 0%, transparent 60%);"></div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-4">{t(tr, "tutorials.heroTitle")}</h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">{t(tr, "tutorials.heroDesc")}</p>
    </div>
  </div>
  <div class="bg-gray-50 min-h-screen py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="flex flex-col gap-4">
        {sorted.map((tutorial, i) => (
          <a href={getLocalizedUrl(`/tutorials/${tutorial.slug}`, locale)} class="group flex items-start sm:items-center bg-white rounded-2xl border border-gray-100 p-4 sm:p-6 shadow-sm hover:shadow-xl hover:border-teal-100 transition-all duration-300">
            <span class="flex-shrink-0 w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-teal-50 text-teal-700 font-bold flex items-center justify-center mr-3 sm:mr-5 text-base sm:text-lg">{i + 1}</span>
            <div class="flex-grow min-w-0">
              <h2 class="text-lg sm:text-xl font-bold text-gray-900 group-hover:text-teal-600 transition-colors break-words">{tutorial.data.title}</h2>
            </div>
            <span class="ml-2 sm:ml-4 text-gray-400 group-hover:text-teal-600 transition-colors flex-shrink-0">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
