---
import { type Locale, defaultLocale, loadTranslations, t } from "../../i18n/utils";
interface Props { locale?: Locale }
const { locale = defaultLocale } = Astro.props;
const tr = await loadTranslations(locale);
---

<div id="cso-plot" data-generation={t(tr, "examples.plot.generation")}  data-min={t(tr, "examples.plot.min")}  data-max={t(tr, "examples.plot.max")}  data-median={t(tr, "examples.plot.median")}  data-front={t(tr, "examples.plot.front")}  data-population={t(tr, "examples.plot.population")}  class="w-full h-full"></div>
<script is:inline>
  // Load Plotly only once: multiple components on the same page share this
  // promise, so the CDN script is injected a single time and everyone awaits it.
  window.__plotlyLoad =
    window.__plotlyLoad ||
    new Promise((resolve, reject) => {
      if (window.Plotly) {
        resolve(window.Plotly);
        return;
      }
      const s = document.createElement("script");
      s.src = "https://cdn.plot.ly/plotly-3.3.0.min.js";
      s.charset = "utf-8";
      s.onload = () => resolve(window.Plotly);
      s.onerror = () => reject(new Error("Failed to load Plotly"));
      document.head.appendChild(s);
    });
</script>

<script>
  import { data, layout } from "./cso-data.js";

  const cso_plot = document.getElementById("cso-plot");
  if (cso_plot) {
    const localizedLayout = structuredClone(layout);
    localizedLayout.sliders.forEach(slider => {
      slider.currentvalue.prefix = `${cso_plot.dataset.generation}: `;
    });
    const localizedData = data.map(trace => ({ ...trace, name: cso_plot.dataset[({ Min: "min", Max: "max", Median: "median" })[trace.name]] || trace.name }));
    // @ts-ignore
    (window.__plotlyLoad || Promise.reject(new Error("Plotly loader not initialized")))
      .then(() => {
        // @ts-ignore
        if (typeof Plotly === "undefined") {
          throw new Error("Plotly is not defined");
        }
        // @ts-ignore
        return Plotly.newPlot(cso_plot, localizedData, localizedLayout, { responsive: true });
      })
      .then(() => {
        let subdata = [];
        for (let i = 0; i < 80; i++) {
          let frame = { data: [], name: i + "" };
          // @ts-ignore
          localizedData.forEach((it) => {
            let x = it.x.slice(0, i + 1);
            let y = it.y.slice(0, i + 1);
            // @ts-ignore
            frame.data.push({ ...it, x, y });
          });
          // @ts-ignore
          subdata.push(frame);
        }
        // @ts-ignore
        return Plotly.addFrames(cso_plot, subdata);
      })
      .then(() => {
        cso_plot.setAttribute("data-ready", "true");
      })
      .catch((err: unknown) => {
        console.warn("Failed to render cso plot:", err instanceof Error ? err.message : err);
        cso_plot.style.display = "none";
      });
  }
</script>
