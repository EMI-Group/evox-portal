---
import { Icon } from "astro-icon/components";
import { type Locale, defaultLocale, locales, localeNames, loadTranslations, t, getLocalizedUrl } from "../i18n/utils";

interface Props {
  sticky?: boolean;
  animated?: boolean;
  locale?: Locale;
}

const { sticky = false, animated = false, locale = defaultLocale } = Astro.props;
const tr = await loadTranslations(locale);
const currentPath = Astro.url.pathname;

const navLinks = [
  {
    label: t(tr, "nav.tutorials"),
    href: getLocalizedUrl("/tutorials", locale),
  },
  {
    label: t(tr, "nav.docs"),
    dropdown: [
      {
        label: t(tr, "nav.docs.guide"),
        desc: t(tr, "nav.docs.guide.desc"),
        href: getLocalizedUrl("/docs", locale),
      },
      {
        label: t(tr, "nav.docs.api"),
        desc: t(tr, "nav.docs.api.desc"),
        href: "https://evox.readthedocs.io/en/latest/apidocs/index.html",
      },
    ],
  },
  {
    label: t(tr, "nav.blog"),
    dropdown: [
      {
        label: t(tr, "nav.blog.news"),
        desc: t(tr, "nav.blog.news.desc"),
        href: getLocalizedUrl("/news", locale),
      },
      {
        label: t(tr, "nav.blog.releases"),
        desc: t(tr, "nav.blog.releases.desc"),
        href: getLocalizedUrl("/releases", locale),
      },
    ],
  },
  {
    label: t(tr, "nav.community"),
    href: getLocalizedUrl("/community", locale),
  },
  {
    label: t(tr, "nav.ecosystem"),
    href: getLocalizedUrl("/libs", locale),
  },
  {
    label: t(tr, "nav.contact"),
    href: "https://chengran.tech/",
  },
];
---

<header
  class:list={[
    "w-full border-b border-gray-800 text-white transition-all duration-300",
    !animated && "z-50",
    !animated && (sticky ? "sticky top-0" : "fixed top-0"),
  ]}
  style="background: rgb(22, 27, 48);"
>
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <div class="flex-shrink-0">
        <a
          href={getLocalizedUrl("/", locale)}
          class="flex items-center"
          aria-label="EvoX"
          id={sticky ? "nav-logo-group" : undefined}
          style={
            sticky
              ? "opacity: 0; transition: opacity 0.15s;"
              : undefined
          }
        >
          <img
            src="/logo_text.png"
            alt="EVO"
            class="h-8"
            style="filter: brightness(0) invert(1);"
          />
          <img
            src="/logo.svg"
            alt="EvoX mark"
            class="h-10"
            data-logo-mark
            id={sticky ? "nav-logo" : undefined}
            style={animated ? "opacity: 0;" : undefined}
          />
        </a>
      </div>

      <nav class="hidden md:flex space-x-8 items-center">
        {
          navLinks.map((link) => (
            <div class="relative group" data-dropdown>
              {link.dropdown ? (
                <button
                  class="flex items-center gap-1 py-2 text-sm font-medium hover:text-teal-400 transition-colors focus:outline-none cursor-pointer"
                  aria-haspopup="true"
                  aria-expanded="false"
                >
                  {link.label}
                  <Icon
                    name="heroicons:chevron-down-20-solid"
                    class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180 group-[.dropdown-open]:rotate-180"
                  />
                </button>
              ) : (
                <a
                  href={link.href}
                  target={link.href?.startsWith("http") ? "_blank" : undefined}
                  rel={link.href?.startsWith("http") ? "noopener noreferrer" : undefined}
                  class="text-sm font-medium hover:text-teal-400 transition-colors"
                >
                  {link.label}
                </a>
              )}

              {link.dropdown && (
                <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible group-[.dropdown-open]:opacity-100 group-[.dropdown-open]:visible transition-all duration-200 transform origin-top" data-dropdown-menu>
                  <div class="bg-[rgb(22,27,48)] rounded-lg shadow-xl overflow-hidden ring-1 ring-white/10">
                    <div class="py-2">
                      {link.dropdown.map((item) => (
                        <a
                          href={item.href}
                          target={item.href.startsWith("#") ? undefined : (item.href.startsWith("http") ? "_blank" : undefined)}
                          rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
                          class="block px-4 py-3 hover:bg-white/10 transition-colors group/item"
                        >
                          <p class="text-sm font-bold text-gray-100 group-hover/item:text-teal-400">
                            {item.label}
                          </p>
                          <p class="mt-1 text-xs text-gray-400 line-clamp-2">
                            {item.desc}
                          </p>
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              )}
            </div>
          ))
        }

        {/* Language Switcher */}
        <div class="relative group" data-dropdown>
          <button
            class="flex items-center gap-1 py-2 text-sm font-medium hover:text-teal-400 transition-colors focus:outline-none cursor-pointer"
            aria-haspopup="true"
            aria-expanded="false"
          >
            <Icon name="heroicons:language-20-solid" class="w-4 h-4" />
            {localeNames[locale]}
            <Icon
              name="heroicons:chevron-down-20-solid"
              class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180 group-[.dropdown-open]:rotate-180"
            />
          </button>
          <div class="absolute right-0 top-full pt-2 w-48 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible group-[.dropdown-open]:opacity-100 group-[.dropdown-open]:visible transition-all duration-200 transform origin-top" data-dropdown-menu>
            <div class="bg-[rgb(22,27,48)] rounded-lg shadow-xl overflow-hidden ring-1 ring-white/10 max-h-80 overflow-y-auto">
              <div class="py-2">
                {locales.map((loc) => (
                  <a
                    href={getLocalizedUrl(currentPath, loc)}
                    data-locale-link
                    class:list={[
                      "block px-4 py-2 text-sm transition-colors",
                      loc === locale
                        ? "text-teal-400 font-bold"
                        : "text-gray-300 hover:bg-white/10 hover:text-white",
                    ]}
                  >
                    {localeNames[loc]}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </nav>

      <details class="relative md:hidden">
        <summary class="list-none text-gray-300 hover:text-white p-2 cursor-pointer">
          <span class="sr-only">Open menu</span>
          <Icon name="heroicons:ellipsis-horizontal-20-solid" class="h-6 w-6" />
        </summary>
        <div class="absolute right-0 top-full mt-2 w-[min(88vw,20rem)] bg-[rgb(22,27,48)] rounded-lg shadow-xl ring-1 ring-white/10 overflow-hidden z-50">
          <nav class="py-2">
            {
              navLinks.map((link) => (
                link.dropdown ? (
                  <details class="border-b border-white/5 last:border-b-0">
                    <summary class="list-none flex items-center justify-between px-4 py-3 text-sm font-medium text-gray-100 cursor-pointer hover:bg-white/10">
                      {link.label}
                      <Icon name="heroicons:chevron-down-20-solid" class="w-4 h-4" />
                    </summary>
                    <div class="pb-2">
                      {link.dropdown.map((item) => (
                        <a
                          href={item.href}
                          target={item.href.startsWith("http") ? "_blank" : undefined}
                          rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
                          class="block px-6 py-2 text-sm text-gray-300 hover:bg-white/10 hover:text-white"
                        >
                          {item.label}
                        </a>
                      ))}
                    </div>
                  </details>
                ) : (
                  <a
                    href={link.href}
                    target={link.href?.startsWith("http") ? "_blank" : undefined}
                    rel={link.href?.startsWith("http") ? "noopener noreferrer" : undefined}
                    class="block px-4 py-3 text-sm font-medium text-gray-100 hover:bg-white/10"
                  >
                    {link.label}
                  </a>
                )
              ))
            }

            <details class="border-t border-white/10 mt-1">
              <summary class="list-none flex items-center justify-between px-4 py-3 text-sm font-medium text-gray-100 cursor-pointer hover:bg-white/10">
                {localeNames[locale]}
                <Icon name="heroicons:chevron-down-20-solid" class="w-4 h-4" />
              </summary>
              <div class="max-h-64 overflow-y-auto pb-2">
                {locales.map((loc) => (
                  <a
                    href={getLocalizedUrl(currentPath, loc)}
                    data-locale-link
                    class:list={[
                      "block px-6 py-2 text-sm transition-colors",
                      loc === locale
                        ? "text-teal-400 font-bold"
                        : "text-gray-300 hover:bg-white/10 hover:text-white",
                    ]}
                  >
                    {localeNames[loc]}
                  </a>
                ))}
              </div>
            </details>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  /* JS adds .dropdown-suppressed to a just-closed dropdown so group-hover
     and group-focus-within cannot re-show its menu while the pointer still
     hovers it or focus returns to its trigger. */
  [data-dropdown].dropdown-suppressed [data-dropdown-menu] {
    opacity: 0 !important;
    visibility: hidden !important;
  }
</style>

<script>
  // Desktop dropdowns: CSS group-hover handles hover; JS is the single source
  // of truth for click/focus state — it manages the dropdown-open class,
  // aria-expanded, and blurs focused elements on close so that
  // group-focus-within cannot keep a closed dropdown open. A just-closed
  // dropdown gets dropdown-suppressed so group-hover/group-focus-within
  // cannot re-show it until the pointer leaves or focus moves on.
  const dropdowns = document.querySelectorAll<HTMLElement>("[data-dropdown]");

  function isDropdownOpen(dropdown: HTMLElement) {
    return (
      dropdown.classList.contains("dropdown-open") ||
      dropdown.matches(":focus-within")
    );
  }

  function openDropdown(dropdown: HTMLElement, button: HTMLButtonElement) {
    dropdown.classList.remove("dropdown-suppressed");
    dropdown.classList.add("dropdown-open");
    button.setAttribute("aria-expanded", "true");
  }

  function closeDropdown(dropdown: HTMLElement) {
    dropdown.classList.remove("dropdown-open");
    dropdown.querySelector("button")?.setAttribute("aria-expanded", "false");
    // Blur any focused element inside so group-focus-within releases the menu
    const active = document.activeElement;
    if (active instanceof HTMLElement && dropdown.contains(active)) {
      active.blur();
    }
  }

  function closeAllDropdowns(except?: HTMLElement) {
    dropdowns.forEach((dropdown) => {
      if (dropdown !== except) closeDropdown(dropdown);
    });
  }

  dropdowns.forEach((dropdown) => {
    const button = dropdown.querySelector("button");
    if (!button) return;

    // Capture the open state before the activation moves focus. At
    // pointerdown focus has not moved yet, so isDropdownOpen reflects the
    // pre-click state; on keyboard activation focus is already on the
    // button (:focus-within always matches), so only the pinned
    // dropdown-open class counts as "open".
    let openBeforeClick = false;
    button.addEventListener("pointerdown", () => {
      openBeforeClick = isDropdownOpen(dropdown);
    });
    button.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        openBeforeClick = dropdown.classList.contains("dropdown-open");
      }
    });

    button.addEventListener("click", (event) => {
      event.stopPropagation();
      if (openBeforeClick) {
        closeDropdown(dropdown);
        // The pointer may still hover this dropdown: keep the menu hidden
        // until it leaves, otherwise group-hover re-shows it at once.
        dropdown.classList.add("dropdown-suppressed");
      } else {
        // Exclude this dropdown so closeDropdown cannot blur the button
        // that just received focus.
        closeAllDropdowns(dropdown);
        openDropdown(dropdown, button);
      }
    });

    // Menubar behavior: while a dropdown is pinned open via click, hovering
    // another dropdown closes the pinned one.
    dropdown.addEventListener("pointerenter", () => {
      dropdowns.forEach((other) => {
        if (other !== dropdown && other.classList.contains("dropdown-open")) {
          closeDropdown(other);
        }
      });
    });

    dropdown.addEventListener("mouseleave", () => {
      dropdown.classList.remove("dropdown-suppressed");
    });
    dropdown.addEventListener("focusout", (event) => {
      if (
        !(event.relatedTarget instanceof Node) ||
        !dropdown.contains(event.relatedTarget)
      ) {
        dropdown.classList.remove("dropdown-suppressed");
      }
    });
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    dropdowns.forEach((dropdown) => {
      if (!dropdown.contains(event.target as Node)) closeDropdown(dropdown);
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    dropdowns.forEach((dropdown) => {
      if (!isDropdownOpen(dropdown)) return;
      // Return focus to the trigger button; suppression keeps the menu
      // closed even though focus-within now matches again.
      const hadFocusInside = dropdown.contains(document.activeElement);
      closeDropdown(dropdown);
      if (hadFocusInside) {
        dropdown.classList.add("dropdown-suppressed");
        dropdown.querySelector("button")?.focus();
      }
    });
  });

  // Preserve query string and hash when switching locales; in a static build
  // they are only known on the client.
  const urlSuffix = window.location.search + window.location.hash;
  if (urlSuffix) {
    document
      .querySelectorAll<HTMLAnchorElement>("a[data-locale-link]")
      .forEach((link) => {
        link.href += urlSuffix;
      });
  }
</script>
