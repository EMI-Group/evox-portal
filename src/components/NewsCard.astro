---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import { getLocalizedUrl, getDateLocale, loadTranslations, t, type Locale } from "../i18n/utils";

interface Props {
  article: CollectionEntry<"news"> & { slug: string };
  locale: Locale;
  eager?: boolean;
}

const { article, locale, eager = false } = Astro.props;
const tr = await loadTranslations(locale);
const images = import.meta.glob<ImageMetadata>("../content/news/**/*.{png,jpg,jpeg,webp}", { eager: true, import: "default" });
const firstImage = article.body?.match(/!\[([^\]]*)\]\(\.\/([^\s)]+)/);
// Content IDs are normalized to lowercase, while some source directories are not.
const imageKey = `../content/news/${article.id.replace(/\/[^/]+$/, "")}/${firstImage?.[2]}`.toLowerCase();
const cover = Object.entries(images).find(([path]) => path.toLowerCase() === imageKey)?.[1];
const date = article.data.pubDate.toLocaleDateString(getDateLocale(locale), { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<a href={getLocalizedUrl(`/news/${article.slug}`, locale)} class="news-card surface-card group flex flex-col overflow-hidden">
  {cover && (
    <div class="relative overflow-hidden">
      <Image
        src={cover}
        alt={firstImage?.[1] || article.data.title}
        width={1088}
        widths={[480, 768, 1088]}
        sizes="(min-width: 1280px) 384px, (min-width: 1024px) calc((100vw - 96px) / 2), (min-width: 768px) calc((100vw - 80px) / 2), calc(100vw - 48px)"
        format="webp"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        class="block w-full aspect-video object-cover transition-transform duration-700 group-hover:scale-[1.03]"
      />
      <time datetime={article.data.pubDate.toISOString()} class="glass-chip absolute top-3.5 left-3.5">{date}</time>
    </div>
  )}
  <div class="flex flex-col flex-grow min-w-0 p-6">
    {!cover && <time datetime={article.data.pubDate.toISOString()} class="mb-4 text-xs font-medium tracking-wide text-gray-500">{date}</time>}
    <h2 class="text-xl font-semibold text-gray-900 mb-3 group-hover:text-teal-600 transition-colors leading-snug break-words">{article.data.title}</h2>
    <p class="text-gray-600 text-base leading-relaxed line-clamp-3 mb-6">{article.data.summary || t(tr, "news.defaultSummary")}</p>
    <div class="mt-auto flex items-center text-teal-600 font-semibold text-sm">
      {t(tr, "news.readMore")}
      <span class="ml-2 transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
    </div>
  </div>
</a>
