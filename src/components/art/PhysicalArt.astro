---
type Point = [number, number];
type Pose = { at: number; height: number; tilt?: number; shift?: number };

const ground = 220;
const bodyCenter = 58;
const halfLeg = 42;
const legs = [
  { side: "far", end: "rear", x: 31, inset: 5, plantedX: 20, phase: 0 },
  { side: "far", end: "front", x: 83, inset: 5, plantedX: 96, phase: .5 },
  { side: "near", end: "rear", x: 35, inset: 7, plantedX: 11, phase: .5 },
  { side: "near", end: "front", x: 87, inset: 7, plantedX: 105, phase: 0 },
];
// Irregular corrective steps widen and narrow the support area in place.
// A foot moves only during its lift; this is deliberately not a walking gait.
const corrections = [
  { start: 4, end: 15, returnStart: 55, returnEnd: 66, shift: -6, lift: 6 },
  { start: 28, end: 39, returnStart: 77, returnEnd: 88, shift: -8, lift: 7 },
  { start: 39, end: 51, returnStart: 88, returnEnd: 100, shift: 8, lift: 7 },
  { start: 15, end: 27, returnStart: 66, returnEnd: 77, shift: 10, lift: 8 },
];
const learning: Pose[] = [
  { at: 0, height: 148, tilt: -3 },
  { at: 12, height: 148, tilt: 4, shift: 2 },
  { at: 20, height: 151, tilt: -6, shift: -2 },
  { at: 27, height: 166, tilt: -13, shift: -5 },
  { at: 33, height: 187, tilt: -17, shift: -8 },
  { at: 39, height: 203.5, tilt: -12, shift: -9 },
  { at: 44, height: 200.5, tilt: -14, shift: -9 },
  { at: 51, height: 203.5, tilt: -12, shift: -9 },
  { at: 57, height: 197, tilt: -15, shift: -7 },
  { at: 63, height: 202.5, tilt: -13, shift: -9 },
  { at: 69, height: 197.5, tilt: -10, shift: -7 },
  { at: 75, height: 203.5, tilt: -12, shift: -9 },
  { at: 81, height: 199, tilt: -15, shift: -8 },
  { at: 88, height: 203.5, tilt: -12, shift: -9 },
  // Reset while the fallen model is faded out, without showing a recovery.
  { at: 94, height: 148, tilt: -3 }, { at: 100, height: 148, tilt: -3 },
];
// Include every footfall boundary so CSS never blends two corrective swings.
const standingTimes = [...new Set([
  ...Array.from({ length: 81 }, (_, index) => index / 80 * 100),
  ...corrections.flatMap(step => [step.start, step.end, step.returnStart, step.returnEnd]),
])].sort((a, b) => a - b);
const standing: Pose[] = standingTimes.map(at => {
  const phase = at / 100 * Math.PI * 2;
  return {
    at,
    height: 147 + 2 * Math.sin(phase * 2 + .8),
    tilt: 5.5 * Math.sin(phase + .5) + 1.5 * Math.sin(phase * 3),
    shift: 4 * Math.sin(phase) + 1.5 * Math.sin(phase * 3 + .4),
  };
});
const walking: Pose[] = Array.from({ length: 33 }, (_, index) => ({
  at: index / 32 * 100,
  height: 133 + .5 * Math.cos(index / 32 * Math.PI * 4),
}));
// Re-solve the knees between authored fall poses; CSS only interpolates short
// intervals, keeping the two rigid segments connected to the rotating torso.
const interpolatePoses = (poses: Pose[]) => poses.flatMap((pose, index) => {
  const next = poses[index + 1];
  if (!next) return [pose];
  const steps = pose.height === next.height && pose.tilt === next.tilt && pose.shift === next.shift ? 1 : 8;
  return Array.from({ length: steps }, (_, step) => {
    const ratio = step / steps;
    return {
      at: pose.at + (next.at - pose.at) * ratio,
      height: pose.height + (next.height - pose.height) * ratio,
      tilt: (pose.tilt ?? 0) + ((next.tilt ?? 0) - (pose.tilt ?? 0)) * ratio,
      shift: (pose.shift ?? 0) + ((next.shift ?? 0) - (pose.shift ?? 0)) * ratio,
    };
  });
});
const stages = [
  { name: "learning", x: 28, duration: 2, delay: 0, poses: interpolatePoses(learning), still: learning[7] },
  { name: "standing", x: 181, duration: 1.6, delay: -.8, poses: standing, still: standing[12] },
  { name: "walking", x: 334, duration: 2.8, delay: -.35, poses: walking, still: walking[4] },
];

const number = (value: number) => Number(value.toFixed(2));
const point = ([x, y]: Point) => `${number(x)} ${number(y)}`;
const bodyPoint = (pose: Pose, x: number, offset: number): Point => {
  const angle = (pose.tilt ?? 0) * Math.PI / 180;
  const dx = x - bodyCenter;
  return [bodyCenter + (pose.shift ?? 0) + dx * Math.cos(angle) - offset * Math.sin(angle),
    pose.height + dx * Math.sin(angle) + offset * Math.cos(angle)];
};
const bodyPath = (pose: Pose) => {
  const outline: Point[] = [[20, -5], [26, -10], [90, -10], [96, -5], [96, 5], [90, 10], [26, 10], [20, 5]];
  return outline.map(([x, offset], index) => `${index ? "L" : "M"}${point(bodyPoint(pose, x, offset))}`).join("") + "Z";
};
const smooth = (value: number) => value * value * (3 - 2 * value);
const footPoint = (stage: string, pose: Pose, leg: typeof legs[number]): Point => {
  if (stage === "standing") {
    const step = corrections[legs.indexOf(leg)];
    const at = pose.at;
    if (at < step.start || at >= step.returnEnd) return [leg.plantedX, ground];
    if (at >= step.end && at < step.returnStart) return [leg.plantedX + step.shift, ground];
    const returning = at >= step.returnStart;
    const progress = returning ? (at - step.returnStart) / (step.returnEnd - step.returnStart) : (at - step.start) / (step.end - step.start);
    const offset = step.shift * (returning ? 1 - smooth(progress) : smooth(progress));
    return [leg.plantedX + offset, ground - step.lift * Math.sin(Math.PI * progress)];
  }
  if (stage !== "walking") return [leg.plantedX, ground];
  const phase = (pose.at / 100 + leg.phase) % 1;
  if (phase <= .55) return [leg.x + 11 - 22 * phase / .55, ground];
  const swing = (phase - .55) / .45;
  return [leg.x - 11 + 22 * swing, ground - 12 * Math.sin(swing * Math.PI)];
};
const legPath = (stage: string, pose: Pose, leg: typeof legs[number]) => {
  const hip = bodyPoint(pose, leg.x, leg.inset);
  const foot = footPoint(stage, pose, leg);
  const dx = foot[0] - hip[0];
  const dy = foot[1] - hip[1];
  const distance = Math.hypot(dx, dy);
  const bend = Math.sqrt(Math.max(0, halfLeg ** 2 - (distance / 2) ** 2));
  const direction = leg.end === "rear" ? -1 : 1;
  const knee: Point = [
    (hip[0] + foot[0]) / 2 + direction * bend * dy / distance,
    (hip[1] + foot[1]) / 2 - direction * bend * dx / distance,
  ];
  return `M${point(hip)}L${point(knee)}L${point(foot)}`;
};

// Every path shares its stage's timeline. Hip coordinates follow the rigid torso;
// corrective feet remain planted between individual balance steps.
const animationStyles = stages.map((stage) => {
  const body = `@keyframes physical-${stage.name}-body{${stage.poses.map((pose) => `${pose.at}%{d:path("${bodyPath(pose)}")}`).join("")}}`;
  const limbs = legs.map((leg, index) => `@keyframes physical-${stage.name}-leg-${index}{${stage.poses.map((pose) => `${pose.at}%{d:path("${legPath(stage.name, pose, leg)}")}`).join("")}}`).join("");
  return body + limbs;
}).join("");
---

<svg class="physical-art" viewBox="0 0 480 280" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <path class="ground" d="M35 220H454" />
  {stages.map((stage) => (
    <g class={`quadruped ${stage.name}`} transform={`translate(${stage.x} 0)`} style={`--gait-duration:${stage.duration}s;--gait-delay:${stage.delay}s;`}>
      {legs.map((leg, index) => (
        <path class={`leg ${leg.side} ${leg.end}`} d={legPath(stage.name, stage.still, leg)}
          style={`--gait-name:physical-${stage.name}-leg-${index};`} />
      ))}
      <path class="body" d={bodyPath(stage.still)} style={`--gait-name:physical-${stage.name}-body;`} />
    </g>
  ))}
</svg>

<style is:inline set:html={animationStyles} />
<style>
  .physical-art { display: block; width: 100%; height: 100%; }
  .ground { stroke: var(--art-guide); stroke-width: 1; stroke-linecap: round; }
  .quadruped { stroke: var(--art-line); stroke-linecap: round; stroke-linejoin: round; }
  .learning { opacity: .65; animation: physical-fall-reset var(--gait-duration) linear infinite; }
  .standing { opacity: .85; }
  .walking { stroke: var(--art-accent); }
  .body { fill: var(--art-fill); stroke-width: 1.5; }
  .walking .body { fill: var(--art-accent-soft); }
  .leg { stroke-width: 2; }
  .far { opacity: .38; }
  .body, .leg { animation: var(--gait-name) var(--gait-duration) linear var(--gait-delay) infinite; }
  @keyframes physical-fall-reset {
    0%, 82%, 100% { opacity: .65; }
    88%, 94% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .physical-art .quadruped, .physical-art .body, .physical-art .leg { animation: none; }
  }
</style>
