---
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import {
  type Locale,
  defaultLocale,
  loadTranslations,
  t,
  getLocalizedUrl,
  getDateLocale,
  getLocalizedArticles,
  getLocalizedNews,
} from "../../i18n/utils";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const tr = await loadTranslations(locale);
const dateLocale = getDateLocale(locale);

const allNews = await getCollection("news");
const allReleases = await getCollection("releases");
const localizedNews = getLocalizedNews(allNews, locale);
const localizedReleases = getLocalizedArticles(allReleases, locale);
const latestRelease = localizedReleases.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)[0];
const latestNews = localizedNews
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const latestArticles = [latestRelease, ...latestNews];

const allLibs = await getCollection("libs");
const ecosystem = allLibs.slice(0, 3);
---

<Layout title={t(tr, "site.title")} hideHeader hideFooter locale={locale}>
  <!-- ========== Navbar (starts at bottom, flies to top) ========== -->
  <div
    id="navbar"
    class="fixed left-0 right-0 top-0"
    style="z-index: 50; transform: translateY(100vh);"
  >
    <Header animated locale={locale} />
  </div>

  <!-- ========== Scroll Indicator ========== -->
  <div
    id="scroll-indicator"
    class="fixed bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center text-gray-500 scroll-bounce cursor-pointer"
    style="z-index: 35;"
  >
    <span class="text-sm mb-2">{t(tr, "hero.scroll")}</span>
    <svg
      class="w-4 h-4"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
      ></path>
    </svg>
  </div>

  <!-- ========== Hero Section ========== -->
  <section
    id="hero-section"
    class="relative flex flex-col items-center justify-center text-center px-4 py-16"
    style="min-height: 100vh; background: rgb(22, 27, 48); z-index: 10;"
  >
    <div
      class="absolute inset-0"
      id="hero-gradient"
      style="background: radial-gradient(ellipse at center, rgba(60, 70, 110, 0.5) 0%, transparent 60%);"
    >
    </div>

    <div class="relative z-10 w-full max-w-[1280px]">
      <!-- Hero Logo (visible by default) -->
      <img
        id="hero-logo"
        src="/logo.svg"
        alt="EvoX Logo"
        class="h-28 md:h-36 mb-10 mx-auto"
      />

      <h1
        id="hero-title"
        class="text-4xl md:text-6xl font-bold text-white mb-5 transition-opacity duration-700 mx-auto max-w-full"
      >
        <span class="block">{t(tr, "hero.title.line1")}</span>
        <span class="block">{t(tr, "hero.title.line2")}</span>
      </h1>
      <p
        id="hero-subtitle"
        class="text-lg md:text-xl text-gray-400 mb-8 transition-opacity duration-700 break-words"
      >
        {t(tr, "hero.subtitle")}
      </p>

      <!-- CTA Content (appears when expanded) -->
      <div
        id="cta-content"
        class="mt-8"
        style="opacity: 0; pointer-events: none;"
        inert
      >
        <p class="text-lg text-blue-400 mb-10">
          {t(tr, "hero.cta.tagline")}
        </p>
      </div>
    </div>
  </section>

  <!-- ========== Page Content ========== -->
  <div id="page-content" class="relative" style="background: rgb(22, 27, 48);">
    <div id="content-body" style="background: rgb(22, 27, 48);">
      <!-- Latest News -->
      <section class="bg-white py-16">
        <div class="max-w-[1280px] mx-auto px-4">
          <div
            class="flex flex-col sm:flex-row sm:justify-between items-start sm:items-end gap-3 border-b border-gray-200 pb-4 mb-8"
          >
            <h2 class="text-2xl font-bold text-gray-900 relative pb-4 -mb-4">
              {t(tr, "news.title")}
              <span class="absolute bottom-0 left-0 w-16 h-0.5 bg-blue-500"
              ></span>
            </h2>
            <a
              href={getLocalizedUrl("/news", locale)}
              class="text-blue-500 hover:text-blue-700 flex items-center gap-1 text-sm font-medium max-w-full break-words"
            >
              {t(tr, "news.viewAll")}
              <span>&rarr;</span>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {
              latestArticles.map((post) => {
                const section = localizedNews.some((n) => n.slug === post.slug)
                  ? "news"
                  : "releases";
                return (
                  <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
                    <p class="text-sm text-gray-400 mb-2">
                      {post.data.pubDate.toLocaleDateString(dateLocale, {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                        timeZone: "UTC",
                      })}
                    </p>
                    <h3 class="text-lg font-bold text-gray-900 mb-3">
                      {post.data.title}
                    </h3>
                    <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                      {post.data.summary ||
                        (section === "releases"
                          ? t(tr, "releases.defaultSummary")
                          : t(tr, "news.defaultSummary"))}
                    </p>
                    <a
                      href={getLocalizedUrl(`/${section}/${post.slug}`, locale)}
                      class="text-blue-500 hover:text-blue-700 text-sm flex items-center gap-1"
                    >
                      {t(tr, "news.readMore")} <span>&rarr;</span>
                    </a>
                  </div>
                );
              })
            }
          </div>
        </div>
      </section>

      <!-- Ecosystem -->
      <div class="bg-gray-50 py-16 border-t border-gray-200">
        <div class="max-w-[1280px] mx-auto px-4">
          <div class="mb-10">
            <h2 class="text-3xl font-bold text-gray-900 mb-2">
              {t(tr, "ecosystem.title")}
            </h2>
            <h3 class="text-teal-600 font-medium mb-4">
              {t(tr, "ecosystem.subtitle")}
            </h3>
            <p class="text-xl text-gray-600">{t(tr, "ecosystem.desc")}</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
              ecosystem.map((item) => (
                <a href={item.data.url} target="_blank" rel="noopener noreferrer" class="block group">
                  <div class="bg-white p-6 rounded-lg shadow-sm group-hover:shadow-md transition-shadow border border-gray-100 h-full">
                    <h4 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-teal-600 transition-colors">
                      {item.data.title}
                    </h4>
                    <p class="text-gray-600 text-sm leading-relaxed">
                      {t(tr, `libs.desc.${item.data.id}`)}
                    </p>
                  </div>
                </a>
              ))
            }
          </div>
          <div class="mt-8 text-center md:text-left">
            <a
              href={getLocalizedUrl("/libs", locale)}
              class="text-teal-700 font-semibold hover:text-teal-900 inline-flex items-center gap-1"
            >
              {t(tr, "ecosystem.seeAll")}
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Community -->
      <div class="bg-gray-100 py-16">
        <div class="max-w-[1280px] mx-auto px-4">
          <div class="text-center mb-10">
            <h2 class="text-3xl font-bold text-gray-900 mb-2">{t(tr, "community.title")}</h2>
            <p class="text-xl text-gray-600">{t(tr, "community.desc")}</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
            <button type="button" data-qq-qr-open class="group block p-8 bg-white rounded-3xl border border-gray-100 hover:border-teal-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-left cursor-pointer">
              <div class="flex items-center gap-4 mb-5">
                <div class="p-3 bg-teal-100 rounded-xl text-teal-600 group-hover:bg-teal-600 group-hover:text-white transition-colors shadow-sm">
                  <Icon name="simple-icons:tencentqq" class="h-6 w-6" />
                </div>
                <h3 class="text-2xl font-bold text-gray-900">EvoX <span class="text-teal-600 group-hover:text-teal-700 font-extrabold">{t(tr, "community.qq.title")}</span></h3>
              </div>
              <p class="text-gray-600 text-lg leading-relaxed">{t(tr, "community.qq.desc")}</p>
            </button>
            <a href="https://discord.com/invite/Vbtgcpy7G4" target="_blank" rel="noopener noreferrer" class="group block p-8 bg-white rounded-3xl border border-gray-100 hover:border-indigo-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
              <div class="flex items-center gap-4 mb-5">
                <div class="p-3 bg-indigo-100 rounded-xl text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-colors shadow-sm">
                  <Icon name="simple-icons:discord" class="h-6 w-6" />
                </div>
                <h3 class="text-2xl font-bold text-gray-900">EvoX <span class="text-indigo-600 group-hover:text-indigo-700 font-extrabold">{t(tr, "community.discord.title")}</span></h3>
              </div>
              <p class="text-gray-600 text-lg leading-relaxed">{t(tr, "community.discord.desc")}</p>
            </a>
          </div>
        </div>
      </div>

      <Footer locale={locale} />
    </div>
  </div>
</Layout>

<style>
  .scroll-bounce {
    animation: float 2s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-bounce {
      animation: none;
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  @media (max-width: 280px) {
    #hero-section {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    #hero-logo {
      height: 4.5rem;
      margin-bottom: 1.25rem;
    }

    #hero-title {
      font-size: 1.5rem;
      line-height: 1.15;
      margin-bottom: 0.75rem;
    }

    #hero-subtitle {
      font-size: 1rem;
      line-height: 1.35;
      margin-bottom: 1rem;
    }
  }

  @media (max-height: 640px) {
    #scroll-indicator {
      display: none;
    }

    #hero-section {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    #hero-logo {
      margin-bottom: 1.5rem;
      height: 5rem;
    }

    #hero-title {
      font-size: 2.25rem;
      line-height: 1.1;
      margin-bottom: 0.75rem;
    }

    #hero-subtitle {
      margin-bottom: 1rem;
    }
  }
</style>

<script>
  // Disable browser scroll restoration so page always starts at top
  if ("scrollRestoration" in history) {
    history.scrollRestoration = "manual";
  }

  function init() {
    const navbar = document.getElementById("navbar");
    const heroSection = document.getElementById("hero-section");
    const heroLogo = document.getElementById("hero-logo");
    const heroGradient = document.getElementById("hero-gradient");
    const scrollIndicator = document.getElementById("scroll-indicator");
    const ctaContent = document.getElementById("cta-content");

    if (!(navbar instanceof HTMLElement) ||
      !(heroSection instanceof HTMLElement) ||
      !(heroLogo instanceof HTMLImageElement)) {
      return;
    }

    const navbarLogoImg = navbar.querySelector("img[data-logo-mark]");
    if (!(navbarLogoImg instanceof HTMLImageElement)) return;

    const navbarEl = navbar;
    const heroSectionEl = heroSection;
    const heroLogoImg = heroLogo;
    const navbarLogoEl = navbarLogoImg;

    navbarLogoEl.style.opacity = "0";

    let isExpanded = false;
    let isAnimating = false;
    // Users who prefer reduced motion get the expanded state instantly,
    // without the flight animation or the scroll lock.
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    function preventScroll(e: Event) {
      e.preventDefault();
    }
    function lockScroll() {
      document.body.style.overflow = "hidden";
      window.addEventListener("wheel", preventScroll, { passive: false });
      window.addEventListener("touchmove", preventScroll, { passive: false });
    }
    function unlockScroll() {
      document.body.style.overflow = "";
      window.removeEventListener("wheel", preventScroll);
      window.removeEventListener("touchmove", preventScroll);
    }

    function smooth(t: number) {
      return t * t * (3 - 2 * t);
    }
    // Cubic Hermite segment: s ∈ [0,1], seg = duration, m0/m1 = end velocities
    function hermite(
      s: number,
      seg: number,
      u0: number,
      u1: number,
      m0: number,
      m1: number,
    ) {
      const s2 = s * s;
      const s3 = s2 * s;
      return (
        (2 * s3 - 3 * s2 + 1) * u0 +
        (s3 - 2 * s2 + s) * seg * m0 +
        (-2 * s3 + 3 * s2) * u1 +
        (s3 - s2) * seg * m1
      );
    }

    let expandCallback: (() => void) | null = null;
    let pendingAnchor: HTMLElement | null = null;

    function expand(onDone?: () => void) {
      if (reduceMotion) {
        // Skip the flight animation and the scroll lock entirely
        completeExpand();
        if (onDone) onDone();
        return;
      }
      if (isExpanded || isAnimating) {
        if (isExpanded && !isAnimating && onDone) onDone();
        return;
      }
      isExpanded = true;
      isAnimating = true;
      lockScroll();
      if (onDone) expandCallback = onDone;

      // Measure hero logo position
      const logoRect = heroLogoImg.getBoundingClientRect();
      const logoStartX = logoRect.left;
      const logoStartY = logoRect.top;
      const logoW = logoRect.width;
      const logoH = logoRect.height;

      // Measure navbar height and logo end position. The navbar is moved by
      // rAF below, so it must have no CSS transform transition — otherwise
      // the rendered position would lag the calculated one every frame.
      navbarEl.style.transform = "translateY(0)";
      navbarEl.offsetHeight;
      const navLogoRect = navbarLogoEl.getBoundingClientRect();
      const logoEndX = navLogoRect.left;
      const logoEndY = navLogoRect.top;
      const logoEndW = navLogoRect.width;
      const logoEndH = navLogoRect.height;
      navbarEl.style.transform = `translateY(${window.innerHeight}px)`;
      navbarEl.offsetHeight;

      // Clone logo for flying
      const flyLogo = heroLogoImg.cloneNode(true) as HTMLImageElement;
      flyLogo.id = "";
      flyLogo.className = "";
      flyLogo.style.cssText = `position:fixed;left:${logoStartX}px;top:${logoStartY}px;width:${logoW}px;height:${logoH}px;z-index:60;pointer-events:none;margin:0;padding:0;`;
      document.body.appendChild(flyLogo);
      heroLogoImg.style.visibility = "hidden";

      // Choreography, all driven by the navbar's rising top edge:
      // 1. The navbar rises from the bottom until its top edge touches the
      //    hero logo's bottom edge (contactY) — the logo waits in place.
      // 2. They then rise together at the same speed, the logo's bottom
      //    glued to the navbar's top edge, while the logo shrinks and moves
      //    left; both complete exactly when the logo reaches its final spot
      //    (dockY = logoEndY + logoEndH).
      // 3. The navbar rises one more logo-height to its final position while
      //    the logo stays parked, then the flyLogo hands off to navbarLogo.
      const vh = window.innerHeight;
      const contactY = logoStartY + logoH;
      const dockY = logoEndY + logoEndH;
      // Distance-proportional durations: the pre-contact rise averages about
      // twice the speed of the post-contact carry. The two segments share the
      // same velocity at the contact instant (junctionV), so the deceleration
      // is continuous and no speed switch is perceptible.
      const riseMs = Math.min(Math.max((vh - contactY) / 0.5, 500), 2000);
      const carryMs = Math.min(Math.max(contactY / 0.25, 1400), 3600);
      const durationMs = riseMs + carryMs;
      const junctionV = (1.5 * contactY) / carryMs;

      const startTime = performance.now();

      function animate(now: number) {
        const elapsed = now - startTime;
        const rawT = Math.min(elapsed / durationMs, 1);

        // Distance risen so far: brisk Hermite segment until contact, gentle
        // segment after; both meet at junctionV, so velocity is continuous
        const risen =
          elapsed < riseMs
            ? hermite(elapsed / riseMs, riseMs, 0, vh - contactY, 0, junctionV)
            : hermite(
                (elapsed - riseMs) / carryMs,
                carryMs,
                vh - contactY,
                vh,
                junctionV,
                0,
              );
        const navbarY = vh - risen;
        navbarEl.style.transform = `translateY(${navbarY}px)`;

        // Post-contact progress for the surrounding elements (hero collapse,
        // CTA fade-in, gradient, scroll indicator), spanning phases 2 and 3
        const pAll = Math.min(Math.max((contactY - navbarY) / contactY, 0), 1);

        heroSectionEl.style.minHeight = `${100 - 40 * pAll}vh`;
        if (heroGradient) heroGradient.style.opacity = `${1 - 0.7 * pAll}`;
        if (ctaContent) {
          ctaContent.style.opacity = `${pAll}`;
          if (pAll >= 1) {
            ctaContent.style.pointerEvents = "";
            ctaContent.removeAttribute("inert");
          }
        }
        if (scrollIndicator) {
          scrollIndicator.style.opacity = `${1 - pAll}`;
          if (pAll > 0) scrollIndicator.style.pointerEvents = "none";
        }

        if (navbarY >= contactY) {
          // Phase 1: the logo waits at its hero spot until the navbar's top
          // edge reaches its bottom edge
          flyLogo.style.left = `${logoStartX}px`;
          flyLogo.style.top = `${logoStartY}px`;
          flyLogo.style.width = `${logoW}px`;
          flyLogo.style.height = `${logoH}px`;
        } else if (navbarY >= dockY) {
          // Phase 2: the logo rides the navbar's top edge (bottom glued to
          // it) while shrinking and sliding left — position and size both
          // complete exactly when the logo reaches its final spot
          const p = smooth((contactY - navbarY) / (contactY - dockY));
          const curW = logoW + (logoEndW - logoW) * p;
          const curH = logoH + (logoEndH - logoH) * p;
          const curX = logoStartX + (logoEndX - logoStartX) * p;
          flyLogo.style.left = `${curX}px`;
          flyLogo.style.top = `${navbarY - curH}px`;
          flyLogo.style.width = `${curW}px`;
          flyLogo.style.height = `${curH}px`;
        } else {
          // Phase 3: the logo is parked at its final spot while the navbar
          // rises the last logo-height underneath it
          flyLogo.style.left = `${logoEndX}px`;
          flyLogo.style.top = `${logoEndY}px`;
          flyLogo.style.width = `${logoEndW}px`;
          flyLogo.style.height = `${logoEndH}px`;
        }

        if (rawT < 1) {
          requestAnimationFrame(animate);
        } else {
          // Ensure navbar is at final position
          navbarEl.style.transform = "translateY(0)";
          // Place flyLogo exactly at navbarLogo position
          flyLogo.style.left = `${logoEndX}px`;
          flyLogo.style.top = `${logoEndY}px`;
          flyLogo.style.width = `${logoEndW}px`;
          flyLogo.style.height = `${logoEndH}px`;
          // The animation is visually done — release the scroll lock and
          // listeners now instead of holding the page hostage. Only the
          // flyLogo → navbarLogo handoff waits for a frame to settle.
          isAnimating = false;
          unlockScroll();
          removeFirstScrollListeners();
          requestAnimationFrame(() => {
            setTimeout(() => {
              navbarLogoEl.style.opacity = "1";
              flyLogo.remove();
              if (expandCallback) {
                expandCallback();
                expandCallback = null;
              }
              if (pendingAnchor) {
                pendingAnchor.scrollIntoView({ behavior: "smooth" });
                pendingAnchor = null;
              }
            }, 50);
          });
        }
      }

      requestAnimationFrame(animate);
    }

    // Skip the flight animation and jump straight to the expanded final state
    function completeExpand() {
      if (isExpanded || isAnimating) return;
      isExpanded = true;
      navbarEl.style.transform = "translateY(0)";
      navbarLogoEl.style.opacity = "1";
      heroLogoImg.style.visibility = "hidden";
      heroSectionEl.style.minHeight = "60vh";
      if (heroGradient) heroGradient.style.opacity = "0.3";
      if (ctaContent) {
        ctaContent.style.opacity = "1";
        ctaContent.style.pointerEvents = "";
        ctaContent.removeAttribute("inert");
      }
      if (scrollIndicator) {
        scrollIndicator.style.opacity = "0";
        scrollIndicator.style.pointerEvents = "none";
      }
      unlockScroll();
      removeFirstScrollListeners();
      if (expandCallback) {
        expandCallback();
        expandCallback = null;
      }
    }

    // Intercept first wheel/touch to trigger animation directly
    function onFirstScroll(e: Event) {
      e.preventDefault();
      if (!isExpanded && !isAnimating) {
        expand();
      }
    }

    // Fallback: keyboard/scrollbar scrolling bypasses wheel/touchmove,
    // so finish the expand immediately once the page actually scrolls
    function onScrollFallback() {
      if (!isExpanded && !isAnimating && window.scrollY > 0) {
        completeExpand();
      }
    }
    window.addEventListener("wheel", onFirstScroll, { passive: false });
    window.addEventListener("touchmove", onFirstScroll, { passive: false });
    window.addEventListener("scroll", onScrollFallback, { passive: true });

    function removeFirstScrollListeners() {
      window.removeEventListener("wheel", onFirstScroll);
      window.removeEventListener("touchmove", onFirstScroll);
      window.removeEventListener("scroll", onScrollFallback);
    }

    heroSection.addEventListener("click", () => {
      if (!isExpanded && !isAnimating) {
        expand();
      }
    });

    if (scrollIndicator) {
      scrollIndicator.addEventListener("click", (e) => {
        e.stopPropagation();
        if (!isExpanded && !isAnimating) {
          expand();
        }
      });
    }

    // Intercept anchor links: if animation hasn't played, play it first then scroll
    document.addEventListener("click", (e) => {
      const anchor = (e.target as HTMLElement).closest(
        "a[href^='#']",
      ) as HTMLAnchorElement | null;
      if (!anchor) return;
      const targetId = anchor.getAttribute("href")?.slice(1);
      if (!targetId) return;
      const targetEl = document.getElementById(targetId);
      if (!targetEl) return;

      e.preventDefault();
      if (!isExpanded) {
        expand(() => {
          targetEl.scrollIntoView({ behavior: "smooth" });
        });
      } else if (!isAnimating) {
        targetEl.scrollIntoView({ behavior: "smooth" });
      } else {
        pendingAnchor = targetEl;
      }
    });
  }

  document.addEventListener("DOMContentLoaded", init);
</script>

<div id="qq-qr-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-label={t(tr, "community.qq.title")}>
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" data-qq-qr-close></div>
  <div class="relative bg-white rounded-3xl p-6 md:p-8 shadow-2xl max-w-sm w-full text-center">
    <button type="button" data-qq-qr-close aria-label={t(tr, "community.qq.close")} class="absolute top-3 right-3 p-2 text-gray-400 hover:text-gray-700 transition-colors cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </button>
    <img src="/images/qq-group-qr.png" alt={t(tr, "community.qq.title")} width="610" height="610" class="w-full h-auto rounded-xl" loading="lazy" />
    <p class="mt-4 text-lg font-bold text-gray-900">QQ: 297969717</p>
    <p class="mt-1 text-gray-600">{t(tr, "community.qq.scan")}</p>
  </div>
</div>
<script>
  const qqQrModal = document.getElementById("qq-qr-modal");
  const closeQqQrModal = () => {
    qqQrModal?.classList.add("hidden");
    qqQrModal?.classList.remove("flex");
  };
  document.querySelectorAll("[data-qq-qr-open]").forEach((btn) => {
    btn.addEventListener("click", () => {
      qqQrModal?.classList.remove("hidden");
      qqQrModal?.classList.add("flex");
    });
  });
  qqQrModal?.querySelectorAll("[data-qq-qr-close]").forEach((el) => {
    el.addEventListener("click", closeQqQrModal);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeQqQrModal();
  });
</script>
