---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths({ paginate }) {
  const blogs = await getCollection("blogs");
  // Sort blogs by publication date descending
  const sortedBlogs = blogs.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  return paginate(sortedBlogs, { pageSize: 10 });
}

const { page } = Astro.props;
const title = `Blogs ${page.currentPage > 1 ? `- Page ${page.currentPage}` : ""} | EvoX`;
---

<Layout title={title}>
  <div class="bg-[#e6e6e6] min-h-screen py-24">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <!-- Header Section -->
      <div class="mb-12 text-center">
        <h1
          class="text-3xl md:text-4xl font-bold text-gray-900 tracking-tight mb-4"
        >
          Latest News & Blogs
        </h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Deep dives into evolutionary computation, project updates, and
          community news.
        </p>
      </div>

      <!-- Blog Grid: Two columns on medium screens and up -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {
          page.data.map((blog) => (
            <a
              href={`/blogs/${blog.id}`}
              class="group flex flex-col bg-white rounded-xl border border-gray-100 p-6 shadow-sm hover:shadow-lg hover:border-teal-200 transition-all duration-300"
            >
              <div class="mb-4">
                <time
                  datetime={blog.data.pubDate.toISOString()}
                  class="inline-block px-3 py-1 rounded-full bg-teal-50 text-teal-700 text-xs font-bold uppercase tracking-wider"
                >
                  {blog.data.pubDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
              </div>

              <h2 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-teal-600 transition-colors leading-tight">
                {blog.data.title}
              </h2>

              <p class="text-gray-600 leading-relaxed line-clamp-3 mb-6 flex-grow">
                {blog.data.summary ||
                  "Click to read the full article and explore more about this topic..."}
              </p>

              <div class="mt-auto flex items-center text-teal-600 font-semibold group-hover:gap-2 transition-all">
                Read More
                <span class="ml-2 transition-transform group-hover:translate-x-1">
                  &rarr;
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <!-- Pagination Controls -->
      {
        page.lastPage > 1 && (
          <nav class="mt-16 flex flex-col sm:flex-row items-center justify-between border-t border-gray-300 pt-8 gap-6">
            <div class="flex items-center gap-2">
              {page.url.prev ? (
                <a
                  href={page.url.prev}
                  class="flex items-center px-5 py-2.5 bg-white border border-gray-200 rounded-lg text-gray-700 font-medium hover:bg-gray-50 hover:border-teal-300 transition-all shadow-sm"
                >
                  &larr; <span class="ml-2">Previous</span>
                </a>
              ) : (
                <span class="flex items-center px-5 py-2.5 bg-gray-100 border border-gray-200 rounded-lg text-gray-400 font-medium cursor-not-allowed">
                  &larr; <span class="ml-2">Previous</span>
                </span>
              )}
            </div>

            <div class="flex items-center gap-3">
              <span class="text-gray-500 font-medium mr-2">
                Page{" "}
                <span class="text-gray-900 font-bold">{page.currentPage}</span>{" "}
                of {page.lastPage}
              </span>

              <div class="hidden md:flex gap-2">
                {Array.from({ length: page.lastPage }, (_, i) => i + 1).map(
                  (p) => (
                    <a
                      href={p === 1 ? "/blogs" : `/blogs/${p}`}
                      class={`w-9 h-9 flex items-center justify-center rounded-lg font-bold transition-all ${
                        page.currentPage === p
                          ? "bg-teal-600 text-white shadow-md"
                          : "text-gray-600 hover:bg-white"
                      }`}
                    >
                      {p}
                    </a>
                  ),
                )}
              </div>
            </div>

            <div class="flex items-center gap-2">
              {page.url.next ? (
                <a
                  href={page.url.next}
                  class="flex items-center px-5 py-2.5 bg-white border border-gray-200 rounded-lg text-gray-700 font-medium hover:bg-gray-50 hover:border-teal-300 transition-all shadow-sm"
                >
                  <span class="mr-2">Next</span> &rarr;
                </a>
              ) : (
                <span class="flex items-center px-5 py-2.5 bg-gray-100 border border-gray-200 rounded-lg text-gray-400 font-medium cursor-not-allowed">
                  <span class="mr-2">Next</span> &rarr;
                </span>
              )}
            </div>
          </nav>
        )
      }
    </div>
  </div>
</Layout>
