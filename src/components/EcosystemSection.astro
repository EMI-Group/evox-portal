---
import tagRight from "../assets/tag_right.png";
---

<div class="ecosystem-wrapper">
  <!-- Quick Start -->
  <section class="quick-start-section">
    <div class="quick-start-content">
      <img src={tagRight.src} alt="" class="arrow-icon" />
      <div class="quick-start-box">
        <span>Get Started</span>
      </div>
    </div>
  </section>

  <!-- Ecosystem -->
  <section class="ecosystem-section">
    <div class="section-header-row">
      <div class="section-title-group">
        <h2>Ecosystem</h2>
        <span class="subtitle">Feature Projects</span>
      </div>
      <a href="/libs" class="view-all-link">
        See all Projects
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </a>
    </div>
    <p class="section-description">Explore a rich ecosystem of libraries, tools, and more to support development.</p>

    <div class="project-grid">
      <a href="https://github.com/EMI-Group/evox" class="project-card" target="_blank" rel="noopener noreferrer">
        <h3>EvoX</h3>
        <p>A distributed GPU-accelerated evolutionary computation framework compatible with PyTorch.</p>
      </a>
      <a href="https://github.com/EMI-Group/evogit" class="project-card" target="_blank" rel="noopener noreferrer">
        <h3>EvoGit</h3>
        <p>A cloud-centric multi-agent framework that reimagines software development as a collaborative, evolutionary process.</p>
      </a>
      <a href="https://github.com/EMI-Group/evogp" class="project-card" target="_blank" rel="noopener noreferrer">
        <h3>EvoGP</h3>
        <p>A fully GPU-accelerated tree-based genetic programming (TGP) framework built on PyTorch.</p>
      </a>
    </div>
  </section>

  <!-- Community -->
  <section class="community-section">
    <h2>Community</h2>
    <p class="section-description">Join the EvoX developer community to contribute, learn, and get your questions answered.</p>

    <div class="community-grid">
      <a href="http://qm.qq.com/cgi-bin/qm/qr?_wv=1027&k=_9aIGJT9OSyG6Zxi_8owHw5-Kpih8--g&authKey=0J4q%2FdbCjeH3p12Y9qlIavA8vdK3g5FIPJ%2BwpO9M3UkNnEwZCSuw9WiRMO4zNe7d&noverify=0&group_code=297969717" class="community-card" target="_blank" rel="noopener noreferrer">
        <div class="community-icon">
          <!-- QQ Penguin Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.003 2c-2.265 0-6.29 1.364-6.29 7.325v1.195S3.55 14.96 3.55 17.474c0 .665.17 1.025.281 1.025.114 0 .902-.484 1.748-2.072 0 0-.18 2.197 1.904 3.967 0 0-1.77.495-1.77 1.182 0 .686 4.078.43 6.29.43 2.212 0 6.29.256 6.29-.43 0-.687-1.77-1.182-1.77-1.182 2.085-1.77 1.905-3.967 1.905-3.967.845 1.588 1.634 2.072 1.746 2.072.111 0 .283-.36.283-1.025 0-2.514-2.166-6.954-2.166-6.954V9.325C18.29 3.364 14.268 2 12.003 2z"/>
          </svg>
        </div>
        <div class="community-info">
          <h3>EvoX <span class="highlight-blue">QQ Group</span></h3>
          <p>Browse and join QQ group discussions</p>
        </div>
      </a>
      <a href="https://discord.gg/evox" class="community-card" target="_blank" rel="noopener noreferrer">
        <div class="community-icon">
          <!-- Discord Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
          </svg>
        </div>
        <div class="community-info">
          <h3>EvoX <span class="highlight-blue">Discord</span></h3>
          <p>Browse and join discussions with Discord</p>
        </div>
      </a>
    </div>
  </section>
</div>

<style>
  .ecosystem-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }

  /* Quick Start */
  .quick-start-section {
    padding: 4rem 0;
    display: flex;
    justify-content: center;
  }

  .quick-start-content {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .arrow-icon {
    width: 48px;
    height: auto;
  }

  .quick-start-box {
    border: 2px dashed #9ca3af;
    padding: 1.5rem 4rem;
    font-size: 2rem;
    font-weight: 300;
    color: #111827;
    letter-spacing: 0.1em;
  }

  /* Ecosystem */
  .ecosystem-section {
    padding: 2rem 0;
  }

  .section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.5rem;
  }

  .section-title-group h2 {
    font-size: 1.75rem;
    font-weight: 600;
    color: #111827;
    margin: 0;
  }

  .section-title-group .subtitle {
    font-size: 0.9rem;
    color: #06b6d4;
    font-weight: 500;
  }

  .view-all-link {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.9rem;
    color: #6b7280;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .view-all-link:hover {
    color: #111827;
    border-color: #d1d5db;
  }

  .section-description {
    color: #6b7280;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .project-card {
    background: #f5f5f5;
    border-radius: 0.5rem;
    padding: 1.5rem;
    text-decoration: none;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }

  .project-card:hover {
    background: #eeeeee;
    border-color: #e5e7eb;
  }

  .project-card h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: #111827;
    margin: 0 0 0.75rem 0;
  }

  .project-card p {
    font-size: 0.9rem;
    color: #6b7280;
    line-height: 1.6;
    margin: 0;
  }

  /* Community */
  .community-section {
    padding: 3rem 0;
  }

  .community-section h2 {
    font-size: 1.75rem;
    font-weight: 600;
    color: #111827;
    margin: 0 0 0.5rem 0;
  }

  .community-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    max-width: 800px;
  }

  .community-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: #fafafa;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .community-card:hover {
    background: #f5f5f5;
    border-color: #d1d5db;
  }

  .community-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #111827;
  }

  .community-icon svg {
    width: 28px;
    height: 28px;
  }

  .community-info h3 {
    font-size: 1rem;
    font-weight: 500;
    color: #111827;
    margin: 0 0 0.25rem 0;
  }

  .community-info h3 .highlight-blue {
    color: #06b6d4;
  }

  .community-info p {
    font-size: 0.85rem;
    color: #6b7280;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .ecosystem-wrapper {
      padding: 0 1rem 3rem;
    }

    .quick-start-section {
      padding: 2rem 0;
    }

    .arrow-icon {
      width: 36px;
    }

    .quick-start-box {
      padding: 1rem 2rem;
      font-size: 1.5rem;
    }

    .section-header-row {
      flex-direction: column;
      gap: 1rem;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .community-grid {
      grid-template-columns: 1fr;
    }

    .section-title-group h2,
    .community-section h2 {
      font-size: 1.5rem;
    }
  }
</style>
