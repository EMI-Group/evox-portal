---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Code } from "astro:components";
import { Icon } from "astro-icon/components";
import bannerImage from "../assets/evox_banner.jpg";

// 导入原始 Python 代码文件 (使用 ?raw 将其作为字符串导入)
import codeSingleObj from "../content/examples/single-obj.py?raw";
import codeMultiObj from "../content/examples/multi-obj.py?raw";
import codeNeuro from "../content/examples/neuroevolution.py?raw";

import SingleObj from "../content/examples/single-obj.astro";
import MultiObj from "../content/examples/multi-obj.astro";
import Neuroevolution from "../content/examples/neuroevolution.astro";

// 1. 获取并处理数据
const allBlogs = await getCollection("blogs");
// 按日期降序排序并取前3
const latestBlogs = allBlogs
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allLibs = await getCollection("libs");
// 取前3个生态项目
const ecosystem = allLibs.slice(0, 3);
---

<Layout title="EvoX - GPU-accelerated Evolutionary Computation">
  <div
    class="relative bg-gray-900 text-white py-48 overflow-hidden bg-cover bg-center xl:bg-[length:100%_100%]"
    style={`background-image: url(${bannerImage.src});`}
  >
    <div class="absolute inset-0 bg-black/50 z-0"></div>

    <div class="relative z-10 container mx-auto px-4 text-center">
      <h1 class="text-5xl md:text-6xl font-bold mb-6">
        Evolutionary Computation for Everyone
      </h1>
      <p class="text-2xl md:text-3xl font-light text-gray-300 mb-10">
        EvoX is All You Need
      </p>

      <a
        href="https://evox.readthedocs.io/en/latest/tutorial/index.html"
        class="inline-block bg-teal-600 hover:bg-teal-700 text-white font-bold py-3 px-8 rounded-lg transition-colors duration-200"
      >
        Get started
      </a>
    </div>
  </div>

  <div class="bg-white py-16">
    <div class="max-w-[1280px] mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
        {
          latestBlogs.map((post) => (
            <div class="flex flex-col gap-2">
              <h3 class="text-xl font-bold text-gray-900">{post.data.title}</h3>
              <p class="text-gray-600 text-sm line-clamp-3">
                {post.data.summary ||
                  "Click to read more details about this release."}
              </p>
              <a
                href={`/blogs/${post.id}`}
                class="text-teal-600 hover:text-teal-800 font-medium text-sm mt-auto"
              >
                Read more
              </a>
            </div>
          ))
        }
      </div>

      <div class="flex justify-start">
        <a
          href="/blogs"
          class="text-teal-700 font-semibold hover:text-teal-900 inline-flex items-center gap-1 group"
        >
          Sell all Blog & News <span>&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <div class="bg-gray-50 py-16">
    <div class="max-w-[1280px] mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-teal-700 mb-12">
        &lt;&lt; Key Features &gt;&gt;
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left">
        <div
          class="bg-white p-6 rounded-lg shadow-sm border-t-4 border-teal-500"
        >
          <h3 class="text-lg font-bold mb-3">🚀 Ultra Performance</h3>
          <ul class="text-sm text-gray-600 space-y-2">
            <li>
              ● Supports acceleration on heterogeneous hardware (CPUs & GPUs),
              achieving over <b>100x</b> speedups.
            </li>
            <li>
              ● Integrated distributed workflows scaling across multiple nodes.
            </li>
          </ul>
        </div>

        <div
          class="bg-white p-6 rounded-lg shadow-sm border-t-4 border-teal-500"
        >
          <h3 class="text-lg font-bold mb-3">🌐 All-in-One Solution</h3>
          <ul class="text-sm text-gray-600 space-y-2">
            <li>
              ● Includes <b>50+ algorithms</b> for single- and multi-objective optimization.
            </li>
            <li>
              ● Hierarchical architecture for meta learning, hyperparameter
              optimization, and neuroevolution.
            </li>
          </ul>
        </div>

        <div
          class="bg-white p-6 rounded-lg shadow-sm border-t-4 border-teal-500"
        >
          <h3 class="text-lg font-bold mb-3">🛠️ Easy-to-Use Design</h3>
          <ul class="text-sm text-gray-600 space-y-2">
            <li>
              ● Fully compatible with EvoX ecosystem with a tailored programming
              model.
            </li>
            <li>● Effortless setup with one-click installation.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white py-16">
    <div class="max-w-[1280px] mx-auto px-4 flex flex-col gap-24">
      <div class="flex flex-col gap-6">
        <h2 class="text-3xl font-medium text-gray-900 text-left">
          Single-objective Optimization
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div
            class="rounded-lg overflow-auto shadow-lg border border-gray-200 h-[28rem] bg-[#0d1117]"
          >
            <Code
              code={codeSingleObj}
              lang="python"
              theme="github-dark"
              class="p-4 md:p-6 min-h-full"
            />
          </div>
          <div
            class="h-[28rem] bg-white rounded-lg border border-gray-200 overflow-hidden relative"
          >
            <SingleObj />
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-6">
        <h2 class="text-3xl font-medium text-gray-900 text-left">
          Multi-objective Optimization
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div
            class="rounded-lg overflow-auto shadow-lg border border-gray-200 h-[28rem] bg-[#0d1117]"
          >
            <Code
              code={codeMultiObj}
              lang="python"
              theme="github-dark"
              class="p-4 md:p-6 min-h-full"
            />
          </div>
          <div
            class="h-[28rem] bg-white rounded-lg border border-gray-200 overflow-hidden relative"
          >
            <MultiObj />
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-6">
        <h2 class="text-3xl font-medium text-gray-900 text-left">
          Neuroevolution
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div
            class="rounded-lg overflow-auto shadow-lg border border-gray-200 h-[28rem] bg-[#0d1117]"
          >
            <Code
              code={codeNeuro}
              lang="python"
              theme="github-dark"
              class="p-4 md:p-6 min-h-full"
            />
          </div>
          <div
            class="h-[28rem] bg-white rounded-lg border border-gray-200 overflow-hidden relative"
          >
            <Neuroevolution />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-gray-50 py-16 border-t border-gray-200">
    <div class="max-w-[1280px] mx-auto px-4">
      <div class="mb-10">
        <h2 class="text-3xl font-bold text-gray-900 mb-2">Ecosystem</h2>
        <h5 class="text-teal-600 font-medium mb-4">Feature Projects</h5>
        <p class="text-xl text-gray-600">
          Explore a rich ecosystem of libraries, tools, and more to support
          development.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {
          ecosystem.map((item) => (
            <a href={item.data.url} target="_blank" class="block group">
              <div class="bg-white p-6 rounded-lg shadow-sm group-hover:shadow-md transition-shadow border border-gray-100 h-full">
                <h4 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-teal-600 transition-colors">
                  {item.data.title}
                </h4>
                <p class="text-gray-600 text-sm leading-relaxed">
                  {item.data.description}
                </p>
              </div>
            </a>
          ))
        }
      </div>

      <div class="mt-8 text-center md:text-left">
        <a
          href="/libs"
          class="text-teal-700 font-semibold hover:text-teal-900 inline-flex items-center gap-1"
        >
          See all Projects <span>&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <div class="bg-white py-24 border-t border-gray-100">
    <div class="max-w-[1280px] mx-auto px-4">
      <div class="mb-12">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">Community</h2>
        <p class="text-xl text-gray-600 max-w-3xl leading-relaxed">
          Join the EvoX developer community to contribute, learn, and get your
          questions answered.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- QQ Group -->
        <a
          href="http://qm.qq.com/cgi-bin/qm/qr?_wv=1027&k=_9aIGJT9OSyG6Zxi_8owHw5-Kpih8--g&authKey=0J4q%2FdbCjeH3p12Y9qlIavA8vdK3g5FIPJ%2BwpO9M3UkNnEwZCSuw9WiRMO4zNe7d&noverify=0&group_code=297969717"
          target="_blank"
          class="group block p-8 bg-gray-50 rounded-3xl border border-gray-100 hover:border-teal-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
        >
          <div class="flex items-center gap-4 mb-5">
            <div
              class="p-3 bg-teal-100 rounded-xl text-teal-600 group-hover:bg-teal-600 group-hover:text-white transition-colors shadow-sm"
            >
              <Icon name="simple-icons:tencentqq" class="h-6 w-6" />
            </div>
            <h4 class="text-2xl font-bold text-gray-900">
              EvoX <span
                class="text-teal-600 group-hover:text-teal-700 font-extrabold"
                >QQ群</span
              >
            </h4>
          </div>
          <p class="text-gray-600 text-lg leading-relaxed">
            浏览并加入QQ群讨论
          </p>
        </a>

        <!-- Discord -->
        <a
          href="https://discord.com/invite/Vbtgcpy7G4"
          target="_blank"
          class="group block p-8 bg-gray-50 rounded-3xl border border-gray-100 hover:border-indigo-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
        >
          <div class="flex items-center gap-4 mb-5">
            <div
              class="p-3 bg-indigo-100 rounded-xl text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-colors shadow-sm"
            >
              <Icon name="simple-icons:discord" class="h-6 w-6" />
            </div>
            <h4 class="text-2xl font-bold text-gray-900">
              EvoX <span
                class="text-indigo-600 group-hover:text-indigo-700 font-extrabold"
                >Discord</span
              >
            </h4>
          </div>
          <p class="text-gray-600 text-lg leading-relaxed">
            Browse and join discussions with Discord
          </p>
        </a>
      </div>
    </div>
  </div>
</Layout>
