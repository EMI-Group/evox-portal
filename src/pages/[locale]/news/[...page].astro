---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { locales, defaultLocale, type Locale, loadTranslations, t, getLocalizedUrl, getDateLocale, getLocalizedNews } from "../../../i18n/utils";

export async function getStaticPaths({ paginate }) {
  const allArticles = await getCollection("news");
  const nonDefaultLocales = locales.filter((l) => l !== defaultLocale);
  return nonDefaultLocales.flatMap((locale) => {
    const articles = getLocalizedNews(allArticles, locale);
    const sorted = articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return paginate(sorted, { params: { locale }, pageSize: 10 });
  });
}

const locale = Astro.params.locale as Locale;
const tr = await loadTranslations(locale);
const dateLocale = getDateLocale(locale);

const { page } = Astro.props;
const title = t(tr, "news.pageTitle", { page: page.currentPage > 1 ? `- ${t(tr, "news.page")} ${page.currentPage}` : "" });
---

<Layout title={title} locale={locale}>
  <div class="relative text-white py-20 md:py-28 overflow-hidden" style="background: rgb(22, 27, 48);">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at center, rgba(60, 70, 110, 0.4) 0%, transparent 60%);"></div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-4">{t(tr, "news.heroTitle")}</h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">{t(tr, "news.heroDesc")}</p>
    </div>
  </div>
  <div class="bg-gray-50 min-h-screen py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
        {page.data.map((article) => (
          <a href={getLocalizedUrl(`/news/${article.slug}`, locale)} class="group flex flex-col bg-white rounded-3xl border border-gray-100 p-8 shadow-sm hover:shadow-2xl hover:border-teal-100 transition-all duration-300 transform hover:-translate-y-2">
            <div class="mb-5">
              <time datetime={article.data.pubDate.toISOString()} class="inline-block px-3 py-1 rounded-full bg-teal-50 text-teal-700 text-xs font-bold uppercase tracking-wider">
                {article.data.pubDate.toLocaleDateString(dateLocale, { year: "numeric", month: "long", day: "numeric" })}
              </time>
            </div>
            <h2 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-teal-600 transition-colors leading-tight">{article.data.title}</h2>
            <p class="text-gray-600 text-lg leading-relaxed line-clamp-3 mb-8 flex-grow">{article.data.summary || t(tr, "news.defaultSummary")}</p>
            <div class="mt-auto flex items-center text-teal-600 font-bold group-hover:gap-2 transition-all">
              {t(tr, "news.readMore")}
              <span class="ml-2 transition-transform group-hover:translate-x-1">&rarr;</span>
            </div>
          </a>
        ))}
      </div>

      {
        page.lastPage > 1 && (
          <nav class="mt-20 flex flex-col sm:flex-row items-center justify-between border-t border-gray-200 pt-10 gap-8">
            <div class="flex items-center gap-2">
              {page.url.prev ? (
                <a href={page.url.prev} class="flex items-center px-6 py-3 bg-white border border-gray-200 rounded-2xl text-gray-700 font-semibold hover:bg-gray-50 hover:border-teal-300 transition-all shadow-sm">
                  &larr; <span class="ml-2">{t(tr, "news.prev")}</span>
                </a>
              ) : (
                <span class="flex items-center px-6 py-3 bg-gray-50 border border-gray-100 rounded-2xl text-gray-300 font-semibold cursor-not-allowed">
                  &larr; <span class="ml-2">{t(tr, "news.prev")}</span>
                </span>
              )}
            </div>
            <div class="flex items-center gap-3">
              <span class="text-gray-500 font-medium mr-2">
                {t(tr, "news.page")}{" "}
                <span class="text-gray-900 font-bold">{page.currentPage}</span>{" "}
                {t(tr, "news.of")} {page.lastPage}
              </span>
            </div>
            <div class="flex items-center gap-2">
              {page.url.next ? (
                <a href={page.url.next} class="flex items-center px-6 py-3 bg-white border border-gray-200 rounded-2xl text-gray-700 font-semibold hover:bg-gray-50 hover:border-teal-300 transition-all shadow-sm">
                  <span class="mr-2">{t(tr, "news.next")}</span> &rarr;
                </a>
              ) : (
                <span class="flex items-center px-6 py-3 bg-gray-50 border border-gray-100 rounded-2xl text-gray-300 font-semibold cursor-not-allowed">
                  <span class="mr-2">{t(tr, "news.next")}</span> &rarr;
                </span>
              )}
            </div>
          </nav>
        )
      }
    </div>
  </div>
</Layout>
