---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths({ paginate }) {
  const blogs = await getCollection("blogs");
  // Sort blogs by publication date descending
  const sortedBlogs = blogs.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  return paginate(sortedBlogs, { pageSize: 10 });
}

const { page } = Astro.props;
const title = `Blogs ${page.currentPage > 1 ? `- Page ${page.currentPage}` : ""} | EvoX`;
---

<Layout title={title}>
  <div class="bg-gray-50 min-h-screen py-24">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <!-- Header Section -->
      <div class="mb-16 text-center">
        <h1
          class="text-4xl md:text-5xl font-extrabold text-gray-900 tracking-tight mb-4"
        >
          Latest News & Blogs
        </h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Deep dives into evolutionary computation, project updates, and
          community news.
        </p>
      </div>

      <!-- Blog Grid: Two columns on medium screens and up -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
        {
          page.data.map((blog) => (
            <a
              href={`/blogs/${blog.id}`}
              class="group flex flex-col bg-white rounded-3xl border border-gray-100 p-8 shadow-sm hover:shadow-2xl hover:border-teal-100 transition-all duration-300 transform hover:-translate-y-2"
            >
              <div class="mb-5">
                <time
                  datetime={blog.data.pubDate.toISOString()}
                  class="inline-block px-3 py-1 rounded-full bg-teal-50 text-teal-700 text-xs font-bold uppercase tracking-wider"
                >
                  {blog.data.pubDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
              </div>

              <h2 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-teal-600 transition-colors leading-tight">
                {blog.data.title}
              </h2>

              <p class="text-gray-600 text-lg leading-relaxed line-clamp-3 mb-8 flex-grow">
                {blog.data.summary ||
                  "Click to read the full article and explore more about this topic..."}
              </p>

              <div class="mt-auto flex items-center text-teal-600 font-bold group-hover:gap-2 transition-all">
                Read More
                <span class="ml-2 transition-transform group-hover:translate-x-1">
                  &rarr;
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <!-- Pagination Controls -->
      {
        page.lastPage > 1 && (
          <nav class="mt-20 flex flex-col sm:flex-row items-center justify-between border-t border-gray-200 pt-10 gap-8">
            <div class="flex items-center gap-2">
              {page.url.prev ? (
                <a
                  href={page.url.prev}
                  class="flex items-center px-6 py-3 bg-white border border-gray-200 rounded-2xl text-gray-700 font-semibold hover:bg-gray-50 hover:border-teal-300 transition-all shadow-sm"
                >
                  &larr; <span class="ml-2">Previous</span>
                </a>
              ) : (
                <span class="flex items-center px-6 py-3 bg-gray-50 border border-gray-100 rounded-2xl text-gray-300 font-semibold cursor-not-allowed">
                  &larr; <span class="ml-2">Previous</span>
                </span>
              )}
            </div>

            <div class="flex items-center gap-3">
              <span class="text-gray-500 font-medium mr-2">
                Page{" "}
                <span class="text-gray-900 font-bold">{page.currentPage}</span>{" "}
                of {page.lastPage}
              </span>

              <div class="hidden md:flex gap-2">
                {Array.from({ length: page.lastPage }, (_, i) => i + 1).map(
                  (p) => (
                    <a
                      href={p === 1 ? "/blogs" : `/blogs/${p}`}
                      class={`w-10 h-10 flex items-center justify-center rounded-xl font-bold transition-all ${
                        page.currentPage === p
                          ? "bg-teal-600 text-white shadow-lg shadow-teal-100"
                          : "text-gray-600 hover:bg-gray-100"
                      }`}
                    >
                      {p}
                    </a>
                  ),
                )}
              </div>
            </div>

            <div class="flex items-center gap-2">
              {page.url.next ? (
                <a
                  href={page.url.next}
                  class="flex items-center px-6 py-3 bg-white border border-gray-200 rounded-2xl text-gray-700 font-semibold hover:bg-gray-50 hover:border-teal-300 transition-all shadow-sm"
                >
                  <span class="mr-2">Next</span> &rarr;
                </a>
              ) : (
                <span class="flex items-center px-6 py-3 bg-gray-50 border border-gray-100 rounded-2xl text-gray-300 font-semibold cursor-not-allowed">
                  <span class="mr-2">Next</span> &rarr;
                </span>
              )}
            </div>
          </nav>
        )
      }
    </div>
  </div>
</Layout>
