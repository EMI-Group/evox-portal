---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { getLocalizedNews, getLocalizedArticles, getLocalizedUrl, getDateLocale, loadTranslations, t, type Locale } from "../../i18n/utils";
import evococoBanner from "../../content/news/evococo/title_banner.png";
import autopsoBanner from "../../content/news/autopso/autopso-hero.png";
import evogmBanner from "../../content/news/evogm/evogm-1.png";
import evogoBanner from "../../content/news/evogo/image1.png";
import evogpBanner from "../../content/news/evogp/evogp-1.jpg";
import istratdeBanner from "../../content/news/iStratDE/istratde-1.png";
import { blogSamples, blogSamplePath } from "./blog-samples";

interface Props { locale: Locale; slug?: string; kind?: "news" | "releases"; preview?: boolean }
const { locale, slug = "evococo", kind = "news", preview = false } = Astro.props;
const sample = blogSamples.find(entry => entry.slug === slug);
const paperBanner = ({ evococo: evococoBanner, autopso: autopsoBanner, evogm: evogmBanner, evogo: evogoBanner, evogp: evogpBanner, istratde: istratdeBanner } as Partial<Record<string, typeof evococoBanner>>)[slug.toLowerCase()];
const tr = await loadTranslations(locale);
const articles = kind === "news" ? getLocalizedNews(await getCollection("news"), locale) : getLocalizedArticles(await getCollection("releases"), locale);
const article = articles.find(entry => entry.slug === slug);
if (!article) throw new Error(`Missing blog article: ${slug}`);
const { Content, headings } = await render(article);
const sections = headings.filter(heading => heading.depth === 2).map(heading => ({
  ...heading, text: heading.text.replace(/^[一二三四五六七八九十]+、/, ""),
}));
const originalPath = `/${kind}/${slug}`;
const originalUrl = getLocalizedUrl(originalPath, locale);
const titleParts = article.data.title.match(/^([^:：]+)[:：]\s*([\s\S]+)$/);
const headline = titleParts?.[2] || article.data.title;
const headlineLines = locale === "zh-cn" ? headline.split(slug === "codex-for-evox" ? /(?<=、)/ : /(?<=，)/) : [headline];
---

<Layout title={article.data.title} description={article.data.summary} locale={locale} localePath={preview ? blogSamplePath(slug) : originalPath} noSEO={preview}>
  <div class="blog-sample" id="article-top" data-sample={slug} data-paper={Boolean(paperBanner)}>
    {preview && <><div class="sample-bar">
      <span><i aria-hidden="true"></i>{t(tr, "sample.label")}</span>
      <a href={originalUrl}>{t(tr, "sample.original")} <span aria-hidden="true">↗</span></a>
    </div>
    <nav class="sample-switcher" aria-label={t(tr, "sample.choose")}>
      {blogSamples.map(entry => <a href={getLocalizedUrl(blogSamplePath(entry.slug), locale)} aria-current={entry.slug === slug ? "page" : undefined}>{entry.label}</a>)}
    </nav></>}
    <header class="article-header">
      <div class="article-meta"><a href={getLocalizedUrl(`/${kind}`, locale)}>{t(tr, "nav.blog")}</a><span aria-hidden="true">/</span><span>{t(tr, `nav.blog.${kind}`)}</span><time datetime={article.data.pubDate.toISOString()}>{article.data.pubDate.toLocaleDateString(getDateLocale(locale), { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}</time></div>
      <h1>{titleParts && <span class="project-name">{titleParts[1]}</span>}{headlineLines.map(line => <span>{line}</span>)}</h1>
      <p class="article-deck">{article.data.summary}</p>
      {sample && <div class="article-topics" aria-label={t(tr, "blog.topics")}>{sample.topics.map(topic => <span>{topic}</span>)}</div>}
    </header>
    <div class:list={["reading-layout", { "without-toc": sections.length < 2 }]}>
      <article class="article-body">
        <div class="sample-prose"><Content /></div>
        {paperBanner && <details class="paper-details"><summary>{t(tr, "blog.paper")}</summary><img src={paperBanner.src} width={paperBanner.width} height={paperBanner.height} alt={t(tr, "blog.paper")} loading="lazy" /></details>}
        <div class="article-end"><a href={getLocalizedUrl(`/${kind}`, locale)}>← {t(tr, kind === "news" ? "news.backToNews" : "releases.backToReleases")}</a><a href="#article-top">{t(tr, "blog.top")} ↑</a></div>
      </article>
      {sections.length > 1 && <aside class="reading-sidebar">
        <nav class="desktop-toc" aria-label={t(tr, "blog.contents")}>
          <p class="toc-label">{t(tr, "blog.contents")}</p>
          <ol>{sections.map((section, index) => <li><a href={`#${section.slug}`} data-section={section.slug}><span class="toc-number">{String(index + 1).padStart(2, "0")}</span><span>{section.text}</span></a></li>)}</ol>
          <div class="reading-track" aria-hidden="true"><div></div></div>
        </nav>
        <details class="mobile-toc"><summary>{t(tr, "blog.contents")}</summary><nav aria-label={t(tr, "blog.contents")}><ol>{sections.map(section => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol></nav></details>
      </aside>}
    </div>
  </div>
</Layout>

<style>
  .blog-sample { max-width: 1104px; margin: auto; padding: 0 32px; }
  .sample-bar { display: flex; align-items: center; justify-content: space-between; gap: 20px; border-bottom: 1px solid var(--site-line); padding: 23px 0; font-size: 12px; color: var(--site-muted); }
  .sample-bar > span { display: flex; align-items: center; gap: 10px; }
  .sample-bar i { width: 5px; height: 5px; background: var(--site-accent); border-radius: 50%; }
  a { text-decoration: none; transition: color .2s; }
  a:hover { color: var(--site-link); }
  .sample-bar a span { margin-left: 8px; }
  .sample-switcher { display: flex; flex-wrap: wrap; gap: 12px 26px; padding: 20px 0; border-bottom: 1px solid var(--site-line); font-size: 12px; color: var(--site-muted); }
  .sample-switcher a[aria-current="page"] { color: var(--site-ink); text-decoration: underline; text-decoration-color: var(--site-accent); text-underline-offset: 8px; }
  .article-header { padding: 44px 0; border-bottom: 1px solid var(--site-line); }
  .article-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; color: var(--site-muted); font-size: 12px; }
  .article-meta time { margin-left: auto; font-variant-numeric: tabular-nums; }
  h1 { max-width: 900px; margin: 27px 0 23px; font-size: clamp(30px, 3.6vw, 46px); font-weight: 500; line-height: 1.3; letter-spacing: -.035em; text-wrap: balance; }
  h1 span { display: block; }
  .project-name { font-size: 15px; line-height: 1.5; font-weight: 500; letter-spacing: .02em; margin-bottom: 15px; color: var(--site-link); }
  .article-deck { max-width: 790px; color: var(--site-muted); font-size: 17px; line-height: 1.85; margin: 0; text-wrap: pretty; }
  .article-topics { display: flex; gap: 22px; margin-top: 25px; font-family: var(--site-mono); font-size: 10px; letter-spacing: .015em; color: var(--site-muted); }
  .article-topics span + span { border-left: 1px solid var(--site-line); padding-left: 22px; }
  .reading-layout { display: grid; grid-template-columns: minmax(0, 720px) minmax(180px, 1fr); gap: 64px; padding: 48px 0 80px; }
  .article-body { min-width: 0; }
  .without-toc { grid-template-columns: minmax(0, 720px); }
  .sample-prose > :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: 0; }
  .sample-prose :global(h4) { color: var(--site-ink); font-size: 17px; font-weight: 600; margin: 28px 0 14px; }
  .article-topics { flex-wrap: wrap; }
  .reading-sidebar { min-width: 0; }
  .desktop-toc { position: sticky; top: 104px; max-height: calc(100svh - 136px); overflow-y: auto; scrollbar-width: thin; padding-right: 8px; }
  .toc-label { font-size: 11px; letter-spacing: .08em; margin: 0 0 22px; color: var(--site-ink); }
  .desktop-toc ol { list-style: none; margin: 0; padding: 0; }
  .desktop-toc li + li { margin-top: 17px; }
  .desktop-toc a { display: flex; gap: 12px; font-size: 12px; line-height: 1.7; color: var(--site-muted); }
  .desktop-toc a:hover, .desktop-toc a[aria-current="location"] { color: var(--site-ink); }
  .toc-number { color: var(--site-muted); font: 10px/2 var(--site-mono); }
  .desktop-toc a[aria-current="location"] .toc-number { color: var(--site-link); }
  .reading-track { height: 1px; margin-top: 28px; background: var(--site-line); overflow: hidden; }
  .reading-track div { height: 100%; background: var(--site-accent); transform: scaleX(0); transform-origin: left; }
  .mobile-toc { display: none; }
  .sample-prose { color: color-mix(in srgb, var(--site-ink) 82%, var(--site-bg)); font-size: 16px; line-height: 1.95; overflow-wrap: anywhere; }
  .sample-prose :global(p) { margin: 0 0 22px; }
  /* The paper title image is available in the source-details disclosure below. */
  [data-paper="true"] .sample-prose > :global(p:first-of-type:has(img)) { display: none; }
  .sample-prose > :global(h1:first-child) { display: none; }
  [data-paper="true"] .sample-prose > :global(h1:first-child + p:has(img) + h2) { margin-top: 0; padding-top: 0; border-top: 0; }
  .sample-prose :global(h2) { color: var(--site-ink); font-size: 26px; font-weight: 500; line-height: 1.5; letter-spacing: -.025em; margin: 58px 0 23px; padding-top: 29px; border-top: 1px solid var(--site-line); scroll-margin-top: 24px; text-wrap: pretty; }
  .sample-prose :global(h3) { color: var(--site-ink); font-size: 19px; font-weight: 500; margin: 34px 0 17px; scroll-margin-top: 24px; }
  .sample-prose :global(strong) { color: var(--site-ink); font-weight: 600; }
  .sample-prose :global(a) { color: var(--site-link); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--site-link) 40%, transparent); text-underline-offset: 4px; }
  .sample-prose :global(ul), .sample-prose :global(ol) { padding-left: 22px; margin: 22px 0 28px; }
  .sample-prose :global(ul) { list-style: disc; }
  .sample-prose :global(ol) { list-style: decimal; }
  .sample-prose :global(li) { padding-left: 6px; margin: 9px 0; }
  .sample-prose :global(li::marker) { color: var(--site-accent); font-size: .85em; }
  .sample-prose :global(img) { width: 100%; height: auto; border-radius: 6px; background: #fff; }
  .sample-prose :global(p:has(> img)) { margin: 32px 0 13px; }
  .sample-prose :global(p:has(> img) + p:has(> em:only-child)) { font-size: 12px; line-height: 1.75; color: var(--site-muted); margin-bottom: 30px; }
  .sample-prose :global(p > em:only-child) { font-style: normal; }

  .sample-prose :global(table) { display: block; width: 100%; overflow-x: auto; border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: 13px; margin: 30px 0; }
  .sample-prose :global(.table-scroll) { overflow-x: auto; margin: 30px 0; }
  .sample-prose :global(.table-scroll table) { display: table; margin: 0; }
  .sample-prose :global(th), .sample-prose :global(td) { text-align: left; padding: 14px 18px; border-bottom: 1px solid var(--site-line); white-space: nowrap; }
  .sample-prose :global(th) { background: var(--site-alt); font-weight: 500; color: var(--site-ink); }
  .sample-prose :global(pre) { overflow-x: auto; padding: 22px; border: 1px solid var(--site-line); border-radius: 8px; font: 13px/1.8 var(--site-mono); margin: 28px 0; }
  .sample-prose :global(code) { font-family: var(--site-mono); font-size: .85em; }
  .sample-prose :global(:not(pre) > code) { background: var(--site-alt); padding: 3px 6px; border-radius: 4px; }
  .sample-prose :global(blockquote) { margin: 28px 0; padding: 12px 24px; border-left: 2px solid var(--site-accent); background: var(--site-alt); }
  .sample-prose :global(blockquote p:last-child) { margin: 0; }
  .paper-details { margin-top: 40px; padding: 18px 0; border-top: 1px solid var(--site-line); font-size: 12px; color: var(--site-muted); }
  summary { cursor: pointer; }
  .paper-details img { width: 100%; height: auto; margin-top: 20px; border-radius: 6px; }
  .article-end { display: flex; justify-content: space-between; gap: 20px; padding-top: 24px; border-top: 1px solid var(--site-line); margin-top: 24px; color: var(--site-muted); font-size: 12px; }
  @media(max-width: 900px) {
    .reading-layout { grid-template-columns: minmax(0, 1fr); max-width: 720px; gap: 30px; padding-top: 28px; }
    .reading-sidebar { grid-row: 1; }
    .desktop-toc { display: none; }
    .mobile-toc { display: block; font-size: 13px; color: var(--site-muted); border-bottom: 1px solid var(--site-line); padding-bottom: 20px; }
    .mobile-toc ol { display: grid; gap: 14px; list-style: decimal; padding-left: 20px; margin: 20px 0 0; }
  }
  @media(max-width: 560px) {
    .blog-sample { padding: 0 22px; }
    .sample-bar { padding: 19px 0; font-size: 11px; }
    .article-header { padding: 34px 0 30px; }
    .article-meta { font-size: 11px; gap: 10px; }
    h1 { font-size: 30px; letter-spacing: -.03em; margin: 23px 0 20px; line-height: 1.4; }
    .article-deck { font-size: 15px; }
    .sample-prose { font-size: 15px; line-height: 1.95; }
    .sample-prose :global(h2) { font-size: 23px; margin-top: 42px; }
    .article-topics { gap: 14px; }
    .article-topics span + span { padding-left: 14px; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>(".blog-sample");
  if (root) {
    root.querySelectorAll<HTMLTableElement>(".sample-prose table").forEach(table => {
      const wrapper = document.createElement("div");
      wrapper.className = "table-scroll";
      wrapper.tabIndex = 0;
      wrapper.setAttribute("role", "region");
      wrapper.setAttribute("aria-label", [...table.querySelectorAll("th")].map(cell => cell.textContent).join(" / "));
      table.before(wrapper);
      wrapper.append(table);
    });
    const links = [...root.querySelectorAll<HTMLAnchorElement>("[data-section]")];
    const sections = links.map(link => document.getElementById(link.dataset.section!)).filter((node): node is HTMLElement => Boolean(node));
    const body = root.querySelector<HTMLElement>(".sample-prose")!;
    const progress = root.querySelector<HTMLElement>(".reading-track div")!;
    let scheduled = false;
    const update = () => {
      scheduled = false;
      const active = sections.filter(section => section.getBoundingClientRect().top <= 150).at(-1);
      links.forEach(link => active?.id === link.dataset.section ? link.setAttribute("aria-current", "location") : link.removeAttribute("aria-current"));
      const rect = body.getBoundingClientRect();
      const fraction = Math.max(0, Math.min(1, (window.innerHeight - rect.top) / rect.height));
      if (progress) progress.style.transform = `scaleX(${fraction})`;
    };
    const schedule = () => { if (!scheduled) { scheduled = true; requestAnimationFrame(update); } };
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule, { passive: true });
    update();
  }
</script>
