---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { locales, defaultLocale, type Locale, loadTranslations, t, getLocalizedUrl, getLocalizedArticles } from "../../../i18n/utils";

export function getStaticPaths() {
  const nonDefaultLocales = locales.filter((l) => l !== defaultLocale);
  return nonDefaultLocales.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const locale = Astro.params.locale as Locale;
const tr = await loadTranslations(locale);

const allDocs = await getCollection("docs");
const docs = getLocalizedArticles(allDocs, locale);
const sorted = docs.sort((a, b) => a.data.order - b.data.order);

const sectionKeys = [...new Set(sorted.map((d) => d.data.section))];
const sections = sectionKeys.map((key) => ({
  key,
  label: t(tr, `docs.section.${key}`),
  minOrder: Math.min(...sorted.filter((d) => d.data.section === key).map((d) => d.data.order)),
})).sort((a, b) => a.minOrder - b.minOrder);
---

<Layout title={t(tr, "docs.pageTitle")} locale={locale}>
  <div class="relative text-white py-20 md:py-28 overflow-hidden" style="background: rgb(22, 27, 48);">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at center, rgba(60, 70, 110, 0.4) 0%, transparent 60%);"></div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-4">{t(tr, "docs.heroTitle")}</h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">{t(tr, "docs.heroDesc")}</p>
    </div>
  </div>
  <div class="bg-gray-50 min-h-screen py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      {sections.map((section) => {
        const sectionDocs = sorted.filter((d) => d.data.section === section.key);
        return sectionDocs.length > 0 && (
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-3 border-b border-gray-200">{section.label}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {sectionDocs.map((doc) => (
                <a href={getLocalizedUrl(`/docs/${doc.slug}`, locale)} class="group flex items-center bg-white rounded-2xl border border-gray-100 p-5 shadow-sm hover:shadow-xl hover:border-teal-100 transition-all duration-300">
                  <div class="flex-grow">
                    <h3 class="text-lg font-semibold text-gray-900 group-hover:text-teal-600 transition-colors">{doc.data.title}</h3>
                  </div>
                  <span class="ml-3 text-gray-400 group-hover:text-teal-600 transition-colors">&rarr;</span>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</Layout>
