---
import BlogSample from "../../../../components/pages/BlogSample.astro";
import { blogSamples } from "../../../../components/pages/blog-samples";
import { locales, defaultLocale, type Locale } from "../../../../i18n/utils";
export function getStaticPaths() {
  return locales.filter(locale => locale !== defaultLocale).flatMap(locale =>
    blogSamples.filter(entry => entry.slug !== "evococo").map(entry => ({
      params: { locale, sample: entry.slug }, props: { slug: entry.slug },
    })));
}
const locale = Astro.params.locale as Locale;
const { slug } = Astro.props;
---
<BlogSample locale={locale} slug={slug} />
