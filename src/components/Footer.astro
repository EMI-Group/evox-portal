---
import { Icon } from "astro-icon/components";
import logoCom from "../assets/logo_com.png";
import { type Locale, defaultLocale, loadTranslations, t, getLocalizedUrl } from "../i18n/utils";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const tr = await loadTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="pt-16 pb-8 border-t border-gray-800" style="background: rgb(22, 27, 48);">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center mb-16">
      <div class="flex flex-col items-center">
        <h2 class="text-2xl font-bold text-white mb-2">{t(tr, "footer.docs.title")}</h2>
        <p class="text-gray-400 mb-4 text-sm">
          {t(tr, "footer.docs.desc")}
        </p>
        <a
          href={getLocalizedUrl("/docs", locale)}
          class="text-teal-400 font-semibold hover:text-teal-300 flex items-center gap-1 transition-colors"
        >
          {t(tr, "footer.docs.link")} <span>&rarr;</span>
        </a>
      </div>

      <div class="flex flex-col items-center">
        <h2 class="text-2xl font-bold text-white mb-2">{t(tr, "footer.tutorials.title")}</h2>
        <p class="text-gray-400 mb-4 text-sm">
          {t(tr, "footer.tutorials.desc")}
        </p>
        <a
          href={getLocalizedUrl("/tutorials", locale)}
          class="text-teal-400 font-semibold hover:text-teal-300 flex items-center gap-1 transition-colors"
        >
          {t(tr, "footer.tutorials.link")} <span>&rarr;</span>
        </a>
      </div>

      <div class="flex flex-col items-center">
        <h2 class="text-2xl font-bold text-white mb-2">{t(tr, "footer.resources.title")}</h2>
        <p class="text-gray-400 mb-4 text-sm">
          {t(tr, "footer.resources.desc")}
        </p>
        <a
          href="https://github.com/EMI-Group"
          class="text-teal-400 font-semibold hover:text-teal-300 flex items-center gap-1 transition-colors"
        >
          {t(tr, "footer.resources.link")} <span>&rarr;</span>
        </a>
      </div>
    </div>

    <hr class="border-gray-700 my-8" />

    <div class="flex flex-col gap-8">
      <div class="flex flex-row justify-between items-center">
        <a href={getLocalizedUrl("/", locale)} class="opacity-80 hover:opacity-100 transition-opacity">
          <img
            src={logoCom.src}
            alt="EvoX"
            class="h-10"
            style="filter: brightness(0) invert(1);"
          />
        </a>

        <ul class="flex space-x-10">
          <li>
            <a
              href="https://www.facebook.com/evoxhello"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-500 hover:text-[#1877F2] transition-colors"
              aria-label="Facebook"
            >
              <Icon name="simple-icons:facebook" class="w-10 h-10" />
            </a>
          </li>
          <li>
            <a
              href="https://www.x.com/evoxhello"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-500 hover:text-white transition-colors"
              aria-label="X"
            >
              <Icon name="simple-icons:x" class="w-10 h-10" />
            </a>
          </li>
          <li>
            <a
              href="https://www.xiaohongshu.com/user/profile/67a5b52300000000040300b1"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-500 hover:text-[#FF2442] transition-colors"
              aria-label="RedNote"
            >
              <Icon name="simple-icons:xiaohongshu" class="w-10 h-10" />
            </a>
          </li>
          <li>
            <a
              href="https://www.zhihu.com/people/evoxhello"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-500 hover:text-[#0084FF] transition-colors"
              aria-label="Zhihu"
            >
              <Icon name="simple-icons:zhihu" class="w-10 h-10" />
            </a>
          </li>
        </ul>
      </div>

      <div class="text-center">
        <p class="text-sm text-gray-500">
          {t(tr, "footer.copyright", { year: String(year) })}
        </p>
      </div>
    </div>
  </div>
</footer>
