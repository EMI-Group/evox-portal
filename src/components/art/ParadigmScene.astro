---
import { type Locale, defaultLocale, loadTranslations, t } from "../../i18n/utils";
import type { ParadigmKind } from "./paradigm-scenes";
interface Props { kind: ParadigmKind; locale?: Locale; }
const { kind, locale = defaultLocale } = Astro.props;
const tr = await loadTranslations(locale);
---
<div class="paradigm-scene" data-kind={kind} data-caption0={t(tr, `scene.${kind}.0`)} data-caption1={t(tr, `scene.${kind}.1`)} data-caption2={t(tr, `scene.${kind}.2`)}
  data-caption3={t(tr, `scene.${kind}.3`)}
  data-generation-label={t(tr, "scene.generation")}
  data-level0={kind === "agentic" ? t(tr, "scene.agentic.level0") : undefined}
  data-level1={kind === "agentic" ? t(tr, "scene.agentic.level1") : undefined}
  data-level2={kind === "agentic" ? t(tr, "scene.agentic.level2") : undefined}
  data-retained-label={kind === "science" ? t(tr, "scene.science.retained") : kind === "physical" ? t(tr, "scene.physical.retained") : kind === "generative" ? t(tr, "scene.retained") : undefined}>
  <canvas class="scene-canvas" role="img" aria-label={`${t(tr, `paradigms.${kind}.title`)} · ${t(tr, "evolution.figure")}`}></canvas>
  <div class="scene-loading" aria-hidden="true"><i></i><i></i><i></i></div>
  <p class="scene-caption">{t(tr, `scene.${kind}.0`)}</p>
  <div class="scene-controls">
    <button type="button" data-action="pause" data-play={t(tr,"evolution.play")} data-pause={t(tr,"evolution.pause")} aria-label={t(tr,"evolution.pause")} aria-pressed="false"><svg viewBox="0 0 16 16" aria-hidden="true"><path class="pause-icon" d="M5 4v8M11 4v8"/><path class="play-icon" d="m5 3 7 5-7 5Z"/></svg></button>
    <button type="button" data-action="restart" aria-label={t(tr,"evolution.restart")}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6a5.3 5.3 0 1 1 .8 5M3 2v4h4"/></svg></button>
  </div>
</div>
<style>
  .paradigm-scene { position:relative; width:100%; }
  .scene-canvas { display:block; width:100%; height:auto; aspect-ratio:12/7; opacity:0; }
  .scene-loading { position:absolute; top:0; left:0; display:flex; align-items:center; justify-content:center; gap:7px; width:100%; aspect-ratio:12/7; }
  .scene-loading i { width:5px; height:5px; border-radius:50%; background:var(--diagram-muted); opacity:.25; animation:scene-loading 1.2s ease-in-out infinite; }
  .scene-loading i:nth-child(2) { animation-delay:.15s; }.scene-loading i:nth-child(3) { animation-delay:.3s; }
  @keyframes scene-loading { 0%,80%,100% { opacity:.25; transform:scale(.8); } 40% { opacity:.9; transform:scale(1); } }
  @media (prefers-reduced-motion: reduce) { .scene-loading i { animation:none; opacity:.5; } }
  [data-ready] .scene-canvas { opacity:1; }[data-ready] .scene-loading { display:none; }
  .scene-caption { display:flex; align-items:center; justify-content:center; min-height:44px; margin:0; padding:0 16px 12px; text-align:center; font-size:12px; line-height:1.4; color:var(--diagram-muted); pointer-events:none; }
  .scene-controls { position:absolute; top:10px; right:12px; display:none; gap:5px; z-index:4; }
  [data-ready] .scene-controls { display:flex; }
  .scene-controls button { display:grid; place-items:center; width:27px; height:27px; padding:0; border:1px solid var(--diagram-border); border-radius:50%; color:var(--diagram-muted); background:var(--diagram-fill); cursor:pointer; }
  .scene-controls button:hover { color:var(--diagram-ink); border-color:var(--diagram-bright); }.scene-controls button:focus-visible { outline:2px solid var(--diagram-bright); outline-offset:3px; }
  .scene-controls button svg { width:12px!important; height:12px!important; transform:none!important; fill:none; stroke:currentColor; stroke-width:1.2; stroke-linecap:round; stroke-linejoin:round; }
  .play-icon,[data-user-paused] .pause-icon { display:none; }[data-user-paused] .play-icon { display:block; }
</style>
<script>
  import { mountParadigmScenes } from "./paradigm-scenes";
  mountParadigmScenes();
</script>
