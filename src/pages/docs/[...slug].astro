---
// Redirect stub: docs moved to https://runtime.evox.group.
// Slugs are hardcoded (getStaticPaths runs in an isolated scope, so they
// must come from an import) because the content collection was removed.
import { docSlugs } from "../../utils/movedSlugs";

export function getStaticPaths() {
  return docSlugs.map((slug) => ({
    params: { slug },
  }));
}

return Astro.redirect(`https://runtime.evox.group/docs/${Astro.params.slug}`);
---
