  .sci-flow path { stroke-dasharray: 10 8; animation: dash-flow 2.2s linear infinite; }
  .sci-foil { animation: glow-pulse 4s ease-in-out infinite; transform-origin: 208px 108px; }

  @keyframes dash-flow { to { stroke-dashoffset: -36; } }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
  @keyframes glow-pulse { 0%, 100% { opacity: 0.9; } 50% { opacity: 1; filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.5)); } }

  /* ---------- 04 · Computing ---------- */
  .computing-glow {
    background:
      radial-gradient(50rem 24rem at 50% 0%, rgba(59, 130, 246, 0.18), transparent 70%),
      radial-gradient(40rem 20rem at 50% 100%, rgba(20, 184, 166, 0.14), transparent 70%);
  }
  .platform-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.5rem 0.75rem 1.25rem;
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    transition:
      opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
      background-color 0.3s,
      box-shadow 0.3s;
  }
  .platform-tile:hover {
    background: rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 0 0 1px rgba(94, 234, 212, 0.4), 0 0 32px -8px rgba(45, 212, 191, 0.35);
  }
  .platform-tile:hover .platform-icon {
    color: white;
    transform: translateY(-2px) scale(1.08);
  }
  .platform-icon {
    transition: transform 0.3s, color 0.3s;
  }
  .stat-value {
    background: linear-gradient(90deg, #ffffff 0%, #99f6e4 60%, #93c5fd 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stat-bar span {
    width: 0;
    background: linear-gradient(90deg, #3b82f6, #2dd4bf);
    transition: width 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) 0.4s;
  }
  .stat-card.is-visible .stat-bar span {
    width: var(--w);
  }

  /* Pointer-follow glow on dark cards (positions set by initSpotlight). */
  .spotlight {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .spotlight::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s;
    background: radial-gradient(240px circle at var(--mx, 50%) var(--my, 50%), rgba(94, 234, 212, 0.14), transparent 65%);
  }
  .spotlight:hover::before {
    opacity: 1;
  }

  /* ---------- 05 · Explore ---------- */
  .explore-card.is-visible:hover,
  .news-card.is-visible:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 36px -18px rgba(15, 23, 42, 0.2);
  }

  @keyframes rise { to { opacity: 1; transform: none; } }
  @keyframes shimmer { to { background-position: 200% center; } }
  @keyframes drift-a { to { transform: translate(8rem, 5rem) scale(1.1); } }
  @keyframes drift-b { to { transform: translate(-7rem, -4rem) scale(1.15); } }

  /* ---------- Reduced motion: final states, no looping animation ---------- */
  @media (prefers-reduced-motion: reduce) {
    .hero-rise,
    .reveal {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
      transition: none !important;
    }
    .hero-gradient-text,
    .hero-orb,
    .gen-flow,
    .gen-expert,
    .gen-merged,
    .phy-walker,
    .phy-trail,
    .sci-flow path,
    .sci-foil,
    .loop-dot,
    .loop-label,
    .loop-repeat :global(svg) {
      animation: none !important;
    }
    .loop-step::after {
      transition: none !important;
      transform: scaleX(1) !important;
    }
    .evo-path,
    .evo-figure.is-playing .evo-path {
      animation: none !important;
      stroke-dashoffset: 0;
    }
    .evo-path.pruned { opacity: 0.2; }
    .evo-node,
    .evo-figure.is-playing .evo-node {
      animation: none !important;
      opacity: 1;
    }
    .pruned-node { opacity: 0.3 !important; }
    .stat-bar span { transition: none; width: var(--w); }
  }
</style>

<script>
  // Disable browser scroll restoration so page always starts at top
  if ("scrollRestoration" in history) {
    history.scrollRestoration = "manual";
  }

  function init() {
    const navbar = document.getElementById("navbar");
    const heroSection = document.getElementById("hero-section");
    const heroLogo = document.getElementById("hero-logo");
    const heroGradient = document.getElementById("hero-gradient");
    const scrollIndicator = document.getElementById("scroll-indicator");
    const ctaContent = document.getElementById("cta-content");

    if (!(navbar instanceof HTMLElement) ||
      !(heroSection instanceof HTMLElement) ||
      !(heroLogo instanceof HTMLImageElement)) {
      return;
    }

    const navbarLogoImg = navbar.querySelector("img[data-logo-mark]");
    if (!(navbarLogoImg instanceof HTMLImageElement)) return;

    const navbarEl = navbar;
    const heroSectionEl = heroSection;
    const heroLogoImg = heroLogo;
    const navbarLogoEl = navbarLogoImg;

    navbarLogoEl.style.opacity = "0";

    let isExpanded = false;
    let isAnimating = false;
    // Users who prefer reduced motion get the expanded state instantly,
    // without the flight animation or the scroll lock.
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    function preventScroll(e: Event) {
      e.preventDefault();
    }
    function lockScroll() {
      document.body.style.overflow = "hidden";
      window.addEventListener("wheel", preventScroll, { passive: false });
      window.addEventListener("touchmove", preventScroll, { passive: false });
    }
    function unlockScroll() {
      document.body.style.overflow = "";
      window.removeEventListener("wheel", preventScroll);
      window.removeEventListener("touchmove", preventScroll);
    }

    // Ease-out cubic: fast start, soft landing (~cubic-bezier(0.215, 0.61, 0.355, 1)).
    // Applied to both the navbar slide and the logo flight so the motion
    // reads as one natural gesture instead of a slow-fast-slow float.
    function easeOutCubic(t: number) {
      return 1 - Math.pow(1 - t, 3);
    }

    let expandCallback: (() => void) | null = null;
    let pendingAnchor: HTMLElement | null = null;

    function expand(onDone?: () => void) {
      if (reduceMotion) {
        // Skip the flight animation and the scroll lock entirely
        completeExpand();
        if (onDone) onDone();
        return;
      }
      if (isExpanded || isAnimating) {
        if (isExpanded && !isAnimating && onDone) onDone();
        return;
      }
      isExpanded = true;
      isAnimating = true;
      lockScroll();
      if (onDone) expandCallback = onDone;

      // Measure hero logo position
      const logoRect = heroLogoImg.getBoundingClientRect();
      const logoStartX = logoRect.left;
      const logoStartY = logoRect.top;
      const logoW = logoRect.width;
      const logoH = logoRect.height;

      // Measure navbar height and logo end position. The navbar is moved by
      // rAF below, so it must have no CSS transform transition — otherwise
      // the rendered position would lag the calculated one every frame.
      navbarEl.style.transform = "translateY(0)";
      navbarEl.offsetHeight;
      const navLogoRect = navbarLogoEl.getBoundingClientRect();
      const logoEndX = navLogoRect.left;
      const logoEndY = navLogoRect.top;
      const logoEndW = navLogoRect.width;
      const logoEndH = navLogoRect.height;
      navbarEl.style.transform = "translateY(-100%)";
      navbarEl.offsetHeight;
      const navbarH = navbarEl.offsetHeight;

      // Clone logo for flying. The clone pins the hero logo's exact size and
      // position ONCE (fixed, transform-origin 0 0) and is then morphed with
      // a pure translate + uniform-scale transform every frame — the browser
      // composites it without per-frame layout work. The hero logo and the
      // navbar mark are the same /logo.svg with only different heights, so a
      // uniform scale maps every point of the start rect exactly onto the end
      // rect (no snap when the logo lands).
      const flyLogo = heroLogoImg.cloneNode(true) as HTMLImageElement;
      flyLogo.id = "";
      flyLogo.className = "";
      flyLogo.style.cssText = `position:fixed;left:${logoStartX}px;top:${logoStartY}px;width:${logoW}px;height:${logoH}px;transform-origin:0 0;will-change:transform;z-index:60;pointer-events:none;margin:0;padding:0;`;
      document.body.appendChild(flyLogo);
      heroLogoImg.style.visibility = "hidden";

      const flyDx = logoEndX - logoStartX;
      const flyDy = logoEndY - logoStartY;
      const flyScale = logoW > 0 ? logoEndW / logoW : 1;

      // Choreography (decoupled):
      // 1. The navbar slides down from above the viewport (translateY(-100%))
      //    into place (translateY(0)) over a short, snappy duration.
      // 2. Meanwhile the flyLogo morphs independently from the hero spot to
      //    its final spot inside the navbar over a longer, eased duration.
      // 3. Both run on the same timeline (the navbar simply arrives first and
      //    waits), then the flyLogo hands off to the navbar logo.
      // Durations are distance-proportional so the overall feel stays
      // comparable to the old bottom-rise (~0.5–5.6 s total). The flight
      // duration uses the absolute vertical delta — if expand() runs while
      // the page is scrolled (hero logo partially or fully off-screen) the
      // morph still animates cleanly from the measured start spot.
      const slideMs = Math.min(Math.max(navbarH / 0.5, 250), 600);
      const flyMs = Math.min(
        Math.max(Math.abs(logoEndY - logoStartY) / 0.25, 1400),
        3600,
      );
      const durationMs = flyMs;

      const startTime = performance.now();

      function animate(now: number) {
        const elapsed = now - startTime;
        const rawT = Math.min(elapsed / durationMs, 1);

        // Navbar: slides down from above the viewport into its final place
        const slideP = Math.min(elapsed / slideMs, 1);
        navbarEl.style.transform = `translateY(${
          -navbarH * (1 - easeOutCubic(slideP))
        }px)`;

        // flyLogo: eased transform morph from the hero spot to its final
        // navbar spot — only `transform` changes per frame (translate +
        // uniform scale), never left/top/width/height. The same eased
        // progress drives the surrounding elements (hero collapse, CTA
        // fade-in, gradient, scroll indicator), so they all finish exactly
        // when the logo lands.
        const pAll = easeOutCubic(rawT);
        flyLogo.style.transform = `translate(${flyDx * pAll}px, ${flyDy * pAll}px) scale(${1 + (flyScale - 1) * pAll})`;

        heroSectionEl.style.minHeight = `${100 - 40 * pAll}vh`;
        if (heroGradient) heroGradient.style.opacity = `${1 - 0.7 * pAll}`;
        if (ctaContent) {
          ctaContent.style.opacity = `${pAll}`;
          if (pAll >= 1) {
            ctaContent.style.pointerEvents = "";
            ctaContent.removeAttribute("inert");
          }
        }
        if (scrollIndicator) {
          scrollIndicator.style.opacity = `${1 - pAll}`;
          if (pAll > 0) scrollIndicator.style.pointerEvents = "none";
        }

        if (rawT < 1) {
          requestAnimationFrame(animate);
        } else {
          // Ensure navbar is at final position
          navbarEl.style.transform = "translateY(0)";
          // Pin the flyLogo to the exact end rect — at pAll = 1 the transform
          // already equals translate(dx, dy) scale(S), so this is pixel-exact.
          flyLogo.style.transform = `translate(${flyDx}px, ${flyDy}px) scale(${flyScale})`;
          // The animation is visually done — release the scroll lock and
          // listeners now instead of holding the page hostage. Only the
          // flyLogo → navbarLogo handoff waits for a frame to settle.
          isAnimating = false;
          unlockScroll();
          removeFirstScrollListeners();
          requestAnimationFrame(() => {
            setTimeout(() => {
              navbarLogoEl.style.opacity = "1";
              flyLogo.remove();
              if (expandCallback) {
                expandCallback();
                expandCallback = null;
              }
              if (pendingAnchor) {
                pendingAnchor.scrollIntoView({ behavior: "smooth" });
                pendingAnchor = null;
              }
            }, 50);
          });
        }
      }

      requestAnimationFrame(animate);
    }

    // Skip the flight animation and jump straight to the expanded final state
    function completeExpand() {
      if (isExpanded || isAnimating) return;
      isExpanded = true;
      navbarEl.style.transform = "translateY(0)";
      navbarLogoEl.style.opacity = "1";
      heroLogoImg.style.visibility = "hidden";
      heroSectionEl.style.minHeight = "60vh";
      if (heroGradient) heroGradient.style.opacity = "0.3";
      if (ctaContent) {
        ctaContent.style.opacity = "1";
        ctaContent.style.pointerEvents = "";
        ctaContent.removeAttribute("inert");
      }
      if (scrollIndicator) {
        scrollIndicator.style.opacity = "0";
        scrollIndicator.style.pointerEvents = "none";
      }
      unlockScroll();
      removeFirstScrollListeners();
      if (expandCallback) {
        expandCallback();
        expandCallback = null;
      }
    }

    // Intercept first wheel/touch to trigger animation directly
    function onFirstScroll(e: Event) {
      e.preventDefault();
      if (!isExpanded && !isAnimating) {
        expand();
      }
    }

    // Fallback: keyboard/scrollbar scrolling bypasses wheel/touchmove,
    // so finish the expand immediately once the page actually scrolls
    function onScrollFallback() {
      if (!isExpanded && !isAnimating && window.scrollY > 0) {
        completeExpand();
      }
    }
    window.addEventListener("wheel", onFirstScroll, { passive: false });
    window.addEventListener("touchmove", onFirstScroll, { passive: false });
    window.addEventListener("scroll", onScrollFallback, { passive: true });

    function removeFirstScrollListeners() {
      window.removeEventListener("wheel", onFirstScroll);
      window.removeEventListener("touchmove", onFirstScroll);
      window.removeEventListener("scroll", onScrollFallback);
    }

    heroSection.addEventListener("click", () => {
      if (!isExpanded && !isAnimating) {
        expand();
      }
    });

    if (scrollIndicator) {
      scrollIndicator.addEventListener("click", (e) => {
        e.stopPropagation();
        if (!isExpanded && !isAnimating) {
          expand();
        }
      });
    }

    // Intercept anchor links: if animation hasn't played, play it first then scroll
    document.addEventListener("click", (e) => {
      const anchor = (e.target as HTMLElement).closest(
        "a[href^='#']",
      ) as HTMLAnchorElement | null;
      if (!anchor) return;
      const targetId = anchor.getAttribute("href")?.slice(1);
      if (!targetId) return;
      const targetEl = document.getElementById(targetId);
      if (!targetEl) return;

      e.preventDefault();
      if (!isExpanded) {
        expand(() => {
          targetEl.scrollIntoView({ behavior: "smooth" });
        });
      } else if (!isAnimating) {
        targetEl.scrollIntoView({ behavior: "smooth" });
      } else {
        pendingAnchor = targetEl;
      }
    });
  }

  document.addEventListener("DOMContentLoaded", init);
</script>

<script>
  // ---------- Scroll reveal + evolution figure playback ----------
  // Elements with .reveal fade/slide in once they enter the viewport. The
  // mechanism figure only loops while it is on screen.
  function initReveal() {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
    const figure = document.getElementById("evo-figure");

    if (reduceMotion || !("IntersectionObserver" in window)) {
      revealEls.forEach((el) => el.classList.add("is-visible"));
      return;
    }

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
    );
    revealEls.forEach((el) => revealObserver.observe(el));

    if (figure) {
      const figureObserver = new IntersectionObserver(
        ([entry]) => figure.classList.toggle("is-playing", entry.isIntersecting),
        { threshold: 0.35 },
      );
      figureObserver.observe(figure);
    }
  }

  // ---------- Hero "evolving population" particle field ----------
  // A light canvas animation: particles drift, link to near neighbours, and
  // occasionally a particle "mutates" (pulses teal). Paused off-screen and
  // rendered as a single static frame for reduced-motion users.
  function initHeroCanvas() {
    const canvas = document.getElementById("hero-canvas");
    const hero = document.getElementById("hero-section");
    if (!(canvas instanceof HTMLCanvasElement) || !hero) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const context = ctx;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    type Particle = { x: number; y: number; vx: number; vy: number; r: number; pulse: number };
    let particles: Particle[] = [];
    let width = 0;
    let height = 0;
    let rafId = 0;
    let running = false;
    const linkDist = 140;

    function resizeCanvas() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = hero!.clientWidth;
      height = hero!.clientHeight;
      canvas!.width = Math.round(width * dpr);
      canvas!.height = Math.round(height * dpr);
      context.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function resize() {
      resizeCanvas();
      const count = Math.round(Math.min(90, Math.max(28, (width * height) / 18000)));
      particles = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.28,
        vy: (Math.random() - 0.5) * 0.28,
        r: Math.random() * 1.6 + 0.6,
        pulse: 0,
      }));
    }

    function draw() {
      context.clearRect(0, 0, width, height);
      for (let i = 0; i < particles.length; i++) {
        const a = particles[i];
        for (let j = i + 1; j < particles.length; j++) {
          const b = particles[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < linkDist * linkDist) {
            const alpha = (1 - Math.sqrt(d2) / linkDist) * 0.18;
            context.strokeStyle = `rgba(125, 211, 252, ${alpha})`;
            context.lineWidth = 1;
            context.beginPath();
            context.moveTo(a.x, a.y);
            context.lineTo(b.x, b.y);
            context.stroke();
          }
        }
      }
      for (const p of particles) {
        const glow = p.pulse > 0 ? p.pulse : 0;
        context.fillStyle = glow > 0 ? `rgba(94, 234, 212, ${0.5 + glow * 0.5})` : "rgba(191, 219, 254, 0.55)";
        context.beginPath();
        context.arc(p.x, p.y, p.r + glow * 2.5, 0, Math.PI * 2);
        context.fill();
      }
    }

    function step() {
      for (const p of particles) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < -10) p.x = width + 10;
        if (p.x > width + 10) p.x = -10;
        if (p.y < -10) p.y = height + 10;
        if (p.y > height + 10) p.y = -10;
        if (p.pulse > 0) p.pulse = Math.max(0, p.pulse - 0.012);
        else if (Math.random() < 0.0015) p.pulse = 1;
      }
      draw();
      rafId = requestAnimationFrame(step);
    }

    function start() {
      if (running || reduceMotion) return;
      running = true;
      rafId = requestAnimationFrame(step);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(rafId);
    }

    resize();
    draw();
    let resizeTimer = 0;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        draw();
      }, 150);
    });
    // The hero height animates during the logo flight; keep the canvas sized
    // without reseeding the particles (which would flicker).
    if ("ResizeObserver" in window) {
      new ResizeObserver(() => {
        resizeCanvas();
        draw();
      }).observe(hero);
    }

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(([entry]) => (entry.isIntersecting ? start() : stop())).observe(hero);
    } else {
      start();
    }
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
  }

  // ---------- Pointer spotlight on dark cards ----------
  // Fine pointers only; touch devices keep the static card style.
  function initSpotlight() {
    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
    document.querySelectorAll<HTMLElement>(".spotlight").forEach((el) => {
      el.addEventListener("pointermove", (e) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty("--mx", `${e.clientX - r.left}px`);
        el.style.setProperty("--my", `${e.clientY - r.top}px`);
      });
    });
  }

  initReveal();
  initHeroCanvas();
  initSpotlight();
</script>
