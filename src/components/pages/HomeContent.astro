  /* ---------- Scroll reveal (JS adds .is-visible) ---------- */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: var(--d, 0s);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: none;
  }
  /* Without JS, never hide content. */
  :global(html:not(.js-reveal)) .reveal {
    opacity: 1;
    transform: none;
  }

  /* ---------- 02 · Evolution figure ---------- */
  /* Five steps + a repeat marker on one row; labels may wrap but steps never do. */
  .loop-track {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr)) 2.5rem;
    align-items: start;
    max-width: 34rem;
  }
  .loop-step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  /* Connector from this dot to the next one (or to the repeat marker). */
  .loop-step::after {
    content: "";
    position: absolute;
    top: calc(1rem - 1px);
    left: calc(50% + 1.375rem);
    right: calc(-50% + 1.375rem);
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, #93c5fd, #5eead4);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--i) * 0.12s + 0.5s);
  }
  .loop-step:nth-child(5)::after {
    right: -0.375rem;
    background: repeating-linear-gradient(90deg, #5eead4 0 4px, transparent 4px 8px);
  }
  .reveal.is-visible .loop-step::after,
  :global(html:not(.js-reveal)) .loop-step::after {
    transform: scaleX(1);
  }
  .loop-dot {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    font-size: 0.6875rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: white;
    background: linear-gradient(135deg, #3b82f6, #14b8a6);
    box-shadow: 0 4px 12px -4px rgba(20, 184, 166, 0.5);
  }
  .loop-label {
    margin-top: 0.625rem;
    padding: 0 0.125rem;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.25;
    color: rgb(30 41 59);
    overflow-wrap: anywhere;
    hyphens: auto;
  }
  @media (min-width: 640px) {
    .loop-label { font-size: 0.875rem; }
  }
  .loop-repeat {
    display: grid;
    place-items: center;
    justify-self: end;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    color: rgb(13 148 136);
    box-shadow: inset 0 0 0 1.5px rgb(153 246 228);
    background: rgb(240 253 250);
  }
  .reveal.is-visible .loop-dot {
    animation: dot-pulse 8s ease-in-out infinite;
    animation-delay: calc(var(--i) * 1.1s + 0.6s);
  }
  .reveal.is-visible .loop-label {
    animation: label-pulse 8s ease-in-out infinite;
    animation-delay: calc(var(--i) * 1.1s + 0.6s);
  }
  .reveal.is-visible .loop-repeat :global(svg) {
    animation: repeat-spin 8s ease-in-out infinite;
    animation-delay: 6.1s;
  }
  @keyframes dot-pulse {
    0%, 100% { transform: scale(1); box-shadow: 0 4px 12px -4px rgba(20, 184, 166, 0.5); }
    6%, 12% { transform: scale(1.12); box-shadow: 0 0 0 5px rgba(45, 212, 191, 0.18), 0 6px 16px -4px rgba(20, 184, 166, 0.6); }
    18% { transform: scale(1); box-shadow: 0 4px 12px -4px rgba(20, 184, 166, 0.5); }
  }
  @keyframes label-pulse {
    0%, 100% { color: rgb(30 41 59); }
    6%, 12% { color: rgb(15 118 110); }
    18% { color: rgb(30 41 59); }
  }
  @keyframes repeat-spin {
    0% { transform: rotate(0deg); }
    14%, 100% { transform: rotate(360deg); }
  }
  .evo-panel {
    background:
      radial-gradient(ellipse at 30% 20%, rgba(59, 130, 246, 0.18), transparent 60%),
