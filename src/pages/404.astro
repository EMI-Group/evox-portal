---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found | EvoX" noSEO localePath="/">
  <section class="bg-[rgb(22,27,48)] flex flex-col items-center justify-center text-center px-6 py-24 min-h-[70vh]">
    <p class="text-7xl md:text-9xl font-extrabold text-teal-400 tracking-tight">404</p>
    <h1 class="mt-6 text-2xl md:text-3xl font-bold text-gray-100">Page Not Found</h1>
    <p class="mt-4 max-w-md text-gray-300">
      The page you are looking for doesn't exist or has been moved.
    </p>
    <a
      href="/"
      class="mt-10 inline-flex items-center rounded-lg border border-teal-400/40 bg-teal-500/10 px-6 py-3 text-sm font-semibold text-teal-400 hover:bg-teal-500/20 transition-colors"
    >
      Back to Home
    </a>
  </section>
</Layout>
